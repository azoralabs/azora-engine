/**
 * @file engine/tilemap/draw
 *
 * Drawing a tilemap: a 2D camera, culling, parallax, tinting, mirroring and
 * animation, for every lattice the package supports.
 *
 * ## Only what is on screen
 *
 * The camera rectangle is converted back into tile coordinates once per layer
 * and only those cells are visited, so the cost of a frame follows the size of
 * the window rather than the size of the world. A layer's chunk occupancy is
 * consulted before each cell, so the empty parts of a sparse layer — a sky, a
 * foreground detail pass — cost one array read per cell and no draw call.
 *
 * ## Painter's order
 *
 * Square and hexagonal lattices tile the plane without overlap, so their cells
 * are drawn in row order. Isometric tiles overlap by design: the tile in front
 * must be painted after the one behind it, which is the diagonal order
 * [drawTileLayer] switches to when the geometry says so. Drawing an isometric
 * map row by row puts the far wall on top of the near one.
 *
 * @since 0.0.4
 */
module engine.tilemap.draw

import std.container.array
import engine.math.vec
import engine.platform
import engine.gpu
import engine.tilemap.types
import engine.tilemap.coords
import engine.tilemap.storage
import engine.tilemap.atlas
import engine.tilemap.anim
import engine.tilemap.tileset
import engine.tilemap.map

/**
 * A camera over a tilemap's world space.
 *
 * `center` is the world point at the middle of the viewport and `zoom` scales
 * world units to screen points, so a pixel-art game holds zoom at an integer to
 * keep its texels square.
 */
pack TileCamera {
    var center: Vec2
    var zoom: Double
    var viewWidth: Double
    var viewHeight: Double
}

/** A camera showing [viewWidth] x [viewHeight] points centred on [center]. */
func tileCamera(center: Vec2, zoom: Double, viewWidth: Double, viewHeight: Double): TileCamera {
    return TileCamera(center, realMax(zoom, 0.0001), viewWidth, viewHeight)
}

/** A camera filling [app]'s window. */
func cameraForApp(app: App, center: Vec2, zoom: Double): TileCamera {
    return tileCamera(center, zoom, app.width() as Double, app.height() as Double)
}

impl TileCamera {
    /** The centre of the viewport, in screen points. */
    func screenCenter(): Vec2 {
        return Vec2(self.viewWidth * 0.5, self.viewHeight * 0.5)
    }

    /** The world rectangle this camera shows, for a layer at [parallax]. */
    func viewAt(parallax: Vec2, offset: Vec2): WorldRect {
        fin eye = Vec2(self.center.x * parallax.x, self.center.y * parallax.y)
        fin halfW = self.viewWidth * 0.5 / self.zoom
        fin halfH = self.viewHeight * 0.5 / self.zoom
        return worldRect(
            eye.x - halfW - offset.x,
            eye.y - halfH - offset.y,
            eye.x + halfW - offset.x,
            eye.y + halfH - offset.y
        )
    }

    /** The world rectangle this camera shows for a world-locked layer. */
    func view(): WorldRect {
        return self.viewAt(Vec2(1.0, 1.0), vec2Zero())
    }

    /** Where the world point [point] lands on screen. */
    func worldToScreen(point: Vec2): Vec2 {
        fin middle = self.screenCenter()
        return Vec2(
            (point.x - self.center.x) * self.zoom + middle.x,
            (point.y - self.center.y) * self.zoom + middle.y
        )
    }

    /** The world point under the screen point [point]. */
    func screenToWorld(point: Vec2): Vec2 {
        fin middle = self.screenCenter()
        return Vec2(
            (point.x - middle.x) / self.zoom + self.center.x,
            (point.y - middle.y) / self.zoom + self.center.y
        )
    }

    /** The camera moved so [point] is at the centre of the viewport. */
    func lookingAt(point: Vec2): TileCamera {
        return TileCamera(point, self.zoom, self.viewWidth, self.viewHeight)
    }

    /**
     * The camera held inside [bounds].
     *
     * A world smaller than the viewport is centred rather than clamped to a
     * corner, which is what stops a small level sticking to the top-left of a
     * large window.
     */
    func clampedTo(bounds: WorldRect): TileCamera {
        fin halfW = self.viewWidth * 0.5 / self.zoom
        fin halfH = self.viewHeight * 0.5 / self.zoom
        fin x = if bounds.width() <= halfW * 2.0 {
            bounds.center().x
        } else {
            realClamp(self.center.x, bounds.minX + halfW, bounds.maxX - halfW)
        }
        fin y = if bounds.height() <= halfH * 2.0 {
            bounds.center().y
        } else {
            realClamp(self.center.y, bounds.minY + halfH, bounds.maxY - halfH)
        }
        return TileCamera(Vec2(x, y), self.zoom, self.viewWidth, self.viewHeight)
    }
}

/** The world point under the mouse, for picking a tile with the cursor. */
func cameraPointerWorld(app: App, camera: TileCamera): Vec2 {
    return camera.screenToWorld(Vec2(app.mouseX(), app.mouseY()))
}

/** The tile under the mouse, on the map or beyond it. */
func pickTileUnderPointer(app: App, map: Tilemap, camera: TileCamera): TilePick {
    fin point = cameraPointerWorld(app, camera)
    return pickTile(map.geometry, worldPos(point.x, point.y))
}

// ── Drawing ─────────────────────────────────────────────────────────────

/**
 * Draws every visible layer of [map] and returns how many tiles were drawn.
 *
 * `seconds` is the clock animated tiles are resolved against — normally
 * `app.timeNow()`. Layers are drawn in their `order`, so a map sorted once
 * paints its background first and its foreground last.
 */
func drawTilemap(app: App, map: Tilemap, camera: TileCamera, seconds: Double): Int {
    if !map.visible || map.opacity <= 0.0 || !map.tiles.ok() {
        return 0
    }
    var drawn = 0
    var i = 0
    while i < map.count {
        drawn = drawn + drawTileLayer(app, map, i, camera, seconds)
        i = i + 1
    }
    return drawn
}

/**
 * Draws one layer and returns how many tiles were drawn.
 *
 * The layer's own parallax, offset, tint and opacity are folded in here, so two
 * layers of the same map can scroll at different rates without the caller
 * running the culling twice.
 */
func drawTileLayer(app: App, map: Tilemap, index: Int, camera: TileCamera, seconds: Double): Int {
    if !map.hasLayer(index) {
        return 0
    }
    fin layer = map.layers[index]
    if !layer.visible || layer.opacity <= 0.0 {
        return 0
    }

    fin parallax = Vec2(layer.parallaxX, layer.parallaxY)
    fin offset = Vec2(layer.offsetX, layer.offsetY)
    fin view = camera.viewAt(parallax, offset)
    fin cells = visibleTiles(map.geometry, view)
    if cells.isEmpty() {
        return 0
    }

    // Parallax and the layer offset are folded into one camera, so the per-tile
    // path stays a single world-to-screen transform.
    fin eye = Vec2(camera.center.x * parallax.x - offset.x, camera.center.y * parallax.y - offset.y)
    fin shifted = TileCamera(eye, camera.zoom, camera.viewWidth, camera.viewHeight)
    fin tint = tileColorModulate(layer.tint, map.tint)
    fin opacity = layer.opacity * map.opacity

    return if geometryDepthSorted(map.geometry) {
        drawSorted(app, map, layer, cells, shifted, tint, opacity, seconds)
    } else {
        drawRows(app, map, layer, cells, shifted, tint, opacity, seconds)
    }
}

/** Row-order traversal, for the lattices whose tiles do not overlap. */
func drawRows(
    app: App
    map: Tilemap
    layer: TileLayer
    cells: TileRect
    camera: TileCamera
    tint: TileColor
    opacity: Double
    seconds: Double
): Int {
    var drawn = 0
    for y in cells.minY..cells.maxY {
        for x in cells.minX..cells.maxX {
            if drawOneTile(app, map, layer, TilePos(x, y), camera, tint, opacity, seconds) {
                drawn = drawn + 1
            }
        }
    }
    return drawn
}

/**
 * Diagonal traversal, for the isometric lattices whose tiles overlap.
 *
 * Cells are visited in order of `x + y`, which on a diamond lattice is exactly
 * increasing screen depth, so a tile is always painted after everything it
 * stands in front of.
 */
func drawSorted(
    app: App
    map: Tilemap
    layer: TileLayer
    cells: TileRect
    camera: TileCamera
    tint: TileColor
    opacity: Double
    seconds: Double
): Int {
    var drawn = 0
    fin first = cells.minX + cells.minY
    fin last = cells.maxX + cells.maxY
    for depth in first..last {
        fin fromX = intMax(cells.minX, depth - cells.maxY)
        fin toX = intMin(cells.maxX, depth - cells.minY)
        var x = fromX
        while x <= toX {
            if drawOneTile(app, map, layer, TilePos(x, depth - x), camera, tint, opacity, seconds) {
                drawn = drawn + 1
            }
            x = x + 1
        }
    }
    return drawn
}

/**
 * Draws the cell at [pos], returning whether anything was drawn.
 *
 * The chunk occupancy is consulted first: in a sparse layer most cells are
 * empty, and one array read rejects a whole neighbourhood of them before any
 * tileset lookup happens.
 */
func drawOneTile(
    app: App
    map: Tilemap
    layer: TileLayer
    pos: TilePos
    camera: TileCamera
    tint: TileColor
    opacity: Double
    seconds: Double
): Bool {
    if layer.chunks.countAt(pos.x, pos.y) == 0 {
        return false
    }
    fin at = layer.offsetOf(pos)
    if at < 0 {
        return false
    }
    fin index = layer.indices[at]
    if index == tileEmpty {
        return false
    }

    var flags = 0
    if layer.flags.size > 0 {
        flags = layer.flags[at]
    }
    if flagsAny(flags, cellHidden) {
        return false
    }

    fin drawnIndex = map.tiles.resolve(index, seconds, pos)
    fin sheet = map.tiles.find(drawnIndex)
    when sheet {
        AtlasPick.Missing() -> { return false }
        AtlasPick.Found(atlas, local) -> {
            return blitTile(app, map, layer, pos, atlas, local, flags, at, camera, tint, opacity)
        }
    }
    return false
}

/** Puts one resolved tile on screen. */
func blitTile(
    app: App
    map: Tilemap
    layer: TileLayer
    pos: TilePos
    atlas: TileAtlas
    local: Int
    flags: Int
    at: Int
    camera: TileCamera
    tint: TileColor
    opacity: Double
): Bool {
    if atlas.texture == 0L || atlas.texWidth <= 0 || atlas.texHeight <= 0 {
        return false
    }
    fin source = atlas.rectOf(local)
    if source.w <= 0 || source.h <= 0 {
        return false
    }

    fin quad = tileQuad(map.geometry, pos)
    fin topLeft = camera.worldToScreen(Vec2(quad.minX, quad.minY))
    fin width = quad.width() * camera.zoom
    fin height = quad.height() * camera.zoom

    var color = tint
    if layer.tints.size > 0 && layer.tints[at] != tileTintNone {
        color = tileColorModulate(tileColorUnpack(layer.tints[at]), tint)
    }
    fin alpha = color.a * opacity
    if alpha <= 0.0 {
        return false
    }

    // Pixel coordinates become texture coordinates here, and the mirrors are
    // applied by swapping them — which costs nothing and avoids storing a
    // flipped copy of every tile.
    fin tw = atlas.texWidth as Double
    fin th = atlas.texHeight as Double
    var u0 = (source.x as Double) / tw
    var v0 = (source.y as Double) / th
    var u1 = ((source.x + source.w) as Double) / tw
    var v1 = ((source.y + source.h) as Double) / th
    if flagsAny(flags, cellFlipX) {
        fin swap = u0
        u0 = u1
        u1 = swap
    }
    if flagsAny(flags, cellFlipY) {
        fin swap = v0
        v0 = v1
        v1 = swap
    }

    app.drawImageQuad(
        topLeft.x, topLeft.y, width, height,
        u0, v0, u1, v1,
        color.r, color.g, color.b, alpha,
        atlas.texture
    )
    return true
}

/**
 * Draws the outline of every visible cell, for debugging a lattice.
 *
 * Cell boundaries are invisible in finished art, so a map whose grid size and
 * tile size disagree looks merely "slightly wrong" until the lattice is drawn
 * on top of it.
 */
func drawTileGrid(app: App, map: Tilemap, camera: TileCamera, color: TileColor): Int {
    fin cells = visibleTiles(map.geometry, camera.view())
    if cells.isEmpty() {
        return 0
    }
    fin thickness = realMax(1.0, camera.zoom * 0.03)
    var drawn = 0
    for y in cells.minY..cells.maxY {
        for x in cells.minX..cells.maxX {
            fin quad = tileQuad(map.geometry, TilePos(x, y))
            fin topLeft = camera.worldToScreen(Vec2(quad.minX, quad.minY))
            fin width = quad.width() * camera.zoom
            fin height = quad.height() * camera.zoom
            app.uiRect(topLeft.x, topLeft.y, width, thickness, color.r, color.g, color.b, color.a)
            app.uiRect(topLeft.x, topLeft.y, thickness, height, color.r, color.g, color.b, color.a)
            drawn = drawn + 1
        }
    }
    return drawn
}

/** Highlights one cell, for a cursor or a placement preview. */
func drawTileHighlight(app: App, map: Tilemap, pos: TilePos, camera: TileCamera, color: TileColor) {
    fin quad = tileQuad(map.geometry, pos)
    fin topLeft = camera.worldToScreen(Vec2(quad.minX, quad.minY))
    app.uiRect(
        topLeft.x,
        topLeft.y,
        quad.width() * camera.zoom,
        quad.height() * camera.zoom,
        color.r, color.g, color.b, color.a
    )
}

test "the camera round-trips between world and screen" {
    fin camera = tileCamera(Vec2(100.0, 50.0), 2.0, 800.0, 600.0)
    fin screen = camera.worldToScreen(Vec2(100.0, 50.0))
    assert realAbs(screen.x - 400.0) < 0.001 && realAbs(screen.y - 300.0) < 0.001 {
        "the camera centre must land at the middle of the viewport"
    }

    fin back = camera.screenToWorld(camera.worldToScreen(Vec2(37.0, -12.0)))
    assert realAbs(back.x - 37.0) < 0.001 && realAbs(back.y + 12.0) < 0.001 {
        "world to screen and back must be the identity"
    }

    fin zoomed = camera.worldToScreen(Vec2(110.0, 50.0))
    assert realAbs(zoomed.x - 420.0) < 0.001 { "ten world units at 2x zoom must be twenty points" }
}

test "the camera's view narrows as it zooms in" {
    fin camera = tileCamera(Vec2(0.0, 0.0), 2.0, 800.0, 600.0)
    fin view = camera.view()
    assert realAbs(view.width() - 400.0) < 0.001 { "an 800-point viewport at 2x shows 400 world units" }
    assert realAbs(view.height() - 300.0) < 0.001 { "a 600-point viewport at 2x shows 300 world units" }

    // A half-speed layer moves half as far, so it sees a different window.
    fin far = camera.lookingAt(Vec2(1000.0, 0.0)).viewAt(Vec2(0.5, 1.0), vec2Zero())
    assert realAbs(far.center().x - 500.0) < 0.001 {
        "a parallax of 0.5 must move the layer at half the camera's rate"
    }
}

test "a camera clamped to a map stays inside it, or centres on a small one" {
    fin camera = tileCamera(Vec2(0.0, 0.0), 1.0, 200.0, 200.0)
    fin big = worldRect(0.0, 0.0, 1000.0, 1000.0)
    fin held = camera.clampedTo(big)
    assert realAbs(held.center.x - 100.0) < 0.001 { "the camera must not show past the left edge" }

    fin small = worldRect(0.0, 0.0, 50.0, 50.0)
    fin centred = camera.lookingAt(Vec2(900.0, 900.0)).clampedTo(small)
    assert realAbs(centred.center.x - 25.0) < 0.001 {
        "a world smaller than the viewport must be centred, not pinned to a corner"
    }
}
