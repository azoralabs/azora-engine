/**
 * Byte-level file access for the Azora Engine.
 *
 * The standard library deliberately owns no filesystem, so asset loading needs
 * a primitive of its own. This package provides exactly one: read a file into a
 * [Blob], then read scalars out of it at explicit offsets and explicit
 * endianness.
 *
 * Every accessor is bounds-checked and returns zero past the end rather than
 * faulting. Asset files are the least trustworthy input an engine handles — a
 * truncated sprite must yield a wrong sprite, never a crashed process.
 */
module engine.io

import std.char
import std.string

bridge .C {
    func fopen(path: std::String, mode: std::String): std::Long
    func fclose(stream: std::Long): std::Int
    func fseek(stream: std::Long, offset: std::Long, whence: std::Int): std::Int
    func ftell(stream: std::Long): std::Long
    func fread(ptr: std::Long, size: std::Long, count: std::Long, stream: std::Long): std::Long
    func fputs(text: std::String, stream: std::Long): std::Int
    func fflush(stream: std::Long): std::Int
    func remove(path: std::String): std::Int
    func rename(oldPath: std::String, newPath: std::String): std::Int

    // Raw memory (az_ffi.c). Declared once here, for the whole engine: this is
    // the lowest module every consumer of raw buffers already imports, and a
    // second declaration elsewhere would collide with this one.
    func @foreignName("az_alloc")(n: std::Long): std::Long
    func @foreignName("az_free")(p: std::Long)
    func @foreignName("az_copy")(dst: std::Long, src: std::Long, n: std::Long)
    func @foreignName("az_peek64")(p: std::Long, off: std::Long): std::Long
    func @foreignName("az_peek32")(p: std::Long, off: std::Long): std::Int
    func @foreignName("az_peek8")(p: std::Long, off: std::Long): std::Int
    func @foreignName("az_peek_f64")(p: std::Long, off: std::Long): std::Double
    func @foreignName("az_poke64")(p: std::Long, off: std::Long, v: std::Long)
    func @foreignName("az_poke32")(p: std::Long, off: std::Long, v: std::Int)
    func @foreignName("az_poke8")(p: std::Long, off: std::Long, v: std::Int)
    func @foreignName("az_poke_f32")(p: std::Long, off: std::Long, v: std::Double)
    func @foreignName("az_poke_f64")(p: std::Long, off: std::Long, v: std::Double)

    // Process-wide close request (az_ffi.c). The flag lives in the runtime
    // because Azora has no mutable global to put it in: a top-level `var` is
    // rejected as unsafe to share, and `fin` is deeply immutable. The engine
    // surface over these two is `azora::engine::exit()` in `engine.core`.
    func @foreignName("az_request_exit")()
    func @foreignName("az_exit_requested")(): std::Long
}

/** `fseek` origin: end of stream. */
fin seekEnd = 2

/** `fseek` origin: start of stream. */
fin seekSet = 0

/**
 * Every printable ASCII character, indexed by `code - 32`.
 *
 * Asset formats label things in ASCII, so turning a byte into a one-character
 * string is a hot path. Slicing this constant is the way to do it: the obvious
 * route, `charsToString(@std::arr[codeToChar(c)])`, miscompiles on the native
 * backend and faults, so it is deliberately not used here.
 */
fin asciiPrintable =
    " !\"#${'$'}%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/**
 * The one-character string for an ASCII [code], or empty when unprintable.
 *
 * Newline and tab are preserved: a text asset read through [Blob.text] must
 * keep its line structure, or every line-based parser downstream sees one
 * enormous line. Carriage returns are dropped so CRLF files behave like LF.
 */
func asciiChar(code: std::Int): std::String {
    if code == 10 {
        return "\n"
    }
    if code == 9 {
        return "\t"
    }
    if code < 32 || code > 126 {
        return ""
    }
    return std::strSlice(asciiPrintable, code - 32, code - 31)
}

/**
 * An owned block of bytes read from disk.
 *
 * A blob owns its allocation; call [release] when finished. `size` is zero for
 * a failed read, which is what [ok] reports.
 */
@std::Experimental(since: "0.1")
pack Blob {
    var data: std::Long
    var size: std::Int
}

/** An empty blob, used for every failure path. */
@std::Experimental(since: "0.1")
func blobEmpty(): Blob {
    return Blob(0L, 0)
}

/**
 * Reads the whole file at [path] into memory.
 *
 * Returns an empty blob when the file cannot be opened or read; callers check
 * [Blob.ok] rather than handling an error type, because a missing asset is
 * expected during development and should degrade rather than abort.
 */
@std::Experimental(since: "0.1")
func readFile(path: std::String): Blob {
    fin stream = fopen(path, "rb")
    if stream == 0L {
        return blobEmpty()
    }

    fseek(stream, 0L, seekEnd)
    fin length = ftell(stream)
    fseek(stream, 0L, seekSet)

    if length <= 0L {
        fclose(stream)
        return blobEmpty()
    }

    fin buffer = azAlloc(length)
    if buffer == 0L {
        fclose(stream)
        return blobEmpty()
    }

    fin read = fread(buffer, 1L, length, stream)
    fclose(stream)

    if read <= 0L {
        azFree(buffer)
        return blobEmpty()
    }
    return Blob(buffer, read as std::Int)
}

/**
 * Atomically replaces a UTF-8 text file.
 *
 * Content is written and flushed to a sibling temporary file before the target
 * is replaced. A failed write leaves the previous file intact and removes the
 * temporary file, making this suitable for settings and save-game metadata.
 */
@std::Experimental(since: "0.1")
func writeTextFile(path: std::String, content: std::String): std::Bool {
    fin temporary = path + ".tmp"
    fin stream = fopen(temporary, "wb")
    if stream == 0L {
        return false
    }
    fin written = fputs(content, stream) >= 0
    fin flushed = fflush(stream) == 0
    fin closed = fclose(stream) == 0
    if !written || !flushed || !closed {
        remove(temporary)
        return false
    }

    // C rename replaces atomically on POSIX when both paths share a directory.
    // Removing first is a compatibility fallback for platforms that reject an
    // existing destination.
    if rename(temporary, path) == 0 {
        return true
    }
    remove(path)
    if rename(temporary, path) == 0 {
        return true
    }
    remove(temporary)
    return false
}

impl Blob {

    /** Whether the blob holds any bytes. */
    func ok(): std::Bool {
        return self.data != 0L && self.size > 0
    }

    /** Whether [count] bytes can be read starting at [offset]. */
    func has(offset: std::Int, count: std::Int): std::Bool {
        if offset < 0 || count < 0 {
            return false
        }
        return offset + count <= self.size
    }

    /**
     * The unsigned byte at [offset], or zero when out of range.
     *
     * `azPeek8` returns a sign-extended byte, so a value above 0x7F arrives
     * negative; masking folds it back into 0..255. The cast is parenthesized
     * because `x as Long & m` would parse `Long &` as a borrowed type.
     */
    func u8(offset: std::Int): std::Int {
        if !self.has(offset, 1) {
            return 0
        }
        return azPeek8(self.data, (offset as std::Long)) & 0xFF
    }

    /** The signed byte at [offset]. */
    func i8(offset: std::Int): std::Int {
        fin value = self.u8(offset)
        if value > 127 {
            return value - 256
        }
        return value
    }

    /**
     * The little-endian unsigned 16-bit value at [offset].
     *
     */
    func u16(offset: std::Int): std::Int {
        return self.u8(offset) | (self.u8(offset + 1) << 8)
    }

    /** The little-endian signed 16-bit value at [offset]. */
    func i16(offset: std::Int): std::Int {
        fin value = self.u16(offset)
        if value > 32767 {
            return value - 65536
        }
        return value
    }

    /**
     * The little-endian 32-bit value at [offset].
     *
     * Assembled byte by byte rather than with a wider peek so the result does
     * not depend on the host's byte order — asset formats are little-endian by
     * definition, whatever the machine reading them.
     */
    func i32(offset: std::Int): std::Int {
        // A trailing operator is what continues the statement across a newline;
        // a leading one would terminate the previous line's expression.
        return self.u8(offset) |
            (self.u8(offset + 1) << 8) |
            (self.u8(offset + 2) << 16) |
            (self.u8(offset + 3) << 24)
    }

    /**
     * The IEEE-754 double at [offset].
     *
     * Read through the runtime rather than reassembled from bytes, because the
     * bit layout of a double is not something to hand-roll.
     */
    func f64(offset: std::Int): std::Double {
        if !self.has(offset, 8) {
            return 0.0
        }
        return azPeekF64(self.data, offset as std::Long)
    }

    /**
     * A fixed-width string of [length] bytes at [offset], stopping at the first
     * NUL. Fixed-width NUL-padded fields are how most asset formats store text.
     */
    func text(offset: std::Int, length: std::Int): std::String {
        var result = ""
        var i = 0
        while i < length {
            fin code = self.u8(offset + i)
            if code == 0 {
                return result
            }
            result = result + asciiChar(code)
            i = i + 1
        }
        return result
    }

    /** Whether the bytes at [offset] equal the ASCII [expected]. */
    func matches(offset: std::Int, expected: std::String): std::Bool {
        fin length = std::strLength(expected)
        if !self.has(offset, length) {
            return false
        }
        return self.text(offset, length) == expected
    }

    /** Releases the blob's memory. Safe to call on an empty blob. */
    func release[self: Self!]() {
        if self.data != 0L {
            azFree(self.data)
        }
        self.data = 0L
        self.size = 0
    }
}
