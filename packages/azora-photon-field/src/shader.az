module engine.lighting.photon.shader

/** Shared Metal functions for the standard and Material Fusion pipelines. */
func photonMetalSource(): String {
    return (""
        + "struct PhotonLighting { float visibility; float3 indirect, direct; };\n"
        + "float3 photonVector(const device float* map,int i) { return float3(map[i],map[i+1],map[i+2]); }\n"
        + "int photonSample(const device float* map,float2 uv) {\n"
        + "    float2 cell=uv/map[5]; int2 page=int2(floor(cell))-int2(map[1],map[2]);\n"
        + "    int side=int(map[3]),res=int(map[4]); if(any(page<0)||any(page>=side)) return -1;\n"
        + "    int slot=int(map[24+page.y*side+page.x]); if(slot<0) return -1;\n"
        + "    int2 sample=clamp(int2(fract(cell)*res),0,res-1);\n"
        + "    return 24+side*side+((slot*res+sample.y)*res+sample.x)*8;\n"
        + "}\n"
        + "PhotonLighting photonLighting(const device float* map,float3 p,float3 n,bool useShadows,bool useGI) {\n"
        + "    if(map[0]<0.5) return {1.0,float3(0),float3(1)};\n"
        + "    float3 x=photonVector(map,10),y=photonVector(map,13),z=photonVector(map,16);\n"
        + "    float2 uv=float2(dot(p,x),dot(p,y)); float depth=dot(p,z), pixel=map[5]/map[4];\n"
        + "    float shadow=0.0, weights=0.0, facing=dot(n,z);\n"
        + "    if(useShadows && map[7]>0 && facing>0.0) {\n"
        + "        float2 plane=float2(dot(n,x),dot(n,y))/max(facing,0.16);\n"
        + "        float bias=map[6]+pixel*(0.32+0.18*length(plane));\n"
        + "        float2 grid=uv/pixel-0.5, base=floor(grid), sub=fract(grid);\n"
        + "        for(int j=-1;j<=2;j++) for(int i=-1;i<=2;i++) {\n"
        + "            float2 offset=float2(i,j); float2 tent=max(float2(0),1.65-abs(offset-sub));\n"
        + "            float w=tent.x*tent.y; float2 tap=(base+offset+0.5)*pixel;\n"
        + "            float receiver=depth-dot(plane,tap-uv); int a=photonSample(map,tap);\n"
        + "            if(a>=0) shadow+=w*smoothstep(bias,bias+0.35*pixel,map[a]-receiver);\n"
        + "            weights+=w;\n"
        + "        }\n"
        + "    }\n"
        + "    float3 indirect=float3(0); float radius=map[9];\n"
        + "    if(useGI && map[8]>0 && map[23]>0.5) {\n"
        + "        // Gathered once per sample (photon_irradiance): four reads, not thirty-two.\n"
        + "        int first=24+int(map[3])*int(map[3]); float3 n2=n*n; float gathered=0.0;\n"
        + "        int px=n.x<0.0?3:0, py=n.y<0.0?9:6, pz=n.z<0.0?15:12;\n"
        + "        float2 grid=uv/pixel-0.5, base=floor(grid), sub=fract(grid);\n"
        + "        for(int j=0;j<4;j++) {\n"
        + "            float2 k=float2(j%2,j/2); float2 blend=mix(1.0-sub,sub,k);\n"
        + "            int a=photonSample(map,(base+k+0.5)*pixel);\n"
        + "            if(a<0 || map[a+7]<0.5) continue;\n"
        + "            float w=blend.x*blend.y*saturate(1.0-abs(map[a]-depth)/radius);\n"
        + "            if(w<=0.0) continue;\n"
        + "            int o=int(map[23])+((a-first)/8)*18;\n"
        + "            indirect+=w*(n2.x*photonVector(map,o+px)+n2.y*photonVector(map,o+py)+n2.z*photonVector(map,o+pz));\n"
        + "            gathered+=w;\n"
        + "        }\n"
        + "        indirect=gathered>1e-4?indirect/gathered:float3(0);\n"
        + "    } else if(useGI && map[8]>0) for(int i=0;i<8;i++) {\n"
        + "        float angle=float(i)*2.39996323;\n"
        + "        float2 requested=uv+float2(cos(angle),sin(angle))*radius*sqrt((float(i)+0.5)/8.0);\n"
        + "        float2 grid=requested/pixel-0.5,base=floor(grid),sub=fract(grid);\n"
        + "        for(int j=0;j<4;j++) {\n"
        + "            float2 k=float2(j%2,j/2); float2 blend=mix(1.0-sub,sub,k); float w=blend.x*blend.y;\n"
        + "            float2 target=(base+k+0.5)*pixel; int a=photonSample(map,target);\n"
        + "            if(a<0 || map[a+7]<0.5) continue;\n"
        + "            float2 offset=target-uv; float3 delta=x*offset.x+y*offset.y+z*(map[a]-depth);\n"
        + "            float d2=dot(delta,delta); if(d2<2.25*pixel*pixel || d2>radius*radius) continue;\n"
        + "            float3 ray=delta*rsqrt(d2);\n"
        + "            float form=saturate(dot(n,ray))*saturate(dot(photonVector(map,a+4),-ray));\n"
        + "            indirect+=w*photonVector(map,a+1)*form*(1.0-d2/(radius*radius))/(1.0+d2);\n"
        + "        }\n"
        + "    }\n"
        + "    return {1.0-map[7]*shadow/max(weights,1e-5),indirect*map[8]*0.23,photonVector(map,20)*map[19]};\n"
        + "}\n"
        + "// The bounce light each sample receives, as an ambient cube: what reaches a\n"
        + "// surface facing +x, -x, +y, -y, +z and -z there. Same gather as the per-pixel one,\n"
        + "// with twice the rings, run once per sample when the field is rebuilt.\n"
        + "kernel void photon_irradiance(device float* map [[buffer(0)]], constant float& count [[buffer(1)]], uint id [[thread_position_in_grid]]) {\n"
        + "    if(float(id)>=count) return;\n"
        + "    int side=int(map[3]),res=int(map[4]),first=24+side*side,perPage=res*res;\n"
        + "    int a=first+int(id)*8, o=int(map[23])+int(id)*18;\n"
        + "    for(int k=0;k<18;k++) map[o+k]=0.0;\n"
        + "    if(map[a+7]<0.5) return;\n"
        + "    int slot=int(id)/perPage, cell=-1;\n"
        + "    for(int c=0;c<side*side;c++) if(int(map[24+c])==slot) { cell=c; break; }\n"
        + "    if(cell<0) return;\n"
        + "    int local=int(id)-slot*perPage; float pixel=map[5]/map[4];\n"
        + "    float2 uv=float2(map[1]+float(cell%side),map[2]+float(cell/side))*map[5]+(float2(local%res,local/res)+0.5)*pixel;\n"
        + "    float3 x=photonVector(map,10),y=photonVector(map,13),z=photonVector(map,16);\n"
        + "    float depth=map[a], radius=map[9];\n"
        + "    float3 cube[6]={float3(0),float3(0),float3(0),float3(0),float3(0),float3(0)};\n"
        + "    for(int i=0;i<16;i++) {\n"
        + "        float angle=float(i)*2.39996323;\n"
        + "        float2 requested=uv+float2(cos(angle),sin(angle))*radius*sqrt((float(i)+0.5)/16.0);\n"
        + "        float2 grid=requested/pixel-0.5,base=floor(grid),sub=fract(grid);\n"
        + "        for(int j=0;j<4;j++) {\n"
        + "            float2 k=float2(j%2,j/2); float2 blend=mix(1.0-sub,sub,k); float w=blend.x*blend.y;\n"
        + "            float2 target=(base+k+0.5)*pixel; int b=photonSample(map,target);\n"
        + "            if(b<0 || map[b+7]<0.5) continue;\n"
        + "            float2 offset=target-uv; float3 delta=x*offset.x+y*offset.y+z*(map[b]-depth);\n"
        + "            float d2=dot(delta,delta); if(d2<2.25*pixel*pixel || d2>radius*radius) continue;\n"
        + "            float3 ray=delta*rsqrt(d2);\n"
        + "            float3 emit=w*photonVector(map,b+1)*saturate(dot(photonVector(map,b+4),-ray))*(1.0-d2/(radius*radius))/(1.0+d2);\n"
        + "            cube[0]+=emit*saturate(ray.x); cube[1]+=emit*saturate(-ray.x);\n"
        + "            cube[2]+=emit*saturate(ray.y); cube[3]+=emit*saturate(-ray.y);\n"
        + "            cube[4]+=emit*saturate(ray.z); cube[5]+=emit*saturate(-ray.z);\n"
        + "        }\n"
        + "    }\n"
        + "    // Half the rings of 16 per pixel before: the same light, sampled twice as finely.\n"
        + "    for(int f=0;f<6;f++) { float3 e=cube[f]*0.5; map[o+f*3]=e.x; map[o+f*3+1]=e.y; map[o+f*3+2]=e.z; }\n"
        + "}\n"
        + "// The sharp cascade (buffer 4: clip transform, then world texel, uv texel, strength, bias).\n"
        + "// Answers the light reaching p and how much of the cascade covers it, fading at its edge.\n"
        + "float2 detailVisibility(depth2d<float> map,constant float4* d,float3 p,float3 n) {\n"
        + "    float4x4 m=float4x4(d[0],d[1],d[2],d[3]);\n"
        + "    // A face the sun grazes is pushed further out and compared more loosely: no acne.\n"
        + "    float facing=saturate(dot(n,normalize(-float3(m[0][2],m[1][2],m[2][2]))));\n"
        + "    float slope=sqrt(1.0-facing*facing)/max(facing,0.25);\n"
        + "    float4 c=m*float4(p+n*d[4].x*(1.0+2.5*(1.0-facing)),1.0);\n"
        + "    float2 uv=float2(c.x*0.5+0.5,0.5-c.y*0.5), edge=min(uv,1.0-uv);\n"
        + "    float cover=saturate(min(edge.x,edge.y)*12.0);\n"
        + "    if(cover<=0.0 || c.z<=0.0 || c.z>=1.0) return float2(1.0,0.0);\n"
        + "    constexpr sampler shadow(filter::linear,address::clamp_to_edge,compare_func::less_equal);\n"
        + "    float lit=0.0, reference=c.z-d[4].w*(1.0+slope);\n"
        + "    for(int j=-1;j<=1;j+=2) for(int i=-1;i<=1;i+=2) lit+=map.sample_compare(shadow,uv+float2(i,j)*d[4].y*0.75,reference);\n"
        + "    return float2(1.0-d[4].z*(1.0-lit*0.25),cover);\n"
        + "}\n"
        + "PhotonLighting scenePhotonLight(const device float* dynamicMap,const device float* staticMap,depth2d<float> detail,constant float4* detailLight,float3 p,float3 n,float flags,float3 direct) {\n"
        + "    int bits=int(flags); bool gi=(bits&2)!=0, cached=(bits&4)!=0, sharp=(bits&8)!=0;\n"
        + "    PhotonLighting light=photonLighting(dynamicMap,p,n,!cached && !sharp,gi);\n"
        + "    if(cached) light.visibility=photonLighting(staticMap,p,n,true,false).visibility;\n"
        + "    if(sharp) {\n"
        + "        // Inside the cascade it alone decides; beyond it, the field's pages do.\n"
        + "        float2 seen=detailVisibility(detail,detailLight,p,n);\n"
        + "        float coarse=seen.y<1.0?photonLighting(dynamicMap,p,n,true,false).visibility:1.0;\n"
        + "        light.visibility=mix(coarse,seen.x,seen.y);\n"
        + "    }\n"
        + "    light.direct=direct; return light;\n"
        + "}\n")
}
