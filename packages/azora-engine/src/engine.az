/**
 * @file engine
 *
 * Complete Azora Engine facade.
 *
 * `use engine` exposes the data-oriented ECS, typed input, rendering,
 * reactive UI, navigation, scheduling, and application APIs. The default
 * plugin composition is declared in `engine.app` with `solo` and `wrap`; this
 * facade contains no second plugin registry and allocates no boxed plugin list.
 */

module engine

exposed import engine.math
exposed import engine.core
exposed import engine.io
exposed import engine.image
exposed import engine.font
exposed import engine.tracker
exposed import engine.objc
exposed import engine.shaders
exposed import engine.input
exposed import engine.gpu
exposed import engine.audio
exposed import engine.ecs
exposed import engine.jobs
exposed import engine.physics
exposed import engine.physics.core
exposed import engine.physics.d2
exposed import engine.physics.d3
exposed import engine.platform
exposed import engine.ui
exposed import engine.render
exposed import engine.tilemap
exposed import engine.animation.core
exposed import engine.animation.d2
exposed import engine.animation.d3
exposed import engine.app
