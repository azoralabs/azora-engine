// Azora Engine — async jobs.
//
// This module is intentionally separate so projects only pay for the Azora
// task runtime when they opt into background work. These helpers avoid
// higher-order callback lowering so they work with the native LLVM backend.

module engine.jobs

import engine.core

async func azNoopJob() {
}

async func azIntJob(value: std::Int): std::Int {
    return value
}
