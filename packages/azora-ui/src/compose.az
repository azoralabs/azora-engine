/**
 * @file engine.ui.compose
 *
 * Turning a declarative description into ECS operations, deterministically.
 *
 * This is the expansion `@compose world { … }` is defined as
 * (`proposals/REACTIVE_ECS_UI.MD` §9.2), written out as functions:
 *
 * ```text
 * begin Composition::of(owner, world)
 *   claim node key "main" under owner
 *   ensure Entity + Column + Key("main")
 *   …
 *   mark unclaimed previous children for disposal
 * commit composition
 * ```
 *
 * The macro is sugar over exactly these calls. Writing them out first means the
 * semantics - identity, reconciliation, disposal - are testable before any
 * syntax exists, and the macro cannot mean something the functions cannot do.
 *
 * ## Reconciliation is by key, not by position
 *
 * [claim] looks a node up by `(parent, key)`. A second pass over the same tree
 * finds the same entities and updates them in place, so a button keeps its
 * identity - and anything attached to that identity - across recompositions.
 * Nodes that are *not* claimed during a pass are removed when it commits: that
 * is how a disappearing node disappears, without anyone writing a removal.
 */
module engine.ui.compose

import std.traits
import std.container.array
import engine::{core, ecs, ui.node}

/**
 * One composition pass over [world].
 *
 * A node is an entity, and what it looks like is components on it, so the tree
 * *is* world state and the world is what holds it. A composition carries only
 * its position in that tree - which world, which root, how far along - so two
 * passes over one world see each other's nodes, and a pass cannot reach a world
 * it was not given (§9.1).
 */
pack Composition {
    /**
     * The world every node lives in.
     *
     * A node is an entity and what it looks like is components on it, so the
     * world holds the tree. The composition holds only where it is in that
     * tree: nothing here is a copy of anything the world has.
     */
    var world: World!
    /** Names the composition, so one owner cannot dispose another's nodes. */
    fin owner: String = ""
    /** The entity claims hang from when no other parent is given. */
    var root: Entity
    /**
     * Whether anything was composed since the pass opened.
     *
     * A tree is world state, so a frame in which no system describes one is a
     * frame that says nothing about it - not one that says it is empty. The
     * sweep at [commit] runs only when something actually claimed, which is what
     * lets a tree built once in `.Startup` outlive the frames after it.
     */
    var composed: Bool = false
    /** Next sibling index, per pass. */
    var cursor: Int = 0
    /**
     * Child counter for the root, whose parent is not a live entity and so has
     * nowhere to carry a [Cursor] of its own.
     */
    var rootCursor: Int = 0
    /** Changes after a committed description; hosts can redraw only changed trees. */
    var version: Long = 0
    /** Explicit invalidation is consumed by composeIfChanged. */
    var dirty: Bool = true
    var lastStamp: Long = 0
    var disposed: Bool = false
    /** The root's children in sibling order, as [Children] holds any other node's. */
    var rootChildren: Array<Entity> = []
}

/**
 * The world's storage for component `T`, reached through a composition.
 *
 * One place where composing code asks the world for a component, so a
 * composition names no component type of its own and every builder goes through
 * the same door. Marked as providing access because the caller already declared
 * the world it is composing into.
 */
@Experimental(since: "0.1")
@ProvidesAccess
inline func<T> store(pass: Composition!): Storage<T>! = ensureStorage<T>(pass.world)

impl Composition {
    /** The world's storage for [Key]. */
    @ProvidesAccess
    func !.keys(): Storage<Key>! = store<Key>(self)

    /** The world's storage for [Child]. */
    @ProvidesAccess
    func !.children(): Storage<Child>! = store<Child>(self)

    /** The world's storage for [SiblingOrder]. */
    @ProvidesAccess
    func !.order(): Storage<SiblingOrder>! = store<SiblingOrder>(self)

    /** The world's storage for [Owned]. */
    @ProvidesAccess
    func !.owned(): Storage<Owned>! = store<Owned>(self)

    /** The world's storage for [Cursor]. */
    @ProvidesAccess
    func !.cursors(): Storage<Cursor>! = store<Cursor>(self)

    /** The world's storage for [Children]. */
    @ProvidesAccess
    func !.childLists(): Storage<Children>! = store<Children>(self)


}

impl Composition {
    /** A composition over [world], owned by [owner]. */
    func of(world: World!, owner: String): Composition {
        // No storage is registered here. A world grows one the first time a
        // component of that type is asked for, so declaring a component is the
        // whole of what it takes to store one - including components declared by
        // programs this file has never heard of.
        return .(world, owner, ::invalid)
    }
}

impl Composition {
    /**
     * Starts a pass.
     *
     * Every node this composition owns is marked unclaimed; [commit] removes
     * whatever is still unclaimed at the end. A pass therefore describes the whole
     * tree, and absence is meaningful.
     */
    func Composition!.begin()
    in assert !self.disposed panic "cannot compose a disposed owner"
    scope {
        var index = 0
        while index < storageLength<Owned>(self.owned()) {
            fin entity = storageEntityAt<Owned>(self.owned(), index)
            if entity.isValid {
                fin mark = storageGetOrDefault<Owned>(self.owned(), entity, .())
                if mark.owner == self.owner then storageInsert<Owned>(self.owned(), entity, .(mark.owner))
            }
            index++
        }
        self.composed = false
        self.cursor = 0
        self.rootCursor = 0
    }

    /**
     * The next free sibling position under [parent], consuming it.
     *
     * The root has no entity to hang a [Cursor] on, so its count lives on the
     * self. Every other parent carries its own, reset when it is claimed.
     */
    func Composition!.nextChildIndex(parent: Entity): Int {
        if !parent.isValid {
            fin position = self.rootCursor
            self.rootCursor = position + 1
            return position
        }
        fin current = storageGetOrDefault<Cursor>(self.cursors(), parent, .())
        storageInsert<Cursor>(self.cursors(), parent, .(current.next + 1))
        return current.next
    }

    /**
     * The key a keyless [role] takes at its position under [parent].
     *
     * Including the role means a block whose shape changes between passes fails
     * loudly - the key stops matching and the node is rebuilt - rather than
     * silently reusing a column's entity for a button.
     */
    func Composition!.positionalKey(parent: Entity, role: String): String = "${role}#${self.peekChildIndex(parent)}"

    /**
     * The position [parent]'s next child will take, without consuming it.
     *
     * A key is built before the node is claimed, and the claim is what advances the
     * counter - so reading it here must not. Peeking keeps the key and the sibling
     * order the node ends up with in step, which is what [childAt] relies on.
     */
    func Composition!.peekChildIndex(parent: Entity): Int {
        return if !parent.isValid then self.rootCursor else storageGetOrDefault<Cursor>(self.cursors(), parent, .()).next
    }

    /**
     * The entity for [key] under [parent], creating it the first time.
     *
     * The same key yields the same entity on every self, which is what makes a
     * recomposition an update rather than a rebuild.
     */
    func Composition!.claim(parent: Entity, key: String): Entity {
        self.composed = true
        fin position = self.peekChildIndex(parent)
        fin existing = self.findChild(parent, key)
        if existing.isValid {
            self.placeChild(parent, existing, position)
            storageInsert<Owned>(self.owned(), existing, .(self.owner, true))
            // Position *among siblings*, not a number shared by the whole self:
            // `parent.childAt(n)` asks for the nth child of that parent, so a
            // global counter left every parent after the first with no child at
            // index 0 - the tree arranged one node and silently dropped the rest.
            storageInsert<SiblingOrder>(self.order(), existing, .(self.nextChildIndex(parent)))
            // A claimed node is about to have its own children enumerated, so its
            // sibling counter starts over here rather than in `begin`: that way a
            // node claimed twice in one self is a visible key collision, not a
            // silently continuing count.
            storageInsert<Cursor>(self.cursors(), existing, .())
            self.cursor++
            return existing
        }

        fin created = spawnEntity(self.world)
        self.placeChild(parent, created, position)
        storageInsert<Key>(self.keys(), created, .(key))
        storageInsert<Child>(self.children(), created, .(parent))
        storageInsert<Owned>(self.owned(), created, .(self.owner, true))
        storageInsert<SiblingOrder>(self.order(), created, .(self.nextChildIndex(parent)))
        storageInsert<Cursor>(self.cursors(), created, .())
        self.cursor++
        return created
    }

    /**
     * The child of [parent] keyed [key], or an invalid entity.
     *
     * Looked for among [parent]'s own children, starting where the next child
     * goes: a tree described the way it was last time finds each node first try.
     */
    func Composition!.findChild(parent: Entity, key: String): Entity {
        fin start = self.peekChildIndex(parent)
        if !parent.isValid then return self.keyedIn(self.rootChildren, start, key)
        fin at = storageIndexOf<Children>(self.childLists(), parent)
        return if at < 0 then ::invalid else self.keyedIn(self.childLists().values[at].list, start, key)
    }

    /** The entity in [list] this owner keyed [key], looking from [start] onwards first. */
    func Composition!.keyedIn(list: Array<Entity>&, start: Int, key: String): Entity {
        for step: Int in 0..<list.size {
            fin index = (start + step) % list.size
            fin keyAt = storageIndexOf<Key>(self.keys(), list[index])
            if keyAt >= 0 && self.keys().values[keyAt].value == key {
                fin ownerAt = storageIndexOf<Owned>(self.owned(), list[index])
                if ownerAt >= 0 && self.owned().values[ownerAt].owner == self.owner then return list[index].clone()
            }
        }
        return ::invalid
    }

    /** Puts [child] at [position] among [parent]'s children, moving it if it sat elsewhere. */
    func Composition!.placeChild(parent: Entity, child: Entity, position: Int) {
        if !parent.isValid {
            placeInList(self.rootChildren, child, position)
            return
        }
        var at = storageIndexOf<Children>(self.childLists(), parent)
        if at < 0 {
            storageInsert<Children>(self.childLists(), parent, .())
            at = storageIndexOf<Children>(self.childLists(), parent)
        }
        placeInList(self.childLists().values[at].list, child, position)
    }

    /** The children this pass claimed under [parent]: the rest of its list is stale. */
    func Composition!.claimedChildren(parent: Entity): Int {
        if !parent.isValid then return self.rootCursor
        fin at = storageIndexOf<Cursor>(self.cursors(), parent)
        return if at < 0 then 0 else self.cursors().values[at].next
    }

    /**
     * Ends the self, removing every node this owner did not claim.
     *
     * Children are disposed before parents would be a stronger guarantee than this
     * gives: removal here is by entity, and a parent's disappearance leaves its
     * children unclaimed in the same self, so both go. Ordering matters once
     * disposal runs user code, which it does not yet (§10.3).
     */
    func Composition!.commit(): Int {
        if !self.composed then return 0
        // Everything this owner holds that the pass did not claim, gathered
        // once: removal compacts the storages, so they are not walked while
        // it happens.
        var unclaimed: Array<Entity> = []
        var index = 0
        while index < storageLength<Owned>(self.owned()) {
            if self.owned().values[index].owner == self.owner && !self.owned().values[index].claimed && self.owned().entities[index].isValid {
                unclaimed.add(self.owned().entities[index].clone())
            }
            index++
        }
        // Leaves go first, so component destructors observe child-before-parent
        // disposal: each round removes the ones with no unclaimed child left.
        var removed = 0
        while unclaimed.size > 0 {
            var kept: Array<Entity> = []
            var round = 0
            var slot = 0
            while slot < unclaimed.size {
                if self.unclaimedChild(unclaimed[slot]) {
                    kept.add(unclaimed[slot].clone())
                } else {
                    despawnEntity(self.world, unclaimed[slot])
                    round++
                }
                slot++
            }
            removed += round
            unclaimed = take kept
            if round == 0 then break
        }
        // A parent's list may still name children it no longer has.
        trimList(self.rootChildren, self.rootCursor)
        index = 0
        while index < storageLength<Children>(self.childLists()) {
            trimList(self.childLists().values[index].list, self.claimedChildren(self.childLists().entities[index]))
            index++
        }
        self.version += 1
        self.dirty = false
        return removed
    }

    /** Whether one of [parent]'s children is this owner's and went unclaimed. */
    func !.unclaimedChild(parent: Entity): Bool {
        fin at = storageIndexOf<Children>(self.childLists(), parent)
        return if at < 0 then false else self.unclaimedIn(self.childLists().values[at].list)
    }

    /** Whether an entity in [list] is this owner's and went unclaimed. */
    func !.unclaimedIn(list: Array<Entity>&): Bool {
        var index = 0
        while index < list.size {
            fin ownerAt = storageIndexOf<Owned>(self.owned(), list[index])
            if ownerAt >= 0 && self.world.isAlive(list[index]) {
                if self.owned().values[ownerAt].owner == self.owner && !self.owned().values[ownerAt].claimed then return true
            }
            index++
        }
        return false
    }

    /** Requests another description pass even when its external revision is unchanged. */
    func !.invalidate() { self.dirty = true }

    /** Removes every node and component owned by this composition. */
    func !.dispose(): Int {
        if self.disposed then return 0
        self.begin()
        self.composed = true
        fin removed = self.commit()
        self.disposed = true
        return removed
    }

    /** How many nodes this composition currently holds. */
    func Composition!.nodeCount(): Int {
        var live = 0
        var index = 0
        while index < storageLength<Owned>(self.owned()) {
            fin entity = storageEntityAt<Owned>(self.owned(), index)
            if entity.isValid {
                fin mark = storageGetOrDefault<Owned>(self.owned(), entity, .())
                if mark.owner == self.owner then live = live + 1
            }
            index++
        }
        return live
    }
}

/** Puts [child] at [position] in [list], moving it from later in the list or inserting it. */
func placeInList(list: Array<Entity>!, child: Entity, position: Int) {
    if position < list.size && list[position].id == child.id && list[position].generation == child.generation then return
    var index = position + 1
    while index < list.size {
        if list[index].id == child.id && list[index].generation == child.generation {
            list.remove(index)
            break
        }
        index++
    }
    if position >= list.size then list.add(child.clone()) else list.insert(position, child.clone())
}

/** Drops [list]'s entries from [size] on. */
func trimList(list: Array<Entity>!, size: Int) {
    while list.size > size && list.size > 0 then list.remove(list.size - 1)
}

// ── Scoped builders ─────────────────────────────────────────────────────
//
// The flat constructors above take `(pass, parent, key, …)`. Every one of
// those three is redundant with where the call *is*: a builder nested inside a
// column belongs to that column, in that composition, at that position. The
// anchor carries them, so a block can be written as a shape rather than as a
// sequence of parented calls.
//
// A block receives its anchor as the lambda's implicit `it`, which is as close
// to the authored surface as the language reaches on its own. `@compose`
// (step 4) is the rewrite that drops the `it.` - and because every builder here
// is an ordinary function, the macro cannot express anything this cannot.

/**
 * How a component puts itself into a composition.
 *
 * The provided body is the whole of what most components need: claim the node,
 * store `Self` on it, and apply the modifier. A component that needs nothing
 * more writes `derive Compose for It`; one that builds something else - a
 * container that also seeds a layout, say - writes its own `impl` instead.
 *
 * The composition is a receiver rather than a parameter, so a call reads it
 * from the block it sits in and no caller passes it by hand.
 */
spec Compose requires Clone {
    func &.compose(
        composition: Composition!
        parent: Entity
        key: String
        modifier: Modifier&
    ): Entity {
        fin node = composition.claim(parent, key)
        storageInsert<Self>(store(composition), node, self.clone())
        composition.applyModifier(node, modifier)
        return node
    }
}

/**
 * A position in a composition: which pass, and which parent to build under.
 *
 * Passed by value while the composition it points at is shared - a child anchor
 * is a new parent over the same pass, so nesting cannot lose writes and an anchor
 * cannot outlive its block into a different tree.
 */
pack Anchor derives Clone {
    var pass: Composition!
    var parent: Entity
}

impl Anchor {
    /** The anchor one level down, under [node]. */
    func &.inside(node: Entity): Self = .(self.pass, node)

    /** Places [node] explicitly, as the flat [place] does. */
    func !.place(
        node: Entity
        x: Double, y: Double
        width: Double, height: Double
    ) {
        self.pass.place(node, x, y, width, height)
    }

    /** Sets how [node] paints. */
    func !.paint(
        node: Entity
        r: Double, g: Double, b: Double
        alpha: Double = 1.0
        size: Double = 0.0
    ) {
        self.pass.paint(node, r, g, b, alpha, size)
    }
}

/**
 * One whole pass over [pass]: begin, describe, commit.
 *
 * The composition is the caller's, not this function's, because identity across
 * frames is the entire point - a pass created here each frame would rebuild the
 * tree every time and no node would keep anything. Returns the number of nodes
 * the pass removed by not mentioning them.
 */
react func compose(
    pass: Composition!
    children: inline react Anchor!.() -> Unit
): Int {
    pass.begin()
    pass.composed = true
    using Anchor(pass, pass.root) then children()
    return pass.commit()
}

/** Reconciles a declarative constructor tree only when its dependency revision changes. */
react func composeIfChanged(
    pass: Composition!
    stamp: Long
    children: inline react Anchor!.() -> Unit
): Bool {
    if !pass.dirty && pass.lastStamp == stamp then return false
    pass.lastStamp = stamp
    compose(pass, children)
    return true
}

impl Composition {
    // ── Node constructors ───────────────────────────────────────────────
    //
    // The low-level layer: claim a node and give it the components that make
    // it what it is. These are §9.3's approved constructors, and they are
    // realm-qualified because the *bare* names belong to the scoped builders
    // below - a free `column` here would shadow `Anchor.column` at every call
    // site that meant to write a block.

    /**
     * Writes [chain] onto [node] as components.
     *
     * This is where a modifier stops being a description and becomes data the
     * layout and paint systems read. The chain is walked in order, so a later
     * link overrides an earlier one asking for the same thing - which is what
     * makes order observable rather than decorative.
     *
     * A chain is applied on every self, so a node that loses a modifier between
     * passes loses its effect too: the components are rebuilt, not accumulated.
     */
    func !.applyModifier(node: Entity, chain: Modifier&) {
        var size: Size = .()
        var pad: Padding = .()
        var hasPadding: Bool = false
        var background: Paint = .()
        var hasBackground: Bool = false
        var corner: Corner = .()
        var hasCorner: Bool = false
        var stroke: Stroke = .()
        var hasStroke: Bool = false
        var hover: HoverPaint = .()
        var hasHover: Bool = false
        var style: TextStyle = .()
        var hasStyle: Bool = false
        var clips: Bool = false

        for i: Int in 0..<chain.entries.size {
            fin entry = chain.entries[i]
            when entry.kind {
                .FillMaxWidth -> size.fillWidth = true
                .FillMaxHeight -> size.fillHeight = true
                .Width -> size.width = entry.a
                .Height -> size.height = entry.a
                .Weight -> size.weight = entry.a
                .Padding -> {
                    pad = .(entry.a, entry.b, entry.c, entry.d)
                    hasPadding = true
                }
                .Background -> {
                    background = .(entry.a, entry.b, entry.c, entry.d, 0.0)
                    hasBackground = true
                }
                .Rounded -> {
                    corner.radius = entry.a
                    hasCorner = true
                }
                .Border -> {
                    stroke = .(entry.a, entry.b, entry.c, entry.d, 1.0)
                    hasStroke = true
                }
                .BorderAlpha -> stroke.alpha = entry.a
                .Hover -> {
                    hover = .(entry.a, entry.b, entry.c, entry.d)
                    hasHover = true
                }
                .TextColor -> {
                    style.r = entry.a
                    style.g = entry.b
                    style.b = entry.c
                    style.alpha = entry.d
                    hasStyle = true
                }
                .FontSize -> {
                    style.size = entry.a
                    hasStyle = true
                }
                .TextAlign -> {
                    style.align = entry.a as Int
                    hasStyle = true
                }
                .Font -> {
                    style.font = entry.a as Int
                    hasStyle = true
                }
                .Clip -> clips = true
            }
        }

        storageInsert<Size>(store(self), node, size)

        if hasPadding then storageInsert<Padding>(store(self), node, pad)
        else storageRemove<Padding>(store(self), node)

        if hasBackground then storageInsert<Paint>(store(self), node, background)

        // Like padding, each style is rebuilt from the chain on every pass, so
        // a node that stops asking for one loses it.
        if hasCorner then storageInsert<Corner>(store(self), node, corner)
        else storageRemove<Corner>(store(self), node)

        if hasStroke then storageInsert<Stroke>(store(self), node, stroke)
        else storageRemove<Stroke>(store(self), node)

        if hasHover then storageInsert<HoverPaint>(store(self), node, hover)
        else storageRemove<HoverPaint>(store(self), node)

        if hasStyle then storageInsert<TextStyle>(store(self), node, style)
        else storageRemove<TextStyle>(store(self), node)

        if clips then storageInsert<Clip>(store(self), node, .())
        else storageRemove<Clip>(store(self), node)
    }

    /** A container that stacks its children downward. */
    func !.column(
        parent: Entity
        key: String
        modifier: Modifier&
        verticalArrangement: Arrangement
        horizontalAlignment: Alignment
        spacing: Double
    ): Entity {
        fin node = self.claim(parent, key)
        storageInsert<Layout>(store(self), node, .(layoutColumn, verticalArrangement, horizontalAlignment, spacing))
        self.applyModifier(node, modifier)
        return node
    }

    /** A container that lays its children across. */
    func !.row(
        parent: Entity
        key: String
        modifier: Modifier&
        horizontalArrangement: Arrangement
        verticalAlignment: Alignment
        spacing: Double
    ): Entity {
        fin node = self.claim(parent, key)
        storageInsert<Layout>(store(self), node, .(layoutRow, horizontalArrangement, verticalAlignment, spacing))
        self.applyModifier(node, modifier)
        return node
    }

    /** A container that places fixed-size children across and wraps. */
    func !.flow(
        parent: Entity
        key: String
        modifier: Modifier&
        spacing: Double
    ): Entity {
        fin node = self.claim(parent, key)
        storageInsert<Layout>(store(self), node, .(layoutFlow, .Start, .Start, spacing))
        self.applyModifier(node, modifier)
        return node
    }

    /** A column whose children are offset by a scroll position. */
    func !.scrollColumn(
        parent: Entity
        key: String
        modifier: Modifier&
        verticalArrangement: Arrangement
        horizontalAlignment: Alignment
        spacing: Double
    ): Entity {
        fin node = self.column(parent, key, modifier, verticalArrangement, horizontalAlignment, spacing)
        fin existing = storageGetOrDefault<Scroll>(store(self), node, .())
        storageInsert<Scroll>(store(self), node, existing)
        return node
    }

    /** A plain rectangle, tagged so a query can find it later. */
    func !.shape(parent: Entity, key: String, modifier: Modifier&, group: Int): Entity {
        fin node = self.claim(parent, key)
        storageInsert<TagI>(store(self), node, .(group))
        self.applyModifier(node, modifier)
        // A shape with no colour of its own is invisible, and a shape is a
        // rectangle - being invisible by default is never what was meant. The
        // paint is written *only when absent*, which is what lets a system own
        // it afterwards: `tintGroup` recolours tagged nodes, and re-running the
        // description on the next frame must not undo that. A component a
        // system writes cannot also be rewritten by the description each frame,
        // or the two fight and the last writer of the frame wins.
        if !storageHas<Paint>(store(self), node)
        then storageInsert<Paint>(store(self), node, .(0.32, 0.34, 0.40, 1.0, 0.0))

        return node
    }

    /** Places [node] - the arrangement a layout self would otherwise compute. */
    func !.place(
        node: Entity
        x: Double, y: Double
        width: Double, height: Double
    ) {
        storageInsert<Rect>(store(self), node, .(x, y, width, height))
    }

    /** Sets how [node] paints. */
    func !.paint(
        node: Entity
        r: Double, g: Double, b: Double
        alpha: Double
        size: Double
    ) {
        storageInsert<Paint>(store(self), node, .(r, g, b, alpha, size))
    }
}
