/**
 * @file engine.ui.node
 *
 * The components a UI node is made of.
 *
 * A node is an entity, and its role is the set of components it carries -
 * `proposals/REACTIVE_ECS_UI.MD` §10.1. There is no `UiNode` type with a `kind`
 * field: a button *is* an entity holding [Clickable], a label *is* an entity
 * holding [Text], and a thing that is both is simply an entity holding both.
 *
 * Keeping these as separate components is what lets a system ask for exactly
 * what it needs. A layout pass reads [Rect] without loading text; a renderer
 * reads [Text] without loading hit-test policy. A single fat node type would
 * make every pass depend on every field.
 */
module engine.ui.node

import std.container.array
import std.traits
import std.format
import engine.core
import engine.ecs

/**
 * A node's identity within its parent.
 *
 * Identity is the key, not the position: reordering keyed siblings moves their
 * state with them, and changing a key destroys the old node rather than
 * quietly repurposing it (§9.4).
 */
@Component
pack Key derives Clone {
    fin value: String = ""
}

/** The parent this node hangs from. One parent per node, no cycles (§10.3). */
@Component
pack Child derives Clone {
    fin parent: Entity
}

/**
 * Position among siblings.
 *
 * Recorded explicitly because ECS storage order is an implementation detail,
 * and the semantic tree must present children in the order they were composed
 * rather than the order they happen to be stored (§10.3).
 */
@Component
pack SiblingOrder derives Clone {
    var index: Int = 0
}

/**
 * How many children have been claimed under this node during the current pass.
 *
 * This is what lets a builder block omit keys: the *n*th child written under a
 * parent is keyed by that position, so `button("Play")` needs no name. Position
 * is only an identity while the shape of the block is stable - reorder a list
 * and positional keys follow the position, not the item - which is why an
 * explicit `key` still overrides it.
 *
 * It is per-parent rather than per-pass because keys only have to be unique
 * among siblings, and a counter shared by the whole tree would change every
 * node's key whenever any earlier subtree grew.
 */
@Component
pack Cursor derives Clone {
    var next: Int = 0
}

/** Text to display. */
@Component
pack Text derives (Copy, Clone, Equal, Hash, Display, Compose) {
    var value: String = ""
}

impl Text {
    func &.display(formatter: Formatter!) { formatter.write(self.value) }
    react ctor (anchor: Anchor!).(
        value: String
        modifier: Modifier& = .()
        key: String = ""
    ): Entity {
        self.value = value

        fin id = if key == "" { anchor.pass.positionalKey(anchor.parent, "text") } else { key }
        return self.compose(anchor.pass, anchor.parent, id, modifier)
    }
}

/** Marks a node as activatable, and whether it currently is. */
@Component
pack Clickable derives Clone {
    var enabled: Bool = true
}

/**
 * A node that can be activated, and what it asks for when it is.
 *
 * A button carries no text of its own: what it shows is its children, so a
 * caption is a [Text] inside it and anything else - an icon, a row of both - is
 * written the same way.
 */
@Component
pack Button derives (Copy, Clone, Equal, Hash, Display) {
    var action: Int = 0
}

/**
 * A button is more than itself on a node, so it composes its own way.
 *
 * The provided body stores `Self` and stops; a button also marks the node
 * activatable, records what it asks for, and centres whatever it contains -
 * which is what makes "inside a button" mean centred without the caller
 * arranging it. That is the whole reason this is an `impl` and not a `derive`.
 */
impl Compose for Button {
    func &.compose(
        composition: Composition!
        parent: Entity
        key: String
        modifier: Modifier&
    ): Entity {
        fin node = composition.claim(parent, key)
        storageInsert<Button>(store(composition), node, self.clone())
        storageInsert<Clickable>(store(composition), node, .(true))
        storageInsert<Action>(store(composition), node, .(self.action))
        storageInsert<Layout>(store(composition), node, .(layoutRow, .Center, .Center, 0.0))
        composition.applyModifier(node, modifier)
        return node
    }
}

impl Button {
    func &.display(formatter: Formatter!) { formatter.write("Button(${self.action})") }
    react ctor (anchor: Anchor!).(
        modifier: Modifier& = .()
        action: Int = 0
        key: String = ""
        children: inline react Anchor!.() -> Unit
    ): Entity {
        self.action = action

        fin id = if key == "" { anchor.pass.positionalKey(anchor.parent, "button") } else { key }
        fin node = self.compose(anchor.pass, anchor.parent, id, modifier)
        using anchor.inside(node) {
            children()
        }
        return node
    }
}

/** A declarative column constructor. In an Anchor scope it returns its retained entity. */
pack Column derives Clone {
    var spacing: Double = 0.0
}
impl Column {
    react ctor (anchor: Anchor!).(
        modifier: Modifier& = .()
        verticalArrangement: Arrangement = .Start
        horizontalAlignment: Alignment = .Start
        spacing: Double = 0.0
        key: String = ""
        children: inline react Anchor!.() -> Unit
    ): Entity {
        self.spacing = spacing
        fin id = if key == "" { anchor.pass.positionalKey(anchor.parent, "column") } else { key }
        fin node = anchor.pass.column(anchor.parent, id, modifier, verticalArrangement, horizontalAlignment, spacing)
        using anchor.inside(node) {
            children()
        }
        return node
    }
}

/** A declarative row constructor. */
pack Row derives Clone {
    var spacing: Double = 0.0
}
impl Row {
    react ctor (anchor: Anchor!).(
        modifier: Modifier& = .()
        horizontalArrangement: Arrangement = .Start
        verticalAlignment: Alignment = .Start
        spacing: Double = 0.0
        key: String = ""
        children: inline react Anchor!.() -> Unit
    ): Entity {
        self.spacing = spacing
        fin id = if key == "" { anchor.pass.positionalKey(anchor.parent, "row") } else { key }
        fin node = anchor.pass.row(anchor.parent, id, modifier, horizontalArrangement, verticalAlignment, spacing)
        using anchor.inside(node) {
            children()
        }
        return node
    }
}

/** A retained column whose children scroll within its arranged rectangle. */
pack ScrollColumn derives Clone {
    var spacing: Double = 0.0
}
impl ScrollColumn {
    react ctor (anchor: Anchor!).(
        modifier: Modifier& = .()
        verticalArrangement: Arrangement = .Start
        horizontalAlignment: Alignment = .Start
        spacing: Double = 0.0
        key: String = ""
        children: inline react Anchor!.() -> Unit
    ): Entity {
        self.spacing = spacing
        fin id = if key == "" { anchor.pass.positionalKey(anchor.parent, "scroll") } else { key }
        fin node = anchor.pass.scrollColumn(anchor.parent, id, modifier, verticalArrangement, horizontalAlignment, spacing)
        using anchor.inside(node) {
            children()
        }
        return node
    }
}

/** A declarative rectangle with an ECS query group. */
pack Shape derives Clone {
    var group: Int = 0
}
impl Shape {
    react ctor (anchor: Anchor!).(
        modifier: Modifier& = .()
        group: Int = 0
        key: String = ""
    ): Entity {
        self.group = group
        fin id = if key == "" { anchor.pass.positionalKey(anchor.parent, "shape") } else { key }
        return anchor.pass.shape(anchor.parent, id, modifier, group)
    }
}

/** What the node was asked to do when activated; 0 means nothing. */
@Component
pack Action derives Clone {
    var code: Int = 0
}

/** The rectangle a node occupies, once arranged. */
@Component
pack Rect derives Clone {
    var x: Double = 0.0
    var y: Double = 0.0
    var width: Double = 0.0
    var height: Double = 0.0
}

/** How a node paints: colour and coverage. */
@Component
pack Paint derives Clone {
    var r: Double = 0.0
    var g: Double = 0.0
    var b: Double = 0.0
    var alpha: Double = 1.0
    /** Text size; 0 for nodes that draw no text. */
    var size: Double = 0.0
}

/**
 * Which composition owns the node, and whether this pass claimed it.
 *
 * Reconciliation is by claim: a pass marks every node it still wants, and
 * whatever is left unclaimed at the end belonged to a previous tree and is
 * disposed (§9.2). Recording the owner keeps one composition from disposing
 * another's nodes.
 */
@Component
pack Owned derives Clone {
    fin owner: String = ""
    var claimed: Bool = false
}

/**
 * How a container arranges its children.
 *
 * Layout is a component rather than a node kind so that "is a column" and "is a
 * button" are independent facts. A node can gain or lose an arrangement without
 * changing what it is.
 */
@Component
pack Layout derives Clone {
    /** 0 stacks children downward, 1 lays them across. */
    var direction: Int = 0
    /** How leftover space along the container's own axis is distributed. */
    var arrangement: Arrangement = .Start
    /** Where each child sits on the axis across this one. */
    var alignment: Alignment = .Start
    /** A fixed gap between children, added before [arrangement] distributes. */
    var spacing: Double = 0.0
}

/** Stacks children downward. */
fin layoutColumn = 0

/** Lays children across. */
fin layoutRow = 1

/**
 * A container whose children are offset by [offset] and clipped to its bounds.
 *
 * Scrolling is a property of looking at a container, not of the children, so it
 * lives here and the children never learn they are scrolled.
 */
@Component
pack Scroll derives Clone {
    var offset: Double = 0.0
    /** Total height the children needed, so scrolling can be bounded. */
    var contentExtent: Double = 0.0
}

/**
 * A group label, so a system can find related nodes without knowing their keys.
 *
 * This is what a query selects on: "every shape tagged 2" is a question about
 * data, answerable without the composition that produced it.
 */
@Component
pack Tag derives Clone {
    fin name: String = ""
}

/**
 * The same marker, numbered.
 *
 * A name says what a thing is and survives a rename of nothing; a number is
 * what a generator hands out when there is no name to give. Both are markers
 * and neither is the other, so they are two components rather than one with a
 * field nobody fills.
 */
@Component
pack TagI derives Clone {
    fin index: Int = 0
}


// ── Arrangement and alignment ───────────────────────────────────────────

/**
 * How a container distributes space *along* its own axis.
 *
 * The values are axis-neutral: a column reads `Start` as top and `End` as
 * bottom, a row reads them as left and right. Compose spells this with one
 * enum per axis; one enum with neutral names says the same thing without
 * making `Arrangement.Top` legal on a row.
 */
enum Arrangement {
    Start
    Center
    End
    SpaceBetween
    SpaceAround
    SpaceEvenly
}

/** Where a child sits on the axis *across* the container's own. */
enum Alignment {
    Start
    Center
    End
}

// ── Modifiers ───────────────────────────────────────────────────────────

/** What a single link in a modifier chain does. */
enum ModifierKind {
    FillMaxWidth
    FillMaxHeight
    Width
    Height
    Padding
    Background
    Weight
    Rounded
    Border
    Hover
    TextColor
    FontSize
    TextAlign
    Font
}

/**
 * One link in a modifier chain.
 *
 * The payload is four unnamed numbers because a link is data, not behaviour -
 * `Padding` reads all four as insets, `Background` reads them as a colour, and
 * nothing else needs to know which is which.
 */
pack ModifierEntry derives (Copy, Clone) {
    fin kind: ModifierKind
    fin a: Double = 0.0
    fin b: Double = 0.0
    fin c: Double = 0.0
    fin d: Double = 0.0
}

/**
 * An immutable, ordered chain of layout, paint and input instructions.
 *
 * Ordered because order is meaning: `.padding(8.0).background(…)` paints inside
 * the inset, `.background(…).padding(8.0)` paints outside it. Immutable because
 * a modifier is a value - chaining returns a new one, so a modifier held in a
 * variable cannot be changed by the widget it was passed to (§12.1).
 *
 * A chain never draws. It records what was asked for; the layout and paint
 * systems decide what that means.
 */
pack Modifier derives Clone {
    fin entries: Array<ModifierEntry> = Array<ModifierEntry>()
}

impl Modifier {
    /** This chain with [entry] appended. */
    func &.then(entry: ModifierEntry): Modifier {
        var grown: Array<ModifierEntry> = Array<ModifierEntry>()
        var index = 0
        while index < self.entries.size {
            grown.add(self.entries[index].clone())
            index = index + 1
        }
        grown.add(take entry)
        return Modifier(take grown)
    }

    /** Take all the width the parent offers. */
    func &.fillMaxWidth(): Modifier {
        return self.then(ModifierEntry(ModifierKind.FillMaxWidth, 0.0, 0.0, 0.0, 0.0))
    }

    /** Take all the height the parent offers. */
    func &.fillMaxHeight(): Modifier {
        return self.then(ModifierEntry(ModifierKind.FillMaxHeight, 0.0, 0.0, 0.0, 0.0))
    }

    /** Take all of both. */
    func &.fillMaxSize(): Modifier {
        return self.fillMaxWidth().fillMaxHeight()
    }

    /** A fixed width. */
    func &.width(value: Double): Modifier {
        return self.then(ModifierEntry(ModifierKind.Width, value, 0.0, 0.0, 0.0))
    }

    /** A fixed height. */
    func &.height(value: Double): Modifier {
        return self.then(ModifierEntry(ModifierKind.Height, value, 0.0, 0.0, 0.0))
    }

    /** A fixed size on both axes. */
    func &.size(width: Double, height: Double): Modifier {
        return self.width(width).height(height)
    }

    /**
     * Inset from the edges.
     *
     * `padding(all:)` sets every edge; the named edges override it, so
     * `padding(all: 8.0, top: 16.0)` reads the way it looks.
     */
    func &.padding(
        all: Double = 0.0
        start: Double = 0 - 1.0
        top: Double = 0 - 1.0
        end: Double = 0 - 1.0
        bottom: Double = 0 - 1.0
    ): Modifier {
        fin l = if start < 0.0 { all } else { start }
        fin t = if top < 0.0 { all } else { top }
        fin r = if end < 0.0 { all } else { end }
        fin b = if bottom < 0.0 { all } else { bottom }
        return self.then(ModifierEntry(ModifierKind.Padding, l, t, r, b))
    }

    /** Fill the node's rectangle with a colour. */
    func &.background(
        r: Double
        g: Double
        b: Double
        alpha: Double = 1.0
    ): Modifier {
        return self.then(ModifierEntry(ModifierKind.Background, r, g, b, alpha))
    }

    /** Share of the leftover space along the parent's axis. */
    func &.weight(value: Double): Modifier {
        return self.then(ModifierEntry(ModifierKind.Weight, value, 0.0, 0.0, 0.0))
    }

    /** Round the background's corners by [radius] points. */
    func &.rounded(radius: Double): Modifier {
        return self.then(ModifierEntry(ModifierKind.Rounded, radius, 0.0, 0.0, 0.0))
    }

    /** Draw an inner border [width] points wide, following any rounding. */
    func &.border(width: Double, r: Double, g: Double, b: Double): Modifier {
        return self.then(ModifierEntry(ModifierKind.Border, width, r, g, b))
    }

    /** Fill with this colour instead of the background while the pointer is over the node. */
    func &.hover(r: Double, g: Double, b: Double, alpha: Double = 1.0): Modifier {
        return self.then(ModifierEntry(ModifierKind.Hover, r, g, b, alpha))
    }

    /** The colour of the node's own text. */
    func &.textColor(r: Double, g: Double, b: Double, alpha: Double = 1.0): Modifier {
        return self.then(ModifierEntry(ModifierKind.TextColor, r, g, b, alpha))
    }

    /** The point size of the node's own text. */
    func &.fontSize(size: Double): Modifier {
        return self.then(ModifierEntry(ModifierKind.FontSize, size, 0.0, 0.0, 0.0))
    }

    /** Draw the node's text in the interface font's semibold weight. */
    func &.semibold(): Modifier {
        return self.then(ModifierEntry(ModifierKind.Font, 1.0, 0.0, 0.0, 0.0))
    }

    /** Draw the node's text in a fixed-pitch font. */
    func &.monospace(): Modifier {
        return self.then(ModifierEntry(ModifierKind.Font, 2.0, 0.0, 0.0, 0.0))
    }

    /** Where the node's text sits across its width; padding insets the edges. */
    func &.textAlign(alignment: Alignment): Modifier {
        fin value: Double = if alignment == Alignment.Start { 0.0 } else if alignment == Alignment.Center { 1.0 } else { 2.0 }
        return self.then(ModifierEntry(ModifierKind.TextAlign, value, 0.0, 0.0, 0.0))
    }
}


/**
 * Starting a chain: `Modifier::fillMaxSize()`, as Compose writes it.
 *
 * Each is the first link; everything after it is an ordinary method on the
 * value returned, so a chain reads the same whether it is one link or six. A
 * static and the instance method of the same name coexist - `Modifier::padding`
 * starts a chain, `.padding` continues one.
 */
impl Modifier {
    /** Take all the width the parent offers. */
    func fillMaxWidth(): Modifier {
        return Modifier().fillMaxWidth()
    }

    /** Take all the height the parent offers. */
    func fillMaxHeight(): Modifier {
        return Modifier().fillMaxHeight()
    }

    /** Take all of both. */
    func fillMaxSize(): Modifier {
        return Modifier().fillMaxSize()
    }

    /** A fixed width. */
    func width(value: Double): Modifier {
        return Modifier().width(value)
    }

    /** A fixed height. */
    func height(value: Double): Modifier {
        return Modifier().height(value)
    }

    /** A fixed size on both axes. */
    func size(width: Double, height: Double): Modifier {
        return Modifier().size(width, height)
    }

    /** Inset from the edges. */
    func padding(
        all: Double = 0.0
        start: Double = 0.0
        top: Double = 0.0
        end: Double = 0.0
        bottom: Double = 0.0
    ): Modifier {
        return .().padding(all: all, start: start, top: top, end: end, bottom: bottom)
    }

    /** Fill the node's rectangle with a colour. */
    func background(
        r: Double
        g: Double
        b: Double
        alpha: Double = 1.0
    ): Modifier {
        return .().background(r, g, b, alpha)
    }

    /** Share of the leftover space along the parent's axis. */
    func weight(value: Double): Modifier {
        return .().weight(value)
    }

    /** Round the background's corners. */
    func rounded(radius: Double): Modifier {
        return .().rounded(radius)
    }

    /** The colour of the node's own text. */
    func textColor(r: Double, g: Double, b: Double, alpha: Double = 1.0): Modifier {
        return .().textColor(r, g, b, alpha)
    }

    /** The point size of the node's own text. */
    func fontSize(size: Double): Modifier {
        return .().fontSize(size)
    }
}

/**
 * A node's own size request, as its modifier chain left it.
 *
 * Absent means "whatever the parent gives me".
 */
@Component
pack Size derives Clone {
    var fillWidth: Bool = false
    var fillHeight: Bool = false
    /** Fixed extent, or 0 when none was asked for. */
    var width: Double = 0.0
    var height: Double = 0.0
    /** Share of leftover space along the parent's axis; 0 when none. */
    var weight: Double = 0.0
}

/** Inset between a node's rectangle and its children's. */
@Component
pack Padding derives Clone {
    var start: Double = 0.0
    var top: Double = 0.0
    var end: Double = 0.0
    var bottom: Double = 0.0
}

/** Corner rounding for a node's background and border. */
@Component
pack Corner derives Clone {
    var radius: Double = 0.0
}

/** An inner border drawn over the background. */
@Component
pack Stroke derives Clone {
    var width: Double = 0.0
    var r: Double = 0.0
    var g: Double = 0.0
    var b: Double = 0.0
    var alpha: Double = 1.0
}

/** The fill a node takes while the pointer is over it. */
@Component
pack HoverPaint derives Clone {
    var r: Double = 0.0
    var g: Double = 0.0
    var b: Double = 0.0
    var alpha: Double = 1.0
}

/**
 * How a node's own text is drawn.
 *
 * [align] is 0 for start, 1 for centre and 2 for end, measured inside the
 * node's padding; [size] 0 means the default point size.
 */
@Component
pack TextStyle derives Clone {
    var r: Double = 0.94
    var g: Double = 0.95
    var b: Double = 0.97
    var alpha: Double = 1.0
    var size: Double = 0.0
    var align: Int = 1
    /** 0 regular, 1 semibold, 2 fixed-pitch. */
    var font: Int = 0
}
