/**
 * @file engine.ui.paint
 *
 * Drawing the committed UI world.
 *
 * The last pass, and the only one that touches `App`. It reads arranged rows -
 * [Rect] with [Paint], and [Text] where present - and submits draw calls.
 * Nothing above it knows a renderer exists, which is what lets the same world be
 * asserted on in a test with no window (§10.1: the render tree owns draw data
 * and nothing else).
 *
 * Nodes are drawn in composition order so later siblings cover earlier ones,
 * matching the order hit-testing resolves them in.
 */
module engine.ui.paint

import std.container.array
import engine.platform
import engine.gpu.draw
import engine.ui
import engine.core
import engine.ecs
import engine.ui.node
import engine.ui.compose
import engine.ui.systems

/**
 * Draws [node] and its subtree.
 *
 * A node outside [clipTop]..[clipBottom] is skipped rather than drawn: that is
 * what makes a scrolled list cost the height of the window instead of the
 * length of its content.
 */
func paintTree(
    app: App
    pass: Composition&
    node: Entity
    clipTop: Double
    clipBottom: Double
) {
    fin rect = storageGetOrDefault<Rect>(store(pass), node, .())
    fin visible = rect.y + rect.height >= clipTop && rect.y <= clipBottom

    if visible {
        fin ink = storageGetOrDefault<Paint>(store(pass), node, .())
        if ink.alpha > 0.0 && rect.width > 0.0 && rect.height > 0.0 {
            app.uiRect(rect.x, rect.y, rect.width, rect.height, ink.r, ink.g, ink.b, ink.alpha)
        }
        fin label = storageGetOrDefault<Text>(store(pass), node, .())
        if stringLength(label.value) > 0 {
            fin size = if ink.size > 0.0 { ink.size } else { 14.0 }
            // Text is drawn inside its own node's rectangle. It is not nudged
            // off the edge any more: a caption inside a button is a child that
            // the button's centring layout has already placed, so shifting it
            // here would move it off the centre it was just given.
            fin width = app.uiTextWidth(label.value, size)
            app.uiTextColored(
                label.value,
                rect.x + (rect.width - width) * 0.5,
                rect.y + (rect.height - size) * 0.5,
                size,
                0.94, 0.95, 0.97
            )
        }
    }

    // A scrolled container bounds its own content. Its children have been moved
    // by the scroll offset, so without this a row scrolled past the top is
    // drawn over whatever sits above the container - the toolbar, a neighbour,
    // anything. The rectangle is restored afterwards rather than saved and
    // put back, because containers here do not nest.
    fin scrolls = storageHas<Scroll>(store(pass), node)
    var childTop = clipTop
    var childBottom = clipBottom
    if scrolls {
        app.setScissor(rect.x, rect.y, rect.width, rect.height)
        // Culling still uses the tighter bounds: the scissor stops a partly
        // visible row from spilling, and this stops a wholly invisible one from
        // being drawn at all.
        if rect.y > childTop {
            childTop = rect.y
        }
        if rect.y + rect.height < childBottom {
            childBottom = rect.y + rect.height
        }
    }

    // Children are drawn whether or not the parent was visible: a scrolled
    // container is usually off-screen itself while its rows are not.
    fin count = pass.childCount(node)
    var index = 0
    while index < count {
        fin child = pass.childAt(node, index)
        if child.isValid {
            paintTree(app, pass, child, childTop, childBottom)
        }
        index = index + 1
    }

    if scrolls {
        app.clearScissor()
    }
}
