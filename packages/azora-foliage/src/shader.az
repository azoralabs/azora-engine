module engine.foliage.shader

func foliageMetalSource(): String = "#include <metal_stdlib>
using namespace metal;

struct FoliageU {
    float4x4 viewProj;
    float4x4 terrain;
    float4 eye;
    float4 light;
    float4 direct;
    float4 fog;
    float4 fogShape;
    float4 wind;
    float4 cell;
    float4 options;
};

struct FoliageVertex {
    float4 position [[position]];
    float3 world;
    half3 color;
    half3 normal;
};

int foldedVertex(int x, int z, int step, int mask) {
    int i = x, j = z;
    if (step < 32) {
        if (((z == 0 && (mask & 1)) || (z == 32 && (mask & 2))) && (x / step) % 2) i -= step;
        if (((x == 0 && (mask & 4)) || (x == 32 && (mask & 8))) && (z / step) % 2) j -= step;
    }
    return j * 33 + i;
}

float3 groundVertex(device const float* ground, int index) {
    const device float* v = ground + index * 6;
    return float3(v[0], v[1], v[2]);
}

bool groundTriangle(float2 point, float3 a, float3 b, float3 c, thread float& height) {
    float2 u = b.xz - a.xz, v = c.xz - a.xz, p = point - a.xz;
    float det = u.x*v.y-u.y*v.x;
    if (abs(det) < 1e-15) return false;
    float s = (p.x*v.y-p.y*v.x)/det, t = (u.x*p.y-u.y*p.x)/det;
    if (s < -0.00005 || t < -0.00005 || s+t > 1.00005) return false;
    height = a.y+s*(b.y-a.y)+t*(c.y-a.y);
    return true;
}

bool groundCell(float2 point, int x, int z, int step, int mask, device const float* ground, thread float& height) {
    float3 a = groundVertex(ground, foldedVertex(x*step,z*step,step,mask));
    float3 b = groundVertex(ground, foldedVertex((x+1)*step,z*step,step,mask));
    float3 c = groundVertex(ground, foldedVertex(x*step,(z+1)*step,step,mask));
    float3 d = groundVertex(ground, foldedVertex((x+1)*step,(z+1)*step,step,mask));
    if ((x+z)%2 == 0) return groundTriangle(point,a,c,d,height) || groundTriangle(point,a,d,b,height);
    return groundTriangle(point,a,c,b,height) || groundTriangle(point,b,c,d,height);
}

// Follow the visible terrain's LOD and the exact index fold at a tile edge.
// A folded triangle can cross into a neighbouring cell on the same tile.
float plantedHeight(float2 point, device const float* ground, constant FoliageU& u) {
    int step = 1 << int(u.options.x), mask = int(u.options.y), cells = 32 / step;
    int2 xy = clamp(int2(floor((point-u.cell.xy)/u.cell.zw/float(step))),0,cells-1);
    float height = 0.0;
    if (groundCell(point,xy.x,xy.y,step,mask,ground,height)) return height;
    for (int z = max(0,xy.y-1); z <= min(cells-1,xy.y+1); z++) {
        for (int x = max(0,xy.x-1); x <= min(cells-1,xy.x+1); x++) {
            if (groundCell(point,x,z,step,mask,ground,height)) return height;
        }
    }
    return groundVertex(ground,xy.y*step*33+xy.x*step).y;
}

float2 circle(float angle) {
    return float2(cos(angle),sin(angle));
}

vertex FoliageVertex foliage_vertex(uint vid [[vertex_id]], uint iid [[instance_id]],
       device const float4* plants [[buffer(0)]], constant FoliageU& u [[buffer(1)]],
       device const float* ground [[buffer(2)]]) {
    float4 plant = plants[iid];
    float seed = plant.w;
    float3 root = (u.terrain * float4(plant.x,plantedHeight(plant.xy,ground,u),plant.y,1.0)).xyz;
    float distance = length(root.xz-u.eye.xz);
    int lod = int(u.options.w);
    bool fir = u.options.z > 0.5;
    float3 offset;
    float3 n;
    half3 tint;
    float turn = seed*6.2831853;
    float phase = u.wind.z*1.75 + dot(root.xz,float2(0.095,0.127)) + turn*0.35;
    float2 wind = (float2(0.55,0.24) + clamp(u.wind.xy*0.11,-1.0,1.0)) * sin(phase);
    if (fir) {
        root.y -= 0.10;
        if (vid < 24) {
            int side = int(vid)/6, v = int(vid)%6;
            float2 a = circle(turn+float(side)*1.5707963);
            float2 b = circle(turn+float(side+1)*1.5707963);
            bool top = v == 2 || v == 4 || v == 5;
            float2 p = (v == 0 || v == 3 || v == 5) ? a : b;
            float width = plant.z*(top ? 0.018 : 0.029);
            offset = float3(p.x*width,top ? plant.z*0.56 : 0.0,p.y*width);
            n = float3((a+b).x,0.0,(a+b).y);
            tint = half3(0.23,0.145,0.09);
        } else {
            int sides = lod == 0 ? 7 : lod == 1 ? 5 : 4;
            int tiers = lod == 0 ? 4 : lod == 1 ? 3 : 2;
            int face = (int(vid)-24)/3, tier = face/sides, side = face%sides;
            int v = (int(vid)-24)%3;
            float fraction = float(tier)/float(tiers-1);
            float angle = turn+float(side)*6.2831853/float(sides)+fraction*1.82;
            float2 a = circle(angle), b = circle(angle+6.2831853/float(sides));
            float2 p = v == 0 ? b : a;
            float radius = plant.z*mix(0.143,0.054,fraction)*(0.88+0.21*sin(angle*3.0+turn));
            float base = plant.z*(0.21+0.49*fraction+0.025*sin(angle+turn));
            float tip = plant.z*(0.63+0.37*fraction);
            offset = v == 2 ? float3(0,tip,0) : float3(p.x*radius,base,p.y*radius);
            n = normalize(float3((a+b).x,0.53,(a+b).y));
            half variation = half(0.83+seed*0.24+0.06*sin(angle*1.5+turn));
            tint = mix(half3(0.045,0.145,0.09),half3(0.105,0.26,0.15),half(fraction))*variation;
            offset.xz += wind * (offset.y/plant.z) * (0.04+0.025*plant.z);
        }
    } else {
        root.y -= 0.022;
        int blade = int(vid)/3, v = int(vid)%3;
        float angle = turn+float(blade)*2.3999632;
        float2 side = circle(angle), bend = float2(-side.y,side.x);
        float height = plant.z * (0.66+0.3*fract(seed*3.79+float(blade)*0.41));
        height *= 1.0-smoothstep(55.0,84.0,distance);
        float width = plant.z * (lod == 0 ? 0.12 : 0.16);
        float2 p = v == 2 ? bend*height*0.23+wind*height*0.31 : side*width*(v == 0 ? -1.0 : 1.0);
        p += bend*plant.z*float(blade)*0.13;
        offset = float3(p.x,v == 2 ? height : 0.0,p.y);
        n = normalize(float3(bend.x,0.9,bend.y));
        half3 deep = mix(half3(0.11,0.23,0.055),half3(0.19,0.31,0.08),half(seed));
        half3 tip = mix(half3(0.23,0.37,0.09),half3(0.36,0.45,0.14),half(seed));
        tint = v == 2 ? tip : deep;
    }
    FoliageVertex result;
    result.world = root + offset;
    result.position = u.viewProj * float4(result.world,1.0);
    result.color = tint;
    result.normal = half3(n);
    return result;
}

fragment half4 foliage_fragment(FoliageVertex in [[stage_in]], constant FoliageU& u [[buffer(1)]]) {
    half ambient = half(clamp(u.light.w+0.2,0.0,1.0));
    half diffuse = half(0.32+0.68*max(dot(normalize(in.normal),half3(u.light.xyz)),half(0)));
    half3 lit = in.color * (ambient + (half(1)-ambient)*diffuse*half3(u.direct.xyz)*half(u.direct.w));
    if (u.eye.w > 0.5) lit = in.color;
    float dist = distance(in.world,u.eye.xyz);
    float haze = 1.0-exp(-max(0.0,dist-u.fogShape.z)*max(u.fog.w,0.0));
    return half4(mix(lit,half3(u.fog.xyz),half(min(haze,u.fogShape.w))),1.0h);
}
"
