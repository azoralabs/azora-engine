module engine.vehicles.drivetrain

import std.math

// An engine and its gearbox: the torque an engine makes at each speed, the
// gears that turn it into wheel torque, and the automatic that picks them.
// Units: revolutions per minute, newton metres, seconds.

pack DrivetrainSpec {
    var idleRpm: Double = 850.0
    var limitRpm: Double = 6800.0
    /** Crank, flywheel and clutch, in kg m²: what the wheels also turn while the clutch is closed. */
    var inertia: Double = 0.16
    /** Full-throttle torque at 0, [torqueStep], 2 x [torqueStep] … rpm. */
    var torque: Array<Double> = []
    var torqueStep: Double = 500.0
    /** First gear first. */
    var ratios: Array<Double> = []
    var reverse: Double = 3.3
    var finalDrive: Double = 4.1
    /** Upshift points at full and at no throttle; the downshift point is [downShare] of the upshift point. */
    var upRpm: Double = 6300.0
    var lightUpRpm: Double = 2400.0
    var downShare: Double = 0.55
    var shiftTime: Double = 0.18
    /** How long a gear is held after a shift before another. */
    var holdTime: Double = 0.6
    /** Closed-throttle drag at the limiter. */
    var dragAtLimit: Double = 60.0
    var efficiency: Double = 0.9
    /** How far above idle the clutch lets the engine run at full throttle while it slips at launch. */
    var launchRpm: Double = 1500.0
}

/**
 * A 2.0 litre turbocharged inline-4 (about 165 kW at 6500 rpm) with six
 * close ratios, top speed on the limiter in sixth, or a
 * 700 cc parallel twin (about 67 kW at 10000 rpm) with five.
 */
func drivetrainSpec(motorcycle: Bool, sport: Bool = false): DrivetrainSpec {
    if sport {
        if motorcycle {
            return DrivetrainSpec(idleRpm: 1450.0,limitRpm: 13900.0,inertia: 0.027,torqueStep: 1000.0,
                torque: [35.0,39.0,48.0,56.0,62.0,69.0,73.0,75.0,77.0,77.0,76.0,74.0,69.0,65.0,60.0]
                ratios: [2.68,1.98,1.59,1.32,1.125,0.98],finalDrive: 6.15,reverse: 2.60
                upRpm: 13200.0,lightUpRpm: 4400.0,launchRpm: 4250.0,shiftTime: 0.12,dragAtLimit: 22.0)
        }
        return DrivetrainSpec(limitRpm: 7850.0,
            torque: [105.0,139.0,176.0,208.0,246.0,270.0,291.0,304.0,315.0,320.0,318.0,314.0,308.0,297.0,284.0,270.0,252.0]
            ratios: [3.52,2.40,1.78,1.41,1.16,0.99],finalDrive: 3.66,upRpm: 7480.0
            lightUpRpm: 2600.0,launchRpm: 2400.0,shiftTime: 0.105,inertia: 0.13)
    }
    if !motorcycle then return DrivetrainSpec(
        torque: [120.0, 140.0, 175.0, 210.0, 240.0, 255.0, 262.0, 266.0, 268.0, 268.0, 266.0, 262.0, 255.0, 245.0, 228.0, 205.0]
        ratios: [3.55, 2.30, 1.70, 1.38, 1.17, 1.00])
    return DrivetrainSpec(idleRpm: 1300.0, limitRpm: 11500.0, inertia: 0.035,
        torque: [30.0, 34.0, 45.0, 55.0, 61.0, 65.0, 68.0, 70.0, 70.0, 68.0, 64.0, 58.0, 50.0], torqueStep: 1000.0
        ratios: [2.60, 1.90, 1.50, 1.25, 1.05], reverse: 2.6, finalDrive: 6.5, upRpm: 11000.0, lightUpRpm: 4000.0
        dragAtLimit: 18.0, launchRpm: 2500.0)
}

/** Full-throttle torque at [rpm], between the table's points. */
func curveTorque(train: DrivetrainSpec&, rpm: Double): Double {
    fin at = (if rpm > 0.0 then rpm else 0.0) / train.torqueStep
    fin index = at as Int
    if index >= train.torque.size - 1 then return train.torque[train.torque.size - 1]
    fin part = at - (index as Double)
    return train.torque[index] + (train.torque[index + 1] - train.torque[index]) * part
}

/** The torque the engine gives at [rpm] and [throttle]; a closed throttle drags, more the faster it spins. */
func engineTorque(train: DrivetrainSpec&, rpm: Double, throttle: Double): Double {
    if throttle <= 0.0 then return -train.dragAtLimit * (if rpm > 0.0 then rpm else 0.0) / train.limitRpm
    return curveTorque(train, rpm) * (if throttle > 1.0 then 1.0 else throttle)
}

/** Gearbox and final drive together for [gear]: negative in reverse, 0 in neutral. */
func overallRatio(train: DrivetrainSpec&, gear: Int): Double {
    return when {
        gear == -1 -> -train.reverse * train.finalDrive
        gear < 1 || gear > train.ratios.size -> 0.0
        else -> train.ratios[gear - 1] * train.finalDrive
    }
}

func upShiftRpm(train: DrivetrainSpec&, throttle: Double): Double {
    fin pedal = if throttle > 0.0 then (if throttle > 1.0 then 1.0 else throttle) else 0.0
    return train.lightUpRpm + (train.upRpm - train.lightUpRpm) * pedal * pedal
}

/**
 * The gear to be in. Up when the engine passes the upshift point for the
 * throttle, down when it falls under [DrivetrainSpec.downShare] of it - the
 * gap between the two is wider than any step between gears, so a shift never
 * lands where the next one would undo it. A gear is held [holdTime] after
 * each shift. Reverse only from a standstill, and back out of it the same way.
 */
func nextGear(train: DrivetrainSpec&, gear: Int, rpm: Double, throttle: Double, forwardSpeed: Double, gearAge: Double): Int {
    fin still = forwardSpeed < 0.5 && forwardSpeed > -0.5
    if gear == -1 then return if throttle > 0.0 && still then 1 else -1
    if throttle < 0.0 && still && train.reverse > 0.0 then return -1
    if gear < 1 then return 1
    if gearAge < train.holdTime then return gear
    fin up = upShiftRpm(train, throttle)
    return when {
        gear < train.ratios.size && rpm > up -> gear + 1
        gear > 1 && rpm < up * train.downShare -> gear - 1
        else -> gear
    }
}

/**
 * The gear an engine settles in at [wheelSpeed] (rad/s at the driven wheels)
 * cruising on a light throttle: the highest whose engine speed stays above
 * where it would shift down, or first when none does.
 */
func cruisingGear(train: DrivetrainSpec&, wheelSpeed: Double): Int {
    fin floor = upShiftRpm(train, 0.35) * train.downShare
    var chosen = 1
    for gear: Int in 1..train.ratios.size {
        if wheelSpeed * overallRatio(train, gear) * 9.549296585513721 >= floor then chosen = gear
    }
    return chosen
}
