inline fin gtGlass = "azora.gt.glass"
inline fin gtCarbon = "azora.gt.carbon"
inline fin gtStripe = "azora.gt.stripe"
inline fin gtFrontLED = "azora.gt.front"
inline fin gtRearLED = "azora.gt.rear"
