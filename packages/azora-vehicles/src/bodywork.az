/** Cross sections of a hull perpendicular to its longitudinal Z axis. */
pack BodySection derives Clone {
    var z: Double
    var width: Double
    var top: Double
    var shoulder: Double
    var low: Double
}

func bodyMix(a: Double, b: Double, t: Double): Double = a+(b-a)*t

func bodyDifference(a: Vec3&, b: Vec3&): Vec3 = Vec3(a.x-b.x,a.y-b.y,a.z-b.z)
func bodyCross(a: Vec3&, b: Vec3&): Vec3 = Vec3(a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x)

func bodyUnit(n: Vec3&): Vec3 {
    fin length = sqrt(n.x*n.x+n.y*n.y+n.z*n.z)
    return if length <= 0.000001 then Vec3(0.0,1.0,0.0) else .(n.x/length,n.y/length,n.z/length)
}

func bodyVertex(data: Array<Double>!, p: Vec3&, n: Vec3&) {
    data.add(p.x)
    data.add(p.y)
    data.add(p.z)
    data.add(n.x)
    data.add(n.y)
    data.add(n.z)
}

func bodyTriangle(data: Array<Double>!, a: Vec3&, b: Vec3&, c: Vec3&) {
    fin n = bodyUnit(bodyCross(bodyDifference(b,a),bodyDifference(c,a)))
    bodyVertex(data,a,n)
    bodyVertex(data,b,n)
    bodyVertex(data,c,n)
}

func bodyQuad(data: Array<Double>!, a: Vec3&, b: Vec3&, c: Vec3&, d: Vec3&) {
    bodyTriangle(data,a,b,c)
    bodyTriangle(data,a,c,d)
}

func bodyBox(data: Array<Double>!, x: Double, y: Double, z: Double, dx: Double, dy: Double, dz: Double) {
    fin a: Vec3 = .(x-dx,y-dy,z-dz)
    fin b: Vec3 = .(x+dx,y-dy,z-dz)
    fin c: Vec3 = .(x+dx,y+dy,z-dz)
    fin d: Vec3 = .(x-dx,y+dy,z-dz)
    fin e: Vec3 = .(x-dx,y-dy,z+dz)
    fin f: Vec3 = .(x+dx,y-dy,z+dz)
    fin g: Vec3 = .(x+dx,y+dy,z+dz)
    fin h: Vec3 = .(x-dx,y+dy,z+dz)
    bodyQuad(data,a,d,c,b)
    bodyQuad(data,e,f,g,h)
    bodyQuad(data,a,e,h,d)
    bodyQuad(data,b,c,g,f)
    bodyQuad(data,d,h,g,c)
    bodyQuad(data,a,b,f,e)
}

func archLower(section: BodySection&, side: Double, cutouts: Bool): Double {
    if !cutouts || side < 0.74 then return section.low
    fin front = absValue(section.z+1.32)
    fin rear = absValue(section.z-1.28)
    fin near = if front < rear then front else rear
    fin arch: Double = 0.47
    if near >= arch then return section.low
    fin cut = -0.35+sqrt(arch*arch-near*near)
    return if cut > section.low then cut else section.low
}

func hullPoint(section: BodySection&, step: Int, sides: Int, cutouts: Bool): Vec3 {
    fin angle = (step as Double)*6.283185307179586/(sides as Double)
    fin x = cos(angle)
    fin y = sin(angle)
    fin low = archLower(section,absValue(x),cutouts)
    fin belt = if section.shoulder > low then section.shoulder else low
    fin height = if y >= 0.0 then bodyMix(belt,section.top,y) else bodyMix(belt,low,-y)
    return .(section.width*x,height,section.z)
}

func hullNormal(sections: Array<BodySection>&, row: Int, col: Int, sides: Int, cutouts: Bool): Vec3 {
    fin s = sections[row].&
    fin arm = bodyDifference(hullPoint(s,col+1,sides,cutouts),hullPoint(s,col-1,sides,cutouts))
    fin before = sections[if row > 0 then row-1 else row].&
    fin after = sections[if row+1 < sections.size then row+1 else row].&
    fin longitudinal = bodyDifference(hullPoint(after,col,sides,cutouts),hullPoint(before,col,sides,cutouts))
    return bodyUnit(bodyCross(arm,longitudinal))
}

func bodyHull(data: Array<Double>!, sections: Array<BodySection>&, sides: Int, cutouts: Bool = false) {
    var row = 0
    while row+1 < sections.size {
        var col = 0
        while col < sides {
            fin a = hullPoint(sections[row],col,sides,cutouts)
            fin b = hullPoint(sections[row],col+1,sides,cutouts)
            fin c = hullPoint(sections[row+1],col+1,sides,cutouts)
            fin d = hullPoint(sections[row+1],col,sides,cutouts)
            fin na = hullNormal(sections,row,col,sides,cutouts)
            fin nb = hullNormal(sections,row,col+1,sides,cutouts)
            fin nc = hullNormal(sections,row+1,col+1,sides,cutouts)
            fin nd = hullNormal(sections,row+1,col,sides,cutouts)
            bodyVertex(data,a,na)
            bodyVertex(data,b,nb)
            bodyVertex(data,c,nc)
            bodyVertex(data,a,na)
            bodyVertex(data,c,nc)
            bodyVertex(data,d,nd)
            col++
        }
        row++
    }
    fin front = sections[0].&
    fin rear = sections[sections.size-1].&
    var edge = 0
    while edge < sides {
        bodyTriangle(data,.(0.0,front.shoulder,front.z),hullPoint(front,edge+1,sides,cutouts),hullPoint(front,edge,sides,cutouts))
        bodyTriangle(data,.(0.0,rear.shoulder,rear.z),hullPoint(rear,edge,sides,cutouts),hullPoint(rear,edge+1,sides,cutouts))
        edge++
    }
}

func stripePoint(section: BodySection&, x: Double): Vec3 {
    fin fraction = x/section.width
    return .(x,bodyMix(section.shoulder,section.top,sqrt(1.0-fraction*fraction))+0.008,section.z)
}

func stripes(data: Array<Double>!, sections: Array<BodySection>&, width: Double, gap: Double) {
    var i = 0
    while i+1 < sections.size {
        fin a = sections[i].&
        fin b = sections[i+1].&
        if a.width > width+gap && b.width > width+gap {
            bodyQuad(data,stripePoint(a,gap),stripePoint(b,gap),stripePoint(b,gap+width),stripePoint(a,gap+width))
            bodyQuad(data,stripePoint(a,-gap-width),stripePoint(b,-gap-width),stripePoint(b,-gap),stripePoint(a,-gap))
        }
        i++
    }
}

