module engine.vehicles.enginesound

import std.math
import engine.io
import engine.audio.dsp

// The sound of an engine, made the way an engine makes it: each cylinder's
// exhaust valve opens on the firing order and lets out a pressure pulse
// whose length is a fixed stretch of crank angle, so it shortens as the
// engine spins faster; the pulses run down the headers into one pipe, ring
// in it, and leave through the silencer's chambers. The intake breathes
// between them, the valve train ticks, and a closed throttle lets the
// exhaust pop. Nothing here is recorded and nothing loops.
//
// Per sample only Doubles: the voice keeps its state in place.

/** Crank degrees a cylinder's exhaust pulse lasts. */
inline fin pulseDegrees: Double = 160.0

pack EngineVoice {
    var rate: Double = 48000.0
    var motorcycle: Bool = false
    /** Firing angles within the 720° cycle, one per cylinder. */
    var firing: Array<Double> = []
    /** Per cylinder: crank degrees since its valve opened (negative when closed), this pulse's strength, its header delay in samples. */
    var age: Array<Double> = []
    var strength: Array<Double> = []
    var header: Array<Double> = []
    var crank: Double = 0.0
    var cycles: Int = 0
    var rpm: Double = 0.0
    var load: Double = 0.0
    var throttle: Double = 0.0
    var limiter: Bool = false
    var noise: Noise = .()
    var hiss: Noise = .()
    /** Each cylinder's header, then the shared pipe that rings at its length. */
    var headers: DelayLine = .()
    var pipe: DelayLine = .()
    var pipeDelay: Double = 0.0
    var chamberLow: Biquad = .()
    var chamberHigh: Biquad = .()
    var silencer: Biquad = .()
    var tailpipe: Biquad = .()
    var intakeBand: Biquad = .()
    var tickBand: Biquad = .()
    var popBand: Biquad = .()
    var popLevel: Double = 0.0
    /** A turbocharger's spool (the car) and its whistle's phase. */
    var boost: Double = 0.0
    var whistle: Double = 0.0
    var gain: Double = 1.0
    /** Whether it has a turbocharger, the speed its intake roar is measured against, and the speed and odds of overrun pops. */
    var turbo: Bool = true
    var breathRpm: Double = 6800.0
    var popRpm: Double = 3800.0
    var popOdds: Double = 0.94
    /**
     * An outboard's exhaust leaves through the propeller hub, under water: the
     * pulses come up as bubbles, dull and unsteady. [bubbling] is that slow
     * flutter's state.
     */
    var underwater: Bool = false
    var bubbling: OnePole = .()
    var flutter: Double = 1.0
}

/**
 * The car's 2.0 litre inline-4 (firing order 1-3-4-2, a cylinder every
 * 180°) or the motorcycle's 270° parallel twin (fires at 0° and 270°, then
 * waits 450°: its loping beat).
 */
func engineVoice(motorcycle: Bool, rate: Double): EngineVoice {
    var voice: EngineVoice = .(rate: rate, motorcycle: motorcycle, noise: noise(if motorcycle then 271 else 113), hiss: noise(997))
    voice.firing = if motorcycle then [0.0, 270.0] else [0.0, 180.0, 360.0, 540.0]
    // Header lengths differ a little, so pulses meet the collector unevenly.
    fin headers: Array<Double> = if motorcycle then [0.0011, 0.00135] else [0.0016, 0.0019, 0.0017, 0.00205]
    for seconds in headers then voice.header.add(seconds * rate)
    for angle in voice.firing {
        voice.age.add(-1.0)
        voice.strength.add(0.0)
    }
    voice.headers = delayLine((0.004 * rate) as Int)
    // A 2.4 m car exhaust and a 1.1 m bike pipe: a pressure wave there and back.
    voice.pipeDelay = (if motorcycle then 2.2 else 4.8) / 343.0 * rate
    voice.pipe = delayLine((voice.pipeDelay as Int) + 4)
    if motorcycle {
        voice.chamberLow.peak(120.0, 1.2, 7.0, rate)
        voice.chamberHigh.peak(420.0, 1.6, 4.0, rate)
        voice.silencer.lowpass(4800.0, 0.7, rate)
        voice.gain = 0.55
        voice.turbo = false
        voice.breathRpm = 11500.0
        voice.popRpm = 5000.0
        voice.popOdds = 0.84
    } else {
        voice.chamberLow.peak(90.0, 1.1, 8.0, rate)
        voice.chamberHigh.peak(260.0, 1.4, 3.0, rate)
        voice.silencer.lowpass(2600.0, 0.7, rate)
        voice.gain = 0.42
    }
    voice.tailpipe.highpass(35.0, 0.7, rate)
    voice.intakeBand.bandpass(if motorcycle then 1600.0 else 1100.0, 1.4, rate)
    voice.tickBand.bandpass(4200.0, 3.0, rate)
    voice.popBand.bandpass(if motorcycle then 900.0 else 650.0, 1.1, rate)
    return take voice
}

/**
 * A four-stroke outboard's inline-4 (a cylinder every 180°, idling at about
 * 750 rpm, flat out near 6000): its exhaust runs down the leg and out
 * through the propeller hub, so the note comes up through water - low,
 * thick and bubbling - while the powerhead's intake and valve train are
 * heard from under the cowling.
 */
func outboardVoice(rate: Double): EngineVoice {
    var voice: EngineVoice = .(rate: rate, noise: noise(331), hiss: noise(587))
    voice.firing = [0.0, 180.0, 360.0, 540.0]
    fin headers: Array<Double> = [0.0009, 0.00115, 0.001, 0.0012]
    for seconds in headers then voice.header.add(seconds * rate)
    for angle in voice.firing {
        voice.age.add(-1.0)
        voice.strength.add(0.0)
    }
    voice.headers = delayLine((0.004 * rate) as Int)
    // Down the 0.8 m leg and back.
    voice.pipeDelay = 1.6 / 343.0 * rate
    voice.pipe = delayLine((voice.pipeDelay as Int) + 4)
    voice.chamberLow.peak(75.0, 1.0, 9.0, rate)
    voice.chamberHigh.peak(310.0, 1.3, 2.0, rate)
    // Water takes the top off: what reaches the air is under a kilohertz.
    voice.silencer.lowpass(900.0, 0.8, rate)
    voice.tailpipe.highpass(30.0, 0.7, rate)
    voice.intakeBand.bandpass(1400.0, 1.2, rate)
    voice.tickBand.bandpass(3600.0, 2.5, rate)
    voice.popBand.bandpass(500.0, 1.0, rate)
    voice.bubbling.tune(14.0, rate)
    voice.underwater = true
    voice.turbo = false
    voice.breathRpm = 6000.0
    voice.popRpm = 1.0e9
    voice.popOdds = 1.0
    voice.gain = 0.62
    return take voice
}

/**
 * A light aircraft's air-cooled flat-4 (a cylinder every 180°, 700 rpm at
 * idle, 2700 flat out) breathing through short stacks: an open, raw,
 * low-pitched beat with little silencing.
 */
func aircraftEngineVoice(rate: Double): EngineVoice {
    var voice: EngineVoice = .(rate: rate, noise: noise(613), hiss: noise(149))
    voice.firing = [0.0, 180.0, 360.0, 540.0]
    // Left and right banks reach the collector unevenly.
    fin headers: Array<Double> = [0.0012, 0.0019, 0.0014, 0.0021]
    for seconds in headers then voice.header.add(seconds * rate)
    for angle in voice.firing {
        voice.age.add(-1.0)
        voice.strength.add(0.0)
    }
    voice.headers = delayLine((0.004 * rate) as Int)
    voice.pipeDelay = 2.2 / 343.0 * rate
    voice.pipe = delayLine((voice.pipeDelay as Int) + 4)
    voice.chamberLow.peak(95.0, 1.1, 6.0, rate)
    voice.chamberHigh.peak(330.0, 1.4, 4.0, rate)
    voice.silencer.lowpass(4200.0, 0.7, rate)
    voice.tailpipe.highpass(28.0, 0.7, rate)
    voice.intakeBand.bandpass(900.0, 1.2, rate)
    voice.tickBand.bandpass(3900.0, 3.0, rate)
    voice.popBand.bandpass(600.0, 1.0, rate)
    voice.turbo = false
    voice.breathRpm = 2700.0
    voice.popRpm = 2100.0
    voice.popOdds = 0.97
    voice.gain = 0.5
    return take voice
}

/**
 * A propeller's own sound: each blade passing pushes the air once - a
 * pressure pulse that sharpens into a buzz as the tips go faster - with a
 * little unevenness between blades (heard at the shaft's rate), and the
 * broadband hiss of the air leaving the tips.
 */
pack PropellerVoice {
    var rate: Double = 48000.0
    var blades: Int = 2
    var phase: Double = 0.0
    var rpm: Double = 0.0
    var hiss: Noise = noise(71)
    var tipBand: Biquad = .()
    var body: Biquad = .()
}

func propellerVoice(blades: Int, rate: Double): PropellerVoice {
    var voice: PropellerVoice = .(rate: rate, blades: if blades < 1 then 1 else blades)
    voice.tipBand.bandpass(1500.0, 0.8, rate)
    voice.body.lowpass(2400.0, 0.7, rate)
    return take voice
}

/** Adds [frames] samples of the propeller turning at [rpm] (gliding from the last block's), pulling with [load] 0..1. */
func PropellerVoice!.render(into: Long, frames: Int, rpm: Double, load: Double) {
    fin startRpm = if self.rpm > 0.0 then self.rpm else rpm
    var i = 0
    while i < frames {
        fin t = ((i + 1) as Double) / (frames as Double)
        fin speed = startRpm + (rpm - startRpm) * t
        fin shaft = speed / 60.0
        self.phase += 2.0 * PI * shaft / self.rate
        if self.phase > 2.0 * PI then self.phase -= 2.0 * PI
        fin passing = self.phase * (self.blades as Double)
        // Tip speed sets how sharp each blade's pulse is and how loud: it grows steeply with the rpm.
        fin tip = dspClamp(speed / 2700.0, 0.0, 1.3)
        fin sharp = 2.0 + 10.0 * tip * tip
        fin pulse = exp(sharp * (cos(passing) - 1.0)) - 1.0 / (1.0 + sharp)
        fin uneven = 1.0 + 0.08 * sin(self.phase)
        fin loud = tip * tip * tip * (0.45 + 0.55 * dspClamp(load, 0.0, 1.0))
        var sound = self.body.process(pulse * uneven) * loud * 0.55
        sound += self.tipBand.process(self.hiss.white()) * loud * tip * 0.12
        addSample(into, i, sound)
        i++
    }
    self.rpm = rpm
}

/**
 * The water around a moving hull: the bow's wave hissing and the spray
 * breaking off its sides, louder and brighter with speed and unsteady with
 * the sea; and the slap of small waves on the hull at rest.
 */
pack WakeVoice {
    var rate: Double = 48000.0
    var pink: PinkNoise = .()
    var white: Noise = noise(4099)
    var spray: Biquad = .()
    var wash: Biquad = .()
    var slap: Biquad = .()
    var gust: OnePole = .()
    var slapLevel: Double = 0.0
}

func wakeVoice(rate: Double): WakeVoice {
    var voice: WakeVoice = .(rate: rate, pink: pinkNoise(2711))
    voice.spray.bandpass(2600.0, 0.7, rate)
    voice.wash.bandpass(420.0, 0.6, rate)
    voice.slap.bandpass(260.0, 1.4, rate)
    voice.gust.tune(3.0, rate)
    return take voice
}

/** Adds [frames] samples of water past a hull moving [speed] m/s, [wet] of its bottom in the water. */
func WakeVoice!.render(into: Long, frames: Int, speed: Double, wet: Double) {
    fin moving = dspClamp(dspAbs(speed) / 14.0, 0.0, 1.4)
    var i = 0
    while i < frames {
        fin pink = self.pink.next()
        fin bright = self.white.white()
        // The sea's own unevenness: the spray swells and fades a few times a second.
        fin swell = 0.6 + 0.8 * dspClamp(0.5 + 4.0 * self.gust.lowpass(bright), 0.0, 1.0)
        var sound = self.spray.process(bright) * moving * moving * swell * 0.16 * wet
        sound += self.wash.process(pink) * (0.05 + moving * 0.6) * wet * 0.35
        // At rest, now and then, a wavelet knocks the hull.
        if self.white.white() > 0.99985 then self.slapLevel = 0.5 + 0.5 * dspAbs(self.white.white())
        self.slapLevel *= 0.9993
        sound += self.slap.process(pink * self.slapLevel) * (1.0 - dspClamp(moving * 2.0, 0.0, 1.0)) * 0.6 * wet
        addSample(into, i, sound)
        i++
    }
}

/** The pressure a pulse [age] degrees after its valve opened pushes: a steep rise, a longer fall. */
func pulseShape(age: Double): Double {
    if age < 0.0 || age >= pulseDegrees then return 0.0
    fin x = age / pulseDegrees
    fin rise = if x < 0.18 then x / 0.18 else 1.0
    fin hump = sin(PI * x)
    return rise * hump * hump * (1.0 - 0.45 * x)
}

/**
 * Adds [frames] samples of the engine into [into], gliding from where the
 * last block left off to [rpm], [load] and [throttle], so a block boundary
 * never steps. [limiter]: the fuel is cut on alternate cycles.
 */
func EngineVoice!.render(into: Long, frames: Int, rpm: Double, load: Double, throttle: Double, limiter: Bool) {
    fin startRpm = if self.rpm > 0.0 then self.rpm else rpm
    fin startLoad = self.load
    fin startThrottle = self.throttle
    self.limiter = limiter
    fin cylinders = self.firing.size
    var i = 0
    while i < frames {
        fin t = ((i + 1) as Double) / (frames as Double)
        fin speed = startRpm + (rpm - startRpm) * t
        fin pressure = startLoad + (load - startLoad) * t
        fin pedal = startThrottle + (throttle - startThrottle) * t
        fin advance = speed * 6.0 / self.rate
        fin before = self.crank
        self.crank += advance
        if self.crank >= 720.0 {
            self.crank -= 720.0
            self.cycles++
        }
        // A cylinder whose firing angle the crank just passed opens its exhaust.
        var exhaust: Double = 0.0
        for c: Int in 0..<cylinders {
            fin angle = self.firing[c]
            fin crossed = if self.crank >= before then before < angle && self.crank >= angle else before < angle || self.crank >= angle
            if crossed {
                fin cut = self.limiter && self.cycles % 2 == 1
                fin variation = 1.0 + 0.08 * self.noise.white()
                fin power = if cut then 0.04 else (0.22 + 0.78 * pressure) * variation
                // Overrun: a shut throttle at speed burns what is left in the exhaust, now and then.
                if pedal <= 0.01 && speed > self.popRpm && self.noise.white() > self.popOdds {
                    self.popLevel = 0.9 + 0.4 * self.noise.white()
                }
                self.age[c] = 0.0
                self.strength[c] = power
            } else if self.age[c] >= 0.0 {
                self.age[c] += advance
                if self.age[c] >= pulseDegrees then self.age[c] = -1.0
            }
            exhaust += self.strength[c] * pulseShape(self.age[c])
        }
        // Headers: each cylinder's pulse arrives after its own length (approximated on the summed signal by two taps).
        self.headers.push(exhaust)
        fin collected = 0.5 * self.headers.read(self.header[0]) + 0.5 * self.headers.read(self.header[cylinders - 1])
        // The pipe: what comes back from the silencer meets what goes in.
        fin ringing = collected - 0.45 * self.pipe.read(self.pipeDelay)
        self.pipe.push(ringing)
        var sound = self.chamberHigh.process(self.chamberLow.process(ringing))
        // Overrun pops: a burst of noise through the exhaust's band.
        if self.popLevel > 0.001 {
            sound += self.popBand.process(self.hiss.white() * self.popLevel) * 2.5
            self.popLevel *= 0.9975
        }
        sound = self.silencer.process(sound)
        if self.underwater {
            // Bubbles break the exhaust's note up: its loudness flutters a dozen times a second.
            fin wobble = self.bubbling.lowpass(self.hiss.white())
            self.flutter = 0.55 + 0.45 * dspClamp(1.0 + 6.0 * wobble, 0.0, 2.0) * 0.5
            sound *= self.flutter
        }
        // Intake roar rides on the throttle and the rpm.
        fin breath = speed / self.breathRpm
        sound += self.intakeBand.process(self.hiss.white()) * pedal * breath * 0.35
        // The valve train: faint ticks at the cam's rate.
        fin tick: Double = if exhaust > 0.0 && self.noise.white() > 0.995 then 1.0 else 0.0
        sound += self.tickBand.process(tick) * 0.06 * breath
        // The car's turbo spools with load and whistles above it.
        if self.turbo {
            self.boost += (pressure * breath - self.boost) * 0.00012
            self.whistle += 2.0 * PI * (2500.0 + 7000.0 * self.boost) / self.rate
            if self.whistle > 2.0 * PI then self.whistle -= 2.0 * PI
            sound += sin(self.whistle) * self.boost * 0.012
        }
        addSample(into, i, self.tailpipe.process(sound) * self.gain)
        i++
    }
    self.rpm = rpm
    self.load = load
    self.throttle = throttle
}

func EngineVoice!.release() {
    self.headers.release()
    self.pipe.release()
}

// ── Horn ────────────────────────────────────────────────────────────────

/**
 * An electric horn: a diaphragm buzzing at its pitch drives a bell that
 * favours the upper harmonics. The car sounds two detuned horns (about 420
 * and 500 Hz), the motorcycle one brighter one (about 400 Hz).
 */
pack HornVoice {
    var rate: Double = 48000.0
    var pitches: Array<Double> = []
    var phases: Array<Double> = []
    var harmonics: Int = 10
    var level: Double = 0.0
    var vibrato: Double = 0.0
    var bell: Biquad = .()
    var body: Biquad = .()
}

func hornVoice(motorcycle: Bool, rate: Double): HornVoice {
    var horn: HornVoice = .(rate: rate, harmonics: if motorcycle then 14 else 10)
    horn.pitches = if motorcycle then [400.0] else [420.0, 500.0]
    for pitch in horn.pitches then horn.phases.add(0.0)
    horn.bell.peak(if motorcycle then 2600.0 else 2100.0, 1.5, 6.0, rate)
    horn.body.highpass(180.0, 0.7, rate)
    return take horn
}

/** Adds [frames] samples of the horn into [into]: it sounds while [held], rising in 8 ms and dying in 40 ms. */
func HornVoice!.render(into: Long, frames: Int, held: Bool) {
    fin attack = 1.0 / (0.008 * self.rate)
    fin release = 1.0 / (0.040 * self.rate)
    var i = 0
    while i < frames {
        self.level = if held then (if self.level + attack > 1.0 then 1.0 else self.level + attack) else (if self.level - release < 0.0 then 0.0 else self.level - release)
        if self.level <= 0.0 {
            // Silent: keep the filters still, so the next press starts clean.
            addSample(into, i, 0.0)
            i++
            continue
        }
        self.vibrato += 2.0 * PI * 5.5 / self.rate
        if self.vibrato > 2.0 * PI then self.vibrato -= 2.0 * PI
        fin wobble = 1.0 + 0.003 * sin(self.vibrato)
        var buzz: Double = 0.0
        for p: Int in 0..<self.pitches.size {
            fin pitch = self.pitches[p] * wobble
            var phase = self.phases[p] + 2.0 * PI * pitch / self.rate
            if phase > 2.0 * PI then phase -= 2.0 * PI
            self.phases[p] = phase
            var n = 1
            while n <= self.harmonics && (n as Double) * pitch < 9000.0 {
                buzz += sin(phase * (n as Double)) / (n as Double)
                n++
            }
        }
        fin shaped = self.bell.process(self.body.process(buzz * 0.35))
        // The diaphragm saturates: a soft clip.
        fin clipped = shaped / (1.0 + (if shaped < 0.0 then -shaped else shaped))
        addSample(into, i, clipped * self.level * 0.6)
        i++
    }
}
