/**
 * @file engine.media
 *
 * Container-neutral contracts shared by audio and video.
 *
 * Providers own demuxing and decoding. The rest of the engine only sees stable
 * stream ids, rational timestamps, metadata and provider capabilities, so a
 * bundled FFmpeg provider and a platform hardware provider can be selected
 * without changing player code.
 */
module engine.media

import std.container.array
import engine.io

/** Stable identity of one stream inside a media source. */
pack StreamId {
    fin value: Int
}

/** Stable identity of a user-facing track assembled from one or more streams. */
pack TrackId {
    fin value: Int
}

/**
 * A timestamp represented exactly as `value / scale` seconds.
 *
 * Keeping decoder timestamps rational avoids accumulating floating-point drift
 * during long playback and preserves the time bases found in media containers.
 */
pack MediaTime {
    fin ticks: Long
    fin timeBaseNum: Int
    fin timeBaseDen: Int
}

/** Zero seconds in the engine's default microsecond time base. */
func mediaTimeZero(): MediaTime = .(0, 1, 1000000)

/** Builds a timestamp in a `1 / scale` time base. */
func mediaTime(value: Long, scale: Int): MediaTime = if scale <= 0 then .(value, 1, 1000000) else .(value, 1, scale)

/** Converts seconds to the default microsecond time base. */
func mediaTimeSeconds(seconds: Double): MediaTime = .((seconds * 1000000.0) as Long, 1, 1000000)

/** Converts seconds to a provider's native time base. */
func mediaTimeFromSecs(seconds: Double, timeBaseNum: Int, timeBaseDen: Int): MediaTime {
    if timeBaseNum <= 0 || timeBaseDen <= 0 then return mediaTimeSeconds(seconds)
    fin ticks = (seconds * (timeBaseDen as Double) / (timeBaseNum as Double)) as Long
    return .(ticks, timeBaseNum, timeBaseDen)
}

/** Converts a timestamp to seconds for presentation and user interfaces. */
func mediaTimeSecs(time: MediaTime&): Double {
    if time.timeBaseNum <= 0 || time.timeBaseDen <= 0 then return 0.0
    return (time.ticks as Double) * (time.timeBaseNum as Double) / (time.timeBaseDen as Double)
}

/** Compatibility spelling retained for engine internals. */
func mediaTimeAsSeconds(time: MediaTime&): Double = mediaTimeSecs(time)

/** Converts [time] to another rational time base. */
func mediaTimeRescale(time: MediaTime&, scale: Int): MediaTime {
    if scale <= 0 || time.timeBaseNum <= 0 || time.timeBaseDen <= 0 then return mediaTimeZero()
    fin numerator = time.ticks * (time.timeBaseNum as Long) * (scale as Long)
    return .(numerator / (time.timeBaseDen as Long), 1, scale)
}

/** Adds timestamps without first converting them to floating point. */
func mediaTimeAdd(left: MediaTime&, right: MediaTime&): MediaTime {
    if left.timeBaseNum <= 0 || left.timeBaseDen <= 0 then return mediaTimeZero()
    fin numerator = right.ticks * (right.timeBaseNum as Long) * (left.timeBaseDen as Long)
    fin denominator = (right.timeBaseDen as Long) * (left.timeBaseNum as Long)
    return .(left.ticks + numerator / denominator, left.timeBaseNum, left.timeBaseDen)
}

/** Subtracts timestamps without first converting them to floating point. */
func mediaTimeSubtract(left: MediaTime&, right: MediaTime&): MediaTime {
    if left.timeBaseNum <= 0 || left.timeBaseDen <= 0 then return mediaTimeZero()
    fin numerator = right.ticks * (right.timeBaseNum as Long) * (left.timeBaseDen as Long)
    fin denominator = (right.timeBaseDen as Long) * (left.timeBaseNum as Long)
    return .(left.ticks - numerator / denominator, left.timeBaseNum, left.timeBaseDen)
}

/** Returns a negative value, zero, or a positive value according to ordering. */
func mediaTimeCompare(left: MediaTime&, right: MediaTime&): Int {
    fin leftValue = left.ticks * (left.timeBaseNum as Long) * (right.timeBaseDen as Long)
    fin rightValue = right.ticks * (right.timeBaseNum as Long) * (left.timeBaseDen as Long)
    return when {
        leftValue < rightValue -> -1
        leftValue > rightValue -> 1
        else -> 0
    }
}

/** Restricts a timestamp to an inclusive interval. */
func mediaTimeClamp(value: MediaTime&, minimum: MediaTime&, maximum: MediaTime&): MediaTime {
    return when {
        mediaTimeCompare(value, minimum) < 0 -> .(minimum.ticks, minimum.timeBaseNum, minimum.timeBaseDen)
        mediaTimeCompare(value, maximum) > 0 -> .(maximum.ticks, maximum.timeBaseNum, maximum.timeBaseDen)
        else -> .(value.ticks, value.timeBaseNum, value.timeBaseDen)
    }
}

/** A source accepted by a media provider. Byte storage remains caller-owned. */
variant enum MediaSource {
    Path(path: String)
    Bytes(bytes: Blob)
    Uri(uri: String)
}

/** Broad role of one stream in a container. */
enum MediaStreamKind {
    Video
    Audio
    Subtitle
    Attachment
    Data
}

/** Metadata common to all stream kinds, plus kind-specific physical details. */
pack MediaStreamInfo {
    fin id: StreamId
    fin kind: MediaStreamKind
    fin codec: String
    fin language: String
    fin title: String
    fin width: Int
    fin height: Int
    fin frameRate: Double
    fin sampleRate: Int
    fin channels: Int
    fin isDefault: Bool
}

/** Metadata discovered by probing a source without starting playback. */
pack MediaInfo {
    fin format: String
    fin duration: MediaTime
    fin seekable: Bool
    fin live: Bool
    fin streams: Array<MediaStreamInfo>
}

/** An empty probe result used as a safe fallback in tools and tests. */
func mediaInfoEmpty(): MediaInfo = .("", mediaTimeZero(), false, false, Array<MediaStreamInfo>())

/** Number of streams of [kind] in [info]. */
func mediaStreamCount(info: MediaInfo&, kind: MediaStreamKind): Int {
    var count = 0
    for i: Int in 0..<info.streams.size {
        if info.streams[i].kind == kind then count++
    }
    return count
}

/** True when a caller-owned byte source has storage to probe. */
func mediaBytesValid(bytes: Blob&): Bool = bytes.data != 0 && bytes.size > 0

/** True when [source] contains enough information for a provider to open it. */
func mediaSourceValid(source: MediaSource&): Bool {
    return when source {
        .Path(path) -> path != ""
        .Bytes(bytes) -> mediaBytesValid(bytes)
        .Uri(uri) -> uri != ""
    }
}

/** Provider operations rejected at the media boundary. */
error MediaError {
    InvalidSource
    UnsupportedContainer
    UnsupportedCodec
    ProviderUnavailable
    OpenFailed
    DecodeFailed
    NotSeekable
    Cancelled
}

/** Capabilities used by provider selection before a source is opened. */
pack MediaProviderCapabilities {
    fin localFiles: Bool
    fin memory: Bool
    fin network: Bool
    fin softwareDecode: Bool
    fin hardwareVideoDecode: Bool
    fin zeroCopyVideo: Bool
    fin audioDecode: Bool
    fin subtitleDecode: Bool
}

/**
 * Boundary implemented by bundled FFmpeg and platform-specific providers.
 *
 * A player selects a provider by these capabilities and then refers to streams
 * by [StreamId], never by a display name or codec string.
 */
spec MediaProvider {
    func &.name(): String
    func &.capabilities(): MediaProviderCapabilities
    func &.canOpen(source: MediaSource&): Bool
    func &.probe(source: MediaSource&): MediaInfo ?! MediaError
}

/**
 * Deterministic provider used by engine tests before native codecs are loaded.
 * It describes one H.264 video stream, one AAC stream and one subtitle stream.
 */
pack FakeMediaProvider {
    fin available: Bool
}

/** A representative movie returned by [FakeMediaProvider]. */
func fakeMovieInfo(): MediaInfo {
    var streams: Array<MediaStreamInfo> = Array::fill<MediaStreamInfo>(3)
    streams[0] = MediaStreamInfo(
        StreamId(10)
        MediaStreamKind.Video
        "h264"
        "und"
        "Picture"
        1920
        1080
        24.0
        0
        0
        true
    )
    streams[1] = MediaStreamInfo(
        StreamId(20)
        MediaStreamKind.Audio
        "aac"
        "en"
        "Main"
        0
        0
        0.0
        48000
        2
        true
    )
    streams[2] = MediaStreamInfo(
        StreamId(30)
        MediaStreamKind.Subtitle
        "ass"
        "en"
        "English"
        0
        0
        0.0
        0
        0
        false
    )
    return .("matroska", mediaTimeSeconds(120.0), true, false, streams)
}

impl MediaProvider for FakeMediaProvider {
    func &.name(): String = "azora.fake-media"

    func &.capabilities(): MediaProviderCapabilities = .(true, true, false, true, false, false, true, true)

    func &.canOpen(source: MediaSource&): Bool = self.available && mediaSourceValid(source)

    func &.probe(source: MediaSource&): MediaInfo ?! MediaError {
        return when {
            !self.available -> .ProviderUnavailable
            !self.canOpen(source) -> .InvalidSource
            else -> fakeMovieInfo()
        }
    }
}

test "media time preserves ordering across time bases" {
    fin oneSecond = mediaTime(Long(24), 24)
    fin halfSecond = mediaTime(Long(500), 1000)
    assert mediaTimeCompare(oneSecond, halfSecond) > 0 panic "one second must follow half a second"
    assert mediaTimeCompare(oneSecond, mediaTimeSeconds(1.0)) == 0 panic "equal instants must compare equally"
    assert mediaTimeAdd(halfSecond, halfSecond).ticks == 1000 panic "addition must retain the left time base"
}

test "the fake provider exposes streams by stable identity and kind" {
    fin provider: FakeMediaProvider = .(true)
    fin info = provider.probe(.Path("movie.mkv")) catch mediaInfoEmpty()
    assert info.format == "matroska" panic "the test provider must describe its container"
    assert mediaStreamCount(info, .Video) == 1 panic "the movie must have one video stream"
    assert mediaStreamCount(info, .Audio) == 1 panic "the movie must have one audio stream"
    assert info.streams[0].id.value == 10 panic "stream selection must use ids, not names"
}

test "the provider rejects an empty source" {
    fin provider: FakeMediaProvider = .(true)
    var rejected = false
    try {
        provider.probe(.Path(""))
    } catch {
        rejected = true
    }
    assert rejected panic "an empty path must not reach a decoder"
}
