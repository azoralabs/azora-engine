/**
 * Core metadata, clock, reactivity, and dependency-injection services shared
 * by every Azora Engine subsystem.
 *
 * The core package owns no renderer, window, or ECS storage. Keeping these
 * primitives small makes the same system graph usable by LLVM executables and
 * WebAssembly modules.
 */
module engine.core

/**
 * Ordered engine schedule phases.
 *
 * Systems in one phase may run in parallel when their ECS access sets do not
 * conflict. A phase completes before the next phase begins.
 */
@std::Experimental(since: "0.0.4")
enum SystemPhase {
    Startup
    PreUpdate
    Update
    PostUpdate
    FixedUpdate
    Render
    Last
}

/** Marks a pack or enum as ECS component data. */
@std::Experimental(since: "0.0.4")
annot Component for [.Pack, .Enum]

/**
 * Marks a function as an engine system, which is all it takes to schedule it.
 *
 * The engine finds `@System` functions by compile-time reflection, so there is
 * no registration step and nothing to keep in step with this decorator — what
 * is written here *is* the schedule. A scheduled system takes the world and
 * nothing else: `func movement(world: World!)`.
 *
 * Ordering is declared rather than implied by declaration order. `runBefore`
 * and `runAfter` name other systems and are resolved into a topological order
 * once, which is what lets two packages each contribute systems without either
 * knowing where the other sits in the frame. `order` is the tie-break among
 * systems no constraint separates.
 *
 * @param phase Schedule phase in which the system executes.
 * @param order Stable tie-break among systems no constraint separates.
 * @param runBefore Comma-separated names of systems this one must precede.
 * @param runAfter Comma-separated names of systems this one must follow.
 * @param inSet Name of the system set this belongs to; sets order as a unit.
 */
@std::Experimental(since: "0.0.4")
annot System for .Func {
    fin phase: SystemPhase = SystemPhase.Update
    fin order: std::Int = 0
    fin runBefore: std::String = ""
    fin runAfter: std::String = ""
    fin inSet: std::String = ""
}

/**
 * Marks a pack as an ECS event.
 *
 * An event is written by one system and read by any number of others, and
 * survives exactly one frame past the one it was sent in — long enough for a
 * reader scheduled earlier in the frame to still see it, short enough that a
 * queue nobody drains cannot grow without bound.
 */
@std::Experimental(since: "0.0.4")
annot Event for [.Pack, .Enum]

/**
 * Marks a pack as an ECS relationship between two entities.
 *
 * A relation is directed and indexed both ways, so "who is my parent" and "who
 * are my children" are both constant-time without either side storing a list
 * the other has to keep in step.
 */
@std::Experimental(since: "0.0.4")
annot Relation for .Pack

/** Marks a pack as application-wide ECS resource data. */
@std::Experimental(since: "0.0.4")
annot Resource for .Pack

/** Marks a function parameter whose component access is query-derived. */
@std::Experimental(since: "0.0.4")
annot Query for .Param

/**
 * Frame clock injected into systems through `time: res Time`.
 *
 * `deltaSecs` is the clamped variable timestep. `fixedDeltaSecs` is the
 * deterministic simulation step used by `.FixedUpdate`.
 */
@std::Experimental(since: "0.0.4")
pack Time {
    var deltaSecs: std::Double
    var elapsedSecs: std::Double
    var fixedDeltaSecs: std::Double
    var frame: std::Long
}

/** Creates a clock with a 60 Hz fixed timestep. */
@std::Experimental(since: "0.0.4")
func timeInit(): Time {
    return Time(0.0, 0.0, 1.0 / 60.0, 0L)
}

impl Time {
    /**
     * Advances the clock by one rendered frame.
     *
     * Large deltas are clamped to 250 ms so a paused debugger or suspended tab
     * cannot destabilize physics when execution resumes.
     */
    func advance[self: Self!](deltaSecs: std::Double) {
        var clamped = deltaSecs
        if clamped < 0.0 {
            clamped = 0.0
        }
        if clamped > 0.25 {
            clamped = 0.25
        }
        self.deltaSecs = clamped
        self.elapsedSecs = self.elapsedSecs + clamped
        self.frame = self.frame + 1
    }

    /** Replaces the deterministic fixed timestep. */
    func setFixedDelta[self: Self!](seconds: std::Double) {
        assert seconds > 0.0 { "fixed timestep must be positive" }
        self.fixedDeltaSecs = seconds
    }
}

/**
 * Revisioned state shared by ECS resources and retained UI state.
 *
 * Reads are allocation-free. Writes increment `revision`, allowing systems and
 * UI hosts to skip work when the observed value did not change.
 */
@std::Experimental(since: "0.0.4")
pack Signal<T> {
    var value: T
    var revision: std::Long
}

func signalInit<T>(value: T): Signal<T> {
    return Signal<T>(value, 0L)
}

func signalGet<T>(signal: Signal<T>&): T {
    return signal.value
}

func signalSet<T>(signal: Signal<T>!, value: T) {
    signal.value = value
    signal.revision = signal.revision + 1
}

func signalVersion<T>(signal: Signal<T>&): std::Long {
    return signal.revision
}

func signalChangedSince<T>(signal: Signal<T>&, version: std::Long): std::Bool {
    return signal.revision != version
}

/**
 * Shared engine registry provided by the default dependency-injection wrap.
 *
 * Subsystems increment `loadedModules` during installation. The scheduler uses
 * `frameIndex` and `worldRevision` as cheap change tokens.
 */
solo pack EngineRegistry {
    var loadedModules: std::Int = 0
    var frameIndex: std::Long = 0
    var worldRevision: std::Long = 0
}

impl EngineRegistry {
    func markModuleLoaded[self: Self!]() {
        self.loadedModules = self.loadedModules + 1
    }

    func nextFrame[self: Self!]() {
        self.frameIndex = self.frameIndex + 1
    }

    func markWorldChanged[self: Self!]() {
        self.worldRevision = self.worldRevision + 1
    }
}

/** Shared frame clock resolved by `inject EngineClock`. */
solo pack EngineClock {
    var value: Time = timeInit()
}

impl EngineClock {
    func advance[self: Self!](deltaSecs: std::Double) {
        self.value.advance(deltaSecs)
    }
}

/**
 * Base dependency graph for engine applications.
 *
 * Higher-level wraps compose this one and register platform, input, renderer,
 * ECS, and UI services without dynamic plugin objects.
 */
graph AzEngine {
    solo EngineRegistry
    solo EngineClock
}
