/**
 * Core metadata, clock, reactivity, and dependency-injection services shared
 * by every Azora Engine subsystem.
 *
 * The core package owns no renderer, window, or ECS storage. Keeping these
 * primitives small makes the same system graph usable by LLVM executables and
 * WebAssembly modules.
 */
module engine.core
import std.time
import std.traits
import engine.io

/**
 * The block a builder takes: reactive, and capturing what it reads.
 *
 * `Column(…) @children { … }` is `Column(…) react [; &] { … }`. Reactive
 * because a widget's block may hold `remember` or an `effect`; capturing
 * because a block almost always reads the scope around it, and writing the
 * capture list on every one of them is noise rather than information.
 *
 * A source fragment rather than an arm: `react [; &]` is a pair of markers the
 * following lambda carries, not an expression a template could rewrite.
 */
@Experimental(since: "0.1")
macro @children => inline "react [; &]"

/**
 * Ordered engine schedule phases.
 *
 * Systems in one phase may run in parallel when their ECS access sets do not
 * conflict. A phase completes before the next phase begins.
 */
@Experimental(since: "0.1")
enum SystemPhase {
    Startup
    PreUpdate
    Update
    PostUpdate
    FixedUpdate
    /** Inside the 3D view, before the opaque scene: a system that draws the sky claims it with `App.beginCustomSky`. */
    RenderSky
    /** Into the sun's sharp shadow cascade (`AzGpu.casting` is set): what casts shadows draws its depth, from the sun. */
    RenderShadow
    /** With the opaque scene, after the built-in meshes, terrain and roads: depth tested and written (water, plants, road furniture). */
    RenderOpaque
    /** After the opaque scene, its encoder ended: passes that read the scene's colour and depth and draw over it (fog, clouds). */
    RenderVolumes
    /** After the view is reconstructed, at full resolution: blended effects tested against the scene's depth (rain, snow). */
    RenderTransparent
    Render
    /** After drawing: audio systems mix this frame's sound (it runs while paused too). */
    Audio
    Last
}

/**
 * How often a system runs.
 *
 * `Every` follows the game clock and *drops* missed firings: a frame that
 * overruns its interval runs the system once, not once per interval elapsed.
 * `Fixed` is the opposite and is why both exist - it drains the simulation
 * accumulator, so it may run several times in one rendered frame, which is what
 * determinism requires of physics.
 *
 * Frame-counted variants are deterministic where the timed ones are not:
 * "every fourth frame" staggers expensive work without drifting with the frame
 * rate, which "every 60 milliseconds" does.
 */
@Experimental(since: "0.1")
variant enum SystemInterval {
    /** Once per frame. The default, and what most systems want. */
    EveryFrame
    /** Periodically, on the game clock; missed firings are dropped. */
    Every(Duration)
    /** Every *n*th frame, counted rather than timed. */
    EveryFrames(Int)
    /** The first time the phase runs, and never again. */
    Once
    /** Once, after the delay has elapsed. */
    After(Duration)
    /** Once, after that many frames. */
    AfterFrames(Int)
    /** At a fixed simulation step, draining the accumulator. */
    Fixed(Duration)
}

/** Marks a pack or enum as ECS component data. */
@Experimental(since: "0.1")
annot @Component for (.Pack, .Enum)

/**
 * Marks a function as an engine system, which is all it takes to schedule it.
 *
 * The engine finds `@System` functions by compile-time reflection, so there is
 * no registration step and nothing to keep in step with this decorator — what
 * is written here *is* the schedule. A scheduled system takes the world and
 * nothing else: `func movement(world: World!)`.
 *
 * Ordering is declared rather than implied by declaration order. `runBefore`
 * and `runAfter` name other systems and are resolved into a topological order
 * once, which is what lets two packages each contribute systems without either
 * knowing where the other sits in the frame. `order` is the tie-break among
 * systems no constraint separates.
 *
 * @param phase Schedule phase in which the system executes.
 * @param order Stable tie-break among systems no constraint separates.
 * @param runBefore Comma-separated names of systems this one must precede.
 * @param runAfter Comma-separated names of systems this one must follow.
 * @param inSet Name of the system set this belongs to; sets order as a unit.
 */
@Experimental(since: "0.1")
@DeclaresAccess
annot @System for (.Func, .AsyncFunc) {
    fin phase: SystemPhase = .Update
    /**
     * How often the system runs within its phase.
     *
     * Not read on `.Startup`: that phase runs once, before the first frame, so
     * how often has nothing to measure there. An interval written on a startup
     * system is ignored rather than obeyed - the phase decides, and a rule that
     * only the documentation kept would be a rule in name.
     */
    fin interval: SystemInterval = when phase {
        .Startup -> seal .Once
        else -> .EveryFrame
    }
    fin order: Int = 0
    fin runBefore: String = ""
    fin runAfter: String = ""
    fin inSet: String = ""
    /**
     * Whether the system also runs in an editor's viewport (Azora Studio) on
     * the scene being edited, not only in the game: what draws a feature and
     * what keeps its preview alive (weather easing, a sea developing, seasons
     * turning). Gameplay leaves it false. An editor system is not `react`.
     */
    fin editor: Bool = false
    /** An editor update that also synchronizes authored data or rendering while preview time is stopped. */
    fin editorWhilePaused: Bool = false
}

/**
 * Marks a pack as an ECS event.
 *
 * An event is written by one system and read by any number of others, and
 * survives exactly one frame past the one it was sent in — long enough for a
 * reader scheduled earlier in the frame to still see it, short enough that a
 * queue nobody drains cannot grow without bound.
 */
@Experimental(since: "0.1")
annot @Event for (.Pack, .Enum)

/**
 * Marks a pack as an ECS relationship between two entities.
 *
 * A relation is directed and indexed both ways, so "who is my parent" and "who
 * are my children" are both constant-time without either side storing a list
 * the other has to keep in step.
 */
@Experimental(since: "0.1")
annot @Relation for .Pack

/** Marks a pack as application-wide ECS resource data. */
@Experimental(since: "0.1")
annot @Resource for .Pack

/** Marks a function parameter whose component access is query-derived. */
@Experimental(since: "0.1")
annot @Query for .Param

/**
 * Frame clock injected into systems through `time: res Time`.
 *
 * `deltaSecs` is the clamped variable timestep. `fixedDeltaSecs` is the
 * deterministic simulation step used by `.FixedUpdate`.
 */
@Experimental(since: "0.1")
pack Time {
    var deltaSecs: Double
    var elapsedSecs: Double
    var fixedDeltaSecs: Double
    var frame: Long
    /**
     * True while an editor's viewport runs the systems on the scene it edits:
     * what eases toward a setting in play (a sea building up under its wind)
     * shows the setting at once, as the author changes it.
     */
    var editing: Bool = false
    /**
     * The time at the end of the fixed step being simulated: [elapsedSecs]
     * belongs to the frame, which may run several steps (or none), so what a
     * step samples over time (the sea under a hull) reads this instead.
     */
    var fixedElapsedSecs: Double = 0.0
}

/** Creates a clock with a 60 Hz fixed timestep. */
@Experimental(since: "0.1")
func timeInit(): Time = .(0.0, 0.0, 1.0 / 60.0, 0)

impl Time {
    /**
     * Advances the clock by one rendered frame.
     *
     * Large deltas are clamped to 250 ms so a paused debugger or suspended tab
     * cannot destabilize physics when execution resumes.
     */
    func !.advance(deltaSecs: Double) {
        var clamped = deltaSecs
        if clamped < 0.0 then clamped = 0.0
        if clamped > 0.25 then clamped = 0.25
        self.deltaSecs = clamped
        self.elapsedSecs += clamped
        self.frame++
    }

    /** Moves [fixedElapsedSecs] on by one fixed step, before that step's systems run. */
    func !.beginFixedStep()
    scope self.fixedElapsedSecs += self.fixedDeltaSecs

    /** Replaces the deterministic fixed timestep. */
    func !.setFixedDelta(seconds: Double)
    in assert seconds > 0.0 panic "fixed timestep must be positive"
    scope self.fixedDeltaSecs = seconds
}

/**
 * Revisioned state shared by ECS resources and retained UI state.
 *
 * Reads are allocation-free. Writes increment `revision`, allowing systems and
 * UI hosts to skip work when the observed value did not change.
 */
@Experimental(since: "0.1")
pack Signal<T> {
    var value: T
    var revision: Long
}

func<T> signalInit(value: T): Signal<T> = .(value, 0)

func<T> signalGet(signal: Signal<T>&): T = signal.value

func<T> signalSet(signal: Signal<T>!, value: T) {
    signal.value = value
    signal.revision++
}

func<T> signalVersion(signal: Signal<T>&): Long = signal.revision

func<T> signalChangedSince(signal: Signal<T>&, version: Long): Bool = signal.revision != version

/**
 * Shared engine registry provided by the default dependency-injection wrap.
 *
 * Subsystems increment `loadedModules` during installation. The scheduler uses
 * `frameIndex` and `worldRevision` as cheap change tokens.
 */
solo pack EngineRegistry {
    var loadedModules: Int = 0
    var frameIndex: Long = 0
    var worldRevision: Long = 0
}

impl EngineRegistry {
    func !.markModuleLoaded() scope self.loadedModules++

    func !.nextFrame() scope self.frameIndex++

    func !.markWorldChanged() scope self.worldRevision++
}

/** Shared frame clock resolved by `inject EngineClock`. */
solo pack EngineClock {
    var value: Time = timeInit()
}

impl EngineClock {
    func !.advance(deltaSecs: Double) scope self.value.advance(deltaSecs)
}

/**
 * Base dependency graph for engine applications.
 *
 * Higher-level wraps compose this one and register platform, input, renderer,
 * ECS, and UI services without dynamic plugin objects.
 */
graph AzEngine {
    solo EngineRegistry
    solo EngineClock
}

/**
 * Application lifetime, reachable from anywhere.
 *
 * `App.quit()` needs the window; an `effect` does not have one. A reactive
 * body that decides the program is over — `effect mustClose == true { exit() }`
 * — should not have to reach through the UI tree to a platform object it
 * otherwise never touches. These two functions are that decision, expressed
 * where any code can state it and the frame loop can observe it.
 *
 * The request is one-way: `exit()` asks the running application to stop, and
 * nothing clears it. It is not the process exiting — the frame loop still ends
 * the current frame, so teardown, saves and disposal all run normally.
 */
/** Ask the running application to close. Idempotent. */
@Experimental(since: "0.1")
func exit() {
    azRequestExit()
}

/** Whether `exit()` has been called. The frame loop's stop condition. */
@Experimental(since: "0.1")
func exitRequested(): Bool = azExitRequested() != 0

/**
 * A colour with straight alpha, each channel 0..1.
 *
 * The one colour value the Engine passes around: a component's tint, a theme
 * token, a UI style. Packages that draw convert it at the edge.
 */
pack Rgba derives (Copy, Clone) {
    var r: Double = 1.0
    var g: Double = 1.0
    var b: Double = 1.0
    var a: Double = 1.0
}

impl Rgba {
    /** The same colour at [alpha] opacity. */
    func &.withAlpha(alpha: Double): Rgba = .(self.r, self.g, self.b, alpha)
}
