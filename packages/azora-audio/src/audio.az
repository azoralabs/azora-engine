module engine.audio

import engine.objc
import engine.io
import std.math
exposed import engine.media
exposed import engine.audio.runtime

/**
 * @file engine/audio/audio
 *
 * Lightweight native scene audio authored entirely in Azora. Waveforms are
 * generated as PCM at startup, copied into native audio players, and then
 * controlled through a small soundtrack/engine/effects mixer.
 */

pack AudioScene {
    var soundtrack: Long
    var engineLoop: Long
    var crashEffect: Long
    var running: Bool
}

scope engine::audio {
    fin sampleRate = 22050
    fin SOUNDTRACK = 0
    fin engineLoop = 1
    fin crashEffect = 2

    func clamp(value: Double, lo: Double, hi: Double): Double {
        if value < lo { return lo }
        if value > hi { return hi }
        return value
    }

    func pokeWaveHeader(bytes: Long, dataSize: Int) {
        azPoke8(bytes, Long(0), 82)
        azPoke8(bytes, Long(1), 73)
        azPoke8(bytes, Long(2), 70)
        azPoke8(bytes, Long(3), 70)
        azPoke32(bytes, Long(4), dataSize + 36)
        azPoke8(bytes, Long(8), 87)
        azPoke8(bytes, Long(9), 65)
        azPoke8(bytes, Long(10), 86)
        azPoke8(bytes, Long(11), 69)
        azPoke8(bytes, Long(12), 102)
        azPoke8(bytes, Long(13), 109)
        azPoke8(bytes, Long(14), 116)
        azPoke8(bytes, Long(15), 32)
        azPoke32(bytes, Long(16), 16)
        azPoke8(bytes, Long(20), 1)
        azPoke8(bytes, Long(21), 0)
        azPoke8(bytes, Long(22), 1)
        azPoke8(bytes, Long(23), 0)
        azPoke32(bytes, Long(24), sampleRate)
        azPoke32(bytes, Long(28), sampleRate * 2)
        azPoke8(bytes, Long(32), 2)
        azPoke8(bytes, Long(33), 0)
        azPoke8(bytes, Long(34), 16)
        azPoke8(bytes, Long(35), 0)
        azPoke8(bytes, Long(36), 100)
        azPoke8(bytes, Long(37), 97)
        azPoke8(bytes, Long(38), 116)
        azPoke8(bytes, Long(39), 97)
        azPoke32(bytes, Long(40), dataSize)
    }

    func pokeSample(bytes: Long, frame: Int, value: Double) {
        var sample = (clamp(value, -1.0, 1.0) * 28000.0) as Int
        if sample < 0 { sample = sample + 65536 }
        fin offset = Long(44) + (frame * 2) as Long
        azPoke8(bytes, offset, sample % 256)
        azPoke8(bytes, offset + Long(1), (sample / 256) % 256)
    }

    func soundtrackSample(frame: Int): Double {
        fin t = (frame as Double) / (sampleRate as Double)
        fin section = (frame / (sampleRate * 2)) % 4
        var root = 55.0
        if section == 1 { root = 65.41 }
        if section == 2 { root = 73.42 }
        if section == 3 { root = 49.0 }
        var chord = sin(t * PI * 2.0 * root) * 0.34
        chord = chord + sin(t * PI * 2.0 * root * 1.5) * 0.18
        chord = chord + sin(t * PI * 2.0 * root * 2.0) * 0.11
        fin beatFrame = frame % (sampleRate / 2)
        var beat = 0.0
        if beatFrame < 1500 {
            fin envelope = 1.0 - (beatFrame as Double) / 1500.0
            beat = sin(t * PI * 2.0 * 44.0) * envelope * 0.30
        }
        return (chord + beat) * 0.62
    }

    func engineSample(frame: Int): Double {
        fin t = (frame as Double) / (sampleRate as Double)
        fin fundamental = sin(t * PI * 2.0 * 78.0) * 0.48
        fin combustion = sin(t * PI * 2.0 * 156.0) * 0.24
        fin mechanical = sin(t * PI * 2.0 * 312.0) * 0.10
        return fundamental + combustion + mechanical
    }

    func crashSample(frame: Int, frameCount: Int): Double {
        fin t = (frame as Double) / (frameCount as Double)
        fin noise = ((((frame * 97) % 200) - 100) as Double) / 100.0
        fin metal = sin((frame as Double) * 0.37) * 0.35
        fin envelope = (1.0 - t) * (1.0 - t)
        return (noise * 0.72 + metal) * envelope
    }

    func wavePlayer(kind: Int): Long {
        var frameCount = sampleRate
        if kind == SOUNDTRACK { frameCount = sampleRate * 8 }
        if kind == crashEffect { frameCount = (sampleRate * 45) / 100 }
        fin dataSize = frameCount * 2
        fin totalSize = dataSize + 44
        fin bytes = azAlloc(totalSize as Long)
        pokeWaveHeader(bytes, dataSize)

        var frame = 0
        while frame < frameCount {
            var sample = 0.0
            if kind == SOUNDTRACK { sample = soundtrackSample(frame) }
            if kind == engineLoop { sample = engineSample(frame) }
            if kind == crashEffect { sample = crashSample(frame, frameCount) }
            pokeSample(bytes, frame, sample)
            frame = frame + 1
        }

        fin data = send2(cls("NSData"), sel("dataWithBytes:length:"), bytes, totalSize as Long)
        fin player = send2(send0(cls("AVAudioPlayer"), sel("alloc")), sel("initWithData:error:"), data, Long(0))
        azFree(bytes)
        if player != Long(0) {
            send1(player, sel("setEnableRate:"), Long(1))
            send0(player, sel("prepareToPlay"))
        }
        return player
    }

    func scene(): AudioScene {
        return AudioScene(wavePlayer(SOUNDTRACK), wavePlayer(engineLoop), wavePlayer(crashEffect), false)
    }

    func start(scene: AudioScene) {
        if scene.soundtrack != Long(0) {
            send1(scene.soundtrack, sel("setNumberOfLoops:"), Long(1000000))
            fin volume = azSendFloat1(scene.soundtrack, sel("setVolume:"), 0.20)
            send0(scene.soundtrack, sel("play"))
        }
        if scene.engineLoop != Long(0) {
            send1(scene.engineLoop, sel("setNumberOfLoops:"), Long(1000000))
            fin volume = azSendFloat1(scene.engineLoop, sel("setVolume:"), 0.0)
            fin rate = azSendFloat1(scene.engineLoop, sel("setRate:"), 0.72)
            send0(scene.engineLoop, sel("play"))
        }
        scene.running = true
    }

    func updateEngine(scene: AudioScene, speed: Double, throttle: Double, maxSpeed: Double) {
        if !scene.running || scene.engineLoop == Long(0) { return }
        fin speedRatio = clamp(speed / maxSpeed, 0.0, 1.0)
        fin load = clamp(throttle, 0.0, 1.0)
        fin volume = clamp(0.035 + speedRatio * 0.34 + load * 0.22, 0.0, 0.58)
        fin rate = 0.72 + speedRatio * 1.20 + load * 0.16
        fin unusedVolume = azSendFloat1(scene.engineLoop, sel("setVolume:"), volume)
        fin unusedRate = azSendFloat1(scene.engineLoop, sel("setRate:"), rate)
    }

    func playCrash(scene: AudioScene, strength: Double) {
        if scene.crashEffect == Long(0) { return }
        fin restart = azSendF1(scene.crashEffect, sel("setCurrentTime:"), 0.0)
        fin volume = azSendFloat1(scene.crashEffect, sel("setVolume:"), clamp(strength, 0.18, 1.0))
        send0(scene.crashEffect, sel("play"))
    }

    func stop(scene: AudioScene) {
        if scene.soundtrack != Long(0) { send0(scene.soundtrack, sel("stop")) }
        if scene.engineLoop != Long(0) { send0(scene.engineLoop, sel("stop")) }
        if scene.crashEffect != Long(0) { send0(scene.crashEffect, sel("stop")) }
        scene.running = false
    }
}

// ── Sample playback ──────────────────────────────────────────────────────

/**
 * A decoded sound held in memory and ready to play.
 *
 * The platform decoder handles the container, so any format it understands —
 * WAV, AIFF, MP3, AAC — loads through the same call. Tracker modules do not
 * decode this way and are rendered to PCM first; see [soundFromPcm].
 */
@Experimental(since: "0.1")
pack Sound {
    var player: Long
    var ready: Bool
}

/** The sound returned when loading fails; every operation on it is a no-op. */
@Experimental(since: "0.1")
func soundEmpty(): Sound {
    return Sound(Long(0), false)
}

/**
 * Builds a player from encoded audio already in memory.
 *
 * Takes the bytes rather than a path so callers can decode from an archive, a
 * network buffer, or PCM they rendered themselves, without staging a temp file.
 */
@Experimental(since: "0.1")
func soundFromBytes(bytes: Long, length: Int): Sound {
    if bytes == Long(0) || length <= 0 {
        return soundEmpty()
    }
    fin data = send2(cls("NSData"), sel("dataWithBytes:length:"), bytes, length as Long)
    if data == Long(0) {
        return soundEmpty()
    }
    fin player = send2(send0(cls("AVAudioPlayer"), sel("alloc")), sel("initWithData:error:"), data, Long(0))
    if player == Long(0) {
        return soundEmpty()
    }
    send1(player, sel("setEnableRate:"), Long(1))
    send0(player, sel("prepareToPlay"))
    return Sound(player, true)
}

/** Loads an encoded sound file from disk. */
@Experimental(since: "0.1")
func loadSound(path: String): Sound {
    var blob = readFile(path)
    if !blob.ok() {
        return soundEmpty()
    }
    fin sound = soundFromBytes(blob.data, blob.size)
    blob.release()
    return sound
}

impl Sound {

    /** Plays from the start, once. */
    func !.play() {
        if !self.ready {
            return
        }
        fin rewind = azSendF1(self.player, sel("setCurrentTime:"), 0.0)
        send1(self.player, sel("setNumberOfLoops:"), Long(0))
        send0(self.player, sel("play"))
    }

    /**
     * Plays continuously until stopped.
     *
     * Background music is expressed as an effectively unbounded loop count
     * rather than by restarting on completion, so there is no gap at the seam.
     */
    func &.playLooping() {
        if !self.ready {
            return
        }
        send1(self.player, sel("setNumberOfLoops:"), -Long(1))
        send0(self.player, sel("play"))
    }

    /** Stops playback and rewinds. */
    func !.stop() {
        if !self.ready {
            return
        }
        send0(self.player, sel("stop"))
        fin rewind = azSendF1(self.player, sel("setCurrentTime:"), 0.0)
    }

    /** Sets the volume, 0.0 silent to 1.0 full. */
    func &.setVolume(volume: Double) {
        if !self.ready {
            return
        }
        var level = volume
        if level < 0.0 {
            level = 0.0
        }
        if level > 1.0 {
            level = 1.0
        }
        fin applied = azSendFloat1(self.player, sel("setVolume:"), level)
    }

    /** Whether the sound is currently playing. */
    func &.isPlaying(): Bool {
        if !self.ready {
            return false
        }
        return send0(self.player, sel("isPlaying")) != Long(0)
    }

    /** Releases the underlying player. */
    func !.release() {
        if self.ready {
            send0(self.player, sel("stop"))
            fin released = send0(self.player, sel("release"))
        }
        self.player = Long(0)
        self.ready = false
    }
}
