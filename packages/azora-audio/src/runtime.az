/**
 * @file engine.audio.runtime
 *
 * Real-time-safe audio storage and mixing contracts.
 *
 * PCM blocks are allocated when the pool is created. Decode workers acquire a
 * stable lease, fill it, commit it, and the device side reads and releases it.
 * No callback path grows an array or transfers ownership of arbitrary memory.
 */
module engine.audio.runtime

import std.container.array
import engine.media

/** Physical representation expected by an audio provider. */
enum AudioSampleFormat {
    Float32
    Signed16
    Signed32
}

/** PCM shape shared by decoders, effects, the mixer and the output device. */
pack AudioFormat {
    fin sampleRate: Int
    fin channels: Int
    fin sampleFormat: AudioSampleFormat
    fin interleaved: Bool
}

/** Preferred internal mix format. Providers convert at their outer boundary. */
func audioFormatStereo(sampleRate: Int): AudioFormat {
    var rate = sampleRate
    if rate <= 0 then rate = 48000
    return .(rate, 2, .Float32, true)
}

/** Operations rejected by the audio runtime before reaching native code. */
error AudioError {
    InvalidFormat
    PoolExhausted
    InvalidLease
    InvalidFrame
    InvalidChannel
    InvalidBus
    BusCapacity
    BusCycle
}

/** Lifecycle of one block in the dedicated PCM pool. */
enum AudioBufferState {
    Free
    Writing
    Ready
    Reading
}

/**
 * Generation-checked right to one preallocated PCM block.
 *
 * A released slot may be reused immediately, but its generation changes. That
 * makes a late decoder or output callback fail safely instead of touching the
 * next owner's samples.
 */
pack AudioBufferLease {
    fin slot: Int
    fin generation: Long
    fin firstSample: Int
    fin sampleCapacity: Int
}

/** A value that names no block. */
func audioBufferLeaseInvalid(): AudioBufferLease = .(-1, 0, 0, 0)

/** Snapshot useful to the profiler without exposing pool internals. */
pack AudioBufferPoolStats {
    fin capacity: Int
    fin available: Int
    fin inUse: Int
    fin highWater: Int
    fin acquisitions: Long
    fin exhausted: Long
}

/** Dedicated, fixed-size PCM block pool. */
pack AudioBufferPool {
    var format: AudioFormat
    var blockFrames: Int
    var blocks: Int
    var samples: Array<Double>
    var states: Array<AudioBufferState>
    var generations: Array<Long>
    var frameCounts: Array<Int>
    var timestamps: Array<MediaTime>
    var available: Int
    var highWaterMark: Int
    var acquisitions: Long
    var exhausted: Long
}

/** A pool with no usable storage, suitable only as an explicit fallback. */
func audioBufferPoolEmpty(): AudioBufferPool {
    return AudioBufferPool(
        AudioFormat(48000, 2, .Float32, true)
        0
        0
        Array<Double>()
        Array<AudioBufferState>()
        Array<Long>()
        Array<Int>()
        Array<MediaTime>()
        0
        0
        0
        0
    )
}

/** Allocates all PCM and bookkeeping storage up front. */
func audioBufferPool(
    format: AudioFormat
    blockFrames: Int
    blocks: Int
): AudioBufferPool ?! AudioError {
    if format.sampleRate <= 0 || format.channels <= 0 || blockFrames <= 0 || blocks <= 0 then return .InvalidFormat
    fin sampleCount = blockFrames * blocks * format.channels
    var samples: Array<Double> = Array::fill<Double>(sampleCount)
    var states: Array<AudioBufferState> = Array::fill<AudioBufferState>(blocks)
    var generations: Array<Long> = Array::fill<Long>(blocks)
    var frameCounts: Array<Int> = Array::fill<Int>(blocks)
    var timestamps: Array<MediaTime> = Array::fill<MediaTime>(blocks)
    for sampleIndex: Int in 0..<sampleCount then samples[sampleIndex] = 0.0
    for i: Int in 0..<blocks {
        states[i] = AudioBufferState.Free
        generations[i] = 1
        frameCounts[i] = 0
        timestamps[i] = mediaTimeZero()
    }
    return AudioBufferPool(
        format
        blockFrames
        blocks
        samples
        states
        generations
        frameCounts
        timestamps
        blocks
        0
        0
        0
    )
}

/** Public constructor spelling used by the audio proposal. */
func audioCreateBufferPool(
    format: AudioFormat
    blockFrames: Int
    blockCount: Int
): AudioBufferPool ?! AudioError {
    return try audioBufferPool(format, blockFrames, blockCount)
}

/** Releases pool storage after the device and decoder workers have stopped. */
func audioDestroyBufferPool(pool: AudioBufferPool!) {
    pool.samples = Array<Double>()
    pool.states = Array<AudioBufferState>()
    pool.generations = Array<Long>()
    pool.frameCounts = Array<Int>()
    pool.timestamps = Array<MediaTime>()
    pool.blockFrames = 0
    pool.blocks = 0
    pool.available = 0
}

/** Public profiler snapshot spelling used by the audio proposal. */
func audioBufferPoolStats(pool: AudioBufferPool&): AudioBufferPoolStats = pool.stats()

/** True when [lease] still owns [slot]. */
func audioLeaseCurrent(pool: AudioBufferPool&, lease: AudioBufferLease&): Bool {
    if lease.slot < 0 || lease.slot >= pool.blocks then return false
    return pool.generations[lease.slot] == lease.generation && pool.states[lease.slot] != .Free
}

/** Restricts a mix sample to the normal PCM interval. */
func audioClampSample(sample: Double): Double {
    return when {
        sample < -1.0 -> -1.0
        sample > 1.0 -> 1.0
        else -> sample
    }
}

impl AudioBufferPool {
    /** Claims one free block for a decoder or producer. */
    func !.acquire(): AudioBufferLease ?! AudioError {
        for slot: Int in 0..<self.blocks {
            if self.states[slot] == .Free {
                self.states[slot] = AudioBufferState.Writing
                self.frameCounts[slot] = 0
                self.timestamps[slot] = mediaTimeZero()
                self.available--
                self.acquisitions += 1
                fin used = self.blocks - self.available
                if used > self.highWaterMark then self.highWaterMark = used
                return AudioBufferLease(
                    slot
                    self.generations[slot]
                    slot * self.blockFrames * self.format.channels
                    self.blockFrames * self.format.channels
                )
            }
        }
        self.exhausted += 1
        return .PoolExhausted
    }

    /** Writes one interleaved sample while a block is being produced. */
    func !.write(
        lease: AudioBufferLease&
        frame: Int
        channel: Int
        sample: Double
    ) ?! AudioError {
        if !audioLeaseCurrent(self, lease) || self.states[lease.slot] != .Writing then return .InvalidLease
        if frame < 0 || frame >= self.blockFrames then return .InvalidFrame
        if channel < 0 || channel >= self.format.channels then return .InvalidChannel
        fin at = lease.firstSample + frame * self.format.channels + channel
        self.samples[at] = audioClampSample(sample)
    }

    /** Reads a sample from any live block; effects may read while producing it. */
    func &.read(
        lease: AudioBufferLease&
        frame: Int
        channel: Int
    ): Double ?! AudioError {
        return when {
            !audioLeaseCurrent(self, lease) -> .InvalidLease
            frame < 0 || frame >= self.blockFrames -> .InvalidFrame
            channel < 0 || channel >= self.format.channels -> .InvalidChannel
            else -> self.samples[lease.firstSample + frame * self.format.channels + channel]
        }
    }

    /** Publishes a complete or partial block to the consumer side. */
    func !.commit(
        lease: AudioBufferLease&
        frames: Int
        timestamp: MediaTime&
    ) ?! AudioError {
        if !audioLeaseCurrent(self, lease) || self.states[lease.slot] != .Writing then return .InvalidLease
        if frames < 0 || frames > self.blockFrames then return .InvalidFrame
        self.frameCounts[lease.slot] = frames
        self.timestamps[lease.slot] = MediaTime(timestamp.ticks, timestamp.timeBaseNum, timestamp.timeBaseDen)
        self.states[lease.slot] = AudioBufferState.Ready
    }

    /** Marks a committed block as owned by the output side. */
    func !.beginRead(lease: AudioBufferLease&) ?! AudioError {
        if !audioLeaseCurrent(self, lease) || self.states[lease.slot] != .Ready then return .InvalidLease
        self.states[lease.slot] = AudioBufferState.Reading
    }

    /** Returns a block to the pool and invalidates every old copy of its lease. */
    func !.release(lease: AudioBufferLease&) ?! AudioError {
        if !audioLeaseCurrent(self, lease) then return .InvalidLease
        self.states[lease.slot] = AudioBufferState.Free
        self.generations[lease.slot] += 1
        self.frameCounts[lease.slot] = 0
        self.timestamps[lease.slot] = mediaTimeZero()
        self.available++
    }

    /** Current pool pressure for profiler counters and adaptive decoding. */
    func &.stats(): AudioBufferPoolStats {
        return AudioBufferPoolStats(
            self.blocks
            self.available
            self.blocks - self.available
            self.highWaterMark
            self.acquisitions
            self.exhausted
        )
    }
}

/** Stable identity of a mixer bus. */
pack AudioBusId {
    fin value: Int
}

func audioMasterBus(): AudioBusId = AudioBusId(0)
func audioMediaBus(): AudioBusId = AudioBusId(1)
func audioMusicBus(): AudioBusId = AudioBusId(2)
func audioEffectsBus(): AudioBusId = AudioBusId(3)
func audioVoiceBus(): AudioBusId = AudioBusId(4)
func audioUiBus(): AudioBusId = AudioBusId(5)

/** One node of the mixer hierarchy. */
pack AudioBus {
    fin id: AudioBusId
    var name: String
    var parent: AudioBusId
    var gain: Double
    var pan: Double
    var muted: Bool
    var soloed: Bool
}

func audioBusEmpty(): AudioBus = .(AudioBusId(-1), "", AudioBusId(-1), 1.0, 0.0, false, false)

/** Bounded bus graph; topology changes happen outside the device callback. */
pack AudioMixer {
    var buses: Array<AudioBus>
    var count: Int
    var nextId: Int
}

/** Creates the six engine buses used by media and game audio. */
func audioMixer(capacity: Int): AudioMixer {
    var room = capacity
    if room < 6 then room = 6
    var buses: Array<AudioBus> = Array::fill<AudioBus>(room)
    for i: Int in 0..<room then buses[i] = audioBusEmpty()
    buses[0] = AudioBus(audioMasterBus(), "Master", .(-1), 1.0, 0.0, false, false)
    buses[1] = AudioBus(audioMediaBus(), "Media", audioMasterBus(), 1.0, 0.0, false, false)
    buses[2] = AudioBus(audioMusicBus(), "Music", audioMasterBus(), 1.0, 0.0, false, false)
    buses[3] = AudioBus(audioEffectsBus(), "Effects", audioMasterBus(), 1.0, 0.0, false, false)
    buses[4] = AudioBus(audioVoiceBus(), "Voice", audioMasterBus(), 1.0, 0.0, false, false)
    buses[5] = AudioBus(audioUiBus(), "UI", audioMasterBus(), 1.0, 0.0, false, false)
    return .(buses, 6, 6)
}

/** Resolves a bus by stable id rather than by its editable display name. */
func audioBusIndex(mixer: AudioMixer&, id: AudioBusId&): Int {
    for i: Int in 0..<mixer.count {
        if mixer.buses[i].id.value == id.value then return i
    }
    return -1
}

impl AudioMixer {
    /** Adds a bus without reallocating the mixer graph. */
    func !.createBus(name: String, parent: AudioBusId&): AudioBusId ?! AudioError {
        if self.count >= self.buses.size then return .BusCapacity
        if audioBusIndex(self, parent) < 0 then return .InvalidBus
        fin id: AudioBusId = .(self.nextId)
        self.buses[self.count] = AudioBus(id, name, .(parent.value), 1.0, 0.0, false, false)
        self.count++
        self.nextId++
        return id
    }

    func !.setGain(id: AudioBusId&, gain: Double) ?! AudioError {
        fin index = audioBusIndex(self, id)
        if index < 0 then return .InvalidBus
        var level = gain
        if level < 0.0 then level = 0.0
        if level > 4.0 then level = 4.0
        self.buses[index].gain = level
    }

    func !.setMuted(id: AudioBusId&, muted: Bool) ?! AudioError {
        fin index = audioBusIndex(self, id)
        if index < 0 then return .InvalidBus
        self.buses[index].muted = muted
    }

    /** Reparents a bus while refusing cycles in the signal graph. */
    func !.setParent(id: AudioBusId&, parent: AudioBusId&) ?! AudioError {
        fin index = audioBusIndex(self, id)
        fin parentIndex = audioBusIndex(self, parent)
        if index < 0 || parentIndex < 0 || id.value == audioMasterBus().value then return .InvalidBus
        var current: AudioBusId = .(parent.value)
        var depth = 0
        while current.value >= 0 && depth <= self.count {
            if current.value == id.value then return .BusCycle
            fin currentIndex = audioBusIndex(self, current)
            if currentIndex < 0 then return .InvalidBus
            current = AudioBusId(self.buses[currentIndex].parent.value)
            depth++
        }
        self.buses[index].parent = AudioBusId(parent.value)
    }

    /** Gain inherited through the bus graph, including mute state. */
    func &.effectiveGain(id: AudioBusId&): Double ?! AudioError {
        var current: AudioBusId = .(id.value)
        var gain = 1.0
        var depth = 0
        while current.value >= 0 && depth <= self.count {
            fin index = audioBusIndex(self, current)
            if index < 0 then return .InvalidBus
            if self.buses[index].muted then return 0.0
            gain *= self.buses[index].gain
            current = AudioBusId(self.buses[index].parent.value)
            depth++
        }
        return gain
    }
}

/**
 * Contract for built-in and package-provided effects.
 *
 * Preparation may allocate or build coefficients. [process] runs only over a
 * caller-owned pool lease and therefore needs no hidden allocation.
 */
spec AudioEffect {
    func !.prepare(format: AudioFormat&, maxFrames: Int)
    func !.process(
        pool: AudioBufferPool!
        lease: AudioBufferLease&
        frames: Int
    ): Unit ?! AudioError
    func !.reset()
    func &.latency(): Int
}

/** Reference effect that applies a constant gain in place. */
pack GainEffect {
    var gain: Double
}

impl AudioEffect for GainEffect {
    func !.prepare(format: AudioFormat&, maxFrames: Int) {
        self.gain = audioClampSample(self.gain)
    }

    func !.process(
        pool: AudioBufferPool!
        lease: AudioBufferLease&
        frames: Int
    ): Unit ?! AudioError {
        if frames < 0 || frames > pool.blockFrames then return .InvalidFrame
        for frame: Int in 0..<frames {
            var channel = 0
            while channel < pool.format.channels {
                fin sample = try pool.read(lease, frame, channel)
                try pool.write(lease, frame, channel, sample * self.gain)
                channel++
            }
        }
    }

    func !.reset() { }

    func &.latency(): Int = 0
}

test "the PCM pool exhausts without growing and rejects stale leases" {
    var pool = audioBufferPool(audioFormatStereo(48000), 4, 2) catch audioBufferPoolEmpty()
    fin first = pool.acquire() catch audioBufferLeaseInvalid()
    fin second = pool.acquire() catch audioBufferLeaseInvalid()
    var exhausted = false
    try {
        pool.acquire()
    } catch {
        exhausted = true
    }
    assert exhausted panic "a real-time pool must not allocate a surprise third block"
    assert pool.stats().highWater == 2 panic "pool pressure must be observable"

    pool.write(first, 0, 0, 0.75) catch { }
    pool.commit(first, 1, mediaTimeZero()) catch { }
    pool.beginRead(first) catch { }
    fin sample = pool.read(first, 0, 0) catch 0.0
    assert sample > 0.74 && sample < 0.76 panic "committed PCM must survive the handoff"
    pool.release(first) catch { }

    var stale = false
    try {
        pool.read(first, 0, 0)
    } catch {
        stale = true
    }
    assert stale panic "a released generation must never address its replacement"
    pool.release(second) catch { }
}

test "mixer buses resolve by id and inherit gain" {
    var mixer = audioMixer(8)
    mixer.setGain(audioMasterBus(), 0.5) catch { }
    mixer.setGain(audioMediaBus(), 0.8) catch { }
    fin gain = mixer.effectiveGain(audioMediaBus()) catch 0.0
    assert gain > 0.39 && gain < 0.41 panic "media gain must include the master bus"

    var cycle = false
    try {
        mixer.setParent(audioMediaBus(), audioMediaBus())
    } catch {
        cycle = true
    }
    assert cycle panic "a bus must not route into itself"
}

test "effect packs process a caller-owned lease in place" {
    var pool = audioBufferPool(audioFormatStereo(48000), 2, 1) catch audioBufferPoolEmpty()
    fin lease = pool.acquire() catch audioBufferLeaseInvalid()
    pool.write(lease, 0, 0, 0.5) catch { }
    var gainEffect: GainEffect = .(0.25)
    gainEffect.prepare(audioFormatStereo(48000), 2)
    gainEffect.process(pool, lease, 1) catch { }
    fin sample = pool.read(lease, 0, 0) catch 0.0
    assert sample > 0.124 && sample < 0.126 panic "the effect must update the pool block"
    pool.release(lease) catch { }
}
