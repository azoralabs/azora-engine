/**
 * @file engine.scene.io
 *
 * Scene files: every live entity, its parent, and its inspectable components,
 * as canonical AZON.
 *
 * ```
 * {"format": "azora-scene", "version": 2, "entities": [
 *   {"parent": -1, "components": {"Name": {"value": "Cube"}, "Transform": {...}}}
 * ]}
 * ```
 *
 * Components are keyed by declaration name and written field by field through
 * `reflect<C>.fields`, so a component added to the program is saved and loaded
 * without anything here naming it. A component or field the file does not
 * mention keeps its declared default. Unknown components are preserved until
 * their owning package is available.
 */
module engine.scene.io

import std.reflection
import std.serializer
import std.traits
import std.container.list
import engine.core
import engine.ecs
import engine.math
import engine.scene

/** Component data preserved by an editor without the owning runtime package. */
pack ExternalSceneComponent derives Clone {
    var name: String = ""
    var text: String = "{}"
}

@Component
pack ExternalSceneComponents derives Clone {
    var values: Array<ExternalSceneComponent> = []
}

func externalComponentText(world: World&, entity: Entity, name: String): String {
    fin components = storageOf<ExternalSceneComponents>(world)
    if !storageHas<ExternalSceneComponents>(components, entity) then return ""
    fin saved = storageGet<ExternalSceneComponents>(components, entity)
    for value in saved.values {
        if value.name == name then return value.text
    }
    return ""
}

func setExternalComponent(world: World!, entity: Entity, name: String, text: String): Bool {
    if !world.isAlive(entity) || name == "" then return false
    if text != "" {
        fin decoded = decodeSerialValue(text, serializerOptions()) catch SerialValue.Null
        when decoded {
            .Object(fields) -> {}
            else -> return false
        }
    }
    fin components = ensureStorage<ExternalSceneComponents>(world)
    var saved = storageGetOrDefault<ExternalSceneComponents>(components, entity, .())
    var index = 0
    while index < saved.values.size && saved.values[index].name != name then index += 1
    if index < saved.values.size {
        if text == "" then saved.values.removeAt(index) else saved.values[index].text = text
    } else if text != "" {
        saved.values.add(ExternalSceneComponent(name, text))
    }
    storageInsert<ExternalSceneComponents>(ensureStorage(world), entity, take saved)
    return true
}

// ── Writing ─────────────────────────────────────────────────────────────

/** [text] as an AZON string literal. */
func azonText(text: String): String {
    var escaped = ""
    var index = 0
    fin length = stringLength(text)
    while index < length {
        fin ch = charAt(text, index)
        when ch {
            '"' -> { escaped = "${escaped}\\\"" }
            '\\' -> { escaped = "${escaped}\\\\" }
            '\n' -> { escaped = "${escaped}\\n" }
            '\t' -> { escaped = "${escaped}\\t" }
            else -> { escaped = "${escaped}${ch}" }
        }
        index++
    }
    return "\"${escaped}\""
}

/** [members] with `"name": value` appended, comma-separated. */
func azonMember(members: String, name: String, value: String): String {
    fin entry = "${azonText(name)}: ${value}"
    return if stringLength(members) == 0 then entry else "${members}, ${entry}"
}

/** Every inspectable component [entity] carries, as one AZON object. */
func componentsAzon(world: World!, entity: Entity): String {
    var members = ""
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if storageHas<C>(ensureStorage(world), entity) {
            fin value = storageGet<C>(ensureStorage(world), entity).clone()
            var fields = ""
            inline for f in reflect<C>.fields {
                inline if f.typeName == "Double" {
                    fields = azonMember(fields, f.name, formatDecimal(value.${f.name}, 6))
                }
                inline if f.typeName == "Int" {
                    fields = azonMember(fields, f.name, "${value.${f.name}}")
                }
                inline if f.typeName == "Bool" {
                    fields = azonMember(fields, f.name, if value.${f.name} { "true" } else { "false" })
                }
                inline if f.typeName == "String" {
                    fields = azonMember(fields, f.name, azonText(value.${f.name}))
                }
                inline if f.typeName == "Vec3" {
                    fields = azonMember(fields, f.name, "[${formatDecimal(value.${f.name}.x, 6)}, ${formatDecimal(value.${f.name}.y, 6)}, ${formatDecimal(value.${f.name}.z, 6)}]")
                }
                inline if f.typeName == "Rgba" {
                    fields = azonMember(fields, f.name, "[${formatDecimal(value.${f.name}.r, 4)}, ${formatDecimal(value.${f.name}.g, 4)}, ${formatDecimal(value.${f.name}.b, 4)}, ${formatDecimal(value.${f.name}.a, 4)}]")
                }
            }
            fin serialized = reflect<C>.annotMeta<Inspectable>.serializedName
            fin name = if serialized != "" then serialized else reflect<C>.declName
            members = azonMember(members, name, "{${fields}}")
        }
    }
    fin external = ensureStorage<ExternalSceneComponents>(world)
    if storageHas<ExternalSceneComponents>(external, entity) {
        fin saved = storageGet<ExternalSceneComponents>(external, entity)
        for field in saved.values then members = azonMember(members, field.name, field.text)
    }
    return "{${members}}"
}

/** Whether [id] is a live entity a scene file should hold. */
/** Whether entity [id] is written into the scene: alive, not a resource, not streamed in. */
func sceneEntity(world: World!, id: Int): Bool =
    world.alive[id] && !world.resourceMarks[id] && !storageHas<Streamed>(ensureStorage(world), world.entityAt(id))

/** The whole scene in [world] as AZON text. */
func writeScene(world: World!): String {
    // Parents are written as positions in this file, not as entity ids, so a
    // file stays valid whatever ids the next world hands out.
    var positions: Array<Int> = []
    var count = 0
    var id = 0
    while id < world.entityCount {
        positions.add(if sceneEntity(world, id) then count else -1)
        if sceneEntity(world, id) then count = count + 1
        id++
    }
    var entities = ""
    id = 0
    while id < world.entityCount {
        if sceneEntity(world, id) {
            fin entity = world.entityAt(id)
            fin parentId = world.parents[id]
            fin parent = if parentId >= 0 && parentId < world.entityCount then positions[parentId] else -1
            fin record = "{\"parent\": ${parent}, \"components\": ${componentsAzon(world, entity)}}"
            entities = if stringLength(entities) == 0 then record else { "${entities},\n    ${record}" }
        }
        id++
    }
    return "{\"format\": \"azora-scene\", \"version\": 2, \"entities\": [\n    ${entities}\n]}\n"
}

// ── Reading ─────────────────────────────────────────────────────────────

/** The position of member [name] in [fields], or -1. */
func memberIndex(fields: List<SerialField>&, name: String): Int {
    for i: Int in 0..<fields.size {
        if fields[i].name == name then return i
    }
    return -1
}

/** [value] as a number, or [fallback] when it is not one. */
func serialNumberOr(value: SerialValue&, fallback: Double): Double = serialAsReal(value) catch fallback

/** Element [index] of the array [value] as a number, or [fallback]. */
func serialElementOr(value: SerialValue&, index: Int, fallback: Double): Double {
    when value {
        .Array(elements) -> {
            return if index < elements.size then serialAsReal(elements[index]) catch fallback else fallback
        }
        else -> return fallback
    }
}

/**
 * Puts on [entity] every inspectable component [components] mentions.
 *
 * Each starts from its declared default, so a field the file leaves out reads
 * as it would on a freshly added component.
 */
func readComponents(world: World!, entity: Entity, components: List<SerialField>&, contentOnly: Bool = false) {
    var recognized: Array<String> = []
    fin ground = contentOnly && cellGroundRecord(components)
    inline for C in reflect<*>.withAnnot<Inspectable> {
        fin serialized = reflect<C>.annotMeta<Inspectable>.serializedName
        fin declared = if serialized != "" then memberIndex(components, serialized) else -1
        fin at = if declared >= 0 then declared else memberIndex(components, reflect<C>.declName)
        if at >= 0 && (!ground || !cellGroundComponent(components[at].name)) {
            recognized.add(components[at].name)
            var value = C()
            when components[at].value {
                .Object(fields) -> {
                    inline for f in reflect<C>.fields {
                        fin slot = memberIndex(fields, f.name)
                        if slot >= 0 {
                            inline if f.typeName == "Double" {
                                value.${f.name} = serialNumberOr(fields[slot].value, value.${f.name})
                            }
                            inline if f.typeName == "Int" {
                                value.${f.name} = serialNumberOr(fields[slot].value, value.${f.name} as Double) as Int
                            }
                            inline if f.typeName == "Bool" {
                                value.${f.name} = serialAsBool(fields[slot].value) catch value.${f.name}
                            }
                            inline if f.typeName == "String" {
                                value.${f.name} = serialAsText(fields[slot].value) catch value.${f.name}
                            }
                            inline if f.typeName == "Vec3" {
                                value.${f.name}.x = serialElementOr(fields[slot].value, 0, value.${f.name}.x)
                                value.${f.name}.y = serialElementOr(fields[slot].value, 1, value.${f.name}.y)
                                value.${f.name}.z = serialElementOr(fields[slot].value, 2, value.${f.name}.z)
                            }
                            inline if f.typeName == "Rgba" {
                                value.${f.name}.r = serialElementOr(fields[slot].value, 0, value.${f.name}.r)
                                value.${f.name}.g = serialElementOr(fields[slot].value, 1, value.${f.name}.g)
                                value.${f.name}.b = serialElementOr(fields[slot].value, 2, value.${f.name}.b)
                                value.${f.name}.a = serialElementOr(fields[slot].value, 3, value.${f.name}.a)
                            }
                        }
                    }
                }
                else -> { }
            }
            storageInsert<C>(ensureStorage(world), entity, take value)
        }
    }
    for component in components {
        if (!ground || !cellGroundComponent(component.name)) && !recognized.contains(component.name) {
            fin encoded = encodeSerialValue(component.value, serializerOptions()) catch ""
            if encoded != "" then setExternalComponent(world, entity, component.name, encoded)
        }
    }
}

/** Ground records can still serve as transform parents for authored cell objects. */
func cellGroundRecord(components: List<SerialField>&): Bool {
    if memberIndex(components, "HeightfieldTerrain") >= 0 then return true
    fin at = memberIndex(components, "PluginObject")
    if at >= 0 {
        when components[at].value {
            .Object(fields) -> {
                fin plugin = memberIndex(fields, "plugin")
                if plugin >= 0 then return (serialAsText(fields[plugin].value) catch "") == "azora.flex-landscape"
            }
            else -> { }
        }
    }
    return false
}

func cellGroundComponent(name: String): Bool =
    name == "HeightfieldTerrain" || name == "LandscapeCollision" || name == "TerrainHoles" ||
    name == "FoliagePaint" || name == "PluginObject"

/**
 * Loads the scene in [text] into [world], which should be empty.
 *
 * Answers the number of entities read, or -1 when the text is not a scene this
 * version understands - in which case nothing was added.
 */
func readScene(world: World!, text: String): Int {
    var spawned: Array<Entity> = []
    return readSceneInto(world, text, spawned)
}

/**
 * Adds the entities of scene [text] to [world], appending each one spawned to
 * [spawned] (a streaming system unloads them later); answers how many, or -1
 * when the text is not a scene. Content cells retain object transforms and
 * leave the landscape and its collision to the main scene.
 */
func readSceneInto(world: World!, text: String, spawned: Array<Entity>!, contentOnly: Bool = false): Int {
    var options = serializerOptions()
    options.reuseTokens = true
    fin root = decodeSerialValue(text, options) catch SerialValue.Null
    fin first = spawned.size
    var parents: Array<Int> = []
    when root {
        .Object(members) -> {
            fin format = memberIndex(members, "format")
            fin list = memberIndex(members, "entities")
            if format < 0 || list < 0 then return -1
            if (serialAsText(members[format].value) catch "") != "azora-scene" then return -1
            when members[list].value {
                .Array(records) -> {
                    var index = 0
                    while index < records.size {
                        when records[index] {
                            .Object(fields) -> {
                                fin entity = world.spawn()
                                spawned.add(entity)
                                fin parentAt = memberIndex(fields, "parent")
                                parents.add(if parentAt >= 0 then serialNumberOr(fields[parentAt].value, -1.0) as Int else -1)
                                fin componentsAt = memberIndex(fields, "components")
                                if componentsAt >= 0 {
                                    when fields[componentsAt].value {
                                        .Object(components) -> readComponents(world, entity, components, contentOnly)
                                        else -> { }
                                    }
                                }
                            }
                            else -> { }
                        }
                        index++
                    }
                }
                else -> return -1
            }
        }
        else -> return -1
    }
    for index: Int in 0..<parents.size {
        fin parent = parents[index]
        if parent >= 0 && parent < parents.size && parent != index then world.setParent(spawned[first + index], spawned[first + parent])
    }
    return spawned.size - first
}
