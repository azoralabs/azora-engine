/**
 * Engine application host: the ECS world, the frame clock, and the system
 * schedule, driven over a platform window.
 *
 * There is no plugin graph. Subsystems are ordinary modules a game imports
 * directly, screens are a navigation back stack, and behaviour is ECS systems
 * on a schedule — so there is nothing for a plugin registry to configure, and
 * no service-locator indirection between a game and the engine it calls.
 *
 * A game may use this host, or drive `appInit` and `app.frame()` itself when it
 * wants the frame loop in its own hands; both are first-class.
 */
module engine.app

import std.container.array
import engine.core
import engine.ecs
import engine.platform

/** A per-frame callback for games that keep logic outside the ECS schedule. */
spec GameSystem {
    func run[self: Self&](app: App!)
}

/**
 * Owns the ECS world, frame clock, and system schedule for a game.
 *
 * Construct with [engine], register systems, then call [run].
 */
pack Engine {
    var title: std::String
    var width: std::Int
    var height: std::Int
    var clearR: std::Double
    var clearG: std::Double
    var clearB: std::Double
    var world: World
    var time: Time
    var plan: SystemPlan
    var startup: std::Array<GameSystem>
    var update: std::Array<GameSystem>
}

/** Creates an engine host with an empty world and schedule. */
func engine(title: std::String, width: std::Int, height: std::Int): Engine {
    return Engine(
        title,
        width,
        height,
        0.06,
        0.07,
        0.09,
        worldInit(),
        timeInit(),
        systemPlan(),
        std::Array::fill<GameSystem>(0),
        std::Array::fill<GameSystem>(0)
    )
}

impl Engine {
    func setClearColor[self: Self!](r: std::Double, g: std::Double, b: std::Double): Engine! {
        self.clearR = r
        self.clearG = g
        self.clearB = b
        return self
    }

    /** Registers a callback to run once, before the first frame. */
    func addStartupSystem[self: Self!](system: GameSystem): Engine! {
        self.startup.add(system)
        return self
    }

    /** Registers a callback to run every frame. */
    func addUpdateSystem[self: Self!](system: GameSystem): Engine! {
        self.update.add(system)
        return self
    }

    /**
     * Opens the window and runs the complete phase schedule until it closes.
     *
     * `.FixedUpdate` drains the world's fixed-step accumulator, so simulation
     * stays deterministic regardless of frame rate; every other phase runs
     * exactly once per rendered frame.
     */
    func run[self: Self!]() {
        var app = appInit(self.title, self.width, self.height)
        if !app.ok {
            return
        }
        app.setClearColor(self.clearR, self.clearG, self.clearB)

        runPhase(self.plan, SystemPhase.Startup, self.world)
        for system in self.startup {
            system.run(app)
        }

        while app.frame() {
            self.time.advance(app.deltaTime())
            self.world.progress(self.time.deltaSecs)

            runPhase(self.plan, SystemPhase.PreUpdate, self.world)
            runPhase(self.plan, SystemPhase.Update, self.world)
            for system in self.update {
                system.run(app)
            }
            runPhase(self.plan, SystemPhase.PostUpdate, self.world)

            while self.world.consumeFixedStep() {
                runPhase(self.plan, SystemPhase.FixedUpdate, self.world)
            }

            runPhase(self.plan, SystemPhase.Render, self.world)
            app.present()
            runPhase(self.plan, SystemPhase.Last, self.world)
        }
        app.shutdown()
    }
}
