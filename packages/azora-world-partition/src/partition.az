module engine.world.partition

import std.io
import std.math
import std.string
import engine.core
import engine.ecs
import engine.io
import engine.math
import engine.scene
import engine.scene.io
import engine.scene.terrain
import engine.scene.transforms
import engine.landscape.collision
import engine.game
import engine.procedural
import engine.world.partition.cooked

// Cells contain the objects placed on the land. The landscape has its own
// lifetime and LOD. Streamed entities are excluded from scene saves.

/** Streams the world its entity's World Recipe describes around the player. */
@Component
@Inspectable(title: "World Partition", serializedName: "WorldPartition", icon: "grid-3x3", category: "World", order: 51)
pack WorldPartition derives Clone {
    var enabled: Bool = true
    /** Cells intersecting this distance from the player are loaded, and unloaded past [unloadRadius]. */
    @Range(min: 500.0, max: 30000.0, step: 250.0)
    var loadRadius: Double = 5000.0
    @Range(min: 500.0, max: 40000.0, step: 250.0)
    var unloadRadius: Double = 6500.0
    /** Maximum cell reads per streaming update. */
    @Range(min: 1.0, max: 16.0, step: 1.0)
    var cellsPerFrame: Int = 1
    /** The project folder generated cells are cached in (made when missing). */
    var folder: String = ".azora-build"
    /** Reads authored <column>-<row>.azscene cells from folder. A cells.azindex also selects this mode. */
    var authored: Bool = false
    /** Additional indexed content folders sharing the grid. Defaults to the comma-separated cells.azlayers file. */
    var layers: String = ""
    /** Maximum cells read before the first game frame. Negative loads everything in range. */
    var startupCells: Int = -1
    /** Minimum number of game frames between stream updates. */
    @Range(min: 1.0, max: 60.0, step: 1.0)
    var updateInterval: Int = 1
    /** Creates a permanent base heightfield for procedural worlds without a scene landscape. */
    var overview: Bool = true
}

/** A loaded cell and every entity it brought in, its own [group] entity last. */
pack LoadedCell derives Clone {
    var column: Int = 0
    var row: Int = 0
    /** The cell's entity: the partition's child, and the parent of what the cell's scene has at its top. */
    var group: Entity = .(-1, 0)
    var entities: Array<Entity> = []
}

pack CellLayer {
    fin folder: String
    fin occupied: Array<Bool>
}

/** A partition's run-time state: the world's plan and its loaded cells (never saved). */
@Component
pack PartitionState {
    var plan: WorldPlan = .()
    var planned: Bool = false
    /** The recipe the plan and the loaded cells come from (see [worldCacheName]). */
    var recipe: String = ""
    var cells: Array<LoadedCell> = []
    var terrain: Entity = Entity::invalid
    var root: String = ""
    var sourceFolder: String = ""
    var folder: String = ""
    var runtime: Bool = false
    var authoredSetting: Bool = false
    var authored: Bool = false
    var recipeKey: Long = 0
    var occupied: Array<Bool> = []
    var layerFolders: String = ""
    var layers: Array<CellLayer> = []
    var settled: Bool = false
    var lastX: Double = 0.0
    var lastZ: Double = 0.0
    var lastLoad: Double = 0.0
    var lastUnload: Double = 0.0
}

/** The first enabled World Partition with a World Recipe, or an invalid entity. */
func worldPartitionEntity(world: World!): Entity {
    fin partitions = ensureStorage<WorldPartition>(world)
    for i: Int in 0..<storageLength<WorldPartition>(partitions) {
        fin entity = storageEntityAt<WorldPartition>(partitions, i)
        if partitions.values[i].enabled && world.isAlive(entity) && storageHas<WorldRecipe>(ensureStorage(world), entity) then return entity
    }
    return .(-1, 0)
}

/**
 * Brings [world]'s partition up to date around [center]: unloads the cells
 * past the unload radius, then loads (generating when not yet cached) the
 * nearest missing cells within the load radius - at most [limit] of them, or
 * every one when [limit] is negative. [root] is the project folder. Answers
 * how many cells came in or went.
 */
func streamWorld(world: World!, root: String, center: Vec3&, limit: Int = -1, runtime: Bool = false): Int {
    fin owner = worldPartitionEntity(world)
    fin here = partitionPoint(world, owner, center)
    // A partition switched off, removed or no longer first unloads what it brought in.
    var other = 0
    while other < storageLength<PartitionState>(ensureStorage(world)) {
        fin holder = storageEntityAt<PartitionState>(ensureStorage(world), other)
        if holder != owner {
            unloadPartition(world, holder)
            storageRemove<PartitionState>(ensureStorage(world), holder)
        } else {
            other++
        }
    }
    if !owner.isValid {
        despawnStreamed(world)
        return 0
    }
    fin recipes = ensureStorage<WorldRecipe>(world)
    fin recipe = storageGet<WorldRecipe>(recipes, owner).&
    fin settings = storageGet<WorldPartition>(ensureStorage(world), owner).&
    if recipe.cellSize <= 0.0 || recipe.width <= 0.0 || recipe.length <= 0.0 {
        unloadPartition(world, owner)
        return 0
    }
    if !storageHas<PartitionState>(ensureStorage(world), owner) then storageInsert<PartitionState>(ensureStorage(world), owner, .())
    let states = ensureStorage<PartitionState>(world)
    fin at = storageIndexOf<PartitionState>(states, owner)
    let state = states.values[at].!
    fin key = worldRecipeKey(recipe)
    if state.planned && (state.recipeKey != key || state.root != root || state.sourceFolder != settings.folder || state.runtime != runtime ||
        state.authoredSetting != settings.authored || state.layerFolders != settings.layers) then unloadPartition(world, owner)

    fin columns = worldColumns(recipe)
    fin rows = worldRows(recipe)
    if !state.planned {
        // The owner may have been deleted along with its state.
        despawnStreamed(world)
        state.root = root
        state.sourceFolder = settings.folder
        state.folder = settings.folder
        state.runtime = runtime
        state.layerFolders = settings.layers
        state.recipeKey = key
        state.authoredSetting = settings.authored
        state.occupied = readCellIndex(root, settings.folder, columns, rows)
        state.authored = settings.authored || state.occupied.size > 0
        if state.authored {
            if runtime {
                fin cooked = cellManifest(root, settings.folder, "cells.azruntime")
                if cooked != "" {
                    fin occupied = readCellIndex(root, cooked, columns, rows)
                    if occupied.size > 0 {
                        state.folder = cooked
                        state.occupied = take occupied
                    }
                }
            }
            fin folders = if settings.layers != "" then settings.layers else cellManifest(root, settings.folder, "cells.azlayers")
            for folder in split(folders, ",") {
                if folder == "" || folder == settings.folder then continue
                fin occupied = readCellIndex(root, folder, columns, rows)
                if occupied.size > 0 then state.layers.add(CellLayer(folder, take occupied))
            }
        }
        state.recipe = if state.authored then settings.folder else worldCacheName(recipe)
        if !state.authored then state.plan = planWorld(recipe)
        state.planned = true
    }
    // Generated terrain is resident for the life of the recipe. When the
    // scene has its own land, it is the sole source of ground geometry.
    if !state.authored && settings.overview && !state.terrain.isValid &&
        storageLength<HeightfieldTerrain>(ensureStorage(world)) == 0 {
        state.terrain = loadPartitionTerrain(world, root, recipe, state, owner)
    }
    if !settings.overview && state.terrain.isValid {
        if world.isAlive(state.terrain) then world.despawn(state.terrain)
        state.terrain = Entity::invalid
    }

    fin loadRadius = if settings.loadRadius > 0.0 then settings.loadRadius else 0.0
    fin unloadRadius = if settings.unloadRadius > loadRadius then settings.unloadRadius else loadRadius
    if state.settled && state.lastX == here.x && state.lastZ == here.z &&
        state.lastLoad == loadRadius && state.lastUnload == unloadRadius then return 0
    state.lastX = here.x
    state.lastZ = here.z
    state.lastLoad = loadRadius
    state.lastUnload = unloadRadius
    fin loadSquared = loadRadius * loadRadius
    fin unloadSquared = unloadRadius * unloadRadius
    var unloaded = 0
    var i = 0
    while i < state.cells.size {
        fin cell = state.cells[i].&
        if cellDistanceSquared(recipe, cell.column, cell.row, here) > unloadSquared {
            for entity in cell.entities then if world.isAlive(entity) then world.despawn(entity)
            state.cells.removeAt(i)
            unloaded++
        } else {
            i++
        }
    }
    // Calculate the candidate set once, even when filling it in one update at
    // startup. Include the cell containing the player at any load radius.
    fin c0 = floor(worldClamp((here.x + recipe.width * 0.5 - loadRadius) / recipe.cellSize, 0.0, columns as Double)) as Int
    fin r0 = floor(worldClamp((here.z + recipe.length * 0.5 - loadRadius) / recipe.cellSize, 0.0, rows as Double)) as Int
    fin c1 = floor(worldClamp((here.x + recipe.width * 0.5 + loadRadius) / recipe.cellSize, -1.0, (columns - 1) as Double)) as Int
    fin r1 = floor(worldClamp((here.z + recipe.length * 0.5 + loadRadius) / recipe.cellSize, -1.0, (rows - 1) as Double)) as Int
    var candidates: Array<CellCandidate> = []
    if c0 <= c1 && r0 <= r1 {
        for row: Int in r0..r1 {
            for column: Int in c0..c1 {
                if !cellMayContainContent(state, row * columns + column) then continue
                fin distance = cellDistanceSquared(recipe, column, row, here)
                if distance <= loadSquared && !cellLoaded(state.cells, column, row) {
                    candidates.add(CellCandidate(column, row, distance))
                }
            }
        }
    }
    var loaded = 0
    var attempts = 0
    var failed = false
    while candidates.size > 0 && (limit < 0 || attempts < limit) {
        var nearest = 0
        for j: Int in 1..<candidates.size then if candidates[j].distance < candidates[nearest].distance then nearest = j
        fin column = candidates[nearest].column
        fin row = candidates[nearest].row
        candidates.removeAt(nearest)
        var cell: LoadedCell = .(column, row)
        attempts++
        if loadCell(world, recipe, state, cell, owner) {
            if cell.group.isValid then loaded++
            state.cells.add(take cell)
        } else {
            failed = true
        }
    }
    state.settled = candidates.size == 0 && !failed
    return loaded + unloaded
}

func cellManifest(root: String, folder: String, name: String): String {
    var file = readFile("${root}/${folder}/${name}")
    defer { file.release() }
    return file.text(0, file.size)
}

func cellMayContainContent(state: PartitionState&, index: Int): Bool {
    if state.occupied.size == 0 || state.occupied[index] then return true
    for layer in state.layers then if layer.occupied[index] then return true
    return false
}

/** An indexed authored folder lists its occupied coordinates as little-endian u16 pairs after AZCELL1. */
func readCellIndex(root: String, folder: String, columns: Int, rows: Int): Array<Bool> {
    var file = readFile("${root}/${folder}/cells.azindex")
    defer { file.release() }
    if file.size < 7 || (file.size - 7) % 4 != 0 || !file.matches(0, "AZCELL1") then return []
    var occupied: Array<Bool> = .() * (columns * rows)
    var offset = 7
    while offset < file.size {
        fin column = file.u16(offset)
        fin row = file.u16(offset + 2)
        if column < columns && row < rows then occupied[row * columns + column] = true
        offset += 4
    }
    return take occupied
}

pack CellCandidate {
    fin column: Int
    fin row: Int
    fin distance: Double
}

/** [point] in [owner]'s own frame: the cells lie in it, so a moved World Partition takes its world along. */
func partitionPoint(world: World!, owner: Entity, point: Vec3&): Vec3 {
    if !owner.isValid || !world.isAlive(owner) then return point.clone()
    fin m = mat4Inverse(worldMatrix(world, owner))
    return .(m.m00 * point.x + m.m01 * point.y + m.m02 * point.z + m.m03,
        m.m10 * point.x + m.m11 * point.y + m.m12 * point.z + m.m13,
        m.m20 * point.x + m.m21 * point.y + m.m22 * point.z + m.m23)
}

/** Despawns every streamed entity in [world], whichever partition brought it in. */
func despawnStreamed(world: World!) {
    fin streamed = ensureStorage<Streamed>(world)
    if storageLength<Streamed>(streamed) == 0 then return
    var gone: Array<Entity> = []
    for i: Int in 0..<storageLength<Streamed>(streamed) then gone.add(storageEntityAt<Streamed>(streamed, i))
    for entity in gone then if world.isAlive(entity) then world.despawn(entity)
}

/** Despawns every cell and the generated landscape [owner]'s partition brought in, and forgets its plan. */
func unloadPartition(world: World!, owner: Entity) {
    let states = ensureStorage<PartitionState>(world)
    fin at = storageIndexOf<PartitionState>(states, owner)
    if at < 0 then return
    for cell in states.values[at].cells {
        for entity in cell.entities then if world.isAlive(entity) then world.despawn(entity)
    }
    fin terrain = states.values[at].terrain
    if world.isAlive(terrain) then world.despawn(terrain)
    let again = ensureStorage<PartitionState>(world)
    fin index = storageIndexOf<PartitionState>(again, owner)
    again.values[index].cells.clear()
    again.values[index].terrain = Entity::invalid
    again.values[index].occupied.clear()
    again.values[index].layers.clear()
    again.values[index].settled = false
    again.values[index].plan = .()
    again.values[index].planned = false
    again.values[index].recipe = ""
}

func cellDistanceSquared(recipe: WorldRecipe&, column: Int, row: Int, center: Vec3&): Double {
    fin left = cellLeft(recipe, column)
    fin top = cellTop(recipe, row)
    fin dx = center.x - worldClamp(center.x, left, left + recipe.cellSize)
    fin dz = center.z - worldClamp(center.z, top, top + recipe.cellSize)
    return dx * dx + dz * dz
}

func cellLoaded(cells: Array<LoadedCell>&, column: Int, row: Int): Bool {
    for cell in cells {
        if cell.column == column && cell.row == row then return true
    }
    return false
}

/** Reads one content cell and attaches its entities beneath the partition owner. */
func loadCell(world: World!, recipe: WorldRecipe&, state: PartitionState&, cell: LoadedCell!, owner: Entity): Bool {
    if state.authored {
        if !readAuthoredCell(world, state, cell, worldColumns(recipe)) {
            for entity in cell.entities then if world.isAlive(entity) then world.despawn(entity)
            cell.entities.clear()
            return false
        }
    } else if !readGeneratedCell(world, recipe, state, cell) then return false
    if cell.entities.size == 0 then return true
    fin group = world.spawn()
    storageInsert<Name>(ensureStorage(world), group, .("Cell ${cell.column}, ${cell.row}"))
    if world.isAlive(owner) then world.setParent(group, owner)
    for entity in cell.entities then if !world.isAlive(world.getParent(entity)) then world.setParent(entity, group)
    cell.group = group
    cell.entities.add(group)
    fin key = (cell.column as Long) * 65536 + (cell.row as Long)
    for entity in cell.entities then storageInsert<Streamed>(ensureStorage(world), entity, .(cell: key))
    return true
}

func readAuthoredCell(world: World!, state: PartitionState&, cell: LoadedCell!, columns: Int): Bool {
    fin index = cell.row * columns + cell.column
    fin filename = "${cell.column}-${cell.row}"
    if state.occupied.size == 0 || state.occupied[index] {
        if !readCellScene(world, "${state.root}/${state.folder}/${filename}", cell.entities,
            state.occupied.size > 0, state.runtime) then return false
    }
    for layer in state.layers {
        if layer.occupied[index] && !readCellScene(world, "${state.root}/${layer.folder}/${filename}", cell.entities,
            true, state.runtime) then return false
    }
    return true
}

func readCellScene(world: World!, path: String, entities: Array<Entity>!, required: Bool, runtime: Bool): Bool {
    if runtime {
        var cooked = readFile("${path}.azcell")
        defer { cooked.release() }
        if cooked.ok() then return readCookedCell(world, cooked, entities)
    }
    var file = readFile("${path}.azscene")
    defer { file.release() }
    if !file.ok() then return !required
    return readSceneInto(world, file.text(0, file.size), entities, contentOnly: true) >= 0
}

func readGeneratedCell(world: World!, recipe: WorldRecipe&, state: PartitionState&, cell: LoadedCell!): Bool {
    fin scenePath = "${state.root}/${state.folder}/${state.recipe}_cell_${cell.column}_${cell.row}.azscene"
    var file = readFile(scenePath)
    if !file.ok() {
        file.release()
        makeFolders("${state.root}/${state.folder}")
        if !generateWorldCell(recipe, state.plan, state.root, state.folder, cell.column, cell.row) then return false
        file = readFile(scenePath)
    }
    defer { file.release() }
    if !file.ok() then return false
    return readSceneInto(world, file.text(0, file.size), cell.entities, contentOnly: true) >= 0
}

/** Creates the independent heightfield for an otherwise empty procedural scene. */
func loadPartitionTerrain(world: World!, root: String, recipe: WorldRecipe&, state: PartitionState&, owner: Entity): Entity {
    fin image = worldOverviewPath(state.folder, recipe)
    fin path = "${root}/${image}"
    var file = readFile(path)
    fin cached = file.ok()
    file.release()
    if !cached then makeFolders("${root}/${state.folder}")
    if !cached && !generateWorldOverview(recipe, state.plan, path) then return Entity::invalid
    fin width = (worldColumns(recipe) as Double) * recipe.cellSize
    fin length = (worldRows(recipe) as Double) * recipe.cellSize
    fin entity = world.spawn()
    storageInsert<Name>(ensureStorage(world), entity, .("World Landscape"))
    storageInsert<Transform>(ensureStorage(world), entity, .(translation: .(cellLeft(recipe, 0) + width * 0.5,
        recipe.baseHeight + recipe.heightRange * 0.5, cellTop(recipe, 0) + length * 0.5)))
    storageInsert<HeightfieldTerrain>(ensureStorage(world), entity, .(image: image, width: width, length: length,
        elevation: recipe.heightRange, detailError: 3.0, gradeRoads: false))
    storageInsert<LandscapeCollision>(ensureStorage(world), entity, .())
    if world.isAlive(owner) then world.setParent(entity, owner)
    storageInsert<FusionMaterial>(ensureStorage(world), entity, .(asset: "Materials/landscape.az"))
    storageInsert<StandardMaterial>(ensureStorage(world), entity, .(color: .(0.29, 0.38, 0.21, 1.0), roughness: 0.9))
    storageInsert<Streamed>(ensureStorage(world), entity, .(cell: -1))
    return entity
}

// ── In a game ───────────────────────────────────────────────────────────

/** Before anything spawns on the ground: the cells around the camera, all at once. */
@System(phase: .Startup)
func startWorldPartition(frame: Game!) {
    fin start = playerStartPosition(frame.world)
    fin owner = worldPartitionEntity(frame.world)
    fin limit = if owner.isValid then storageGet<WorldPartition>(ensureStorage(frame.world), owner).startupCells else -1
    streamWorld(frame.world, ".", start, limit, runtime: true)
}

/** Every frame, a cell or so around the camera. */
@System(phase: .PreUpdate)
func streamWorldPartition(frame: Game!) {
    fin owner = worldPartitionEntity(frame.world)
    fin interval = if owner.isValid then storageGet<WorldPartition>(ensureStorage(frame.world), owner).updateInterval else 1
    if interval <= 1 || frame.window.framesRun % interval == 0 then streamWorldAround(frame.world, ".", frame.camera.target, runtime: true)
}

/**
 * One frame of streaming around [center] (a game's camera, an editor's view):
 * as many new cells as the partition's `cellsPerFrame` allows, and with no
 * enabled partition, whatever one streamed in before goes.
 */
func streamWorldAround(world: World!, root: String, center: Vec3&, runtime: Bool = false): Int {
    fin owner = worldPartitionEntity(world)
    fin perFrame = if owner.isValid then storageGet<WorldPartition>(ensureStorage(world), owner).cellsPerFrame else 0
    return streamWorld(world, root, center, perFrame, runtime)
}

/** Where the first enabled Player Start stands, or the origin. */
func playerStartPosition(world: World!): Vec3 {
    fin starts = ensureStorage<PlayerStart>(world)
    for i: Int in 0..<storageLength<PlayerStart>(starts) {
        fin entity = storageEntityAt<PlayerStart>(starts, i)
        if starts.values[i].enabled && world.isAlive(entity) then return worldPosition(world, entity)
    }
    return .(0.0, 0.0, 0.0)
}
