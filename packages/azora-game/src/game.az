/** A scene game declares one configuration named game in its entry module. */
pack GameConfig {
    fin title: String
    fin width: Int = 1280
    fin height: Int = 760
    fin scene: String = "scene.azscene"
    /**
     * Physics steps per second when nothing overrides it. The simulation runs
     * at this fixed rate, whatever the frame rate, and each frame is drawn
     * between the last two steps by the time left over (as Unreal's fixed
     * physics with interpolation). AZORA_PHYSICS_RATE (Studio's Preferences,
     * "Physics steps per second") sets it for a run.
     */
    fin physicsRate: Int = 120
    fin maxFrameSeconds: Double = 0.08
}

/** Which render stages the game's systems use, found once from its plan. */
pack RenderStages {
    var sky: Bool = false
    var volumes: Bool = false
    var transparent: Bool = false
}

pack Game {
    var world: World!
    var window: App!
    var overlay: Composition!
    /** The sound this frame mixes: `Audio` systems add their voices to `frame.audio`. */
    var audio: AudioOutput!
    var view: SceneView = .()
    var stages: RenderStages = .()
    var atmosphere: AetherRenderer = .()
    var atmosphereTried: Bool = false
    var atmosphereActive: Bool = false
    /** The particle stages, compiled the first time something emits; [particlesTried] keeps a failure from retrying every frame. */
    var particles: ParticlePipelines = .()
    var particlesTried: Bool = false
    var camera: EditorCamera = .()
    var stats: FrameStats = .()
    var time: Time = timeInit()
    var paused: Bool = false
    var action: Int = 0
    var interpolation: Double = 0.0
    /** Set false while an opaque screen covers the world. The 2D UI still renders. */
    var drawWorld: Bool = true
}

impl Game { func fromGame(frame: Game!): Game! = frame }
impl World { func fromGame(frame: Game!): World! = frame.world }
impl Time { func fromGame(frame: Game!): Time& = frame.time }
impl Anchor { func fromGame(frame: Game!): Anchor = Anchor(frame.overlay, frame.overlay.root) }
impl QueryOf<...T> {
    func fromGame(frame: Game!): QueryOf<...T> = QueryOf::provide(frame.world)
}

/** Resolve each declared parameter at the point its system runs. */
react func dispatchGame(plan: SystemPlan&, phase: SystemPhase, frame: Game!) {
    for step: Int in 0..<plan.resolvedCount {
        fin due = plan.resolved[step]
        if plan.systems[due].phase == phase && plan.systems[due].enabled {
            var index = 0
            inline for S in reflect<*>.withAnnot<System> {
                if index == due {
                    S(inline for P in reflect<S>.params { P::fromGame(frame) })
                }
                index++
            }
        }
    }
}

/** Points [frame.view] at this frame's camera and scene targets, keeping last frame's transform as its past. */
func updateSceneView(frame: Game!, viewProj: Mat4&, rect: ViewRect&) {
    let camera: EditorCamera& = frame.camera.&
    let gpu: AzGpu! = frame.window.gpu
    fin view = frame.view.matrices
    if view != 0 {
        // Last frame's pair becomes the past; a first frame's past is itself.
        if frame.view.frame > 0 then azCopy(view + 128, view, 128)
        pokeMat4(view, 0, viewProj)
        pokeMat4(view, 64, mat4Inverse(viewProj))
        if frame.view.frame == 0 then azCopy(view + 128, view, 128)
    }
    fin eye = camera.position()
    fin forward = camera.forward()
    fin right = camera.right()
    fin up = camera.up()
    fin moved = frame.view.frame > 0 && frame.time.deltaSecs > 0.0
    frame.view.motionX = if moved then (eye.x - frame.view.eyeX) / frame.time.deltaSecs else 0.0
    frame.view.motionY = if moved then (eye.y - frame.view.eyeY) / frame.time.deltaSecs else 0.0
    frame.view.motionZ = if moved then (eye.z - frame.view.eyeZ) / frame.time.deltaSecs else 0.0
    frame.view.eyeX = eye.x
    frame.view.eyeY = eye.y
    frame.view.eyeZ = eye.z
    frame.view.forwardX = forward.x
    frame.view.forwardY = forward.y
    frame.view.forwardZ = forward.z
    frame.view.rightX = right.x
    frame.view.rightY = right.y
    frame.view.rightZ = right.z
    frame.view.upX = up.x
    frame.view.upY = up.y
    frame.view.upZ = up.z
    frame.view.tangent = tan(camera.fov * degreesToRadians * 0.5)
    frame.view.aspect = rect.aspect()
    frame.view.near = camera.near
    frame.view.far = camera.far
    frame.view.time = frame.time.elapsedSecs
    frame.view.delta = frame.time.deltaSecs
    frame.view.frame++
    frame.view.commands = gpu.cmd
    frame.view.device = gpu.device
    frame.view.encoder = gpu.enc
    frame.view.fullWidth = gpu.depthW as Int
    frame.view.fullHeight = gpu.depthH as Int
    fin pass = gpu.scenePass.active
    frame.view.upscaled = pass && gpu.upscale
    frame.view.color = if pass then gpu.scenePass.color else 0
    frame.view.depth = if pass then gpu.scenePass.depth else 0
    frame.view.width = if pass then gpu.scenePass.width as Int else gpu.depthW as Int
    frame.view.height = if pass then gpu.scenePass.height as Int else gpu.depthH as Int
    frame.view.jitterX = if pass then gpu.scenePass.jitterX else 0.0
    frame.view.jitterY = if pass then gpu.scenePass.jitterY else 0.0
}

/** A scene emitter's running pool, made from its `ParticleEmitter` the first time it is drawn. */
@Component
pack ParticleRuntime {
    var system: ParticleSystem = .()
    var capacity: Int = 0
    var simulation: Int = -1
}

/** Compiles the particle stages once; answers whether they are ready. */
func ensureParticles(frame: Game!): Bool {
    if !frame.particlesTried {
        frame.particles = makeParticlePipelines(frame.window.gpu.device)
        frame.particlesTried = true
    }
    return frame.particles.ready
}

/**
 * How particles see this frame: the camera and its targets, last frame's
 * transform and depth for collisions, the scene's light, wind and lamps.
 * [commands] is where the simulation is encoded.
 */
func particleViewOf(frame: Game!, commands: Long): ParticleView {
    let gpu: AzGpu! = frame.window.gpu
    fin light = sceneLightFrom(frame.world, frame.view.time)
    fin weather = resourceNamedOr<SceneEnvironment>(frame.world, "SceneEnvironment", SceneEnvironment())
    // A Wind in the scene blows the particles; without one, the weather's own wind does.
    fin windy = frame.world.isAlive(sceneWindEntity(frame.world))
    fin blowing = if windy then sceneWind(frame.world, frame.view.time) else Vec3(weather.windX, 0.0, weather.windZ)
    fin matrices = frame.view.matrices
    return ParticleView(commands: commands, viewProj: matrices, previousViewProj: matrices + 128, previousInverse: matrices + 192,
        depth: frame.view.depth, eyeX: frame.view.eyeX, eyeY: frame.view.eyeY, eyeZ: frame.view.eyeZ, time: frame.view.time
        delta: frame.view.delta, motionX: frame.view.motionX, motionY: frame.view.motionY, motionZ: frame.view.motionZ
        fullWidth: frame.view.fullWidth as Double, fullHeight: frame.view.fullHeight as Double
        depthWidth: frame.view.width as Double, depthHeight: frame.view.height as Double, near: frame.view.near, far: frame.view.far
        focal: (frame.view.fullHeight as Double) * 0.5 / frame.view.tangent, windX: blowing.x, windY: blowing.y, windZ: blowing.z
        lightX: light.direction.x, lightY: light.direction.y, lightZ: light.direction.z, lightStrength: light.intensity
        lightRed: light.color.r, lightGreen: light.color.g, lightBlue: light.color.b, ambient: light.ambient
        airRed: light.haze.r * (0.25 + 0.75 * light.daylight), airGreen: light.haze.g * (0.25 + 0.75 * light.daylight)
        airBlue: light.haze.b * (0.25 + 0.75 * light.daylight), lights: gpu.localLights)
}

/** Steps every scene emitter, in a command buffer of its own committed before the frame's (collisions read last frame's depth). */
func simulateSceneEmitters(frame: Game!) {
    fin emitters = ensureStorage<ParticleEmitter>(frame.world)
    if storageLength<ParticleEmitter>(emitters) == 0 || !ensureParticles(frame) then return
    let runtimes = ensureStorage<ParticleRuntime>(frame.world)
    fin commands = send0(frame.window.gpu.queue, sel("commandBuffer"))
    fin seen = particleViewOf(frame, commands)
    var index = 0
    while index < storageLength<ParticleEmitter>(emitters) {
        fin entity = storageEntityAt<ParticleEmitter>(emitters, index)
        fin emitter = emitters.values[index].clone()
        if emitter.enabled && frame.world.isAlive(entity) && visibleInWorld(frame.world, entity) {
            fin wanted = if emitter.capacity > 0 then emitter.capacity else 1
            if !storageHas<ParticleRuntime>(runtimes, entity) || storageGet<ParticleRuntime>(runtimes, entity).capacity != wanted ||
                storageGet<ParticleRuntime>(runtimes, entity).simulation != emitter.simulation {
                storageInsert<ParticleRuntime>(runtimes, entity, ParticleRuntime(particleSystem(frame.window.gpu.device, frame.window.gpu.queue,
                    wanted, emitter.simulation == 1, 1), wanted, emitter.simulation))
            }
            let store = ensureStorage<ParticleRuntime>(frame.world)
            store.values[storageIndexOf<ParticleRuntime>(store, entity)].system.simulate(frame.particles, emitter, seen, worldPosition(frame.world, entity))
        }
        index++
    }
    send0(commands, sel("commit"))
}

/** Draws every scene emitter over the finished view. */
func drawSceneEmitters(frame: Game!) {
    fin emitters = ensureStorage<ParticleEmitter>(frame.world)
    if storageLength<ParticleEmitter>(emitters) == 0 || !frame.particles.ready || frame.view.depth == 0 then return
    fin runtimes = ensureStorage<ParticleRuntime>(frame.world)
    fin seen = particleViewOf(frame, 0)
    var index = 0
    while index < storageLength<ParticleEmitter>(emitters) {
        fin entity = storageEntityAt<ParticleEmitter>(emitters, index)
        fin emitter = emitters.values[index].clone()
        if emitter.enabled && storageHas<ParticleRuntime>(runtimes, entity) {
            storageGet<ParticleRuntime>(runtimes, entity).system.draw(frame.particles, emitter, seen, frame.window.gpu.enc,
                frame.view.depth, frame.window.gpu.depthOff)
        }
        index++
    }
    frame.window.gpu.mode = -1
    frame.window.gpu.meshPipeline = 0
}

/**
 * The 3D view, in stages: the sky (a `RenderSky` system's, else the built-in
 * one), the opaque scene, `RenderVolumes` over its colour and depth, the
 * temporal resolve, then `RenderTransparent` at full resolution.
 */
react func drawGameScene(frame: Game!, plan: SystemPlan&, meshes: PrimitiveMeshes&, rect: ViewRect&) {
    let camera: EditorCamera& = frame.camera.&
    fin elapsed = frame.time.elapsedSecs
    let gpu: AzGpu! = frame.window.gpu
    fin emitting = storageLength<ParticleEmitter>(ensureStorage(frame.world)) > 0
    fin skyOwner = atmosphereEntity(frame.world)
    fin physicalSky = frame.world.isAlive(skyOwner)
    if physicalSky && !frame.atmosphereTried {
        frame.atmosphere = makeAetherRenderer(gpu.device)
        frame.atmosphereTried = true
    }
    if physicalSky {
        prepareAtmosphere(frame.world, skyOwner, frame.atmosphere, elapsed, camera.position())
    } else if frame.atmosphereActive {
        publishSceneEnvironment(frame.world, .())
    }
    frame.atmosphereActive = physicalSky
    gpu.offscreenScene = frame.stages.volumes || frame.stages.transparent || emitting || (physicalSky && frame.atmosphere.ready)
    gpu.skyClaimed = false
    fin viewProj = camera.viewProj(rect.aspect())
    frame.window.beginScenePass()
    updateSceneView(frame, viewProj, rect)
    if emitting then simulateSceneEmitters(frame)
    if frame.stages.sky || physicalSky then dispatchGame(plan, .RenderSky, frame)
    if !gpu.skyClaimed && physicalSky && frame.atmosphere.ready {
        fin sky = storageGet<AetherSky>(ensureStorage(frame.world), skyOwner)
        writeAetherView(frame.atmosphere.uniforms, frame.view, sky)
        ensureCloudTargets(gpu.device, frame.atmosphere, frame.view.fullWidth, frame.view.fullHeight)
        fin commands = updateAetherTables(gpu.queue, frame.atmosphere, sky)
        if gpu.timing {
            send0(commands, sel("waitUntilCompleted"))
            gpu.gpuSeconds += azSendD0(commands, sel("GPUEndTime")) - azSendD0(commands, sel("GPUStartTime"))
        }
        drawAtmosphereSky(frame.window.beginCustomSky(), gpu.depthOff, frame.atmosphere)
    }
    if !gpu.skyClaimed {
        fin skyEntity = sceneSkyLight(frame.world)
        if frame.world.isAlive(skyEntity) {
            fin environment = storageGet<SkyEnvironment>(storageOf(frame.world), skyEntity)
            fin sky = sampleSky(environment, elapsed)
            frame.window.drawSkyView(0.0, 0.0, rect.width, rect.height, sky,
                camera.forward(), camera.right(), camera.up(), tan(camera.fov * degreesToRadians * 0.5))
        }
    }
    frame.window.beginView(viewProj, rect)
    frame.window.setMaterialEye(camera.position())
    frame.window.applySceneLight(frame.world, elapsed)
    frame.window.updateScenePhotons(frame.world, camera.target, elapsed)
    frame.window.drawScene(frame.world, meshes, elapsed: elapsed)
    if (frame.stages.volumes || (physicalSky && frame.atmosphere.ready)) && gpu.scenePass.active {
        frame.window.suspendScenePass()
        frame.view.encoder = 0
        frame.view.commands = gpu.cmd
        if physicalSky && frame.atmosphere.ready then drawAtmosphereAir(frame.view, frame.atmosphere)
        if frame.stages.volumes then dispatchGame(plan, .RenderVolumes, frame)
    }
    frame.window.endView()
    if emitting && gpu.hasEncoder {
        frame.view.encoder = gpu.enc
        drawSceneEmitters(frame)
    }
    if (frame.stages.transparent || physicalSky) && gpu.hasEncoder {
        frame.view.encoder = gpu.enc
        dispatchGame(plan, .RenderTransparent, frame)
        gpu.mode = -1
        gpu.meshPipeline = 0
    }
}

/** A scene without an atmosphere only pays for render stages supplied by the game. */
func customGameRenderStage(plan: SystemPlan&, phase: SystemPhase): Bool {
    for scheduled in plan.systems {
        if scheduled.phase == phase && scheduled.enabled && scheduled.name != "simulateAetherPrecipitation" &&
            scheduled.name != "drawAetherPrecipitation" && scheduled.name != "drawAetherBolts" then return true
    }
    return false
}

/** Physics steps per second for this run: AZORA_PHYSICS_RATE when it names one (10 to 1000), else the game's. */
func physicsRateOf(config: GameConfig&): Int {
    fin asked = leadingNumber(envVar("AZORA_PHYSICS_RATE"))
    return if asked >= 10 && asked <= 1000 then asked else config.physicsRate
}

react func runSceneGame(config: GameConfig&)
in assert config.physicsRate > 0 && config.maxFrameSeconds > 0.0 panic "invalid game clock"
scope {
    fin plan = systemPlan()
    assert !plan.cyclic panic plan.cycleReport
    enterWorkingDirectory()
    var world: World = .()
    var file = readFile(config.scene)
    fin loaded = file.ok() && readScene(world, file.text(0, file.size)) >= 0
    file.release()
    if !loaded {
        println("Could not load ${config.scene}")
        return
    }
    var window = appInit(config.title, config.width, config.height)
    if !window.ok then return
    defer { window.shutdown() }
    window.setFusionRoot(".")
    window.prepareFusionMaterials(world)
    var meshes = window.primitiveMeshes()
    defer { window.releasePrimitives(meshes) }
    var uiWorld: World = .()
    var overlay = Composition::of(uiWorld, "game")
    defer { overlay.dispose() }
    var audio = audioOutputOpen()
    defer { audio.close() }
    var frame: Game = .(world, window, overlay, audio)
    frame.stages = RenderStages(customGameRenderStage(plan,.RenderSky),phaseHasSystems(plan,.RenderVolumes),
        customGameRenderStage(plan,.RenderTransparent))
    frame.view.matrices = azAlloc(sceneViewMatrixBytes)
    defer { azFree(frame.view.matrices) }
    fin rate = physicsRateOf(config)
    world.setFixedTimestep(1.0 / (rate as Double))
    frame.time.setFixedDelta(world.fixedTimestep)
    dispatchGame(plan, .Startup, frame)

    while window.frame() {
        fin seconds = window.deltaTime()
        frame.stats.tick(seconds)
        frame.action = if window.mouseClicked(.Left) then overlay.hit(window.mouseX(), window.mouseY()) else 0
        fin wasPaused = frame.paused
        fin delta = if seconds < config.maxFrameSeconds then seconds else config.maxFrameSeconds
        frame.time.deltaSecs = if wasPaused then 0.0 else delta
        dispatchGame(plan, .PreUpdate, frame)
        frame.time.advance(if frame.paused || wasPaused then 0.0 else delta)
        if !frame.paused && !wasPaused {
            world.progress(frame.time.deltaSecs)
            while world.consumeFixedStep() then dispatchGame(plan, .FixedUpdate, frame)
            // What is drawn this frame lies between the last two steps by the time left over.
            frame.interpolation = world.fixedAccumulator / world.fixedTimestep
            dispatchGame(plan, .Update, frame)
            dispatchGame(plan, .PostUpdate, frame)
        }

        fin rect: ViewRect = .(0.0, 0.0, window.width() as Double, window.height() as Double)
        if frame.drawWorld then drawGameScene(frame, plan, meshes, rect)
        overlay.begin()
        dispatchGame(plan, .Render, frame)
        overlay.commit()
        var child = 0
        while child < overlay.childCount(overlay.root) {
            fin node = overlay.childAt(overlay.root, child)
            overlay.arrange(node, 0.0, 0.0, rect.width, rect.height)
            paintTree(window, overlay, node, 0.0, rect.height)
            child++
        }
        window.present()
        // Sound for the frame just shown, heard from the camera; paused games still mix (a fade, a menu click).
        audio.setListener(frame.camera.position(), frame.camera.forward(), frame.camera.right(), delta)
        if audio.beginBlock() > 0 {
            dispatchGame(plan, .Audio, frame)
            audio.endBlock()
        }
        dispatchGame(plan, .Last, frame)
    }
}

// Weather stages

/**
 * The weather's runtime on the Atmosphere's entity, made when it is first
 * needed: its state; the precipitation pools once Rain, Snow or Dust is in
 * the scene; the storm once Thunder is; the voices once there is rain or
 * wind to hear. A scene without them pays for none of it.
 */
@System(phase: .PreUpdate)
func prepareWeather(frame: Game!) {
    fin owner = atmosphereEntity(frame.world)
    if !frame.world.isAlive(owner) then return
    if !storageHas<AetherState>(ensureStorage(frame.world), owner) then storageInsert<AetherState>(ensureStorage(frame.world), owner, .())
    fin parts = weatherParts(frame.world)
    if (parts.rain.enabled || parts.snow.enabled || parts.dust.enabled) && !storageHas<AetherPrecipitation>(ensureStorage(frame.world), owner) {
        storageInsert<AetherPrecipitation>(ensureStorage(frame.world), owner, aetherPrecipitation(frame.window.gpu.device, frame.window.gpu.queue))
    }
    if parts.thunder.enabled && !storageHas<AetherStorm>(ensureStorage(frame.world), owner) {
        storageInsert<AetherStorm>(ensureStorage(frame.world), owner, aetherStorm(frame.window.gpu.device, frame.audio.rate as Double))
    }
    if (parts.rain.enabled || frame.world.isAlive(sceneWindEntity(frame.world))) && !storageHas<AetherSound>(ensureStorage(frame.world), owner) {
        storageInsert<AetherSound>(ensureStorage(frame.world), owner, aetherSound())
    }
}

/** Moves the weather on and hands it to the atmosphere's renderer. */
@System(phase: .PostUpdate)
func simulateWeather(frame: Game!) {
    fin owner = atmosphereEntity(frame.world)
    if !frame.world.isAlive(owner) then return
    let store = ensureStorage<AetherState>(frame.world)
    fin at = storageIndexOf<AetherState>(store, owner)
    if at < 0 then return
    previewWeather(frame.world, owner, store.values[at], frame.time.elapsedSecs, frame.time.deltaSecs, frame.camera.position(),
        frame.camera.right())
}

/**
 * Moves rain, snow and dust one step, on the GPU, in a command buffer
 * committed before the frame's: the drops' collisions read the depth the last
 * frame left, and their hits spawn the splashes.
 */
@System(phase: .RenderSky)
func simulateAetherPrecipitation(frame: Game!, skies: @query [AetherSky&, AetherState&, AetherPrecipitation!]) {
    while skies.hasNext() {
        let row = skies.next()
        let sky: AetherSky& = row.1
        let state: AetherState& = row.2
        let rain: AetherPrecipitation! = row.3
        if !sky.enabled || !rain.ready || !ensureParticles(frame) then continue
        fin parts = weatherParts(frame.world)
        // How far and how much landing drops splash: the Rain's settings.
        fin reach = weatherClamp(parts.rain.splashDistance, 5.0, 80.0)
        if absValue(reach - rain.reach) > 0.5 then sizeImpacts(rain, frame.window.gpu.device, frame.window.gpu.queue, reach)
        fin splashes = weatherClamp(parts.rain.splashes, 0.0, 1.0)
        fin falling = weatherClamp(state.rain, 0.0, 1.0)
        fin snowing = weatherClamp(state.snow, 0.0, 1.0)
        fin dusting = weatherClamp(state.dust, 0.0, 1.0)
        if falling <= 0.0 && snowing <= 0.0 && dusting <= 0.0 && rain.rings.active == 0 && rain.puffs.active == 0 then return
        fin commands = send0(frame.window.gpu.queue, sel("commandBuffer"))
        fin seen = particleViewOf(frame, commands)
        fin eye: Vec3 = .(seen.eyeX, seen.eyeY, seen.eyeZ)
        rain.dropsNear.simulate(frame.particles, dropEmitter(9.0, 4.5, falling, false), seen, eye, falling)
        rain.dropsFar.simulate(frame.particles, dropEmitter(35.0, 35.0, falling, false), seen, eye, falling)
        rain.impacts.simulate(frame.particles, impactEmitter(reach, falling), seen, eye, falling)
        rain.impactsNear.simulate(frame.particles, impactEmitter(nearReach, falling), seen, eye, falling)
        rain.rings.spawnFromHits(frame.particles, ringEmitter(state.wetness, splashes), seen, rain.impacts, 1, 1, false)
        rain.rings.spawnFromHits(frame.particles, ringEmitter(state.wetness, splashes), seen, rain.impactsNear, 1, 1)
        // A weak splash throws one droplet a landing; a strong one, three.
        fin perLanding = if splashes < 0.05 then 0 else if splashes < 0.4 then 1 else if splashes < 0.75 then 2 else 3
        if perLanding > 0 {
            rain.droplets.spawnFromHits(frame.particles, dropletEmitter(splashes), seen, rain.impacts, perLanding, 3, false)
            rain.droplets.spawnFromHits(frame.particles, dropletEmitter(splashes), seen, rain.impactsNear, perLanding, 3)
        }
        rain.flakesNear.simulate(frame.particles, flakeEmitter(9.0, true), seen, eye, snowing)
        rain.flakesFar.simulate(frame.particles, flakeEmitter(35.0, false), seen, eye, snowing)
        rain.puffs.spawnFromHits(frame.particles, puffEmitter(), seen, rain.flakesNear, 1, 2)
        fin mote = weatherClamp(parts.dust.moteSize, 0.2, 10.0) * 0.001
        rain.motesNear.simulate(frame.particles, moteEmitter(12.0, mote, parts.dust.color), seen, eye, dusting)
        rain.motesFar.simulate(frame.particles, moteEmitter(40.0, mote * 4.0, parts.dust.color), seen, eye, dusting)
        send0(commands, sel("commit"))
        // Under AZORA_GPU_TIMING the frame's GPU time counts this command buffer too.
        if frame.window.gpu.timing {
            send0(commands, sel("waitUntilCompleted"))
            frame.window.gpu.gpuSeconds += azSendD0(commands, sel("GPUEndTime")) - azSendD0(commands, sel("GPUStartTime"))
        }
        return
    }
}

/** Draws rain, snow, dust and their splashes over the finished view, soft against what the scene drew. */
@System(phase: .RenderTransparent)
func drawAetherPrecipitation(frame: Game!, skies: @query [AetherSky&, AetherState&, AetherPrecipitation&]) {
    while skies.hasNext() {
        let row = skies.next()
        let sky: AetherSky& = row.1
        let state: AetherState& = row.2
        let rain: AetherPrecipitation& = row.3
        if !sky.enabled || !rain.ready || !frame.particles.ready || frame.view.encoder == 0 || frame.view.depth == 0 then continue
        fin parts = weatherParts(frame.world)
        fin falling = weatherClamp(state.rain, 0.0, 1.0)
        fin snowing = weatherClamp(state.snow, 0.0, 1.0)
        fin dusting = weatherClamp(state.dust, 0.0, 1.0)
        fin splashes = weatherClamp(parts.rain.splashes, 0.0, 1.0)
        fin seen = particleViewOf(frame, 0)
        fin encoder = frame.view.encoder
        fin depth = frame.view.depth
        fin still = frame.window.gpu.depthOff
        rain.rings.draw(frame.particles, ringEmitter(state.wetness, splashes), seen, encoder, depth, still)
        rain.droplets.draw(frame.particles, dropletEmitter(splashes), seen, encoder, depth, still)
        rain.puffs.draw(frame.particles, puffEmitter(), seen, encoder, depth, still)
        if falling > 0.0 {
            rain.dropsFar.draw(frame.particles, dropEmitter(35.0, 35.0, falling, false), seen, encoder, depth, still)
            rain.dropsNear.draw(frame.particles, dropEmitter(9.0, 4.5, falling, true), seen, encoder, depth, still)
        }
        if snowing > 0.0 {
            rain.flakesFar.draw(frame.particles, flakeEmitter(35.0, false), seen, encoder, depth, still)
            rain.flakesNear.draw(frame.particles, flakeEmitter(9.0, true), seen, encoder, depth, still)
        }
        if dusting > 0.0 {
            fin mote = weatherClamp(parts.dust.moteSize, 0.2, 10.0) * 0.001
            rain.motesFar.draw(frame.particles, moteEmitter(40.0, mote * 4.0, parts.dust.color), seen, encoder, depth, still)
            rain.motesNear.draw(frame.particles, moteEmitter(12.0, mote, parts.dust.color), seen, encoder, depth, still)
        }
        frame.window.gpu.mode = -1
        frame.window.gpu.meshPipeline = 0
        return
    }
}

/** Draws the bolts of ground strikes while they flash, over the finished view; mountains in front hide them. */
@System(phase: .RenderTransparent)
func drawAetherBolts(frame: Game!, skies: @query [AetherSky&, AetherStorm&]) {
    while skies.hasNext() {
        let row = skies.next()
        let sky: AetherSky& = row.1
        let storm: AetherStorm& = row.2
        if !sky.enabled || !storm.ready || frame.view.encoder == 0 || frame.view.depth == 0 || frame.view.matrices == 0 then continue
        fin encoder = frame.view.encoder
        azCopy(storm.block, frame.view.matrices, 64)
        fin focal = (frame.view.fullHeight as Double) * 0.5 / frame.view.tangent
        for s: Int in 0..<strikeSlots {
            if field(storm, s, 0) > 0.5 && field(storm, s, 5) > 0.5 {
                fin glow = flashOf(storm, s, frame.view.time - field(storm, s, 1))
                if glow > 0.01 {
                    pokeVector(storm.block, 64, frame.view.fullWidth as Double, frame.view.fullHeight as Double, frame.view.width as Double,
                        frame.view.height as Double)
                    pokeVector(storm.block, 80, focal, glow, frame.view.near, frame.view.far)
                    send1(encoder, sel("setRenderPipelineState:"), storm.boltPipeline)
                    send1(encoder, sel("setDepthStencilState:"), frame.window.gpu.depthOff)
                    send3(encoder, sel("setVertexBuffer:offset:atIndex:"), storm.segments, ((s * boltSegments) as Long) * segmentBytes, 0)
                    send3(encoder, sel("setVertexBytes:length:atIndex:"), storm.block, 96, 1)
                    send3(encoder, sel("setFragmentBytes:length:atIndex:"), storm.block, 96, 1)
                    send2(encoder, sel("setFragmentTexture:atIndex:"), frame.view.depth, 0)
                    send4(encoder, sel("drawPrimitives:vertexStart:vertexCount:instanceCount:"), 4, 0, 4, field(storm, s, 12) as Long)
                }
            }
        }
        frame.window.gpu.mode = -1
        frame.window.gpu.meshPipeline = 0
        return
    }
}

/** The thunder heard from the camera. */
@System(phase: .Audio)
func mixAetherThunder(frame: Game!, skies: @query [AetherSky&, AetherStorm!]) {
    while skies.hasNext() {
        let row = skies.next()
        let sky: AetherSky& = row.1
        let storm: AetherStorm! = row.2
        if !sky.enabled || frame.audio.frames <= 0 then continue
        fin thunder = weatherParts(frame.world).thunder
        mixThunder(storm, frame.audio.mix, frame.audio.frames, frame.audio.rate as Double, if thunder.enabled then thunder.volume else 1.0)
        return
    }
}

/** The weather heard from the camera: rain and wind, into this frame's block (thunder has its own system). */
@System(phase: .Audio)
func mixAetherWeather(frame: Game!, skies: @query [AetherSky&, AetherState&, AetherSound!]) {
    while skies.hasNext() {
        let row = skies.next()
        let sky: AetherSky& = row.1
        let state: AetherState& = row.2
        let sound: AetherSound! = row.3
        if !sky.enabled || frame.audio.frames <= 0 then continue
        fin rain = weatherParts(frame.world).rain
        fin windy = sceneWindEntity(frame.world)
        fin windVolume = if frame.world.isAlive(windy) then storageGet<Wind>(ensureStorage(frame.world), windy).volume else 0.0
        mixWeather(sound, state, if rain.enabled then rain.volume else 1.0, windVolume, frame.audio.mix, frame.audio.frames,
            frame.audio.rate as Double)
        return
    }
}

