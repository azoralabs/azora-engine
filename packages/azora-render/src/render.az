// Azora Engine — camera.
//
// A first-person fly camera. Movement/look read input from the [App]; the
// view-projection matrix is computed in Azora (az_math.az) and uploaded with
// `app.applyCamera(cam)`.

module engine.render

exposed import engine.render.webgl

import engine.ui
import engine.math.vec
import engine.math.mat
import engine.core
import engine.input
import engine.platform

pack Camera {
    var pos: Vec3
    var yaw: std::Double
    var pitch: std::Double
    var fovDeg: std::Double
}

pack Color {
    var r: std::Double
    var g: std::Double
    var b: std::Double
    var a: std::Double
}

pack Material {
    var color: Color
    var roughness: std::Double
}

pack Transform3d {
    var position: Vec3
    var rotation: Vec3
    var scale: Vec3
}

/**
 * ECS transform used by architecture-style systems.
 *
 * `Transform3d` remains available to existing render queues; this component
 * uses the conventional `translation` field expected by gameplay systems.
 */
@Component
pack Transform {
    var translation: Vector3
    var rotation: Vector3
    var scale: Vector3
}

func transformEcsDefault(): Transform {
    return Transform(Vector3::Zero, Vector3::Zero, Vec3(1.0, 1.0, 1.0))
}

pack RenderItem {
    var mesh: Mesh
    var transform: Transform3d
    var material: Material
}

pack RenderQueue {
    var items: std::Array<RenderItem>
    var itemCount: std::Int
}

func cameraDefault(): Camera {
    return Camera(Vec3(0.0, 1.5, 5.0), 0.0, -0.15, 60.0)
}

func colorRgb(r: std::Double, g: std::Double, b: std::Double): Color {
    return Color(r, g, b, 1.0)
}

func colorRgba(r: std::Double, g: std::Double, b: std::Double, a: std::Double): Color {
    return Color(r, g, b, a)
}

func materialColor(color: Color): Material {
    return Material(color, 0.8)
}

func transformDefault(): Transform3d {
    return Transform3d(Vec3(0.0, 0.0, 0.0), Vec3(0.0, 0.0, 0.0), Vec3(1.0, 1.0, 1.0))
}

func transformAt(position: Vec3): Transform3d {
    return Transform3d(position, Vec3(0.0, 0.0, 0.0), Vec3(1.0, 1.0, 1.0))
}

func renderQueueInit(): RenderQueue {
    // Enough room for a streamed city neighborhood, landmark geometry and
    // traffic without replacing a persistent queue inside a frame arena.
    var items: std::Array<RenderItem> = std::Array::fill<RenderItem>(2048)
    return RenderQueue(items, 0)
}

impl Camera {
    /// The horizontal direction the camera faces (unit XZ vector).
    func forward(): Vec3 {
        return Vec3(0.0 - sin(self.yaw), 0.0, 0.0 - cos(self.yaw))
    }

    /// The camera's right direction (unit XZ vector).
    func right(): Vec3 {
        return Vec3(cos(self.yaw), 0.0, 0.0 - sin(self.yaw))
    }

    /// The view-projection matrix for this camera at the given aspect ratio.
    func viewProj(aspect: std::Double): Mat4 {
        fin rotP = mat4RotationX(0.0 - self.pitch)
        fin rotY = mat4RotationY(0.0 - self.yaw)
        fin trans = mat4Translation(0.0 - self.pos.x, 0.0 - self.pos.y, 0.0 - self.pos.z)
        fin viewM = mat4Mul(rotP, mat4Mul(rotY, trans))
        fin proj = mat4Perspective(self.fovDeg, aspect, 0.1, 200.0)
        return mat4Mul(proj, viewM)
    }

    /// Standard fly controls: WASD moves in the yaw plane, Q/E (or
    /// Space/Shift) moves down/up, arrow keys look around.
    func update(app: App, dt: std::Double, moveSpeed: std::Double, lookSpeed: std::Double) {
        var move = vec3Zero()
        if app.keyDown(keyW) { move = move + self.forward() }
        if app.keyDown(keyS) { move = move - self.forward() }
        if app.keyDown(keyD) { move = move + self.right() }
        if app.keyDown(keyA) { move = move - self.right() }
        if (app.keyDown(keyE) || app.keyDown(keySpace)) { move = move + Vec3(0.0, 1.0, 0.0) }
        if (app.keyDown(keyQ) || app.keyDown(keyShift)) { move = move - Vec3(0.0, 1.0, 0.0) }

        fin step = move.normalized.scale(moveSpeed * dt)
        self.pos = self.pos + step

        if app.keyDown(keyArrowLeft) { self.yaw = self.yaw + lookSpeed * dt }
        if app.keyDown(keyArrowRight) { self.yaw = self.yaw - lookSpeed * dt }
        if app.keyDown(keyArrowUp) { self.pitch = self.pitch + lookSpeed * dt }
        if app.keyDown(keyArrowDown) { self.pitch = self.pitch - lookSpeed * dt }

        // Clamp pitch to avoid flipping over the poles.
        if self.pitch > 1.5 { self.pitch = 1.5 }
        if self.pitch < -1.5 { self.pitch = -1.5 }
    }
}

impl Transform3d {
    func matrix(): Mat4 {
        fin translate = mat4Translation(self.position.x, self.position.y, self.position.z)
        fin rotateX = mat4RotationX(self.rotation.x)
        fin rotateY = mat4RotationY(self.rotation.y)
        fin rotateZ = mat4RotationZ(self.rotation.z)
        fin rotate = mat4Mul(rotateZ, mat4Mul(rotateY, rotateX))
        fin scaleM = mat4Scale(self.scale.x, self.scale.y, self.scale.z)
        return mat4Mul(translate, mat4Mul(rotate, scaleM))
    }
}

impl RenderQueue {
    func add(mesh: Mesh, transform: Transform3d, material: Material) {
        if self.itemCount >= self.items.size {
            var grown: std::Array<RenderItem> = std::Array::fill<RenderItem>(self.items.size * 2)
            var i = 0
            while i < self.itemCount {
                grown[i] = self.items[i]
                i = i + 1
            }
            self.items = grown
        }
        self.items[self.itemCount] = RenderItem(mesh, transform, material)
        self.itemCount = self.itemCount + 1
    }

    func clear() {
        self.itemCount = 0
    }

    func count(): std::Int {
        return self.itemCount
    }
}

impl App {
    /// Uploads a camera's view-projection matrix for subsequent drawMesh calls.
    func applyCamera(cam: Camera) {
        var aspect = 1.0
        fin h = self.height()
        if h > 0 {
            aspect = (self.width() as std::Double) / (h as std::Double)
        }
        pokeMat4(self.gpu.viewProj, 0L, cam.viewProj(aspect))
    }

    func drawMeshMaterial(mesh: Mesh, model: Mat4, material: Material) {
        fin color = material.color
        self.drawMesh(mesh, model, color.r, color.g, color.b)
    }

    func drawRenderItem(item: RenderItem) {
        self.drawMeshMaterial(item.mesh, item.transform.matrix(), item.material)
    }

    func drawRenderQueue(queue: RenderQueue) {
        var i = 0
        while i < queue.itemCount {
            self.drawRenderItem(queue.items[i])
            i = i + 1
        }
    }
}
