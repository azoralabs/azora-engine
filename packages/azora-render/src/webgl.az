module engine.render.webgl

import std.math
import engine.shaders

/**
 * @file engine/render/azWebRender
 *
 * Universal immediate rendering API for Azora Engine 0.0.4.
 *
 * Applications import `engine.render` and contain only Azora code. The engine
 * selects the device implementation for the compilation target: WebGL for
 * WebAssembly, Metal on Apple native targets, and Vulkan on supported native
 * targets. Device bridge functions below are an internal compiler/backend ABI;
 * they are not an application-facing browser API.
 *
 * Applications own their lifetime with `async func main`, await [nextFrame] inside
 * an ordinary Azora `loop`, record commands, and call [present]. WebAssembly
 * JSPI suspends that task at the browser repaint boundary without moving the
 * loop into host code. Native runners use the same lifecycle.
 *
 * @since 0.0.4
 */

realm engine {
    /** Rendering device selected for the current compilation target. */
    @std::Experimental(since: "0.1")
    enum RenderBackend {
        Metal,
        Vulkan,
        WebGL
    }

    /** Dimensionality of the active rendering surface. */
    @std::Experimental(since: "0.1")
    enum RenderMode {
        TwoD,
        ThreeD
    }

    /*
     * Internal WebAssembly device ABI. The WebGL backend implements these as
     * typed WASM imports; public engine behavior remains in Azora below.
     */
    bridge [.WebAssembly] {
        func engineWebOpen2d(width: std::Int, height: std::Int, vertexShader: std::String, fragmentShader: std::String): std::Unit
        func engineWebOpen3d(width: std::Int, height: std::Int, vertexShader: std::String, fragmentShader: std::String): std::Unit
        func engineWebNextFrame(): std::Double
        func engineWebPresent(): std::Unit
        func engineWebClear(r: std::Double, g: std::Double, b: std::Double): std::Unit
        func engineWebRect(x: std::Double, y: std::Double, width: std::Double, height: std::Double, r: std::Double, g: std::Double, b: std::Double, a: std::Double): std::Unit
        func engineWebCircle(x: std::Double, y: std::Double, radius: std::Double, r: std::Double, g: std::Double, b: std::Double, a: std::Double): std::Unit
        func engineWebCubeAt(x: std::Double, y: std::Double, z: std::Double, size: std::Double, rotateX: std::Double, rotateY: std::Double, rotateZ: std::Double, r: std::Double, g: std::Double, b: std::Double): std::Unit
        func engineWebCamera(distance: std::Double, fov: std::Double): std::Unit
        func engineWebLog(message: std::String): std::Unit
    }

    /** Returns the rendering backend used by a WebAssembly build. */
    @std::Experimental(since: "0.1")
    prop renderBackend[self: Self&]: RenderBackend = RenderBackend.WebGL

    /** Opens a resolution-independent 2D surface. Call once from `main`. */
    @std::Experimental(since: "0.1")
    func run2d(width: std::Int, height: std::Int) {
        engineWebOpen2d(width, height, webgl2dVertexShaderSource(), webgl2dFragmentShaderSource())
    }

    /** Opens a hardware-accelerated 3D surface. Call once from `main`. */
    @std::Experimental(since: "0.1")
    func run3d(width: std::Int, height: std::Int) {
        engineWebOpen3d(width, height, webgl3dVertexShaderSource(), webgl3dFragmentShaderSource())
    }

    /** Suspends the current task until the display is ready for another frame. */
    @std::Experimental(since: "0.1")
    async func nextFrame(): std::Double {
        return engineWebNextFrame()
    }

    /** Submits the commands recorded since [nextFrame] to the active device. */
    @std::Experimental(since: "0.1")
    func present() {
        engineWebPresent()
    }

    /** Clears the active frame with a linear RGB color. */
    @std::Experimental(since: "0.1")
    func clear(r: std::Double, g: std::Double, b: std::Double) {
        engineWebClear(r, g, b)
    }

    /** Draws a filled rectangle in logical 2D coordinates. */
    @std::Experimental(since: "0.1")
    func rect(x: std::Double, y: std::Double, width: std::Double, height: std::Double, r: std::Double, g: std::Double, b: std::Double, a: std::Double = 1.0) {
        engineWebRect(x, y, width, height, r, g, b, a)
    }

    /** Draws a filled circle in logical 2D coordinates. */
    @std::Experimental(since: "0.1")
    func circle(x: std::Double, y: std::Double, radius: std::Double, r: std::Double, g: std::Double, b: std::Double, a: std::Double = 1.0) {
        engineWebCircle(x, y, radius, r, g, b, a)
    }

    /** Draws or updates a lit cube. Rotation angles are radians. */
    @std::Experimental(since: "0.1")
    func cube(size: std::Double, rotateX: std::Double, rotateY: std::Double, rotateZ: std::Double, r: std::Double, g: std::Double, b: std::Double) {
        engineWebCubeAt(0.0, 0.0, 0.0, size, rotateX, rotateY, rotateZ, r, g, b)
    }

    /** Draws or updates a lit cube at the given world-space position. */
    @std::Experimental(since: "0.1")
    func cubeAt(x: std::Double, y: std::Double, z: std::Double, size: std::Double, rotateX: std::Double, rotateY: std::Double, rotateZ: std::Double, r: std::Double, g: std::Double, b: std::Double) {
        engineWebCubeAt(x, y, z, size, rotateX, rotateY, rotateZ, r, g, b)
    }

    /** Configures the perspective camera for the active 3D surface. */
    @std::Experimental(since: "0.1")
    func camera(distance: std::Double, fov: std::Double = 48.0) {
        engineWebCamera(distance, fov)
    }

    /** Returns a smooth sine wave for procedural animation. */
    @std::Experimental(since: "0.1")
    func wave(time: std::Double, amplitude: std::Double = 1.0, speed: std::Double = 1.0): std::Double {
        return std::sin(time * speed) * amplitude
    }

    /** Writes a message to the engine console. */
    @std::Experimental(since: "0.1")
    func log(message: std::String) {
        engineWebLog(message)
    }
}
