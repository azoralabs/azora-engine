/**
 * @file engine.water.ocean
 *
 * Oceans drawn by systems. Each [Ocean] is a square of cells around the eye
 * and rings around it, each ring's cells twice as wide (a clipmap), snapped
 * so the grid never swims; toward its outer edge a ring folds onto the
 * coarser one so they meet without cracks. Its [Sea] moves the vertices and
 * shades the pixels; maps of the ground under it around the eye
 * ([OceanShore], baked a few rows a frame from the loaded terrain) calm the
 * open sea's waves in the shallows and raise the surf instead
 * (engine.water.shore), and the opaque scene taken before the water is drawn
 * shows through it as deep as the light gets.
 */
module engine.water.ocean

import std.math
import engine.core
import engine.ecs
import engine.gpu
import engine.gpu.draw
import engine.io
import engine.math
import engine.math.mat
import engine.objc
import engine.platform
import engine.scene
import engine.scene.terrain
import engine.scene.transforms
import engine.gpu.terrain
import engine.atmosphere.view
import engine.render.scene
import engine.water.components
import engine.water.query
import engine.water.spectrum
import engine.water.seas
import engine.water.waves
import engine.water.shore
import engine.water.hull

/** The loaded terrain mesh of [entity]'s [surface] in [gpu], or -1 while it is not drawn yet. */
func loadedTerrain(gpu: AzGpu&, entity: Entity, surface: HeightfieldTerrain&): Int {
    for i: Int in 0..<gpu.terrains.size then if gpu.terrains[i].gradedEntity == entity.id then return i
    for i: Int in 0..<gpu.terrains.size then if gpu.terrains[i].gradedEntity < 0 && gpu.terrains[i].path == surface.image then return i
    for i: Int in 0..<gpu.terrains.size {
        if gpu.terrains[i].gradedEntity < 0 && surface.overviewImage != "" && gpu.terrains[i].path == surface.overviewImage then return i
    }
    return -1
}

/** A shown heightfield whose mesh is loaded, ready to be asked its height: its placement both ways and its mesh. */
pack ShoreGround derives Clone {
    var model: Mat4 = mat4Identity()
    var inverse: Mat4 = mat4Identity()
    var mesh: Int = -1
}

/** Every shown heightfield of [world] with a loaded mesh in [gpu]. */
func shoreGrounds(gpu: AzGpu&, world: World!): Array<ShoreGround> {
    var grounds: Array<ShoreGround> = []
    fin terrains = ensureStorage<HeightfieldTerrain>(world)
    for row: Int in 0..<storageLength<HeightfieldTerrain>(terrains) {
        fin entity = storageEntityAt<HeightfieldTerrain>(terrains, row)
        if !world.isAlive(entity) || !visibleInWorld(world, entity) then continue
        fin mesh = loadedTerrain(gpu, entity, terrains.values[row])
        if mesh < 0 then continue
        fin model = heightfieldMatrix(world, entity, terrains.values[row])
        grounds.add(ShoreGround(model.clone(), mat4Inverse(model), mesh))
    }
    return take grounds
}

/** The highest ground at world (x, z) under [grounds]; [GroundHeight.found] false where there is none. */
pack GroundHeight {
    var found: Bool = false
    var height: Double = 0.0
}

func groundUnder(gpu: AzGpu&, grounds: Array<ShoreGround>&, x: Double, z: Double): GroundHeight {
    var ground: GroundHeight = .()
    for g in grounds {
        // Into the terrain's unit square at its own base height (its height axis plays no part in x and z).
        fin base = g.model.m13
        fin u = g.inverse.m00 * x + g.inverse.m01 * base + g.inverse.m02 * z + g.inverse.m03
        fin v = g.inverse.m20 * x + g.inverse.m21 * base + g.inverse.m22 * z + g.inverse.m23
        if u < -0.5 || u > 0.5 || v < -0.5 || v > 0.5 then continue
        fin local = sampleTerrain(gpu.terrains[g.mesh].image, u, v)
        fin height = g.model.m10 * u + g.model.m11 * local + g.model.m12 * v + g.model.m13
        if !ground.found || height > ground.height then ground = .(true, height)
    }
    return take ground
}

/**
 * Keeps [shore]'s two maps covering the ground around [eye] under an ocean
 * at [level] for waves [length] metres long (deep water): the fine one wide
 * enough for the shallows the eye can tell apart (wider from higher up), the
 * far one [shoreFarScale] times wider. A map is baked again when the eye has
 * moved a quarter of the way out, the terrain changed or more of it was
 * loaded - its ground
 * [shoreRowsPerFrame] rows a frame, then its transforms a sweep a frame -
 * while the old one still shows; its travel times alone when the sea's
 * wavelength moved by more than a sixth.
 */
func tendShore(gpu: AzGpu&, world: World!, shore: OceanShore!, level: Double, reach: Double, eye: Vec3&, length: Double) {
    if storageLength<HeightfieldTerrain>(ensureStorage(world)) == 0 then return
    fin ground = ensureStorage<HeightfieldTerrain>(world).revision as Long
    fin size = waveClamp(absValue(eye.y - level) * 24.0 + 1200.0, 1200.0, 12000.0)
    tendShoreLevel(gpu, world, shore.near, level, reach, eye, size, length, ground)
    tendShoreLevel(gpu, world, shore.far, level, reach, eye, size * shoreFarScale, length, ground)
}

/** One of an ocean's shore maps kept over the square of [size] around [eye] (see [tendShore]). */
func tendShoreLevel(gpu: AzGpu&, world: World!, tier: ShoreLevel!, level: Double, reach: Double, eye: Vec3&, size: Double, length: Double, ground: Long) {
    // Terrain meshes load after the scene: a map waits for the first, and is made again when more come in.
    fin grounds = shoreGrounds(gpu, world)
    if grounds.size == 0 then return
    if !tier.baking {
        fin moved = !tier.ready || absValue(eye.x - tier.centerX) > tier.size * 0.25 || absValue(eye.z - tier.centerZ) > tier.size * 0.25 ||
            tier.ground != ground || tier.meshes != grounds.size || absValue(size - tier.size) > tier.size * 0.5
        if moved {
            fin snap = size / 8.0
            startShoreBake(tier, (round(eye.x / snap) as Double) * snap, (round(eye.z / snap) as Double) * snap, size, length)
            tier.ground = ground
            tier.meshes = grounds.size
        } else if absValue(length - tier.length) > tier.length / 6.0 {
            restartShoreTravel(tier, length)
        } else {
            return
        }
    }
    // The first map is made at once (the scene is loading): until it is there the open sea would run over the beaches.
    fin first = !tier.ready
    if tier.row < shoreTexels {
        fin last = if first then shoreTexels else if tier.row + shoreRowsPerFrame < shoreTexels then tier.row + shoreRowsPerFrame else shoreTexels
        for row: Int in tier.row..<last {
            fin z = shoreTexelCenter(tier.nextZ, tier.nextSize, row)
            for column: Int in 0..<shoreTexels {
                fin under = groundUnder(gpu, grounds, shoreTexelCenter(tier.nextX, tier.nextSize, column), z)
                // Where no terrain is loaded the sea is open: deep enough for every wave.
                tier.nextDepth[row * shoreTexels + column] = if under.found then waveClamp(level - under.height, -200.0, 2000.0) else 2000.0
            }
        }
        tier.row = last
        if !first then return
    }
    while tier.baking {
        if stepShoreBake(tier) then writeShoreTexture(gpu, tier)
        if !first then return
    }
}

/** Writes [tier]'s finished data into its texture (made the first time): depth, distance, travel time, 0 per texel. */
func writeShoreTexture(gpu: AzGpu&, tier: ShoreLevel!) {
    fin n = shoreTexels
    if tier.texture == 0 {
        fin descriptor = send4(cls("MTLTextureDescriptor"), sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"),
            125, n as Long, n as Long, 0)
        tier.texture = send1(gpu.device, sel("newTextureWithDescriptor:"), descriptor)
    }
    fin bytes = azAlloc((n * n * 16) as Long)
    defer { azFree(bytes) }
    for at: Int in 0..<(n * n) {
        azPokeF32(bytes, (at * 16) as Long, tier.depth[at])
        azPokeF32(bytes, (at * 16 + 4) as Long, tier.distance[at])
        azPokeF32(bytes, (at * 16 + 8) as Long, tier.travel[at])
        azPokeF32(bytes, (at * 16 + 12) as Long, 0.0)
    }
    azSendRegion(tier.texture, sel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), 0, 0, 0, n as Long, n as Long, 1, 0, bytes, (n * 16) as Long)
    tier.fresh = false
}

/** The bytes of the ocean's own block (OceanU) and of a ring's (RingU). */
inline fin oceanUniformBytes: Long = 208
inline fin ringUniformBytes: Long = 32
inline fin reflectionUniformBytes: Long = 80

/** Writes four numbers at [offset] of [block]. */
func pokeFour(block: Long, offset: Long, a: Double, b: Double, c: Double, d: Double) {
    azPokeF32(block, offset, a)
    azPokeF32(block, offset + 4, b)
    azPokeF32(block, offset + 8, c)
    azPokeF32(block, offset + 12, d)
}

/** Where [tier] lies for the shader: centre X/Z, one over its side, and whether it is ready. */
func pokeShoreLevel(block: Long, offset: Long, tier: ShoreLevel&) =
    pokeFour(block, offset, tier.centerX, tier.centerZ, if tier.size > 0.0 then 1.0 / tier.size else 0.0, if tier.ready && tier.texture != 0 then 1.0 else 0.0)

/** The ocean's block: its sea's tiles and level, its look, its foam, its shore maps and the surf on them. */
func pokeOcean(block: Long, ocean: Ocean&, level: Double, sea: SeaState&, optics: WaterOptics&, foam: WaterFoam&, shore: OceanShore&,
               surf: SurfState&, eyeHeight: Double, time: Double) {
    pokeFour(block, 0, sea.tiles[0], sea.tiles[1], sea.tiles[2], level)
    pokeFour(block, 16, sea.resolution as Double, eyeHeight, 0.0, 0.0)
    pokeFour(block, 32, optics.scatter.r, optics.scatter.g, optics.scatter.b, 1.0)
    pokeFour(block, 48, optics.absorption.r, optics.absorption.g, optics.absorption.b, 1.0)
    pokeFour(block, 64, waveClamp(optics.clarity, 0.0, 1.0), optics.subsurface, optics.roughness, optics.reflection)
    pokeFour(block, 80, foam.color.r, foam.color.g, foam.color.b, if foam.enabled then foam.shoreBand else 0.0)
    pokeShoreLevel(block, 96, shore.near)
    // The time wraps every hour (the shader's floats keep their fraction); the surf's phases come in whole.
    pokeFour(block, 112, ocean.shoreDepth, if foam.enabled then 1.0 else 0.0, time - floor(time / 3600.0) * 3600.0,
        if foam.enabled then waveClamp(foam.surf, 0.0, 2.0) else 0.0)
    pokeShoreLevel(block, 128, shore.far)
    pokeFour(block, 144, surf.height, surf.length, surf.runup, 0.0)
    pokeFour(block, 160, surf.firstOmega, surf.secondOmega, surf.firstPhase, surf.secondPhase)
    pokeFour(block, 176, shore.near.size / (shoreTexels as Double), shore.far.size / (shoreTexels as Double), waveClamp(foam.opacity, 0.0, 1.0), 0.0)
    pokeFour(block, 192, optics.shallow.r, optics.shallow.g, optics.shallow.b, waveClamp(optics.shallowDepth, 0.1, 100.0))
}

/**
 * Writes [entity]'s ocean block at [block] as its surface is drawn now
 * ([time]): its sea, look, foam, shore maps and surf. Answers whether its
 * sea is simulated (its maps hold waves).
 */
func pokeOceanBody(block: Long, world: World!, entity: Entity, time: Double, eyeHeight: Double): Bool {
    fin ocean = storageGetOrDefault<Ocean>(ensureStorage(world), entity, .())
    fin optics = storageGetOrDefault<WaterOptics>(ensureStorage(world), entity, .())
    fin foam = storageGetOrDefault<WaterFoam>(ensureStorage(world), entity, .(enabled: false))
    var sea: SeaState = .()
    var surf: SurfState = .()
    var hasSea = false
    let seas = ensureStorage<Sea>(world)
    let sims = ensureStorage<SeaGpu>(world)
    fin seaAt = storageIndexOf<Sea>(seas, entity)
    fin simAt = storageIndexOf<SeaGpu>(sims, entity)
    if seaAt >= 0 && simAt >= 0 && seas.values[seaAt].tiles.size == waveCascades && sims.values[simAt].ready {
        sea = seas.values[seaAt].state.clone()
        surf = surfStateOf(seas.values[seaAt].surf, time)
        hasSea = true
    }
    let shores = ensureStorage<OceanShore>(world)
    if !storageHas<OceanShore>(shores, entity) then storageInsert<OceanShore>(shores, entity, .())
    let shore: OceanShore& = shores.values[storageIndexOf<OceanShore>(shores, entity)]
    pokeOcean(block, ocean, worldPosition(world, entity).y, sea, optics, foam, shore, surf, eyeHeight, time)
    return hasSea
}

/** The most water exclusions one ocean honours. */
inline fin waterExclusionLimit: Int = 8

/**
 * Writes the shown [WaterExclusion] boxes of [world] at [block] for the
 * shader: their count, then per box its centre and its three axes, each
 * with its half size (scale included). Answers the count.
 */
func pokeWaterExclusions(block: Long, world: World!): Int {
    let cuts = ensureStorage<WaterExclusion>(world)
    var count = 0
    for row: Int in 0..<storageLength<WaterExclusion>(cuts) {
        if count >= waterExclusionLimit then break
        fin entity = storageEntityAt<WaterExclusion>(cuts, row)
        fin cut = cuts.values[row].clone()
        if !cut.enabled || !world.isAlive(entity) || !visibleInWorld(world, entity) then continue
        fin m = worldMatrix(world, entity)
        fin base = (16 + count * 64) as Long
        pokeFour(block, base, m.m00 * cut.offset.x + m.m01 * cut.offset.y + m.m02 * cut.offset.z + m.m03,
            m.m10 * cut.offset.x + m.m11 * cut.offset.y + m.m12 * cut.offset.z + m.m13,
            m.m20 * cut.offset.x + m.m21 * cut.offset.y + m.m22 * cut.offset.z + m.m23, 0.0)
        fin lx = sqrt(m.m00 * m.m00 + m.m10 * m.m10 + m.m20 * m.m20)
        fin ly = sqrt(m.m01 * m.m01 + m.m11 * m.m11 + m.m21 * m.m21)
        fin lz = sqrt(m.m02 * m.m02 + m.m12 * m.m12 + m.m22 * m.m22)
        if lx <= 0.0 || ly <= 0.0 || lz <= 0.0 then continue
        pokeFour(block, base + 16, m.m00 / lx, m.m10 / lx, m.m20 / lx, absValue(cut.size.x) * 0.5 * lx)
        pokeFour(block, base + 32, m.m01 / ly, m.m11 / ly, m.m21 / ly, absValue(cut.size.y) * 0.5 * ly)
        pokeFour(block, base + 48, m.m02 / lz, m.m12 / lz, m.m22 / lz, absValue(cut.size.z) * 0.5 * lz)
        count++
    }
    pokeFour(block, 0, count as Double, 0.0, 0.0, 0.0)
    return count
}

/** Captures the opaque scene once, before any ocean writes to its color and depth. */
func captureOceanReflection(app: App!, programs: WaterGpu!): Bool {
    let gpu: AzGpu! = app.gpu
    if !gpu.scenePass.active || !gpu.scenePass.viewed || gpu.sceneSuspended then return false
    if programs.reflectionFrame == gpu.scenePass.frame then return true
    fin width = gpu.scenePass.width
    fin height = gpu.scenePass.height
    if programs.reflectionWidth != width || programs.reflectionHeight != height ||
        programs.reflectionColor == 0 || programs.reflectionDepth == 0 {
        if programs.reflectionColor != 0 then send0(programs.reflectionColor, sel("release"))
        if programs.reflectionDepth != 0 then send0(programs.reflectionDepth, sel("release"))
        programs.reflectionColor = sceneTexture(gpu.device, 80, width, height)
        programs.reflectionDepth = sceneTexture(gpu.device, 252, width, height)
        programs.reflectionWidth = width
        programs.reflectionHeight = height
    }
    if programs.reflectionColor == 0 || programs.reflectionDepth == 0 then return false
    app.suspendScenePass()
    fin blit = send0(gpu.cmd, sel("blitCommandEncoder"))
    send2(blit, sel("copyFromTexture:toTexture:"), gpu.scenePass.color, programs.reflectionColor)
    send2(blit, sel("copyFromTexture:toTexture:"), gpu.scenePass.depth, programs.reflectionDepth)
    send0(blit, sel("endEncoding"))
    app.resumeScenePass()
    app.setScissor(gpu.scenePass.rectX, gpu.scenePass.rectY, gpu.scenePass.rectWidth, gpu.scenePass.rectHeight)
    programs.reflectionFrame = gpu.scenePass.frame
    return true
}

/**
 * Draws [entity]'s ocean: its sea simulated for this frame, then the finest
 * square and its rings around the eye, the shallows and the surf from its shore maps.
 */
func drawOcean(app: App!, world: World!, view: SceneView&, entity: Entity, ocean: Ocean&) {
    let gpu: AzGpu! = app.gpu
    if !gpu.hasEncoder || gpu.casting then return
    // The row first: making the programs adds to the storage the reference is taken from.
    fin programRow = waterGpuRow(world, gpu.device)
    let programs: WaterGpu! = ensureStorage<WaterGpu>(world).values[programRow]
    if programs.ocean == 0 then return
    fin level = worldPosition(world, entity).y
    fin eye: Vec3 = .(view.eyeX, view.eyeY, view.eyeZ)
    fin optics = storageGetOrDefault<WaterOptics>(ensureStorage(world), entity, .())
    let shores = ensureStorage<OceanShore>(world)
    if !storageHas<OceanShore>(shores, entity) then storageInsert<OceanShore>(shores, entity, .())
    let shore: OceanShore& = shores.values[storageIndexOf<OceanShore>(shores, entity)]
    fin surface = waterSurfaceAt(world, eye.x, eye.z, view.time)
    // From above, the opaque scene is taken before the water covers it: seen through the shallows and mirrored in the sea.
    fin behind = eye.y > surface.height && captureOceanReflection(app, programs)
    fin reflecting = behind && gpu.reflectWater && optics.reflection > 0.0

    send1(gpu.enc, sel("setRenderPipelineState:"), programs.ocean)
    send1(gpu.enc, sel("setDepthStencilState:"), gpu.depthOn)
    app.writeSceneUniforms(gpu.scratch, mat4Identity(), optics.scatter.r, optics.scatter.g, optics.scatter.b)
    send3(gpu.enc, sel("setVertexBytes:length:atIndex:"), gpu.scratch, sceneUniformBytes, 1)
    send3(gpu.enc, sel("setFragmentBytes:length:atIndex:"), gpu.scratch, sceneUniformBytes, 1)
    app.bindSceneLighting()
    fin block = gpu.scratch + 256
    // The sea this frame (simulated by `simulateSeas`), or still water without one; the ground from `mapOceanShores`.
    fin hasSea = pokeOceanBody(block, world, entity, view.time, eye.y - surface.height)
    azPokeF32(block, 24, if reflecting then 1.0 else 0.0)
    azPokeF32(block, 28, if behind then 1.0 else 0.0)
    send3(gpu.enc, sel("setVertexBytes:length:atIndex:"), block, oceanUniformBytes, 7)
    send3(gpu.enc, sel("setFragmentBytes:length:atIndex:"), block, oceanUniformBytes, 7)
    fin reflection = gpu.scratch + 576
    if behind {
        pokeMat4(reflection, 0, mat4Inverse(gpu.scenePass.jittered))
        fin width = (gpu.scenePass.fullWidth as Double) / gpu.scale
        fin height = (gpu.scenePass.fullHeight as Double) / gpu.scale
        pokeFour(reflection, 64, gpu.scenePass.rectX / width, gpu.scenePass.rectY / height,
            (gpu.scenePass.rectX + gpu.scenePass.rectWidth) / width,
            (gpu.scenePass.rectY + gpu.scenePass.rectHeight) / height)
    }
    send3(gpu.enc, sel("setFragmentBytes:length:atIndex:"), reflection, reflectionUniformBytes, 9)
    fin cuts = gpu.scratch + 1024
    fin cutCount = pokeWaterExclusions(cuts, world)
    send3(gpu.enc, sel("setFragmentBytes:length:atIndex:"), cuts, (16 + (if cutCount > 0 then cutCount else 1) * 64) as Long, 10)
    send2(gpu.enc, sel("setFragmentTexture:atIndex:"), if behind then programs.reflectionColor else programs.still, 10)
    send2(gpu.enc, sel("setFragmentTexture:atIndex:"), if behind then programs.reflectionDepth else gpu.detailMap, 11)
    let sims = ensureStorage<SeaGpu>(world)
    fin simAt = storageIndexOf<SeaGpu>(sims, entity)
    for c: Int in 0..<waveCascades {
        fin displacement = if hasSea then sims.values[simAt].cascades[c].displacement else programs.still
        fin slopes = if hasSea then sims.values[simAt].cascades[c].slopes else programs.still
        fin foamMap = if hasSea then latestFoam(sims.values[simAt], c) else programs.still
        send2(gpu.enc, sel("setVertexTexture:atIndex:"), displacement, c as Long)
        send2(gpu.enc, sel("setFragmentTexture:atIndex:"), slopes, (3 + c) as Long)
        send2(gpu.enc, sel("setFragmentTexture:atIndex:"), foamMap, (6 + c) as Long)
    }
    fin nearMap = if shore.near.texture != 0 then shore.near.texture else programs.still
    fin farMap = if shore.far.texture != 0 then shore.far.texture else programs.still
    send2(gpu.enc, sel("setVertexTexture:atIndex:"), nearMap, 9)
    send2(gpu.enc, sel("setFragmentTexture:atIndex:"), nearMap, 9)
    send2(gpu.enc, sel("setVertexTexture:atIndex:"), farMap, 12)
    send2(gpu.enc, sel("setFragmentTexture:atIndex:"), farMap, 12)
    // The finest cell grows with the eye's height over the water, in powers of two: rings stay a few pixels a cell.
    fin cells = ((waveClamp(ocean.cells as Double, 16.0, 256.0) as Int) / 4) * 4
    fin height = absValue(eye.y - level)
    var base = waveClamp(ocean.detail, 0.05, 4.0)
    while base * (cells as Double) * 0.25 < height then base *= 2.0
    fin rings = waveClamp(ocean.rings as Double, 2.0, 16.0) as Int
    fin ring = gpu.scratch + 512
    for l: Int in 0..<rings {
        fin size = base * powr(2.0, l as Double)
        fin centerX = (round(eye.x / (size * 2.0)) as Double) * size * 2.0
        fin centerZ = (round(eye.z / (size * 2.0)) as Double) * size * 2.0
        // The finer ring inside: its first cell in this ring's cells (none inside the finest).
        var holeX: Double = -1000000.0
        var holeZ: Double = -1000000.0
        if l > 0 {
            fin finerX = (round(eye.x / size) as Double) * size
            fin finerZ = (round(eye.z / size) as Double) * size
            holeX = (finerX - centerX) / size + ((cells / 4) as Double)
            holeZ = (finerZ - centerZ) / size + ((cells / 4) as Double)
        }
        // Every ring but the last folds onto the next over its outer eighth.
        fin morphStart = if l + 1 < rings then ((cells / 2) as Double) - ((cells / 8) as Double) else 1000000.0
        pokeFour(ring, 0, centerX, centerZ, size, cells as Double)
        pokeFour(ring, 16, holeX, holeZ, morphStart, ((cells / 8) as Double) - 1.0)
        send3(gpu.enc, sel("setVertexBytes:length:atIndex:"), ring, ringUniformBytes, 8)
        send3(gpu.enc, sel("drawPrimitives:vertexStart:vertexCount:"), 3, 0, (cells * cells * 6) as Long)
    }
    gpu.mode = -1
    gpu.meshPipeline = 0
}

/** Every enabled, shown Ocean, drawn with the opaque scene - in the game and in the editor. */
@System(phase: .RenderOpaque, editor: true)
func drawOceans(app: App!, view: SceneView&, world: World!, oceans: @query [Ocean&]) {
    var bodies: Array<Entity> = []
    while oceans.hasNext() then bodies.add(oceans.nextEntity())
    for entity in bodies {
        fin ocean = storageGet<Ocean>(ensureStorage(world), entity).clone()
        if ocean.enabled && world.isAlive(entity) && visibleInWorld(world, entity) then drawOcean(app, world, view, entity, ocean)
    }
}

/**
 * Every enabled, shown Ocean keeps the maps of the ground around the eye
 * that calm its shallows and raise its surf, baked a little each frame -
 * in the game and in the editor. The eye is the view's (last frame's in the
 * game: the shore moves slower than that).
 */
@System(phase: .PostUpdate, editor: true, editorWhilePaused: true)
func mapOceanShores(app: App!, view: SceneView&, world: World!, oceans: @query [Ocean&]) {
    if app.gpu.device == 0 || view.frame == 0 then return
    var bodies: Array<Entity> = []
    while oceans.hasNext() then bodies.add(oceans.nextEntity())
    for entity in bodies {
        fin ocean = storageGet<Ocean>(ensureStorage(world), entity).clone()
        if !ocean.enabled || !world.isAlive(entity) || !visibleInWorld(world, entity) then continue
        fin seaAt = storageIndexOf<Sea>(ensureStorage<Sea>(world), entity)
        fin length = if seaAt >= 0 then storageValueAt<Sea>(ensureStorage(world), seaAt).surf.length else 100.0
        let shores = ensureStorage<OceanShore>(world)
        if !storageHas<OceanShore>(shores, entity) then storageInsert<OceanShore>(shores, entity, .())
        let shore: OceanShore! = shores.values[storageIndexOf<OceanShore>(shores, entity)]
        tendShore(app.gpu, world, shore, worldPosition(world, entity).y, waveClamp(ocean.shoreDepth, 1.0, 500.0),
            .(view.eyeX, view.eyeY, view.eyeZ), length)
    }
}

/** The shore map of a body that is no longer an Ocean is let go. */
@System(phase: .PreUpdate, editor: true, editorWhilePaused: true)
func dropOceanShores(world: World!, shores: @query [OceanShore&] without Ocean) {
    var bodies: Array<Entity> = []
    while shores.hasNext() then bodies.add(shores.nextEntity())
    for entity in bodies then storageRemove<OceanShore>(ensureStorage(world), entity)
}
