module engine.water.underwater

import std.math
import engine.atmosphere.view
import engine.core
import engine.ecs
import engine.gpu
import engine.io
import engine.objc
import engine.platform
import engine.water.components
import engine.water.ocean::{pokeFour, pokeOceanBody, oceanUniformBytes}
import engine.water.oceanshader::{oceanCommonSource}
import engine.water.spectrum
import engine.water.shore
import engine.water.query
import engine.water.waves

@Component
pack UnderwaterGpu {
    var pipeline: Long = 0
    /** The scene as drawn before the water's volume, read back blurred and wavering. */
    var copy: Long = 0
    var copyWidth: Long = 0
    var copyHeight: Long = 0
}

impl UnderwaterGpu {
    dtor .() {
        if self.pipeline != 0 then send0(self.pipeline, sel("release"))
        if self.copy != 0 then send0(self.copy, sel("release"))
    }
}

/** The underwater view, with the scene's volumes - in the game and in the editor. */
@System(phase: .RenderVolumes, editor: true)
func renderUnderwater(app: App!, world: World!, view: SceneView&) {
    drawUnderwater(app, world, view)
}

/**
 * Light travelling through water from the scene depth to a submerged eye,
 * pixel by pixel: a pixel is under water when its point on the camera's near
 * plane is below the sea's surface there - the same waves the surface is
 * drawn with - so a camera dipping through the surface sees the waterline
 * cross the screen, a thin, soft meniscus between air and water. Under it
 * the view wavers in slow horizontal ripples and blurs with distance.
 */
func drawUnderwater(app: App!, world: World!, view: SceneView&) {
    if view.color == 0 || view.depth == 0 || view.matrices == 0 then return
    fin surface = waterSurfaceAt(world, view.eyeX, view.eyeZ, view.time)
    // The near plane reaches this far from the eye; the waves about it a few metres more.
    fin nearReach = view.near * sqrt(1.0 + view.tangent * view.tangent * (1.0 + view.aspect * view.aspect)) + 3.0
    if !surface.found || view.eyeY - surface.height > nearReach then return
    let cache = ensureStorage<UnderwaterGpu>(world)
    if storageLength<UnderwaterGpu>(cache) == 0 {
        var programs: UnderwaterGpu = .()
        fin library = waterLibrary(view.device, underwaterSource(), "underwater optics")
        if library != 0 {
            programs.pipeline = waterSurfacePipeline(view.device, library, "underwaterVertex", "underwaterFragment", false)
            send0(library, sel("release"))
        }
        storageInsert<UnderwaterGpu>(cache, world.spawnResource("Underwater GPU"), take programs)
    }
    let under: UnderwaterGpu! = cache.values[0]
    if under.pipeline == 0 then return
    fin width = send0(view.color, sel("width"))
    fin height = send0(view.color, sel("height"))
    if under.copy == 0 || under.copyWidth != width || under.copyHeight != height {
        if under.copy != 0 then send0(under.copy, sel("release"))
        under.copy = sceneTexture(view.device, send0(view.color, sel("pixelFormat")), width, height)
        under.copyWidth = width
        under.copyHeight = height
    }
    if under.copy == 0 then return
    fin programRow = waterGpuRow(world, view.device)
    let programs: WaterGpu& = ensureStorage<WaterGpu>(world).values[programRow]
    fin optics = storageGetOrDefault<WaterOptics>(ensureStorage(world), surface.body, .())
    let gpu: AzGpu! = app.gpu
    fin block = gpu.scratch
    azCopy(block, view.matrices + 64, 64)
    pokeFour(block, 64, view.eyeX, view.eyeY, view.eyeZ, surface.height)
    pokeFour(block, 80, view.width as Double, view.height as Double, view.jitterX, view.jitterY)
    pokeFour(block, 96, optics.absorption.r, optics.absorption.g, optics.absorption.b, optics.clarity)
    pokeFour(block, 112, optics.scatter.r, optics.scatter.g, optics.scatter.b, view.time - floor(view.time / 3600.0) * 3600.0)
    pokeFour(block, 128, gpu.lightX, gpu.lightY, gpu.lightZ, gpu.ambient)
    pokeFour(block, 144, 0.0, 1.0, 0.0, view.height as Double)
    fin ocean = gpu.scratch + 256
    fin hasSea = pokeOceanBody(ocean, world, surface.body, view.time, view.eyeY - surface.height)
    // The scene so far, to read from while the pass writes over it.
    fin blit = send0(view.commands, sel("blitCommandEncoder"))
    send2(blit, sel("copyFromTexture:toTexture:"), view.color, under.copy)
    send0(blit, sel("endEncoding"))
    fin pass = send0(cls("MTLRenderPassDescriptor"), sel("renderPassDescriptor"))
    fin color = send1(send0(pass, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), 0)
    send1(color, sel("setTexture:"), view.color)
    send1(color, sel("setLoadAction:"), 1)
    send1(color, sel("setStoreAction:"), 1)
    fin encoder = send1(view.commands, sel("renderCommandEncoderWithDescriptor:"), pass)
    send1(encoder, sel("setRenderPipelineState:"), under.pipeline)
    send3(encoder, sel("setFragmentBytes:length:atIndex:"), block, 160, 0)
    send3(encoder, sel("setFragmentBytes:length:atIndex:"), ocean, oceanUniformBytes, 1)
    send2(encoder, sel("setFragmentTexture:atIndex:"), view.depth, 0)
    let sims = ensureStorage<SeaGpu>(world)
    fin simAt = storageIndexOf<SeaGpu>(sims, surface.body)
    for c: Int in 0..<waveCascades {
        send2(encoder, sel("setFragmentTexture:atIndex:"), if hasSea then sims.values[simAt].cascades[c].displacement else programs.still, (1 + c) as Long)
    }
    let shores = ensureStorage<OceanShore>(world)
    fin shoreAt = storageIndexOf<OceanShore>(shores, surface.body)
    fin nearMap = if shoreAt >= 0 && shores.values[shoreAt].near.texture != 0 then shores.values[shoreAt].near.texture else programs.still
    fin farMap = if shoreAt >= 0 && shores.values[shoreAt].far.texture != 0 then shores.values[shoreAt].far.texture else programs.still
    send2(encoder, sel("setFragmentTexture:atIndex:"), nearMap, 4)
    send2(encoder, sel("setFragmentTexture:atIndex:"), farMap, 5)
    send2(encoder, sel("setFragmentTexture:atIndex:"), under.copy, 6)
    send3(encoder, sel("drawPrimitives:vertexStart:vertexCount:"), 3, 0, 3)
    send0(encoder, sel("endEncoding"))
}

func underwaterSource(): String = "
#include <metal_stdlib>
using namespace metal;
" + oceanCommonSource() + "
struct WaterVolume {
    float4x4 inverseView;
    float4 eye, screen, absorption, scatter, sun, plane;
};
struct WaterPixel { float4 position [[position]]; };

vertex WaterPixel underwaterVertex(uint vertexId [[vertex_id]]) {
    return { float4(vertexId == 1 ? 3.0 : -1.0, vertexId == 2 ? 3.0 : -1.0, 0.0, 1.0) };
}

float waterCaustics(float2 p, float t) {
    float2 q = p * 1.7;
    q += float2(sin(p.y * 0.65 + t * 0.71), cos(p.x * 0.81 - t * 0.53)) * 0.85;
    float a = sin(dot(q, float2(0.82, 0.57)) + t * 0.79);
    float b = sin(dot(q, float2(-0.42, 1.03)) - t * 0.94);
    float c = sin(dot(q, float2(1.21, -0.59)) + t * 0.42);
    return exp2(-12.0 * abs(a * 0.46 + b * 0.34 + c * 0.20));
}

float3 nearPlanePoint(float2 uv, constant WaterVolume& u) {
    float4 p = u.inverseView * float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 1.0, 1.0);
    return p.xyz / p.w;
}

fragment float4 underwaterFragment(WaterPixel pixel [[stage_in]], constant WaterVolume& u [[buffer(0)]], constant OceanU& o [[buffer(1)]],
                                     depth2d<float> depth [[texture(0)]],
                                     texture2d<float> d0 [[texture(1)]], texture2d<float> d1 [[texture(2)]], texture2d<float> d2 [[texture(3)]],
                                     texture2d<float> shore [[texture(4)]], texture2d<float> farShore [[texture(5)]],
                                     texture2d<float> sceneCopy [[texture(6)]]) {
    constexpr sampler sceneSampler(filter::linear, address::clamp_to_edge);
    uint2 at = uint2(pixel.position.xy);
    float4 scene = sceneCopy.read(at);
    float2 size = float2(sceneCopy.get_width(), sceneCopy.get_height());
    float2 uv = (pixel.position.xy - u.screen.zw) / u.screen.xy;
    // Is this pixel's point on the near plane below the sea's surface there?
    float3 lens = nearPlanePoint(uv, u);
    float sea = seaHeightAt(lens.xz, o, d0, d1, d2, shore, farShore);
    float below = sea - lens.y;
    float perPixel = length(nearPlanePoint(float2(0.5, 0.0), u) - nearPlanePoint(float2(0.5, 1.0), u)) / max(u.plane.w, 1.0);
    float pixels = below / max(perPixel, 1.0e-6);
    float submerged = smoothstep(-1.5, 1.5, pixels);
    if (pixels < 1.5) {
        // The lens is in the air (or at the waterline). Its ray may still enter the water before what it strikes - a crest just
        // ahead of the lens seen from inside, or the surface closer than the near plane and so not drawn:
        // walk the first metres of the ray; once a step is clearly in the water, the pixel looks through water.
        if (below < -1.2) return scene;
        bool inAir = pixels < -2.5;
        float zHere = depth.read(at);
        float3 ray0 = normalize(nearPlanePoint(uv, u) - u.eye.xyz);
        float limit = 3.5;
        if (zHere > 0.0) {
            float4 met = u.inverseView * float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, zHere, 1.0);
            limit = min(limit, length(met.xyz / met.w - lens) - 0.2);
        }
        bool wet = false;
        const float steps[8] = { 0.05, 0.2, 0.4, 0.7, 1.1, 1.6, 2.4, 3.4 };
        for (int i = 0; i < 8 && !wet; ++i) {
            if (steps[i] > limit) break;
            float3 q = lens + ray0 * steps[i];
            wet = q.y < seaHeightQuick(q.xz, o, d0, d1, d2, shore, farShore) - 0.02;
        }
        if (wet) {
            submerged = 1.0;
            pixels = 1.0e3;
        } else if (inAir) {
            return scene;
        }
    }
    float time = u.scatter.w;
    // Under water the view wavers in slow horizontal ripples and blurs with the distance it looks through.
    float2 waver = float2(sin(uv.y * 38.0 + time * 1.7) * 0.0028 + sin(uv.y * 71.0 - time * 2.3) * 0.0012,
                          sin(uv.x * 23.0 + time * 1.1) * 0.0009) * submerged;
    float2 seenUv = clamp(pixel.position.xy / size + waver, float2(0.0), float2(1.0));
    float z = depth.sample(sceneSampler, seenUv);
    float4 unprojected = u.inverseView * float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, max(z, 0.000001), 1.0);
    float3 hit = unprojected.xyz / unprojected.w;
    float3 travel = hit - u.eye.xyz;
    float3 ray = normalize(travel);
    float immersion = max(sea - u.eye.y, 0.0);
    float reach = z > 0.0 ? min(length(travel), 240.0f) : 240.0;
    // Higher rays leave the medium at the surface. The ocean mesh fills most of these rays
    // with its refracted sky, while the same bound also keeps boats and the shore above it clear.
    if (ray.y > 0.0001) reach = min(reach, (immersion + 0.35) / ray.y);
    float spread = mix(0.6, 3.2, saturate(reach / 30.0)) / size.y * submerged;
    float3 blurred = sceneCopy.sample(sceneSampler, seenUv).rgb * 0.4;
    blurred += sceneCopy.sample(sceneSampler, seenUv + float2(spread, 0.0)).rgb * 0.15;
    blurred += sceneCopy.sample(sceneSampler, seenUv - float2(spread, 0.0)).rgb * 0.15;
    blurred += sceneCopy.sample(sceneSampler, seenUv + float2(0.0, spread)).rgb * 0.15;
    blurred += sceneCopy.sample(sceneSampler, seenUv - float2(0.0, spread)).rgb * 0.15;
    float day = saturate(u.sun.y * 2.1 + 0.14);
    float turbidity = mix(0.075, 0.026, saturate(u.absorption.w));
    float3 extinction = max(u.absorption.rgb * float3(0.66, 0.77, 0.80), float3(0.038, 0.021, 0.014)) + turbidity;
    float3 transmit = exp(-extinction * reach);
    float floorDepth = max(sea - hit.y, 0.0);
    float3 sunRay = refract(-normalize(u.sun.xyz), float3(0, 1, 0), 0.7502);
    float2 sunSlope = sunRay.xz / max(-sunRay.y, 0.42);
    float3 light = pow(max(blurred, 0.0), 2.2);
    if (z > 0.0 && floorDepth > 0.22 && reach < 48.0) {
        float2 surfacePoint = hit.xz - sunSlope * floorDepth;
        float pattern = waterCaustics(surfacePoint, time);
        float caustic = pattern * day * exp(-floorDepth * 0.16) * (1.0 - smoothstep(20.0, 46.0, reach));
        light *= 1.0 + caustic * float3(0.64, 0.90, 0.94);
        // Incident daylight loses its warmer wavelengths before it reaches the bed.
        light *= exp(-extinction * min(floorDepth, 35.0) * 0.25);
    }
    float3 mid = u.eye.xyz + ray * reach * 0.43;
    float midDepth = max(sea - mid.y, 0.0);
    float2 beam = mid.xz - sunSlope * midDepth;
    float shaft = pow(saturate(0.5 + 0.5 * sin(beam.x * 0.33 + sin(beam.y * 0.28 + time * 0.23))), 4.0);
    float forward = pow(saturate(dot(ray, -sunRay) * 0.5 + 0.5), 5.0);
    float3 waterLight = (u.scatter.rgb * float3(0.31, 0.70, 0.90) + float3(0.002, 0.022, 0.033));
    waterLight *= (0.18 + day * (0.70 + forward * (0.50 + shaft * 0.32))) * exp(-midDepth * 0.036);
    waterLight += float3(0.001, 0.012, 0.023) * max(u.sun.w, 0.16);
    float3 seen = light * transmit + waterLight * (1.0 - transmit);
    float3 under = pow(saturate(seen), 1.0 / 2.2);
    // The meniscus: a few pixels where the surface touches the lens, darker and tinted by the water.
    float meniscus = exp(-pixels * pixels / 4.0);
    float3 color = mix(scene.rgb, under, submerged);
    color = mix(color, color * 0.45 + u.scatter.rgb * 0.6, meniscus * 0.75);
    return float4(color, scene.a);
}
"
