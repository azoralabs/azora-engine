module engine.water.underwater

import std.math
import engine.atmosphere.view
import engine.core
import engine.ecs
import engine.gpu
import engine.io
import engine.objc
import engine.objc.shader
import engine.platform
import engine.water.components
import engine.water.ocean::{pokeFour, pokeOceanBody, oceanUniformBytes}
import engine.water.spectrum
import engine.water.shore
import engine.water.query
import engine.water.waves

@Component
pack UnderwaterGpu {
    var pipeline: Long = 0
    /** The scene as drawn before the water's volume, read back blurred and wavering. */
    var copy: Long = 0
    var copyWidth: Long = 0
    var copyHeight: Long = 0
}

impl UnderwaterGpu {
    dtor .() {
        if self.pipeline != 0 then send0(self.pipeline, sel("release"))
        if self.copy != 0 then send0(self.copy, sel("release"))
    }
}

/** The underwater view, with the scene's volumes - in the game and in the editor. */
@System(phase: .RenderVolumes, editor: true)
func renderUnderwater(app: App!, world: World!, view: SceneView&) {
    drawUnderwater(app, world, view)
}

/**
 * Light travelling through water from the scene depth to a submerged eye,
 * pixel by pixel: a pixel is under water when its point on the camera's near
 * plane is below the sea's surface there - the same waves the surface is
 * drawn with - so a camera dipping through the surface sees the waterline
 * cross the screen, a thin, soft meniscus between air and water. Under it
 * the view wavers in slow horizontal ripples and blurs with distance.
 */
func drawUnderwater(app: App!, world: World!, view: SceneView&) {
    if view.color == 0 || view.depth == 0 || view.matrices == 0 then return
    fin surface = waterSurfaceAt(world, view.eyeX, view.eyeZ, view.time)
    // The near plane reaches this far from the eye; the waves about it a few metres more.
    fin nearReach = view.near * sqrt(1.0 + view.tangent * view.tangent * (1.0 + view.aspect * view.aspect)) + 3.0
    if !surface.found || view.eyeY - surface.height > nearReach then return
    let cache = ensureStorage<UnderwaterGpu>(world)
    if storageLength<UnderwaterGpu>(cache) == 0 {
        var programs: UnderwaterGpu = .()
        fin library = shaderLibrary(view.device, "underwater")
        if library != 0 {
            programs.pipeline = waterSurfacePipeline(view.device, library, "underwaterVertex", "underwaterFragment", false)
            send0(library, sel("release"))
        }
        storageInsert<UnderwaterGpu>(cache, world.spawnResource("Underwater GPU"), take programs)
    }
    let under: UnderwaterGpu! = cache.values[0]
    if under.pipeline == 0 then return
    fin width = send0(view.color, sel("width"))
    fin height = send0(view.color, sel("height"))
    if under.copy == 0 || under.copyWidth != width || under.copyHeight != height {
        if under.copy != 0 then send0(under.copy, sel("release"))
        under.copy = sceneTexture(view.device, send0(view.color, sel("pixelFormat")), width, height)
        under.copyWidth = width
        under.copyHeight = height
    }
    if under.copy == 0 then return
    fin programRow = waterGpuRow(world, view.device)
    let programs: WaterGpu& = ensureStorage<WaterGpu>(world).values[programRow]
    fin optics = storageGetOrDefault<WaterOptics>(ensureStorage(world), surface.body, .())
    let gpu: AzGpu! = app.gpu
    fin block = gpu.scratch
    azCopy(block, view.matrices + 64, 64)
    pokeFour(block, 64, view.eyeX, view.eyeY, view.eyeZ, surface.height)
    pokeFour(block, 80, view.width as Double, view.height as Double, view.jitterX, view.jitterY)
    pokeFour(block, 96, optics.absorption.r, optics.absorption.g, optics.absorption.b, optics.clarity)
    pokeFour(block, 112, optics.scatter.r, optics.scatter.g, optics.scatter.b, view.time - floor(view.time / 3600.0) * 3600.0)
    pokeFour(block, 128, gpu.lightX, gpu.lightY, gpu.lightZ, gpu.ambient)
    fin scale = gpu.scale * gpu.passScale
    pokeFour(block, 144, gpu.scenePass.rectX * scale, gpu.scenePass.rectY * scale,
        gpu.scenePass.rectWidth * scale, gpu.scenePass.rectHeight * scale)
    fin ocean = gpu.scratch + 256
    fin hasSea = pokeOceanBody(ocean, world, surface.body, view.time, view.eyeY - surface.height)
    // The scene so far, to read from while the pass writes over it.
    fin blit = send0(view.commands, sel("blitCommandEncoder"))
    send2(blit, sel("copyFromTexture:toTexture:"), view.color, under.copy)
    send0(blit, sel("endEncoding"))
    fin pass = send0(cls("MTLRenderPassDescriptor"), sel("renderPassDescriptor"))
    fin color = send1(send0(pass, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), 0)
    send1(color, sel("setTexture:"), view.color)
    send1(color, sel("setLoadAction:"), 1)
    send1(color, sel("setStoreAction:"), 1)
    fin encoder = send1(view.commands, sel("renderCommandEncoderWithDescriptor:"), pass)
    send1(encoder, sel("setRenderPipelineState:"), under.pipeline)
    send3(encoder, sel("setFragmentBytes:length:atIndex:"), block, 160, 0)
    send3(encoder, sel("setFragmentBytes:length:atIndex:"), ocean, oceanUniformBytes, 1)
    send2(encoder, sel("setFragmentTexture:atIndex:"), view.depth, 0)
    let sims = ensureStorage<SeaGpu>(world)
    fin simAt = storageIndexOf<SeaGpu>(sims, surface.body)
    for c: Int in 0..<waveCascades {
        send2(encoder, sel("setFragmentTexture:atIndex:"), if hasSea then sims.values[simAt].cascades[c].displacement else programs.still, (1 + c) as Long)
    }
    let shores = ensureStorage<OceanShore>(world)
    fin shoreAt = storageIndexOf<OceanShore>(shores, surface.body)
    fin shoreMap = if shoreAt >= 0 && shores.values[shoreAt].near.texture != 0 then shores.values[shoreAt].near.texture else programs.still
    send2(encoder, sel("setFragmentTexture:atIndex:"), shoreMap, 4)
    send2(encoder, sel("setFragmentTexture:atIndex:"), under.copy, 6)
    send3(encoder, sel("drawPrimitives:vertexStart:vertexCount:"), 3, 0, 3)
    send0(encoder, sel("endEncoding"))
}

