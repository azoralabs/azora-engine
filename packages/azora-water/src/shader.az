module engine.water.shader

import std.io
import engine.objc
import engine.objc.shader
import engine.io

func compileWater(device: Long): Long {
    fin failure = azAlloc(8)
    defer { azFree(failure) }
    azPoke64(failure, 0, 0)
    fin library = shaderLibrary(device, "water")
    if library == 0 then return 0
    defer { send0(library, sel("release")) }
    fin vertex = send1(library, sel("newFunctionWithName:"), nsString("waterVertex"))
    fin fragment = send1(library, sel("newFunctionWithName:"), nsString("waterFragment"))
    fin descriptor = newObject("MTLRenderPipelineDescriptor")
    defer {
        send0(vertex, sel("release"))
        send0(fragment, sel("release"))
        send0(descriptor, sel("release"))
    }
    if vertex == 0 || fragment == 0 then return 0
    send1(descriptor, sel("setVertexFunction:"), vertex)
    send1(descriptor, sel("setFragmentFunction:"), fragment)
    fin color = send1(send0(descriptor, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), 0)
    send1(color, sel("setPixelFormat:"), 80)
    send1(descriptor, sel("setDepthAttachmentPixelFormat:"), 252)
    fin pipeline = send2(device, sel("newRenderPipelineStateWithDescriptor:error:"), descriptor, failure)
    if pipeline == 0 {
        fin diagnostic = azPeek64(failure, 0)
        if diagnostic != 0 then println("Azora Water: ${nsStringText(send0(diagnostic, sel("localizedDescription")))}")
    }
    return pipeline
}
