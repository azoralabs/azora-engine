/**
 * @file engine.water.query
 *
 * Asking the water at a point: is there any, where is its surface, which way
 * does it face, how does it flow. Floating bodies, vehicles, plants and
 * spawners ask [waterSurfaceAt]; it answers from the same seas the GPU draws
 * (their low frequencies on the CPU), so what floats rides the waves seen.
 */
module engine.water.query

import engine.core
import engine.ecs
import engine.math
import engine.scene
import engine.scene.transforms
import engine.water.components
import engine.water.spectrum
import engine.water.seas

/** The water at one point: whether there is any, its surface height and normal, its flow, and the body it belongs to. */
pack WaterSample derives Clone {
    var found: Bool = false
    var height: Double = 0.0
    var normal: Vec3 = .(0.0, 1.0, 0.0)
    var flow: Vec3 = .(0.0, 0.0, 0.0)
    var body: Entity = ::invalid
}

/**
 * The water surface over world (x, z) at [time] seconds: the highest enabled,
 * shown body there. An ocean is everywhere at its entity's height, moved by
 * its [Sea] when it has one.
 */
func waterSurfaceAt(world: World!, x: Double, z: Double, time: Double): WaterSample {
    var sample: WaterSample = .()
    fin oceans = ensureStorage<Ocean>(world)
    let seas = ensureStorage<Sea>(world)
    for row: Int in 0..<storageLength<Ocean>(oceans) {
        fin entity = storageEntityAt<Ocean>(oceans, row)
        if !oceans.values[row].enabled || !world.isAlive(entity) || !visibleInWorld(world, entity) then continue
        fin level = worldPosition(world, entity).y
        fin at = storageIndexOf<Sea>(seas, entity)
        var height = level
        var normal: Vec3 = .(0.0, 1.0, 0.0)
        if at >= 0 && seas.values[at].cpu.lengths.size > 0 {
            height += waveHeightAt(seas.values[at].cpu, x, z, time)
            normal = waveNormalAt(seas.values[at].cpu, x, z, time)
        }
        if !sample.found || height > sample.height then sample = .(true, height, normal, .(0.0, 0.0, 0.0), entity)
    }
    return take sample
}
