module engine.weather.precipitation

import std.math
import engine.core
import engine.ecs
import engine.gpu
import engine.math
import engine.objc
import engine.particles
import engine.atmosphere.components
import engine.weather.components
import engine.weather.state
import engine.weather.wind
import engine.platform
import engine.atmosphere
import engine.atmosphere.view
import engine.render.scene

/**
 * Rain, snow and dust as the Engine's GPU particles: drops, flakes and motes in two camera
 * boxes (a dense near one, a wide far one) that are drawn; a pool of drops
 * that is never drawn and only lands, over the box the weather's
 * `splashDistance` sets, so splashes reach as far as asked without drawing
 * every drop that makes them; and what their hits spawn - rings on wet
 * ground, droplets thrown out of each crown, puffs of snow. Each pool is
 * fixed; the weather's intensity says how much of it is alive.
 */
@Component
pack AetherPrecipitation {
    /** Landing drops: dense right around the eye, sparser out to the splash distance. */
    var impactsNear: ParticleSystem = .()
    var impacts: ParticleSystem = .()
    /** The splash distance the impact, ring and droplet pools were sized for. */
    var reach: Double = 0.0
    var dropsNear: ParticleSystem = .()
    var dropsFar: ParticleSystem = .()
    var rings: ParticleSystem = .()
    var droplets: ParticleSystem = .()
    var flakesNear: ParticleSystem = .()
    var flakesFar: ParticleSystem = .()
    var puffs: ParticleSystem = .()
    var motesNear: ParticleSystem = .()
    var motesFar: ParticleSystem = .()
    var ready: Bool = false
}

/** Pool sizes of the drawn drops and flakes; the impact pools follow the splash distance. */
inline fin nearDropCount: Int = 32768
inline fin farDropCount: Int = 26624
inline fin nearFlakeCount: Int = 14336
inline fin farFlakeCount: Int = 22528
inline fin nearMoteCount: Int = 12288
inline fin farMoteCount: Int = 16384
inline fin hitsPerStep: Int = 8192

/** Landings per square metre and second in a downpour: out to the splash distance, and within [nearReach] of the eye. */
inline fin landingsPerSquareMetre: Double = 12.0
inline fin nearLandings: Double = 70.0
inline fin nearReach: Double = 10.0

/** How high the impact box reaches above and below the eye at splash distance [reach]: enough for the ground on a slope. */
func impactHeight(reach: Double): Double = 3.0 + 0.25 * reach

/** Drops an impact pool needs so [landings] land per square metre each second over a box [reach] metres out, falling 9 m/s. */
func impactCount(reach: Double, landings: Double): Int {
    fin wanted = landings * (2.0 * reach) * (2.0 * reach) * 2.0 * impactHeight(reach) / 9.0
    return if wanted > 400000.0 then 400000 else if wanted < 4096.0 then 4096 else wanted as Int
}

/** Rings and droplets alive at once at most: the landings of half a second over both boxes. */
func splashCount(reach: Double): Int {
    fin wanted = (landingsPerSquareMetre * (2.0 * reach) * (2.0 * reach) + nearLandings * (2.0 * nearReach) * (2.0 * nearReach)) * 0.5
    return if wanted > 131072.0 then 131072 else if wanted < 8192.0 then 8192 else wanted as Int
}

/** (Re)makes the impact, ring and droplet pools for splash distance [reach]. */
func sizeImpacts(rain: AetherPrecipitation!, device: Long, queue: Long, reach: Double) {
    rain.impacts.release()
    rain.rings.release()
    rain.droplets.release()
    rain.impacts = particleSystem(device, queue, impactCount(reach, landingsPerSquareMetre), true, hitsPerStep)
    rain.rings = particleSystem(device, queue, splashCount(reach), true)
    rain.droplets = particleSystem(device, queue, splashCount(reach) * 2, true)
    rain.reach = reach
}

func aetherPrecipitation(device: Long, queue: Long): AetherPrecipitation {
    var rain: AetherPrecipitation = .()
    rain.dropsNear = particleSystem(device, queue, nearDropCount, true)
    rain.impactsNear = particleSystem(device, queue, impactCount(nearReach, nearLandings), true, hitsPerStep)
    rain.dropsFar = particleSystem(device, queue, farDropCount, true)
    rain.flakesNear = particleSystem(device, queue, nearFlakeCount, true, hitsPerStep)
    rain.flakesFar = particleSystem(device, queue, farFlakeCount, true)
    rain.puffs = particleSystem(device, queue, 8192, true)
    rain.motesNear = particleSystem(device, queue, nearMoteCount, true)
    rain.motesFar = particleSystem(device, queue, farMoteCount, true)
    sizeImpacts(rain, device, queue, 35.0)
    rain.ready = true
    return take rain
}

/** Drops that are never drawn and only land: over a box [reach] metres out, their hits are the splashes. */
func impactEmitter(reach: Double, intensity: Double): ParticleEmitter = ParticleEmitter(simulation: 1, spawn: 3,
    extent: .(reach, impactHeight(reach), reach), lifeMin: 1.0, lifeMax: 1.0, spread: 0.0, drag: 14.0
    terminalSpeed: 5.0 + 4.0 * intensity, wind: 1.0, collision: 1, thickness: 0.6)

/**
 * Drops in a camera box [half] metres across each way and [tall] up and down:
 * settling to their terminal fall (5-9 m/s by intensity), carried by the wind,
 * drawn as streaks. The near box is low, so more of its drops reach the ground.
 */
func dropEmitter(half: Double, tall: Double, intensity: Double, collide: Bool): ParticleEmitter = ParticleEmitter(simulation: 1, spawn: 3,
    extent: .(half, tall, half), lifeMin: 1.0, lifeMax: 1.0, spread: 0.0, drag: 14.0, terminalSpeed: 5.0 + 4.0 * intensity
    wind: 1.0, sizeStart: 0.0016, sizeEnd: 0.0016, colorStart: .(1.0, 1.0, 1.0, 0.62), colorEnd: .(1.0, 1.0, 1.0, 0.62)
    shape: 1, streak: 1.0 / 60.0, lit: 1.0, softness: 0.35, nearFade: 0.6, collision: if collide then 1 else 0, thickness: 0.6)

/** Flakes: slow, wandering, round. */
func flakeEmitter(half: Double, collide: Bool): ParticleEmitter = ParticleEmitter(simulation: 1, spawn: 3,
    extent: .(half, half, half), lifeMin: 1.0, lifeMax: 1.0, spread: 0.0, drag: 3.0, terminalSpeed: 1.1, wind: 0.9
    turbulence: 0.6, sizeStart: 0.011, sizeEnd: 0.011, colorStart: .(1.0, 1.0, 1.0, 0.85), colorEnd: .(1.0, 1.0, 1.0, 0.85)
    shape: 0, streak: 1.0 / 120.0, lit: 1.0, softness: 0.3, nearFade: 0.5, collision: if collide then 1 else 0, thickness: 0.6)

/** Rings widening on wet ground where a drop lands; brighter the wetter the ground and the stronger the [splashes]. */
func ringEmitter(wetness: Double, splashes: Double): ParticleEmitter = ParticleEmitter(simulation: 1, lifeMin: 0.3, lifeMax: 0.45,
    gravity: 0.0, drag: 0.0, wind: 0.0, sizeStart: 0.015, sizeEnd: 0.085
    colorStart: .(1.0, 1.0, 1.0, (0.25 + 0.25 * wetness) * (0.6 + 0.4 * splashes)), colorEnd: .(1.0, 1.0, 1.0, 0.0)
    lit: 1.0, softness: 0.05, nearFade: 0.3)

/** The droplets of a drop's crown: thrown up and out as hard as [splashes] says, falling back. */
func dropletEmitter(splashes: Double): ParticleEmitter = ParticleEmitter(simulation: 1, lifeMin: 0.16, lifeMax: 0.28, spread: 0.25 + 0.6 * splashes,
    gravity: 9.81, drag: 0.4, wind: 0.0, sizeStart: 0.003 + 0.003 * splashes, sizeEnd: 0.002 + 0.002 * splashes
    colorStart: .(1.0, 1.0, 1.0, 0.25 + 0.5 * splashes), colorEnd: .(1.0, 1.0, 1.0, 0.05)
    shape: 1, streak: 1.0 / 60.0, lit: 1.0, softness: 0.05, nearFade: 0.3)

/** A burst of snow where a flake lands. */
func puffEmitter(): ParticleEmitter = ParticleEmitter(simulation: 1, lifeMin: 0.4, lifeMax: 0.6, gravity: 0.0, drag: 2.0, wind: 0.3,
    sizeStart: 0.025, sizeEnd: 0.08, colorStart: .(1.0, 1.0, 1.0, 0.5), colorEnd: .(1.0, 1.0, 1.0, 0.0), lit: 1.0, softness: 0.1)

/**
 * Dust motes in a camera box [half] metres each way: drifting with the wind,
 * swirling, hardly falling, [size] metres across and of the dust's [color].
 * The far box's motes are larger, so the haze has a grain to it.
 */
func moteEmitter(half: Double, size: Double, color: Rgba&): ParticleEmitter = ParticleEmitter(simulation: 1, spawn: 3,
    extent: .(half, half * 0.5, half), lifeMin: 1.0, lifeMax: 1.0, spread: 0.0, gravity: 0.15, drag: 2.5, terminalSpeed: 0.25
    wind: 1.1, turbulence: 1.6, sizeStart: size, sizeEnd: size, colorStart: .(color.r, color.g, color.b, 0.55)
    colorEnd: .(color.r, color.g, color.b, 0.55), shape: 0, lit: 1.0, softness: 0.3, nearFade: 0.4)

/**
 * How particles see this frame: the camera and its targets, last frame's
 * transform and depth for collisions, the scene's light, wind and lamps.
 * [commands] is where a simulation is encoded (0 to draw).
 */
func sceneParticleView(app: App&, view: SceneView&, world: World!, commands: Long): ParticleView {
    let gpu: AzGpu& = app.gpu
    fin light = sceneLightFrom(world, view.time)
    fin weather = resourceNamedOr<SceneEnvironment>(world, "SceneEnvironment", SceneEnvironment())
    // A Wind in the scene blows the particles; without one, the weather's own wind does.
    fin windy = world.isAlive(sceneWindEntity(world))
    fin blowing = if windy then sceneWind(world, view.time) else Vec3(weather.windX, 0.0, weather.windZ)
    fin matrices = view.matrices
    return ParticleView(commands: commands, viewProj: matrices, previousViewProj: matrices + 128, previousInverse: matrices + 192,
        depth: view.depth, eyeX: view.eyeX, eyeY: view.eyeY, eyeZ: view.eyeZ, time: view.time
        delta: view.delta, motionX: view.motionX, motionY: view.motionY, motionZ: view.motionZ
        fullWidth: view.fullWidth as Double, fullHeight: view.fullHeight as Double
        depthWidth: view.width as Double, depthHeight: view.height as Double, near: view.near, far: view.far
        focal: (view.fullHeight as Double) * 0.5 / view.tangent, windX: blowing.x, windY: blowing.y, windZ: blowing.z
        lightX: light.direction.x, lightY: light.direction.y, lightZ: light.direction.z, lightStrength: light.intensity
        lightRed: light.color.r, lightGreen: light.color.g, lightBlue: light.color.b, ambient: light.ambient
        airRed: light.haze.r * (0.25 + 0.75 * light.daylight), airGreen: light.haze.g * (0.25 + 0.75 * light.daylight)
        airBlue: light.haze.b * (0.25 + 0.75 * light.daylight), lights: gpu.localLights)
}

/**
 * Moves rain, snow and dust one step, on the GPU, in a command buffer
 * committed before the frame's: the drops' collisions read the depth the last
 * frame left, and their hits spawn the splashes.
 */
@System(phase: .RenderSky)
func simulateAetherPrecipitation(app: App!, view: SceneView&, world: World!, particles: ParticlePipelines&, skies: @query [AetherSky&, AetherState&, AetherPrecipitation!]) {
    while skies.hasNext() {
        let row = skies.next()
        let sky: AetherSky& = row.1
        let state: AetherState& = row.2
        let rain: AetherPrecipitation! = row.3
        if !sky.enabled || !rain.ready || !particles.ready then continue
        fin parts = weatherParts(world)
        // How far and how much landing drops splash: the Rain's settings.
        fin reach = weatherClamp(parts.rain.splashDistance, 5.0, 80.0)
        if absValue(reach - rain.reach) > 0.5 then sizeImpacts(rain, app.gpu.device, app.gpu.queue, reach)
        fin splashes = weatherClamp(parts.rain.splashes, 0.0, 1.0)
        fin falling = weatherClamp(state.rain, 0.0, 1.0)
        fin snowing = weatherClamp(state.snow, 0.0, 1.0)
        fin dusting = weatherClamp(state.dust, 0.0, 1.0)
        if falling <= 0.0 && snowing <= 0.0 && dusting <= 0.0 && rain.rings.active == 0 && rain.puffs.active == 0 then return
        fin commands = send0(app.gpu.queue, sel("commandBuffer"))
        fin seen = sceneParticleView(app, view, world, commands)
        fin eye: Vec3 = .(seen.eyeX, seen.eyeY, seen.eyeZ)
        rain.dropsNear.simulate(particles, dropEmitter(9.0, 4.5, falling, false), seen, eye, falling)
        rain.dropsFar.simulate(particles, dropEmitter(35.0, 35.0, falling, false), seen, eye, falling)
        rain.impacts.simulate(particles, impactEmitter(reach, falling), seen, eye, falling)
        rain.impactsNear.simulate(particles, impactEmitter(nearReach, falling), seen, eye, falling)
        rain.rings.spawnFromHits(particles, ringEmitter(state.wetness, splashes), seen, rain.impacts, 1, 1, false)
        rain.rings.spawnFromHits(particles, ringEmitter(state.wetness, splashes), seen, rain.impactsNear, 1, 1)
        // A weak splash throws one droplet a landing; a strong one, three.
        fin perLanding = if splashes < 0.05 then 0 else if splashes < 0.4 then 1 else if splashes < 0.75 then 2 else 3
        if perLanding > 0 {
            rain.droplets.spawnFromHits(particles, dropletEmitter(splashes), seen, rain.impacts, perLanding, 3, false)
            rain.droplets.spawnFromHits(particles, dropletEmitter(splashes), seen, rain.impactsNear, perLanding, 3)
        }
        rain.flakesNear.simulate(particles, flakeEmitter(9.0, true), seen, eye, snowing)
        rain.flakesFar.simulate(particles, flakeEmitter(35.0, false), seen, eye, snowing)
        rain.puffs.spawnFromHits(particles, puffEmitter(), seen, rain.flakesNear, 1, 2)
        fin mote = weatherClamp(parts.dust.moteSize, 0.2, 10.0) * 0.001
        rain.motesNear.simulate(particles, moteEmitter(12.0, mote, parts.dust.color), seen, eye, dusting)
        rain.motesFar.simulate(particles, moteEmitter(40.0, mote * 4.0, parts.dust.color), seen, eye, dusting)
        send0(commands, sel("commit"))
        // Under AZORA_GPU_TIMING the frame's GPU time counts this command buffer too.
        if app.gpu.timing {
            send0(commands, sel("waitUntilCompleted"))
            app.gpu.gpuSeconds += azSendD0(commands, sel("GPUEndTime")) - azSendD0(commands, sel("GPUStartTime"))
        }
        return
    }
}

/** Draws rain, snow, dust and their splashes over the finished view, soft against what the scene drew. */
@System(phase: .RenderTransparent)
func drawAetherPrecipitation(app: App!, view: SceneView&, world: World!, particles: ParticlePipelines&, skies: @query [AetherSky&, AetherState&, AetherPrecipitation&]) {
    while skies.hasNext() {
        let row = skies.next()
        let sky: AetherSky& = row.1
        let state: AetherState& = row.2
        let rain: AetherPrecipitation& = row.3
        if !sky.enabled || !rain.ready || !particles.ready || view.encoder == 0 || view.depth == 0 then continue
        fin parts = weatherParts(world)
        fin falling = weatherClamp(state.rain, 0.0, 1.0)
        fin snowing = weatherClamp(state.snow, 0.0, 1.0)
        fin dusting = weatherClamp(state.dust, 0.0, 1.0)
        fin splashes = weatherClamp(parts.rain.splashes, 0.0, 1.0)
        fin seen = sceneParticleView(app, view, world, 0)
        fin encoder = view.encoder
        fin depth = view.depth
        fin still = app.gpu.depthOff
        rain.rings.draw(particles, ringEmitter(state.wetness, splashes), seen, encoder, depth, still)
        rain.droplets.draw(particles, dropletEmitter(splashes), seen, encoder, depth, still)
        rain.puffs.draw(particles, puffEmitter(), seen, encoder, depth, still)
        if falling > 0.0 {
            rain.dropsFar.draw(particles, dropEmitter(35.0, 35.0, falling, false), seen, encoder, depth, still)
            rain.dropsNear.draw(particles, dropEmitter(9.0, 4.5, falling, true), seen, encoder, depth, still)
        }
        if snowing > 0.0 {
            rain.flakesFar.draw(particles, flakeEmitter(35.0, false), seen, encoder, depth, still)
            rain.flakesNear.draw(particles, flakeEmitter(9.0, true), seen, encoder, depth, still)
        }
        if dusting > 0.0 {
            fin mote = weatherClamp(parts.dust.moteSize, 0.2, 10.0) * 0.001
            rain.motesFar.draw(particles, moteEmitter(40.0, mote * 4.0, parts.dust.color), seen, encoder, depth, still)
            rain.motesNear.draw(particles, moteEmitter(12.0, mote, parts.dust.color), seen, encoder, depth, still)
        }
        app.gpu.mode = -1
        app.gpu.meshPipeline = 0
        return
    }
}
