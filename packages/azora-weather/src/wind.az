/**
 * @file engine.weather.wind
 *
 * The wind, a part of the weather: the scene's [Wind] everywhere, plus
 * [WindZone]s, each a wind of its own over part of the scene (a fan, a gap
 * between buildings, a helicopter's downwash, a dust devil). Anything that
 * moves with the air - rain, clouds, water, plants - asks [WindField.at] for
 * the velocity at a point; shaders get the same field as a block of floats
 * ([packWindField], [windFieldMetalSource]).
 */
module engine.weather.wind

import std.math
import engine.core
import engine.ecs
import engine.io
import engine.math
import engine.math.mat
import engine.scene
import engine.scene.transforms

/**
 * The wind over the scene: how fast it blows, from which compass bearing (0
 * north, the world's -Z; 90 east, +X), how it gusts and wavers, and how loud
 * it is heard. Rain, snow, dust, particles and the clouds follow it.
 */
@Component
@Inspectable(title: "Wind", serializedName: "Wind", icon: "wind", category: "Weather", order: 33)
pack Wind derives Clone {
    var enabled: Bool = true
    /** Metres per second between gusts. */
    @Range(min: 0.0, max: 60.0, step: 0.1)
    var speed: Double = 20.0
    /** The compass bearing it blows from, in degrees. */
    @Range(min: 0.0, max: 360.0, step: 1.0)
    var direction: Double = 225.0
    /** How much stronger a gust blows: 0.5 adds up to half again. */
    @Range(min: 0.0, max: 2.0, step: 0.01)
    var gusts: Double = 0.35
    /** Gusts a second, about. */
    @Range(min: 0.01, max: 4.0, step: 0.01)
    var gustFrequency: Double = 0.2
    /** How far its bearing wavers, as a share of 30 degrees. */
    @Range(min: 0.0, max: 1.0, step: 0.01)
    var turbulence: Double = 0.2
    @Range(min: 0.0, max: 2.0, step: 0.01)
    var volume: Double = 1.0
}

/** A smooth value noise of [t] in 0..1, the same for the same [t] and [salt]. */
func windNoise(t: Double, salt: Double): Double {
    fin cell = floor(t) as Double
    fin f = t - cell
    fin a = windFract(sin(cell * 127.1 + salt * 311.7) * 43758.5453)
    fin b = windFract(sin((cell + 1.0) * 127.1 + salt * 311.7) * 43758.5453)
    fin s = f * f * (3.0 - 2.0 * f)
    return a + (b - a) * s
}

func windFract(x: Double): Double = x - (floor(x) as Double)

/**
 * Where and how hard [wind] blows at [time] seconds, m/s along world X and Z:
 * toward the bearing opposite the one it comes from, gusting (two octaves of
 * smooth noise, only ever stronger) and wavering in bearing.
 */
func windAt(wind: Wind&, time: Double): Vec3 {
    if !wind.enabled then return Vec3(0.0, 0.0, 0.0)
    fin rate = if wind.gustFrequency > 0.0 then wind.gustFrequency else 0.01
    fin swell = windNoise(time * rate, 1.0) * 0.7 + windNoise(time * rate * 2.7, 2.0) * 0.3
    fin gust = wind.gusts * (if swell > 0.45 then (swell - 0.45) / 0.55 else 0.0)
    fin waver = (windNoise(time * rate * 0.6, 3.0) - 0.5) * 2.0 * wind.turbulence * 0.5235987755982988
    fin bearing = wind.direction * 0.017453292519943295 + waver
    fin speed = wind.speed * (1.0 + gust)
    return .(-sin(bearing) * speed, 0.0, cos(bearing) * speed)
}

/** The scene's first enabled, visible [Wind], or none. */
func sceneWindEntity(world: World!): Entity {
    fin winds = ensureStorage<Wind>(world)
    for index: Int in 0..<storageLength<Wind>(winds) {
        fin entity = storageEntityAt<Wind>(winds, index)
        if winds.values[index].enabled && world.isAlive(entity) && visibleInWorld(world, entity) then return entity
    }
    return ::invalid
}

/** How the scene's [Wind] blows at [time], m/s; still air when it has none. Its local [WindZone]s: [gatherWindField]. */
func sceneWind(world: World!, time: Double): Vec3 {
    fin entity = sceneWindEntity(world)
    return if world.isAlive(entity) then windAt(storageGet<Wind>(ensureStorage(world), entity), time) else .(0.0, 0.0, 0.0)
}

/**
 * A wind of its own over part of the scene, added to the scene's [Wind] where
 * it reaches (or, with [replaces], instead of it). Its entity's position is
 * its centre; a box turns with the entity's heading.
 */
@Component
@Inspectable(title: "Wind Zone", serializedName: "WindZone", icon: "wind", category: "Weather", order: 34)
pack WindZone derives Clone {
    var enabled: Bool = true
    /** Where it blows: inside a sphere of [radius], or inside a box of [size] turned with the entity. */
    @Choice(options: "Sphere|Box")
    var shape: Int = 0
    @Range(min: 0.5, max: 5000.0, step: 0.5)
    var radius: Double = 20.0
    /** A box's full size along its own X, Y and Z, in metres. */
    var size: Vec3 = .(20.0, 10.0, 20.0)
    /** The share of its reach over which it fades out toward its edge: 0 a hard edge, 1 from the centre on. */
    @Range(min: 0.0, max: 1.0, step: 0.01)
    var falloff: Double = 0.4
    /** How it blows: along [direction], out from its centre, in toward it, or around it (a vortex, anticlockwise from above). */
    @Choice(options: "Directional|Outward|Inward|Vortex")
    var mode: Int = 0
    /** Metres per second between gusts. */
    @Range(min: 0.0, max: 80.0, step: 0.1)
    var speed: Double = 8.0
    /** Directional: the compass bearing it blows from, in degrees, as [Wind.direction]. */
    @Range(min: 0.0, max: 360.0, step: 1.0)
    var direction: Double = 0.0
    /** Vertical air speed, m/s: up in a thermal, down (negative) under a rotor. */
    @Range(min: -40.0, max: 40.0, step: 0.1)
    var lift: Double = 0.0
    /** How much stronger a gust blows (0.5 adds up to half again). */
    @Range(min: 0.0, max: 2.0, step: 0.01)
    var gusts: Double = 0.3
    /** Gusts a second, about. */
    @Range(min: 0.01, max: 4.0, step: 0.01)
    var gustFrequency: Double = 0.5
    /** Whether, inside, it takes the scene's wind's place (a sheltered courtyard is a zone of speed 0 that replaces). */
    var replaces: Bool = false
}

/** The most zones a shader sees; the rest act only on the CPU side. */
inline fin windZonesOnGpu: Int = 16

/** The floats [packWindField] writes: a header of 8, then 16 a zone. */
inline fin windFieldFloats: Int = 8 + windZonesOnGpu * 16

/** The bytes of the block [packWindField] writes. */
inline fin windFieldBytes: Long = 4 * (8 + 16 * 16)

/** One zone as the field evaluates it this moment: placed, turned and gusting. */
pack WindZoneSample derives Clone {
    var center: Vec3 = .(0.0, 0.0, 0.0)
    /** 0 sphere, 1 box. */
    var shape: Int = 0
    /** A sphere's radius, or a box's half size along its own axes. */
    var reach: Vec3 = .(1.0, 1.0, 1.0)
    var falloff: Double = 0.4
    /** The box's heading as cosine and sine (turning world X/Z into its own). */
    var headingCos: Double = 1.0
    var headingSin: Double = 0.0
    var mode: Int = 0
    /** Speed now, gusts included, m/s. */
    var speed: Double = 0.0
    /** Directional: the unit horizontal direction it blows toward. */
    var towardX: Double = 0.0
    var towardZ: Double = 0.0
    var lift: Double = 0.0
    var replaces: Bool = false
}

/** The wind over a scene at one moment: the scene's [Wind] and every enabled, visible [WindZone]. */
pack WindField derives Clone {
    var global: Vec3 = .(0.0, 0.0, 0.0)
    var zones: Array<WindZoneSample> = []
    var time: Double = 0.0
}

/** The gust factor (1 and up) of a wind gusting by [gusts] at [frequency] a second, at [time]: two octaves of smooth noise. */
func windGust(gusts: Double, frequency: Double, time: Double, salt: Double): Double {
    fin rate = if frequency > 0.0 then frequency else 0.01
    fin swell = windNoise(time * rate, salt) * 0.7 + windNoise(time * rate * 2.7, salt + 1.0) * 0.3
    return 1.0 + gusts * (if swell > 0.45 then (swell - 0.45) / 0.55 else 0.0)
}

/** [zone] at [entity]'s place and heading, gusting as it does at [time]. */
func windZoneSample(world: World!, entity: Entity, zone: WindZone&, time: Double): WindZoneSample {
    fin pose = worldMatrix(world, entity)
    // The heading of the entity's own X axis in the ground plane.
    fin across = sqrt(pose.m00 * pose.m00 + pose.m20 * pose.m20)
    fin c = if across > 0.000001 then pose.m00 / across else 1.0
    fin s = if across > 0.000001 then pose.m20 / across else 0.0
    fin bearing = zone.direction * 0.017453292519943295
    fin reach: Vec3 = if zone.shape == 1 then .(absValue(zone.size.x) * 0.5, absValue(zone.size.y) * 0.5, absValue(zone.size.z) * 0.5)
        else .(absValue(zone.radius), absValue(zone.radius), absValue(zone.radius))
    return .(
        center: .(pose.m03, pose.m13, pose.m23)
        shape: zone.shape
        reach: reach
        falloff: windClamp(zone.falloff, 0.0, 1.0)
        headingCos: c
        headingSin: s
        mode: zone.mode
        speed: zone.speed * windGust(zone.gusts, zone.gustFrequency, time, (entity.id as Double) * 0.37 + 5.0)
        towardX: -sin(bearing)
        towardZ: cos(bearing)
        lift: zone.lift
        replaces: zone.replaces
    )
}

/** The wind over [world] at [time]: its [Wind] and its zones, ready to be asked at many points. */
func gatherWindField(world: World!, time: Double): WindField {
    var field: WindField = .(sceneWind(world, time), [], time)
    fin zones = ensureStorage<WindZone>(world)
    for index: Int in 0..<storageLength<WindZone>(zones) {
        fin entity = storageEntityAt<WindZone>(zones, index)
        if zones.values[index].enabled && world.isAlive(entity) && visibleInWorld(world, entity) then
            field.zones.add(windZoneSample(world, entity, zones.values[index], time))
    }
    return take field
}

func windClamp(x: Double, low: Double, high: Double): Double = if x < low then low else if x > high then high else x

/**
 * How strongly [zone] blows at [point], 0 outside to 1 well inside: its
 * normalised distance from the centre (a sphere's radius or the box's
 * nearest face is 1), faded over the last [WindZoneSample.falloff] of it.
 */
func windZoneWeight(zone: WindZoneSample&, point: Vec3&): Double {
    fin dx = point.x - zone.center.x
    fin dy = point.y - zone.center.y
    fin dz = point.z - zone.center.z
    // A box measures in its own axes (its heading turns world X/Z), a sphere by plain distance.
    fin lx = dx * zone.headingCos + dz * zone.headingSin
    fin lz = -dx * zone.headingSin + dz * zone.headingCos
    fin reach = if zone.shape == 1 then windMaximum(absValue(lx) / windMaximum(zone.reach.x, 0.001),
            windMaximum(absValue(dy) / windMaximum(zone.reach.y, 0.001), absValue(lz) / windMaximum(zone.reach.z, 0.001)))
        else sqrt(dx * dx + dy * dy + dz * dz) / windMaximum(zone.reach.x, 0.001)
    if reach >= 1.0 then return 0.0
    if zone.falloff <= 0.0 then return 1.0
    fin edge = windClamp((1.0 - reach) / zone.falloff, 0.0, 1.0)
    return edge * edge * (3.0 - 2.0 * edge)
}

func windMaximum(a: Double, b: Double): Double = if a > b then a else b

/** [zone]'s own air velocity at [point] at full strength, m/s. */
func windZoneVelocity(zone: WindZoneSample&, point: Vec3&): Vec3 {
    fin dx = point.x - zone.center.x
    fin dz = point.z - zone.center.z
    fin across = sqrt(dx * dx + dz * dz)
    fin outX = if across > 0.001 then dx / across else 0.0
    fin outZ = if across > 0.001 then dz / across else 0.0
    return when zone.mode {
        1 -> .(outX * zone.speed, zone.lift, outZ * zone.speed)
        2 -> .(-outX * zone.speed, zone.lift, -outZ * zone.speed)
        3 -> .(-outZ * zone.speed, zone.lift, outX * zone.speed)
        else -> .(zone.towardX * zone.speed, zone.lift, zone.towardZ * zone.speed)
    }
}

impl WindField {
    /** The air's velocity at [point], m/s: the scene's wind, each zone blended in by its weight. */
    func &.at(point: Vec3&): Vec3 {
        var x = self.global.x
        var y = self.global.y
        var z = self.global.z
        for zone in self.zones {
            fin weight = windZoneWeight(zone, point)
            if weight <= 0.0 then continue
            fin own = windZoneVelocity(zone, point)
            if zone.replaces {
                x += (own.x - x) * weight
                y += (own.y - y) * weight
                z += (own.z - z) * weight
            } else {
                x += own.x * weight
                y += own.y * weight
                z += own.z * weight
            }
        }
        return .(x, y, z)
    }
}

/** The air's velocity at [point] in [world] at [time]: the field gathered for this one question. */
func windFieldAt(world: World!, point: Vec3&, time: Double): Vec3 = gatherWindField(world, time).at(point)

/**
 * Writes [field] into [into] ([windFieldBytes]) as [windFieldMetalSource]
 * reads it: the scene's wind and the zone count, then the first
 * [windZonesOnGpu] zones nearest [near] (four float4 each).
 */
func packWindField(field: WindField&, near: Vec3&, into: Long) {
    azPokeF32(into, 0, field.global.x)
    azPokeF32(into, 4, field.global.y)
    azPokeF32(into, 8, field.global.z)
    fin chosen = nearestWindZones(field, near)
    azPokeF32(into, 12, chosen.size as Double)
    azPokeF32(into, 16, field.time)
    for i: Int in 5..<8 then azPokeF32(into, (i * 4) as Long, 0.0)
    for slot: Int in 0..<chosen.size {
        fin zone = field.zones[chosen[slot]].&
        fin at = (32 + slot * 64) as Long
        azPokeF32(into, at, zone.center.x)
        azPokeF32(into, at + 4, zone.center.y)
        azPokeF32(into, at + 8, zone.center.z)
        azPokeF32(into, at + 12, zone.shape as Double)
        azPokeF32(into, at + 16, zone.reach.x)
        azPokeF32(into, at + 20, zone.reach.y)
        azPokeF32(into, at + 24, zone.reach.z)
        azPokeF32(into, at + 28, zone.falloff)
        azPokeF32(into, at + 32, zone.headingCos)
        azPokeF32(into, at + 36, zone.headingSin)
        azPokeF32(into, at + 40, zone.mode as Double)
        azPokeF32(into, at + 44, if zone.replaces then 1.0 else 0.0)
        azPokeF32(into, at + 48, zone.towardX * zone.speed)
        azPokeF32(into, at + 52, zone.lift)
        azPokeF32(into, at + 56, zone.towardZ * zone.speed)
        azPokeF32(into, at + 60, zone.speed)
    }
}

/** The places in [field]'s zones of the [windZonesOnGpu] whose edge is nearest [near] (all of them when there are fewer). */
func nearestWindZones(field: WindField&, near: Vec3&): Array<Int> {
    var places: Array<Int> = []
    var gaps: Array<Double> = []
    for i: Int in 0..<field.zones.size {
        fin zone = field.zones[i].&
        fin dx = zone.center.x - near.x
        fin dy = zone.center.y - near.y
        fin dz = zone.center.z - near.z
        fin gap = sqrt(dx * dx + dy * dy + dz * dz) - windMaximum(zone.reach.x, windMaximum(zone.reach.y, zone.reach.z))
        // Insertion into the short sorted list kept.
        var k = places.size
        places.add(i)
        gaps.add(gap)
        while k > 0 && gaps[k] < gaps[k - 1] {
            fin g = gaps[k]
            gaps[k] = gaps[k - 1]
            gaps[k - 1] = g
            fin p = places[k]
            places[k] = places[k - 1]
            places[k - 1] = p
            k--
        }
        if places.size > windZonesOnGpu {
            places.removeLast()
            gaps.removeLast()
        }
    }
    return take places
}

/**
 * Metal source of `float3 windFieldAt(float3 p, constant float4* field)`:
 * the field [packWindField] wrote, as [WindField.at] computes it. A shader
 * includes it and passes the block it was given.
 */
func windFieldMetalSource(): String = "
float windZoneWeight(float3 p, constant float4* z) {
    float3 d = p - z[0].xyz;
    float reach;
    if (z[0].w > 0.5) {
        float lx = d.x*z[2].x + d.z*z[2].y;
        float lz = -d.x*z[2].y + d.z*z[2].x;
        reach = max(abs(lx)/max(z[1].x,0.001), max(abs(d.y)/max(z[1].y,0.001), abs(lz)/max(z[1].z,0.001)));
    } else {
        reach = length(d)/max(z[1].x,0.001);
    }
    if (reach >= 1.0) return 0.0;
    if (z[1].w <= 0.0) return 1.0;
    float edge = clamp((1.0-reach)/z[1].w, 0.0, 1.0);
    return edge*edge*(3.0-2.0*edge);
}
float3 windZoneVelocity(float3 p, constant float4* z) {
    float2 d = p.xz - z[0].xz;
    float across = length(d);
    float2 o = across > 0.001 ? d/across : float2(0.0);
    int mode = int(z[2].z + 0.5);
    float speed = z[3].w;
    if (mode == 1) return float3(o.x*speed, z[3].y, o.y*speed);
    if (mode == 2) return float3(-o.x*speed, z[3].y, -o.y*speed);
    if (mode == 3) return float3(-o.y*speed, z[3].y, o.x*speed);
    return z[3].xyz;
}
float3 windFieldAt(float3 p, constant float4* field) {
    float3 v = field[0].xyz;
    int count = int(field[0].w + 0.5);
    for (int i = 0; i < count; i++) {
        constant float4* z = field + 2 + i*4;
        float w = windZoneWeight(p, z);
        if (w <= 0.0) continue;
        float3 own = windZoneVelocity(p, z);
        v = z[2].w > 0.5 ? mix(v, own, w) : v + own*w;
    }
    return v;
}
"
