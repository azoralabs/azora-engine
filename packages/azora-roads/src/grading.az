module engine.roads.grading

import std.math
import engine.io
import engine.math
import engine.math.mat
import engine.roads
import engine.scene.terrain

pack RoadGrade {
    var target: Double = 0.0
    var weight: Double = 0.0
    var distance: Double = 1.0e9
}

func considerRoadGrade(result: RoadGrade!, x: Double, z: Double, span: RoadSpan&, clearance: Double) {
    if span.style.isBridge then return
    fin a = span.start.center.&
    fin b = span.end.center.&
    fin vx = b.x-a.x
    fin vz = b.z-a.z
    fin distance = vx*vx+vz*vz
    if distance < 0.000001 then return
    fin t = roadLimit(((x-a.x)*vx+(z-a.z)*vz)/distance,0.0,1.0)
    fin dx = x - (a.x+t*vx)
    fin dz = z - (a.z+t*vz)
    fin side = if dx*span.start.right.x+dz*span.start.right.z >= 0.0 then roadRight(span.style) else roadLeft(span.style)
    fin dist = sqrt(dx*dx+dz*dz)
    fin blend = roadLimit(span.style.gradingWidth,4.0,120.0)
    if dist >= side+clearance+blend then return
    fin q = roadLimit((dist-side-clearance)/blend,0.0,1.0)
    fin weight = 1.0-q*q*(3.0-2.0*q)
    if weight < result.weight || (weight == result.weight && dist >= result.distance) then return
    fin grade = a.y+t*(b.y-a.y)
    fin fall = roadLimit(span.style.crossfall,0.0,6.0)*0.01
    result.target = grade-roadMin(dist,side)*fall-0.35
    result.weight = weight
    result.distance = dist
}

/** Cut and fill on the same heightfield samples used for rendering and contact. */
func gradeRoadTerrain(image: TerrainImage&, model: Mat4&, network: RoadNetwork&) {
    if image.samples == 0 || network.grid.size == 0 || absValue(model.m11) < 0.001 then return
    // Heightfields used as road ground must have vertical local Y.
    if absValue(model.m01) + absValue(model.m21) > 0.001 then return
    fin dx = (image.columns-1) as Double
    fin dz = (image.rows-1) as Double
    fin clearance = sqrt((model.m00*model.m00+model.m20*model.m20)/(dx*dx) +
        (model.m02*model.m02+model.m22*model.m22)/(dz*dz))
    var grade = RoadGrade()
    var z = 0
    while z < image.rows {
        fin v = (z as Double)/dz-0.5
        var x = 0
        while x < image.columns {
            fin u = (x as Double)/dx-0.5
            fin wx = model.m03+model.m00*u+model.m02*v
            fin wz = model.m23+model.m20*u+model.m22*v
            fin original = terrainHeight(image,x,z)
            fin base = model.m13+model.m10*u+model.m12*v
            fin wy = base+model.m11*original
            fin bucket = network.grid[roadBucketAt(roadBucketCoordinate(wx),roadBucketCoordinate(wz))].&
            grade.weight = 0.0
            grade.distance = 1.0e9
            for index in bucket.spans {
                considerRoadGrade(grade,wx,wz,network.spans[index],clearance)
            }
            for site in network.junctions {
                fin x0 = wx-site.center.x
                fin z0 = wz-site.center.z
                fin dist = sqrt(x0*x0+z0*z0)
                fin q = roadLimit((dist-roadLimit(site.config.radius,3.0,60.0)-clearance)/35.0,0.0,1.0)
                fin weight = 1.0-q*q*(3.0-2.0*q)
                if weight > grade.weight || (dist <= site.config.radius && weight > 0.0) {
                    grade.target = site.center.y-0.35
                    grade.weight = weight
                    grade.distance = dist
                }
            }
            if grade.weight > 0.0 {
                fin height = wy + (grade.target-wy)*grade.weight
                azPokeF64(image.samples,((z*image.columns+x) as Long)*8,terrainClamp((height-base)/model.m11,-0.5,0.5))
            }
            x += 1
        }
        z += 1
    }
}
