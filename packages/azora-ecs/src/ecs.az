// Azora Engine — ECS.
//
// A small, data-oriented ECS layer. Storage is explicit and opt-in: create the
// component stores a game needs, pass them to systems, and keep the renderer or
// UI modules out of pure simulation code.

module engine.ecs

import std.container.*
import engine.core


pack Entity {
    var id: Int
    var generation: Int
}

impl Entity {
    prop isValid[self: Self&]: Bool = self.id >= 0
    fin invalid: Entity = .(-1, 0)
}

pack World {
    var generations: Array<Int> = @arr[1]
    var alive: Array<Bool> = @arr[false]
    var names: Array<String> = @arr[""]
    var parents: Array<Int> = @arr[-1]
    var childCounts: Array<Int> = @arr[0]
    var prefabs: Array<Bool> = @arr[false]
    var resourceMarks: Array<Bool> = @arr[false]
    var freeIds: Array<Int> = @arr[-1]
    var entityCount: Int = 0
    var aliveCount: Int = 0
    var tick: Int = 0
    var storageNames: MutableList<String> = @vec![]
    var storages: MutableList<Any> = @vec![]
    var resourceNames: MutableList<String> = @vec![]
    var resources: MutableList<Any> = @vec![]
    var totalTime: Double = 0.0
    var fixedTimestep: Double = 1.0 / 60.0
    var fixedAccumulator: Double = 0.0
    var revision: Long = 0L
}


impl World {
    func spawn[self: Self&](): Entity {
        if self.freeIds.size > 1 {
            fin last = self.freeIds.size - 1
            fin id = self.freeIds[last]
            self.freeIds.remove(id)

            fin gen = self.generations[id] + 1
            self.generations[id] = gen
            self.alive[id] = true
            self.names[id] = ""
            self.parents[id] = -1
            self.childCounts[id] = 0
            self.prefabs[id] = false
            self.resourceMarks[id] = false
            self.aliveCount = self.aliveCount + 1
            self.revision = self.revision + 1
            return Entity(id, gen)
        }

        fin id = self.entityCount
        if id < self.generations.size {
            self.generations[id] = 0
            self.alive[id] = true
            self.names[id] = ""
            self.parents[id] = -1
            self.childCounts[id] = 0
            self.prefabs[id] = false
            self.resourceMarks[id] = false
        } else {
            self.generations.add(0)
            self.alive.add(true)
            self.names.add("")
            self.parents.add(-1)
            self.childCounts.add(0)
            self.prefabs.add(false)
            self.resourceMarks.add(false)
        }
        self.entityCount = self.entityCount + 1
        self.aliveCount = self.aliveCount + 1
        self.revision = self.revision + 1
        return Entity(id, 0)
    }

    func spawnNamed[self: Self&](name: String): Entity {
        fin entity = self.spawn()
        self.names[entity.id] = name
        return entity
    }

    func despawn[self: Self&](entity: Entity) {
        if !self.isAlive(entity) {
            return
        }

        self.alive[entity.id] = false
        self.names[entity.id] = ""
        self.aliveCount = self.aliveCount - 1

        fin parentId = self.parents[entity.id]
        if parentId >= 0 && parentId < self.entityCount {
            self.childCounts[parentId] = self.childCounts[parentId] - 1
        }
        self.parents[entity.id] = -1
        self.childCounts[entity.id] = 0
        self.prefabs[entity.id] = false
        self.resourceMarks[entity.id] = false
        self.freeIds.add(entity.id)
        self.revision = self.revision + 1
    }

    func isAlive[self: Self&](entity: Entity): Bool {
        if entity.id < 0 || entity.id >= self.entityCount {
            return false
        }
        return self.alive[entity.id] && self.generations[entity.id] == entity.generation
    }

    prop count[self: Self&]: Int = self.aliveCount

    func entityAt[self: Self&](id: Int): Entity {
        if id < 0 || id >= self.entityCount {
            return Entity::invalid
        }
        return Entity(id, self.generations[id])
    }

    func setName[self: Self&](entity: Entity, name: String) {
        if self.isAlive(entity) {
            self.names[entity.id] = name
        }
    }

    func getName[self: Self&](entity: Entity): String {
        if !self.isAlive(entity) {
            return ""
        }
        return self.names[entity.id]
    }

    func lookup[self: Self&](name: String): Entity {
        var i = 0
        while i < self.entityCount {
            if self.alive[i] && self.names[i] == name {
                return Entity(i, self.generations[i])
            }
            i = i + 1
        }
        return Entity::invalid
    }

    func setParent[self: Self&](child: Entity, parent: Entity) {
        if !self.isAlive(child) || !self.isAlive(parent) {
            return
        }
        fin oldParent = self.parents[child.id]
        if oldParent >= 0 && oldParent < self.entityCount {
            self.childCounts[oldParent] = self.childCounts[oldParent] - 1
        }
        self.parents[child.id] = parent.id
        self.childCounts[parent.id] = self.childCounts[parent.id] + 1
    }

    func removeParent[self: Self&](entity: Entity) {
        if !self.isAlive(entity) {
            return
        }
        fin parentId = self.parents[entity.id]
        if parentId >= 0 && parentId < self.entityCount {
            self.childCounts[parentId] = self.childCounts[parentId] - 1
        }
        self.parents[entity.id] = -1
    }

    func getParent[self: Self&](entity: Entity): Entity {
        if !self.isAlive(entity) {
            return Entity::invalid
        }
        fin parentId = self.parents[entity.id]
        if parentId < 0 || parentId >= self.entityCount {
            return Entity::invalid
        }
        return Entity(parentId, self.generations[parentId])
    }

    func getChildCount[self: Self&](entity: Entity): Int {
        if !self.isAlive(entity) {
            return 0
        }
        return self.childCounts[entity.id]
    }

    func markPrefab[self: Self&](entity: Entity) {
        if self.isAlive(entity) {
            self.prefabs[entity.id] = true
        }
    }

    func isPrefab[self: Self&](entity: Entity): Bool {
        if !self.isAlive(entity) {
            return false
        }
        return self.prefabs[entity.id]
    }

    func spawnResource[self: Self&](name: String): Entity {
        fin entity = self.spawnNamed(name)
        self.resourceMarks[entity.id] = true
        return entity
    }

    func markResource[self: Self&](entity: Entity) {
        if self.isAlive(entity) {
            self.resourceMarks[entity.id] = true
        }
    }

    func isResource[self: Self&](entity: Entity): Bool {
        if !self.isAlive(entity) {
            return false
        }
        return self.resourceMarks[entity.id]
    }

    func progress[self: Self&](deltaTime: Double) {
        self.tick = self.tick + 1
        self.totalTime = self.totalTime + deltaTime
        self.fixedAccumulator = self.fixedAccumulator + deltaTime
    }

    func setFixedTimestep[self: Self&](timestep: Double) {
        self.fixedTimestep = timestep
    }

    func consumeFixedStep[self: Self&](): Bool {
        if self.fixedAccumulator >= self.fixedTimestep {
            self.fixedAccumulator = self.fixedAccumulator - self.fixedTimestep
            return true
        }
        return false
    }

    @ProvidesAccess
    prop stamp[self: Self&]: Int {
        return self.revision as Int
    }
}

pack Storage<T> {
    var entities: Array<Entity>
    var values: Array<T>
    var added: Array<Bool>
    var changed: Array<Bool>
    var revision: Long
}

func storageInit<T>(defaultValue: T): Storage<T> {
    var entities = @arr[Entity::invalid]
    var values = @arr[defaultValue]
    var added = @arr[false]
    var changed = @arr[false]
    return Storage<T>(entities, values, added, changed, 0)
}

func storageIndexOf<T>(store: Storage<T>&, entity: Entity): Int {
    if !entity.isValid {
        return -1
    }
    var i = 0
    while i < store.entities.size {
        fin current = store.entities[i]
        if current.isValid && current.id == entity.id && current.generation == entity.generation {
            return i
        }
        i = i + 1
    }
    return -1
}

func storageHas<T>(store: Storage<T>&, entity: Entity): Bool {
    return storageIndexOf<T>(store, entity) >= 0
}

func storageInsert<T>(store: Storage<T>!, entity: Entity, value: T) {
    fin index = storageIndexOf<T>(store, entity)
    if index >= 0 {
        store.values[index] = value
        store.changed[index] = true
        store.revision = store.revision + 1
        return
    }
    store.entities.add(entity)
    store.values.add(value)
    store.added.add(true)
    store.changed.add(false)
    store.revision = store.revision + 1
}

func storageGet<T>(store: Storage<T>&, entity: Entity): T {
    fin index = storageIndexOf<T>(store, entity)
    return store.values[index]
}

func storageGetOrDefault<T>(store: Storage<T>&, entity: Entity, defaultValue: T): T {
    fin index = storageIndexOf<T>(store, entity)
    if index < 0 {
        return defaultValue
    }
    return store.values[index]
}

func storageRemove<T>(store: Storage<T>!, entity: Entity): Bool {
    fin index = storageIndexOf<T>(store, entity)
    if index < 0 {
        return false
    }
    store.entities[index] = Entity::invalid
    store.added[index] = false
    store.changed[index] = false
    store.revision = store.revision + 1
    return true
}

/**
 * Drops [entity] from every storage the world holds, whatever they hold.
 *
 * Removal marks the entity's slot and clears its change flags; it never reads
 * the value, so what a storage holds does not come into it. That is what lets
 * something drop an entity without naming a single component type - and so lets
 * a composition be written without naming the components composed into it.
 *
 * Answers how many storages carried the entity.
 */
@Experimental(since: "0.1")
func removeFromEveryStorage(world: World!, entity: Entity): Int {
    var dropped = 0
    var i = 0
    while i < world.storages.size {
        var store = world.storages[i] as Storage<Any>
        if storageRemove<Any>(store, entity) {
            dropped = dropped + 1
        }
        i = i + 1
    }
    return dropped
}

func storageWasAdded<T>(store: Storage<T>&, entity: Entity): Bool {
    fin index = storageIndexOf<T>(store, entity)
    return index >= 0 && store.added[index]
}

func storageWasChanged<T>(store: Storage<T>&, entity: Entity): Bool {
    fin index = storageIndexOf<T>(store, entity)
    return index >= 0 && store.changed[index]
}

func storageClearTracking<T>(store: Storage<T>!) {
    var i = 0
    while i < store.added.size {
        store.added[i] = false
        store.changed[i] = false
        i = i + 1
    }
}

func storageCount<T>(store: Storage<T>&): Int {
    var total = 0
    var i = 0
    while i < store.entities.size {
        if store.entities[i].isValid {
            total = total + 1
        }
        i = i + 1
    }
    return total
}

func storageEntityAt<T>(store: Storage<T>&, index: Int): Entity {
    return store.entities[index]
}

func storageValueAt<T>(store: Storage<T>&, index: Int): T {
    return store.values[index]
}

func storageLength<T>(store: Storage<T>&): Int {
    return store.entities.size
}

/**
 * Creates an entity with no components.
 *
 * A free function beside `World.spawn`, because an `impl` reaches a module that
 * imports its type directly but not one that sees it only transitively - so a
 * package that merely passes a `World` through could not spawn from it. The
 * free form has no such reach problem.
 */
@Experimental(since: "0.1")
func spawnEntity(world: World!): Entity {
    return world.spawn()
}

/** Destroys [entity]. The free counterpart to `World.despawn`, as above. */
@Experimental(since: "0.1")
func despawnEntity(world: World!, entity: Entity) {
    world.despawn(entity)
}

func spawnWith<T>(world: World!, store: Storage<T>!, value: T): Entity {
    fin entity = world.spawn()
    storageInsert<T>(store, entity, value)
    return entity
}

func copyComponent<T>(store: Storage<T>!, source: Entity, target: Entity) {
    if storageHas<T>(store, source) {
        storageInsert<T>(store, target, storageGet<T>(store, source))
    }
}

func spawnResourceWith<T>(world: World!, store: Storage<T>!, name: String, value: T): Entity {
    fin entity = world.spawnResource(name)
    storageInsert<T>(store, entity, value)
    return entity
}

pack QueryFetch {
    var ok: Bool
    var entity: Entity
    var error: String
}

pack QueryCursor {
    var entities: Array<Entity>
    var cursor: Int
    var ok: Bool
    var error: String
}

/**
 * A typed single-result query.
 *
 * The component value remains borrowed from its storage. `single.*`
 * exposes it explicitly; the entity is retained for commands and diagnostics.
 */
@Experimental(since: "0.1")
pack Single<...T> where (...T).size >= 1 {
    var entity: Entity
    // The field generator emits a *string fragment* because the field's name is
    // generated too: `$index` splices the position in, giving `value0`,
    // `value1`, … . Writing `value: Ty` instead would declare the same name on
    // every iteration - the specialized pack would still take one argument per
    // type, but only the last field would be reachable by name and every
    // earlier one would be silently unreadable.
    inline for Ty in ...T with index {
        inline "value$index: $Ty"
    }
}

impl Single<...T> {
    /** The first (and, for a one-type query, only) component value. */
    oper.* [self: Self&] {
        return self.value0
    }
}

/**
 * Heterogeneous ECS query handle, written `QueryOf<A, B>`.
 *
 * Named apart from the `@Query` parameter decorator: a decorator registered
 * before a pack of the same name shadows it, and which one wins depends on
 * import order - so the two names are kept distinct rather than relying on it.
 *
 * The variadic type list is compile-time-only access metadata. Runtime state is
 * one compact entity cursor, so adding component types does not increase the
 * handle's allocation count.
 */
@Experimental(since: "0.1")
pack QueryOf<...T> {
    var cursor: QueryCursor
    /**
     * The world the query was asked of.
     *
     * Held because a row is the *components*, not the entity that carries them,
     * and the storages they come from are the world's. A `World` field names the
     * world itself rather than a copy - an aggregate is a reference here.
     */
    var world: World
}

/**
 * A query is what `loop` walks: reset it, then take rows while it has them.
 *
 * Declaring the conformance rather than relying on the two methods being
 * present makes the requirement checkable - `loop q { … }` asks for an
 * `Iterator`, and a query is one.
 */
impl Iterator for QueryOf<...T> assoc Item = Tuple<Entity, ...T> {
    func reset[self: Self!]() {
        self.cursor.reset()
    }

    /** Advances the cursor, answering whether a row was found. */
    prop hasNext[self: Self!]: Bool {
        return self.cursor.hasNext()
    }

    /**
     * The row the cursor is on: the entity, then one component per fetch term.
     *
     * The entity comes first so a row is always at least a pair, and so the
     * component positions follow the order the query was written in.
     *
     * The components are the stored values, not copies of them - an aggregate is
     * a reference here - so a term written `!` may be assigned through and the
     * storage sees it. That is what makes a fetch a *borrow* rather than a read,
     * and what lets a system stop reaching for a storage mid-body.
     */
    @ProvidesAccess
    prop next[self: Self!]: Tuple<Entity, ...T> {
        fin row: Entity = self.cursor.next()
        // Spelled with its type arguments: the row's element types cannot be
        // read back off the fetches, whose types come from calls, and a variadic
        // callee is specialized from the types it is given.
        return tupleOf<Entity, ...T>(row, inline for Ty in ...T {
            storageGet<Ty>(storageOf<Ty>(self.world), row)
        })
    }

    /**
     * Walks the rows, handing each one to [body] as a whole.
     *
     * Written out rather than inherited from `Iterator`: a provided
     * member's copy keeps the spec's `Item` unspecialized in its callable
     * parameter, so the block is offered a bare `Tuple` and the concrete row
     * does not match it.
     */
    @ProvidesAccess
    func forEach[self: Self!](body: inline (Tuple<Entity, ...T>) -> Unit) {
        self.reset()
        while self.hasNext {
            body(self.next)
        }
    }

    /**
     * Walks the rows, handing each one to [body] *spread across parameters*.
     *
     * ```azora
     * shapes.unpack { entity, tag, paint -> … }
     * ```
     *
     * The same rows `forEach` walks, taken apart: one parameter for the entity
     * and one per fetch term, in the order the query was written. Separate from
     * [forEach] because the two differ only in how many parameters the block
     * takes, and a block's arity is not something a call can be resolved on.
     *
     * No tuple is built here - each component is fetched straight from its
     * storage, so `unpack` costs a walk and nothing more.
     */
    @ProvidesAccess
    func unpack[self: Self!](body: inline (Entity, ...T) -> Unit) {
        self.reset()
        while self.hasNext {
            fin row: Entity = self.cursor.next()
            body(
                row
                inline for Ty in ...T {
                    storageGet<Ty>(storageOf<Ty>(self.world), row)
                }
            )
        }
    }
}

impl QueryOf<...T>:: {

    /**
     * Builds the query from the world.
     *
     * What it selects is in its own type: every component in `...T` narrows the
     * cursor to rows that carry it, and the world is asked for each storage by
     * the component's own name. Nothing is passed in but the world, which is
     * what lets a system declare a query as a parameter and receive it built.
     */
    @Experimental(since: "0.1")
    /**
     * How far the storages this query reads have moved.
     *
     * A query's rows change when a component is written, and a storage counts
     * its own writes, so the sum over the fetch terms answers for the whole
     * query in one number.
     */
    @ProvidesAccess
    func stamp(world: World&): Int {
        var total = 0
        inline for Ty in ...T {
            total = total + (storageOf<Ty>(world).revision as Int)
        }
        return total
    }

    @ProvidesAccess
    func provide(world: World&): QueryOf<...T> {
        var cursor = queryAll(world, false)
        inline for Ty in ...T {
            queryWith<Ty>(cursor, storageOf<Ty>(world))
        }
        return QueryOf(cursor, world)
    }
}

impl QueryOf<...T> {

    /**
     * Returns the next matching entity.
     *
     * System-parameter lowering projects this entity into the tuple of borrowed
     * components requested by the `QueryOf<…>` type arguments.
     */
    func nextEntity[self: Self!](): Entity {
        return self.cursor.next()
    }
}

/**
 * Puts [value] in the world as the resource of its type.
 *
 * Answers whether it replaced one, which is how a system that inserts on first
 * use can tell. There is one resource per type, so inserting twice replaces.
 */
@Experimental(since: "0.1")
inline func insertResource<T>(world: World!, value: T): Bool {
    return insertResourceNamed<T>(world, T.typeName, take value)
}

/** Puts [value] under an explicit [name]. See [insertResource]. */
@Experimental(since: "0.1")
func insertResourceNamed<T>(world: World!, name: String, value: T): Bool {
    // Appended rather than replaced in place, and read back to front: the newest
    // entry for a name is the one that answers, so inserting is one operation
    // whether or not the resource was already there.
    var replaced = false
    var i = 0
    while i < world.resourceNames.size {
        if world.resourceNames[i] == name {
            replaced = true
        }
        i = i + 1
    }
    world.resourceNames.add(name)
    world.resources.add(value)
    return replaced
}

/**
 * How many times the resource under [name] has been written.
 *
 * Resources are appended, so the position of the newest entry is a number that
 * moves exactly when the resource is written and never otherwise. That is all a
 * reader needs to tell "the same as last time" from "different".
 */
@Experimental(since: "0.1")
func resourceStamp(world: World&, name: String): Int {
    var found = 0 - 1
    var i = 0
    while i < world.resourceNames.size {
        if world.resourceNames[i] == name {
            found = i
        }
        i = i + 1
    }
    return found
}

/**
 * The world's resource of type `T`.
 *
 * A resource a system asks for and the world does not hold is a wiring mistake,
 * not a condition to handle: nothing sensible can be returned in its place, and
 * carrying on would hide where it was supposed to be inserted.
 */
@Experimental(since: "0.1")
@SignatureOnly
inline func resource<T>(world: World&): T {
    return resourceNamed<T>(world, T.typeName)
}

/** The resource under an explicit [name]. See [resource]. */
@Experimental(since: "0.1")
func resourceNamed<T>(world: World&, name: String): T {
    var i = world.resourceNames.size - 1
    while i >= 0 {
        if world.resourceNames[i] == name {
            return world.resources[i] as T
        }
        i = i - 1
    }
    panic "no resource '${name}' in this world - insert it before the systems that ask for it"
}

/**
 * The world's resource of type `T`, or [fallback] when there is none.
 *
 * A fallback rather than a failure: a system that runs before whatever inserts
 * the resource should see a defined value, not stop the frame.
 */
@Experimental(since: "0.1")
@SignatureOnly
inline func resourceOr<T>(world: World&, fallback: T): T {
    return resourceNamedOr<T>(world, T.typeName, take fallback)
}

/** The resource under an explicit [name], or [fallback]. See [resourceOr]. */
@Experimental(since: "0.1")
func resourceNamedOr<T>(world: World&, name: String, fallback: T): T {
    var i = world.resourceNames.size - 1
    while i >= 0 {
        if world.resourceNames[i] == name {
            return world.resources[i] as T
        }
        i = i - 1
    }
    return fallback
}

/**
 * Registers [store] as the world's storage for component `T`.
 *
 * Idempotent: registering the same component twice replaces the entry rather
 * than adding a second one, so a system that registers on first use is safe to
 * run every frame. Answers whether it replaced one.
 */
@Experimental(since: "0.1")
inline func registerStorage<T>(world: World!, store: Storage<T>): Bool {
    return registerStorageNamed<T>(world, T.typeName, take store)
}

/**
 * Registers [store] under an explicit [name].
 *
 * The name is a parameter because the body has more than one statement, and an
 * `inline` body is folded only when it is a single expression - which is what
 * [registerStorage] is, so the type's own name is filled in there.
 */
@Experimental(since: "0.1")
func registerStorageNamed<T>(world: World!, name: String, store: Storage<T>): Bool {
    var i = 0
    while i < world.storageNames.size {
        if world.storageNames[i] == name {
            // Replacing in place is not something a list offers, so the old
            // entry is dropped and the new one appended - a lookup finds the
            // last match either way.
            world.storageNames.removeAt(i)
            world.storages.removeAt(i)
            world.storageNames.add(name)
            world.storages.add(store)
            return true
        }
        i = i + 1
    }
    world.storageNames.add(name)
    world.storages.add(store)
    return false
}

/**
 * The world's storage for component `T`, or an empty one when none was
 * registered.
 *
 * A query over a component nothing ever stored matches nothing, which is what
 * an empty storage gives - the alternative is an error at the one moment a
 * caller can do least about it, midway through a frame.
 */
@Experimental(since: "0.1")
@SignatureOnly
inline func storageOf<T>(world: World&): Storage<T> {
    return storageNamed<T>(world, T.typeName)
}

/** The world's storage registered under an explicit [name]. See [storageOf]. */
@Experimental(since: "0.1")
func storageNamed<T>(world: World&, name: String): Storage<T> {
    var i = 0
    while i < world.storageNames.size {
        if world.storageNames[i] == name {
            return world.storages[i] as Storage<T>
        }
        i = i + 1
    }
    // Nothing has stored a [T] yet, so the world gets a storage for it now.
    // Creating it on the first ask is what registers a component: declaring one
    // is all there is to do, and no list has to be kept in step with the types
    // that exist.
    //
    // Built without `@arr[]`: this fallback is reached from a
    // specialization created after macros are expanded, so a macro left here
    // would still be one when the resolver arrived.
    fin fresh = Storage<T>(
        Array::fill<Entity>(0),
        Array::fill<T>(0),
        Array::fill<Bool>(0),
        Array::fill<Bool>(0),
        0L,
    )
    world.storageNames.add(name)
    world.storages.add(fresh)
    return fresh
}

/**
 * A query narrowed to rows that also carry `T`.
 *
 * The filter is in the type, not in the state: runtime is still the one cursor
 * `Q` was walking, and the extra type arguments are the compile-time record of
 * what was asked for. Nesting is what composes them, so `with` and `without`
 * can be written in either order and as many times as a system needs.
 */
@Experimental(since: "0.1")
pack QueryWith<Q, ...T> {
    var cursor: QueryCursor
}

/** A query narrowed to rows that do *not* carry `T`. */
@Experimental(since: "0.1")
pack QueryWithout<Q, ...T> {
    var cursor: QueryCursor
}

/**
 * How a system asks for the rows it wants.
 *
 * ```azora
 * func recolour(shapes: @query Shape)
 * func moving(bodies: @query [Position, Velocity] without Frozen)
 * ```
 *
 * `$T` is uppercase, so it is a *type* hole: these arms are matched where a
 * type is written rather than where a call is, and the parameter's declared
 * type becomes the query handle the system receives.
 */
@Experimental(since: "0.1")
macro @query {
    $Q => QueryOf<$Q>
    $Q with $T => QueryWith<QueryOf<$Q>, $T>
    $Q with [...$T] => QueryWith<QueryOf<$Q>, ...$T>
    $Q without $T => QueryWithout<QueryOf<$Q>, $T>
    $Q without [...$T] => QueryWithout<QueryOf<$Q>, ...$T>
    $Q with $T without $S => QueryWithout<QueryWith<QueryOf<$Q>, $T>, $S>
    $Q with [...$T] without $S => QueryWithout<QueryWith<QueryOf<$Q>, ...$T>, $S>
    $Q with $T without [...$S] => QueryWithout<QueryWith<QueryOf<$Q>, $T>, ...$S>
    $Q with [...$T] without [...$S] => QueryWithout<QueryWith<QueryOf<$Q>, ...$T>, ...$S>
    [...$Q] => QueryOf<...$Q>
    [...$Q] with $T => QueryWith<QueryOf<...$Q>, $T>
    [...$Q] with [...$T] => QueryWith<QueryOf<...$Q>, ...$T>
    [...$Q] without $T => QueryWithout<QueryOf<...$Q>, $T>
    [...$Q] without [...$T] => QueryWithout<QueryOf<...$Q>, ...$T>
    [...$Q] with $T without $S => QueryWithout<QueryWith<QueryOf<...$Q>, $T>, $S>
    [...$Q] with [...$T] without $S => QueryWithout<QueryWith<QueryOf<...$Q>, ...$T>, $S>
    [...$Q] with $T without [...$S] => QueryWithout<QueryWith<QueryOf<...$Q>, $T>, ...$S>
    [...$Q] with [...$T] without [...$S] => QueryWithout<QueryWith<QueryOf<...$Q>, ...$T>, ...$S>
}

impl QueryWith<Q, ...T>:: {

    /**
     * Builds the narrowed query from the world.
     *
     * The query it narrows builds itself first - `Q` is whatever the clause was
     * written against, and it knows how - and then each component in `...T`
     * removes the rows that do not carry it. Filters nest, so this holds however
     * many clauses were written.
     */
    @Experimental(since: "0.1")
    /** How far the storages this query reads have moved. See [QueryOf::stamp]. */
    @ProvidesAccess
    func stamp(world: World&): Int {
        var total = Q::stamp(world)
        inline for Ty in ...T {
            total = total + (storageOf<Ty>(world).revision as Int)
        }
        return total
    }

    @ProvidesAccess
    func provide(world: World&): QueryWith<Q, ...T> {
        var base = Q::provide(world)
        inline for Ty in ...T {
            queryWith<Ty>(base.cursor, storageOf<Ty>(world))
        }
        return QueryWith(base.cursor)
    }
}

impl QueryWithout<Q, ...T>:: {

    /** The same, keeping only the rows that carry *none* of `...T`. */
    @Experimental(since: "0.1")
    /** How far the storages this query reads have moved. See [QueryOf::stamp]. */
    @ProvidesAccess
    func stamp(world: World&): Int {
        var total = Q::stamp(world)
        inline for Ty in ...T {
            total = total + (storageOf<Ty>(world).revision as Int)
        }
        return total
    }

    @ProvidesAccess
    func provide(world: World&): QueryWithout<Q, ...T> {
        var base = Q::provide(world)
        inline for Ty in ...T {
            queryWithout<Ty>(base.cursor, storageOf<Ty>(world))
        }
        return QueryWithout(base.cursor)
    }
}

/** Rows matching every one of the filters. */
@Experimental(since: "0.1")
pack QueryAnd<Q, ...T> {
    var cursor: QueryCursor
}

/** Rows matching any one of the filters. */
@Experimental(since: "0.1")
pack QueryOr<Q, ...T> {
    var cursor: QueryCursor
}

impl Iterator for QueryAnd<Q, ...T> assoc Item = Entity {
    func reset[self: Self!]() {
        self.cursor.reset()
    }

    prop hasNext[self: Self!]: Bool {
        return self.cursor.hasNext()
    }

    /** The entity the cursor is on. */
    prop next[self: Self!]: Entity {
        return self.cursor.next()
    }
}

impl Iterator for QueryOr<Q, ...T> assoc Item = Entity {
    func reset[self: Self!]() {
        self.cursor.reset()
    }

    prop hasNext[self: Self!]: Bool {
        return self.cursor.hasNext()
    }

    /** The entity the cursor is on. */
    prop next[self: Self!]: Entity {
        return self.cursor.next()
    }
}

/**
 * Rows whose `T` appeared this frame - `@query [Added<Position>]`.
 *
 * A marker: it carries no state and is never constructed. What it does is stand
 * in a query's type list where a component would, saying *which* rows are
 * wanted rather than which components are read. [Changed] and [Removed] are the
 * same idea over the other two things that can happen to a component.
 */
@Experimental(since: "0.1")
pack Added<T>

/** Rows whose `T` was written this frame. */
@Experimental(since: "0.1")
pack Changed<T>

/** Rows whose `T` was taken away this frame. */
@Experimental(since: "0.1")
pack Removed<T>

/** A narrowed query walks its rows exactly as the query it narrowed does. */
impl QueryWith<Q, ...T> {
    /** The next matching entity. See [QueryOf.nextEntity]. */
    @Experimental(since: "0.1")
    func nextEntity[self: Self!](): Entity {
        return self.cursor.next()
    }
}

impl QueryWithout<Q, ...T> {
    /** The next matching entity. See [QueryOf.nextEntity]. */
    @Experimental(since: "0.1")
    func nextEntity[self: Self!](): Entity {
        return self.cursor.next()
    }
}

impl Iterator for QueryWith<Q, ...T> assoc Item = Entity {
    func reset[self: Self!]() {
        self.cursor.reset()
    }

    prop hasNext[self: Self!]: Bool {
        return self.cursor.hasNext()
    }

    /** The entity the cursor is on. */
    prop next[self: Self!]: Entity {
        return self.cursor.next()
    }
}

impl Iterator for QueryWithout<Q, ...T> assoc Item = Entity {
    func reset[self: Self!]() {
        self.cursor.reset()
    }

    prop hasNext[self: Self!]: Bool {
        return self.cursor.hasNext()
    }

    /** The entity the cursor is on. */
    prop next[self: Self!]: Entity {
        return self.cursor.next()
    }
}

func queryEmpty(): QueryCursor {
    return QueryCursor(@arr[Entity::invalid], 1, true, "")
}

func queryError(message: String): QueryCursor {
    return QueryCursor(@arr[Entity::invalid], 1, false, message)
}

impl QueryCursor {
    func add(entity: Entity) {
        if entity.isValid {
            self.entities.add(entity)
        }
    }

    func reset() {
        self.cursor = 1
    }

    func markFailed(message: String) {
        self.ok = false
        self.error = message
    }

    func invalidateAt(index: Int) {
        if index > 0 && index < self.entities.size {
            self.entities[index] = Entity::invalid
        }
    }

    func hasNext(): Bool {
        var i = self.cursor
        while i < self.entities.size {
            if self.entities[i].isValid {
                return true
            }
            i = i + 1
        }
        return false
    }

    func next(): Entity {
        while self.cursor < self.entities.size {
            fin entity = self.entities[self.cursor]
            self.cursor = self.cursor + 1
            if entity.isValid {
                return entity
            }
        }
        return Entity::invalid
    }

    func count(): Int {
        var total = 0
        var i = 1
        while i < self.entities.size {
            if self.entities[i].isValid {
                total = total + 1
            }
            i = i + 1
        }
        return total
    }

    func isEmpty(): Bool {
        return self.count() <= 0
    }

    func single(): QueryFetch {
        var found = Entity::invalid
        var total = 0
        var i = 1
        while i < self.entities.size {
            fin entity = self.entities[i]
            if entity.isValid {
                found = entity
                total = total + 1
            }
            i = i + 1
        }
        if total == 1 {
            return QueryFetch(true, found, "")
        }
        if total == 0 {
            return QueryFetch(false, Entity::invalid, "query expected one entity, found none")
        }
        return QueryFetch(false, Entity::invalid, "query expected one entity, found many")
    }
}

func queryAll(world: World&, includeResources: Bool): QueryCursor {
    var query = queryEmpty()
    var i = 0
    while i < world.entityCount {
        fin entity = world.entityAt(i)
        if world.isAlive(entity) && (includeResources || !world.isResource(entity)) {
            query.add(entity)
        }
        i = i + 1
    }
    return query
}

func queryBroad(world: World&): QueryCursor {
    return queryAll(world, true)
}

func queryScene(world: World&): QueryCursor {
    return queryAll(world, false)
}

func queryRetainAlive(query: QueryCursor!, world: World&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !world.isAlive(entity) {
            query.invalidateAt(i)
        }
        i = i + 1
    }
}

func queryRetainResources(query: QueryCursor!, world: World&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !world.isResource(entity) {
            query.invalidateAt(i)
        }
        i = i + 1
    }
}

func queryRetainScene(query: QueryCursor!, world: World&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && world.isResource(entity) {
            query.invalidateAt(i)
        }
        i = i + 1
    }
}

func queryFromStorage<T>(world: World&, store: Storage<T>&, includeResources: Bool): QueryCursor {
    var query = queryEmpty()
    var i = 0
    while i < store.entities.size {
        fin entity = store.entities[i]
        if entity.isValid && world.isAlive(entity) && (includeResources || !world.isResource(entity)) {
            query.add(entity)
        }
        i = i + 1
    }
    return query
}

func queryWith<T>(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !storageHas<T>(store, entity) {
            query.invalidateAt(i)
        }
        i = i + 1
    }
}

func queryWithout<T>(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && storageHas<T>(store, entity) {
            query.invalidateAt(i)
        }
        i = i + 1
    }
}

func queryAdded<T>(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !storageWasAdded<T>(store, entity) {
            query.invalidateAt(i)
        }
        i = i + 1
    }
}

func queryChanged<T>(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !storageWasChanged<T>(store, entity) {
            query.invalidateAt(i)
        }
        i = i + 1
    }
}

func queryResources<T>(world: World&, store: Storage<T>&): QueryCursor {
    var query = queryFromStorage<T>(world, store, true)
    queryRetainResources(query, world)
    return query
}

pack QueryAccess {
    var system: String
    var reads: Array<String>
    var writes: Array<String>
    var withs: Array<String>
    var withouts: Array<String>
    var added: Array<String>
    var changed: Array<String>
    var broad: Bool
    var includeResources: Bool
    var single: Bool
    var valid: Bool
    var error: String
}

func queryAccessInit(system: String): QueryAccess {
    return QueryAccess(system, @arr[""], @arr[""], @arr[""], @arr[""], @arr[""], @arr[""], false, false, false, true, "")
}

func queryNameListHas(list: Array<String>, name: String): Bool {
    var i = 1
    while i < list.size {
        if list[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

func queryNameListsOverlap(left: Array<String>, right: Array<String>): Bool {
    var i = 1
    while i < left.size {
        if queryNameListHas(right, left[i]) {
            return true
        }
        i = i + 1
    }
    return false
}

func queryAccessRead(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.reads, component) {
        access.reads.add(component)
    }
}

func queryAccessWrite(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.writes, component) {
        access.writes.add(component)
    }
}

func queryAccessWith(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.withs, component) {
        access.withs.add(component)
    }
}

func queryAccessWithout(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.withouts, component) {
        access.withouts.add(component)
    }
}

func queryAccessAdded(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.added, component) {
        access.added.add(component)
    }
}

func queryAccessChanged(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.changed, component) {
        access.changed.add(component)
    }
}

func queryAccessBroad(access: QueryAccess!, includeResources: Bool) {
    access.broad = true
    access.includeResources = includeResources
}

func queryAccessSingle(access: QueryAccess!) {
    access.single = true
}

func queryAccessFail(access: QueryAccess!, message: String) {
    access.valid = false
    access.error = message
}

func queryAccessDisjoint(left: QueryAccess&, right: QueryAccess&): Bool {
    return queryNameListsOverlap(left.withs, right.withouts) || queryNameListsOverlap(right.withs, left.withouts)
}

func queryAccessConflicts(left: QueryAccess&, right: QueryAccess&): Bool {
    if queryAccessDisjoint(left, right) {
        return false
    }
    if queryNameListsOverlap(left.writes, right.writes) {
        return true
    }
    if queryNameListsOverlap(left.writes, right.reads) {
        return true
    }
    if queryNameListsOverlap(right.writes, left.reads) {
        return true
    }
    return false
}

pack ResourceCell<T> {
    var hasValue: Bool
    var value: T
    var revision: Int
}

func resourceInit<T>(defaultValue: T): ResourceCell<T> {
    return ResourceCell<T>(false, defaultValue, 0)
}

func resourceExists<T>(resource: ResourceCell<T>&): Bool {
    return resource.hasValue
}

func resourceSet<T>(resource: ResourceCell<T>!, value: T) {
    resource.value = value
    resource.hasValue = true
    resource.revision = resource.revision + 1
}

func resourceGet<T>(resource: ResourceCell<T>&): T {
    return resource.value
}

func resourceGetOrDefault<T>(resource: ResourceCell<T>&, defaultValue: T): T {
    if resource.hasValue {
        return resource.value
    }
    return defaultValue
}

pack EventQueue<T> {
    var events: Array<T>
    var cursor: Int
}

func eventQueueInit<T>(defaultEvent: T): EventQueue<T> {
    var events = @arr[defaultEvent]
    return EventQueue<T>(events, 1)
}

func eventSend<T>(queue: EventQueue<T>!, event: T) {
    queue.events.add(event)
}

func eventLength<T>(queue: EventQueue<T>&): Int {
    return queue.events.size - queue.cursor
}

func eventIsEmpty<T>(queue: EventQueue<T>&): Bool {
    return eventLength<T>(queue) <= 0
}

func eventPeek<T>(queue: EventQueue<T>&, index: Int): T {
    return queue.events[queue.cursor + index]
}

func eventHasNext<T>(queue: EventQueue<T>&): Bool {
    return queue.cursor < queue.events.size
}

func eventNext<T>(queue: EventQueue<T>!): T {
    fin event = queue.events[queue.cursor]
    queue.cursor = queue.cursor + 1
    return event
}

pack CommandBuffer {
    var despawns: Array<Entity>
    var cursor: Int
}

func commandBufferInit(): CommandBuffer {
    var despawns = @arr[Entity::invalid]
    return CommandBuffer(despawns, 1)
}

impl CommandBuffer {
    func despawn(entity: Entity) {
        self.despawns.add(entity)
    }

    func apply(world: World) {
        while self.cursor < self.despawns.size {
            world.despawn(self.despawns[self.cursor])
            self.cursor = self.cursor + 1
        }
    }
}

/**
 * One `@System` function, as the scheduler sees it.
 *
 * Every field here is read off the decorator — nothing is passed at a
 * registration call site, because there is no registration call site. The
 * decorator is the only place a system's place in the frame is written down,
 * which is what stops the two from drifting apart.
 */
@Experimental(since: "0.1")
pack ScheduledSystem {
    /** The function's own name, as `runBefore`/`runAfter` spell it. */
    fin name: String
    fin phase: SystemPhase
    fin order: Int
    /** Comma-separated names of systems (or sets) this one must precede. */
    fin runBefore: String
    /** Comma-separated names of systems (or sets) this one must follow. */
    fin runAfter: String
    fin inSet: String
    /** Cleared to skip the system without removing its decorator. */
    var enabled: Bool
}

/**
 * True when [name] appears in the comma-separated [list].
 *
 * Matching is exact per segment, so `"input"` does not match `"input_debug"` —
 * a substring test would silently create ordering edges nobody asked for.
 * Surrounding spaces are ignored so `"input, physics"` reads naturally.
 */
func systemNameListed(list: String, name: String): Bool {
    if list == "" || name == "" {
        return false
    }
    var start = 0
    var i = 0
    while i <= list.size {
        if i == list.size || list[i] == ',' {
            var from = start
            var to = i
            while from < to && list[from] == ' ' {
                from = from + 1
            }
            while to > from && list[to - 1] == ' ' {
                to = to - 1
            }
            if to - from == name.size {
                var matched = true
                var k = 0
                while k < name.size {
                    if list[from + k] != name[k] {
                        matched = false
                        k = name.size
                    } else {
                        k = k + 1
                    }
                }
                if matched {
                    return true
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

/**
 * The position of [phase] in the frame.
 *
 * Phases are absolute: every `.PreUpdate` system runs before every `.Update`
 * one, whatever the ordering constraints say. Constraints only order systems
 * *within* a phase, so a stray `runAfter` cannot pull rendering into the middle
 * of simulation.
 */
func systemPhaseRank(phase: SystemPhase): Int {
    return when phase {
        .Startup -> 0
        .PreUpdate -> 1
        .Update -> 2
        .PostUpdate -> 3
        .FixedUpdate -> 4
        .Render -> 5
        .Last -> 6
    }
}

/**
 * The frame's systems and the order they run in.
 *
 * `resolved` holds indices into `systems` in execution order. It is computed
 * once by [systemPlan] rather than per frame, because the constraints come from
 * decorators and so cannot change while the program runs.
 *
 * The index of a system in `systems` is also its position in the compile-time
 * enumeration of `@System` functions — that correspondence is what lets
 * [runPhase] dispatch to the right function from a plain integer. See the note
 * on [systemPlan].
 */
@Experimental(since: "0.1")
pack SystemPlan {
    var systems: Array<ScheduledSystem>
    var count: Int
    var resolved: Array<Int>
    var resolvedCount: Int
    /** Set when the constraints contradict each other. */
    var cyclic: Bool
    var cycleReport: String
}

/** Records one decorated system. Called only by the [systemPlan] expansion. */
func systemPlanDeclare(
    plan: SystemPlan!
    name: String
    phase: SystemPhase
    order: Int
    runBefore: String
    runAfter: String
    inSet: String
) {
    plan.systems.add(ScheduledSystem(name, phase, order, runBefore, runAfter, inSet, true))
    plan.count = plan.count + 1
}

impl SystemPlan {
    /** The index of the system called [name], or `-1`. */
    func indexOf(name: String): Int {
        var i = 0
        while i < self.count {
            if self.systems[i].name == name {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /**
     * Enables or disables a system, returning false if no system has that name.
     *
     * The decorator says where a system runs; whether it runs at all is a
     * runtime decision, so this is the one part of a system's schedule that is
     * not fixed at compile time.
     */
    func setEnabled(name: String, enabled: Bool): Bool {
        fin found = self.indexOf(name)
        if found < 0 {
            return false
        }
        self.systems[found].enabled = enabled
        return true
    }

    /**
     * True when the system at [earlier] must run before the one at [later].
     *
     * A constraint counts from either end — one system saying "before you" and
     * the other saying "after me" are the same edge — and naming a set
     * constrains every member of it, so two packages can order their sets
     * without knowing each other's system names.
     */
    func constrains(earlier: Int, later: Int): Bool {
        fin a = self.systems[earlier]
        fin b = self.systems[later]
        if a.phase != b.phase {
            return false
        }
        if systemNameListed(a.runBefore, b.name) || systemNameListed(b.runAfter, a.name) {
            return true
        }
        if b.inSet != "" && systemNameListed(a.runBefore, b.inSet) {
            return true
        }
        if a.inSet != "" && systemNameListed(b.runAfter, a.inSet) {
            return true
        }
        return false
    }

    /**
     * Orders the systems: phase-major, then by the declared constraints.
     *
     * A stable topological sort. Among the systems whose predecessors are all
     * placed, the lowest `order` wins and enumeration order breaks the rest.
     * Stability matters — a schedule that reshuffles between runs turns an
     * ordering bug into one that only shows up sometimes.
     *
     * Contradictory constraints cannot be satisfied, so the remaining systems
     * are left in enumeration order and `cyclic` records the fact. Degrading to
     * "runs in the order you declared it" keeps the frame running; dropping the
     * systems instead would make a typo look like a physics bug.
     */
    func resolve() {
        self.cyclic = false
        self.cycleReport = ""
        self.resolvedCount = 0

        var placed: Array<Bool> = Array::fill<Bool>(self.count)
        var i = 0
        while i < self.count {
            placed[i] = false
            i = i + 1
        }

        var remaining = self.count
        while remaining > 0 {
            var choice = -1
            var candidate = 0
            while candidate < self.count {
                if !placed[candidate] {
                    // Ready when nothing still unplaced has to come first.
                    var ready = true
                    var other = 0
                    while other < self.count {
                        if !placed[other] && other != candidate && self.constrains(other, candidate) {
                            ready = false
                            other = self.count
                        } else {
                            other = other + 1
                        }
                    }
                    if ready && choice < 0 {
                        choice = candidate
                    } else {
                        if ready {
                            fin here = systemPhaseRank(self.systems[candidate].phase)
                            fin best = systemPhaseRank(self.systems[choice].phase)
                            if here < best {
                                choice = candidate
                            } else {
                                if here == best && self.systems[candidate].order < self.systems[choice].order {
                                    choice = candidate
                                }
                            }
                        }
                    }
                }
                candidate = candidate + 1
            }

            if choice < 0 {
                // Every remaining system waits on another one.
                self.cyclic = true
                self.cycleReport = "system ordering has a cycle"
                var leftover = 0
                while leftover < self.count {
                    if !placed[leftover] {
                        self.resolved[self.resolvedCount] = leftover
                        self.resolvedCount = self.resolvedCount + 1
                        placed[leftover] = true
                    }
                    leftover = leftover + 1
                }
                remaining = 0
            } else {
                self.resolved[self.resolvedCount] = choice
                self.resolvedCount = self.resolvedCount + 1
                placed[choice] = true
                remaining = remaining - 1
            }
        }
    }

    /** The names of [phase]'s systems, in the order they will run. */
    func orderOf(phase: SystemPhase): Array<String> {
        var names = @arr[""]
        var i = 0
        while i < self.resolvedCount {
            fin system = self.systems[self.resolved[i]]
            if system.phase == phase {
                names.add(system.name)
            }
            i = i + 1
        }
        return names
    }
}

/**
 * The schedule, built from every `@System` function in the program.
 *
 * There is no registration: `reflect<*>.withAnnot<System>` enumerates the
 * decorated functions at compile time, and each one's decorator supplies its
 * phase, order and ordering constraints. Adding a system to the frame is
 * writing `@System` above it.
 *
 * ## The index correspondence
 *
 * This function and [runPhase] both unroll the same compile-time enumeration,
 * in the same order, so the *n*-th system recorded here is the *n*-th call site
 * emitted there. That is what lets the resolved order — a list of integers —
 * dispatch to functions without any function values, which is why the schedule
 * lowers the same way on the interpreter, WebAssembly and LLVM.
 * Both loops must therefore stay literally identical.
 *
 * Build it once and keep it; the ordering is fixed at compile time and cannot
 * change while the program runs.
 */
@Experimental(since: "0.1")
func systemPlan(): SystemPlan {
    var plan = SystemPlan(
        Array::fill<ScheduledSystem>(0),
        0,
        Array::fill<Int>(0),
        0,
        false,
        ""
    )

    inline for S in reflect<*>.withAnnot<System> {
        systemPlanDeclare(
            plan,
            reflect<S>.declName,
            reflect<S>.decoMeta<System>.phase,
            reflect<S>.decoMeta<System>.order,
            reflect<S>.decoMeta<System>.runBefore,
            reflect<S>.decoMeta<System>.runAfter,
            reflect<S>.decoMeta<System>.inSet
        )
        plan.resolved.add(0)
    }

    plan.resolve()
    return plan
}

/**
 * Runs [phase]'s systems, in the resolved order.
 *
 * The inner loop walks every system to find the one whose turn it is. That is
 * quadratic in the system count, but it is an integer comparison per step and
 * the alternative — an indirect call through a stored function — is what this
 * design exists to avoid. See [systemPlan] for why the index identifies the
 * function.
 */
@Experimental(since: "0.1")
func runPhase(plan: SystemPlan&, phase: SystemPhase, world: World!) {
    var step = 0
    while step < plan.resolvedCount {
        fin due = plan.resolved[step]
        if plan.systems[due].phase == phase && plan.systems[due].enabled {
            var cursor = 0
            inline for S in reflect<*>.withAnnot<System> {
                if cursor == due {
                    S(world)
                }
                cursor = cursor + 1
            }
        }
        step = step + 1
    }
}

macro @applyKey => inline """
    if key == "" {
        positionalKey(anchor.parent, ${Self.typename.lowercase})
    } else {
        key
    }
"""

/**
 * Runs one whole frame: every phase, in order.
 *
 * `.Startup` is included, so a caller that wants it to happen once must disable
 * those systems afterwards — [SystemPlan.setEnabled] — rather than this
 * deciding on their behalf.
 */
@Experimental(since: "0.1")
func runSystems(plan: SystemPlan&, world: World!) {
    runPhase(plan, .Startup, world)
    runPhase(plan, .PreUpdate, world)
    runPhase(plan, .Update, world)
    runPhase(plan, .PostUpdate, world)
    runPhase(plan, .FixedUpdate, world)
    runPhase(plan, .Render, world)
    runPhase(plan, .Last, world)
}

/** An empty plan, for tests and for hosts that build a schedule by hand. */
func systemPlanEmpty(): SystemPlan {
    return SystemPlan(Array::fill<ScheduledSystem>(0), 0, Array::fill<Int>(0), 0, false, "")
}

test "constraints order systems regardless of declaration order" {
    var plan = systemPlanEmpty()
    // Declared back to front, exactly as a program might.
    systemPlanDeclare(plan, "render", .Update, 0, "", "physics", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "physics", .Update, 0, "", "input", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "input", .Update, 0, "", "", "")
    plan.resolved.add(0)
    plan.resolve()

    assert !plan.cyclic { "three chained constraints are satisfiable" }
    fin order = plan.orderOf(.Update)
    assert order[1] == "input" { "input must run first, not last as declared" }
    assert order[2] == "physics" { "physics must follow input" }
    assert order[3] == "render" { "render must follow physics" }
}

test "a phase runs whole, whatever the constraints say" {
    var plan = systemPlanEmpty()
    // `draw` renders but asks to follow a system in a later phase; the phase
    // boundary must win, or rendering would drift out of its slot.
    systemPlanDeclare(plan, "draw", .Render, 0, "", "cleanup", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "cleanup", .Last, 0, "", "", "")
    plan.resolved.add(0)
    plan.resolve()

    assert !plan.cyclic { "a cross-phase constraint is not a cycle" }
    assert plan.systems[plan.resolved[0]].name == "draw" { "render precedes last" }
    assert plan.systems[plan.resolved[1]].name == "cleanup" { "last comes after render" }
}

test "order breaks ties no constraint settles" {
    var plan = systemPlanEmpty()
    systemPlanDeclare(plan, "late", .Update, 10, "", "", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "early", .Update, 1, "", "", "")
    plan.resolved.add(0)
    plan.resolve()

    assert plan.systems[plan.resolved[0]].name == "early" { "the lower order wins" }
}

test "naming a set orders every system in it" {
    var plan = systemPlanEmpty()
    systemPlanDeclare(plan, "hud", .Update, 0, "", "sim", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "movement", .Update, 0, "", "", "sim")
    plan.resolved.add(0)
    plan.resolve()

    assert plan.systems[plan.resolved[0]].name == "movement" {
        "following a set must mean following its members"
    }
}

test "contradictory constraints degrade to declaration order" {
    var plan = systemPlanEmpty()
    systemPlanDeclare(plan, "a", .Update, 0, "", "b", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "b", .Update, 0, "", "a", "")
    plan.resolved.add(0)
    plan.resolve()

    assert plan.cyclic { "a two-system cycle must be reported" }
    assert plan.resolvedCount == 2 { "both systems must still run" }
    assert plan.systems[plan.resolved[0]].name == "a" { "the fallback is declaration order" }
}

test "a name is matched against whole list entries, not substrings" {
    assert systemNameListed("input, physics", "physics") { "a spaced entry must match" }
    assert systemNameListed("input,physics", "input") { "the first entry must match" }
    assert !systemNameListed("input_debug", "input") { "a prefix must not match" }
    assert !systemNameListed("", "input") { "an empty list matches nothing" }
    assert !systemNameListed("input", "") { "an empty name matches nothing" }
}

test "phases order the frame regardless of constraints" {
    assert systemPhaseRank(.Startup) < systemPhaseRank(.Update) {
        "startup must precede update"
    }
    assert systemPhaseRank(.Update) < systemPhaseRank(.Render) {
        "update must precede render"
    }
}

test "query access permits disjoint systems" {
    var movement = queryAccessInit("movement")
    queryAccessWrite(movement, "Transform")
    queryAccessWith(movement, "Player")

    var enemies = queryAccessInit("enemy_ai")
    queryAccessWrite(enemies, "Transform")
    queryAccessWithout(enemies, "Player")

    assert !queryAccessConflicts(movement, enemies) {
        "with/without filters must prove disjoint writes"
    }
}

test "query access rejects shared writes" {
    var movement = queryAccessInit("movement")
    queryAccessWrite(movement, "Transform")

    var physics = queryAccessInit("physics")
    queryAccessRead(physics, "Transform")

    assert queryAccessConflicts(movement, physics) {
        "writer/reader overlap must serialize systems"
    }
}
