// Azora Engine — ECS.
//
// A small, data-oriented ECS layer. Storage is explicit and opt-in: create the
// component stores a game needs, pass them to systems, and keep the renderer or
// UI modules out of pure simulation code.

module engine.ecs

import std.container::*
import std.traits
import engine.core

pack Entity derives (Copy, Clone, Equal, Hash) {
    var id: Int
    var generation: Int
}

impl Entity {
    prop &.isValid: Bool = self.id >= 0
    fin invalid: Entity = .(-1, 0)
}

pack World {
    var generations: Array<Int> = [1]
    var alive: Array<Bool> = [false]
    var names: Array<String> = [""]
    var parents: Array<Int> = [-1]
    var childCounts: Array<Int> = [0]
    var prefabs: Array<Bool> = [false]
    var resourceMarks: Array<Bool> = [false]
    var freeIds: Array<Int> = [-1]
    var entityCount: Int = 0
    var aliveCount: Int = 0
    var tick: Int = 0
    var storageNames: Array<String> = []
    /**
     * Every registered component storage. Typed as storages rather than `Any`
     * so that the world owns them: replacing one destroys the old storage, and
     * a world that is dropped destroys each storage and the components in it.
     * An `Array<Any>` could not, since an erased slot may hold a plain value.
     */
    var storages: Array<Storage<Any>> = []
    var resourceNames: Array<String> = []
    /**
     * Every resource, each in a slot built where its type was known (see
     * [insertResource]), so the world owns them: replacing one destroys the
     * old value, and a world that is dropped destroys every resource. An
     * `Array<Any>` could not, since an erased slot may hold a plain value.
     */
    var resources: Array<ResourceSlot<Any>> = []
    /** When each resource was last written, in [resourceWrites]: see [resourceStamp]. */
    var resourceStamps: Array<Int> = []
    /** How many resource writes this world has seen. */
    var resourceWrites: Int = 0
    var totalTime: Double = 0.0
    var fixedTimestep: Double = 1.0 / 60.0
    var fixedAccumulator: Double = 0.0
    var revision: Long = 0
}


impl World {
    func !.spawn(): Entity {
        if self.freeIds.size > 1 {
            fin last = self.freeIds.size - 1
            fin id = self.freeIds[last]
            self.freeIds.remove(last)

            fin gen = self.generations[id] + 1
            self.generations[id] = gen
            self.alive[id] = true
            self.names[id] = ""
            self.parents[id] = -1
            self.childCounts[id] = 0
            self.prefabs[id] = false
            self.resourceMarks[id] = false
            self.aliveCount++
            self.revision++
            return .(id, gen)
        }

        fin id = self.entityCount
        if id < self.generations.size {
            self.generations[id] = 0
            self.alive[id] = true
            self.names[id] = ""
            self.parents[id] = -1
            self.childCounts[id] = 0
            self.prefabs[id] = false
            self.resourceMarks[id] = false
        } else {
            self.generations.add(0)
            self.alive.add(true)
            self.names.add("")
            self.parents.add(-1)
            self.childCounts.add(0)
            self.prefabs.add(false)
            self.resourceMarks.add(false)
        }
        self.entityCount++
        self.aliveCount++
        self.revision++
        return .(id, 0)
    }

    func !.spawnNamed(name: String): Entity {
        fin entity = self.spawn()
        self.names[entity.id] = name
        return entity
    }

    func !.despawn(entity: Entity) {
        if !self.isAlive(entity) then return

        removeFromEveryStorage(self, entity)
        self.alive[entity.id] = false
        self.names[entity.id] = ""
        self.aliveCount--

        fin parentId = self.parents[entity.id]
        if parentId >= 0 && parentId < self.entityCount then self.childCounts[parentId]--
        self.parents[entity.id] = -1
        self.childCounts[entity.id] = 0
        self.prefabs[entity.id] = false
        self.resourceMarks[entity.id] = false
        self.freeIds.add(entity.id)
        self.revision++
    }

    func &.isAlive(entity: Entity): Bool {
        if entity.id < 0 || entity.id >= self.entityCount then return false
        return self.alive[entity.id] && self.generations[entity.id] == entity.generation
    }

    prop &.count: Int = self.aliveCount

    func &.entityAt(id: Int): Entity
    scope return if id < 0 || id >= self.entityCount then ::invalid else .(id, self.generations[id])

    func !.setName(entity: Entity, name: String) {
        if self.isAlive(entity) then self.names[entity.id] = name
    }

    func &.getName(entity: Entity): String
    scope return if !self.isAlive(entity) then "" else self.names[entity.id]

    func &.lookup(name: String): Entity
    scope return for i: Int in 0..<self.entityCount {
        if self.alive[i] && self.names[i] == name then break .(i, self.generations[i])
    } else ::invalid

    func !.setParent(child: Entity, parent: Entity) {
        if !self.isAlive(child) || !self.isAlive(parent) then return
        fin oldParent = self.parents[child.id]
        if oldParent >= 0 && oldParent < self.entityCount then self.childCounts[oldParent]--
        self.parents[child.id] = parent.id
        self.childCounts[parent.id]++
    }

    func !.removeParent(entity: Entity) {
        if !self.isAlive(entity) then return
        fin parentId = self.parents[entity.id]
        if parentId >= 0 && parentId < self.entityCount then self.childCounts[parentId]--
        self.parents[entity.id] = -1
    }

    func &.getParent(entity: Entity): Entity {
        if !self.isAlive(entity) then return ::invalid
        fin parentId = self.parents[entity.id]
        return if parentId < 0 || parentId >= self.entityCount then ::invalid
        else .(parentId, self.generations[parentId])
    }

    func &.getChildCount(entity: Entity): Int
    scope return if !self.isAlive(entity) then 0 else self.childCounts[entity.id]

    func !.markPrefab(entity: Entity)
    scope if self.isAlive(entity) then self.prefabs[entity.id] = true

    func &.isPrefab(entity: Entity): Bool
    scope return if !self.isAlive(entity) then false else self.prefabs[entity.id]

    func !.spawnResource(name: String): Entity {
        fin entity = self.spawnNamed(name)
        self.resourceMarks[entity.id] = true
        return entity
    }

    func !.markResource(entity: Entity)
    scope if self.isAlive(entity) then self.resourceMarks[entity.id] = true

    func &.isResource(entity: Entity): Bool
    scope return if !self.isAlive(entity) then false else self.resourceMarks[entity.id]

    func !.progress(deltaTime: Double) {
        self.tick++
        self.totalTime += deltaTime
        self.fixedAccumulator += deltaTime
    }

    func !.setFixedTimestep(timestep: Double)
    scope self.fixedTimestep = timestep

    func !.consumeFixedStep(): Bool
    scope return if self.fixedAccumulator >= self.fixedTimestep {
        self.fixedAccumulator -= self.fixedTimestep
        true
    } else false

    @ProvidesAccess
    prop &.stamp: Int = self.revision as Int
}

/**
 * One component's values, densely packed, with the entity each belongs to.
 *
 * A sparse set: [sparse] maps an entity id straight to its dense index (plus
 * one; zero where the entity has none), so finding an entity's component is one
 * read, not a walk over every entity that has one. The dense arrays keep their
 * insertion order - a composition's children are read in that order - so
 * removal shifts the tail and renumbers it.
 */
pack Storage<T> {
    var entities: Array<Entity>
    var values: Array<T>
    var added: Array<Bool>
    var changed: Array<Bool>
    var revision: Long
    var sparse: Array<Int> = []
}

func<T> storageInit(defaultValue: T): Storage<T> {
    var entities = [Entity::invalid.clone()]
    var values = [defaultValue]
    var added = [false]
    var changed = [false]
    return Storage<T>(take entities, take values, take added, take changed, 0)
}

func<T> storageIndexOf(store: Storage<T>&, entity: Entity): Int {
    fin id = entity.id
    if id < 0 || id >= store.sparse.size then return -1
    fin index = store.sparse[id] - 1
    return if index < 0 || store.entities[index].generation != entity.generation then -1 else index
}

/** Points [id]'s sparse slot at dense [index] (-1: no component). */
func<T> storageMark(store: Storage<T>!, id: Int, index: Int) {
    if id < 0 then return
    while store.sparse.size <= id then store.sparse.add(0)
    store.sparse[id] = index + 1
}

func<T> storageHas(store: Storage<T>&, entity: Entity): Bool
scope return storageIndexOf<T>(store, entity) >= 0

func<T> storageInsert(store: Storage<T>!, entity: Entity, value: T) {
    fin index = storageIndexOf<T>(store, entity)
    if index >= 0 {
        store.values[index] = value
        store.changed[index] = true
        store.revision++
        return
    }
    store.entities.add(entity.clone())
    store.values.add(value)
    store.added.add(true)
    store.changed.add(false)
    storageMark<T>(store, entity.id, store.entities.size - 1)
    store.revision++
}

func<T> storageGet(store: Storage<T>&, entity: Entity): T& {
    fin index = storageIndexOf<T>(store, entity)
    return store.values[index]
}

/**
 * [entity]'s component, or a copy of [defaultValue] when it has none.
 *
 * The default is borrowed, not taken: an erased body cannot free a value it
 * was handed but did not keep, so a default it only sometimes returned would
 * leak every time it was not.
 */
func<T: Clone> storageGetOrDefault(store: Storage<T>&, entity: Entity, defaultValue: T&): T {
    fin index = storageIndexOf<T>(store, entity)
    return if index < 0 then defaultValue.clone() else store.values[index].clone()
}

/** An owned snapshot for callers that need a component beyond the storage borrow. */
func<T: Clone> storageGetClone(store: Storage<T>&, entity: Entity): T
scope return storageGet<T>(store, entity).clone()

func<T> storageRemove(store: Storage<T>!, entity: Entity): Bool {
    fin index = storageIndexOf<T>(store, entity)
    if index < 0 then return false
    // remove(index) destroys an owned value; removeAt would transfer it.
    store.values.remove(index)
    store.entities.remove(index)
    store.added.remove(index)
    store.changed.remove(index)
    storageMark<T>(store, entity.id, -1)
    // The tail moved down one place.
    for i: Int in index..<store.entities.size then storageMark<T>(store, store.entities[i].id, i)
    store.revision++
    return true
}

/**
 * Drops [entity] from every storage the world holds, whatever they hold.
 *
 * Removal destroys the owned component and removes its aligned entity/change
 * slots without reading its erased value. That is what lets
 * something drop an entity without naming a single component type - and so lets
 * a composition be written without naming the components composed into it.
 *
 * Answers how many storages carried the entity.
 */
@Experimental(since: "0.1")
func removeFromEveryStorage(world: World!, entity: Entity): Int {
    var dropped: Int = 0
    for i: Int in 0..<world.storages.size {
        let store: Storage<Any>! = world.storages[i] as Storage<Any>!
        if storageRemove<Any>(store, entity) then dropped++
    }
    return dropped
}

func<T> storageWasAdded(store: Storage<T>&, entity: Entity): Bool {
    fin index = storageIndexOf<T>(store, entity)
    return index >= 0 && store.added[index]
}

func<T> storageWasChanged(store: Storage<T>&, entity: Entity): Bool {
    fin index = storageIndexOf<T>(store, entity)
    return index >= 0 && store.changed[index]
}

func<T> storageClearTracking(store: Storage<T>!) {
    for i: Int in 0..<store.added.size {
        store.added[i] = false
        store.changed[i] = false
    }
}

func<T> storageCount(store: Storage<T>&): Int {
    var total: Int = 0
    for i: Int in 0..<store.entities.size then if store.entities[i].isValid then total++
    return total
}

func<T> storageEntityAt(store: Storage<T>&, index: Int): Entity = store.entities[index].clone()

func<T> storageValueAt(store: Storage<T>&, index: Int): T& = store.values[index]

func<T> storageLength(store: Storage<T>&): Int = store.entities.size

/**
 * Creates an entity with no components.
 *
 * A free function beside `World.spawn`, because an `impl` reaches a module that
 * imports its type directly but not one that sees it only transitively - so a
 * package that merely passes a `World` through could not spawn from it. The
 * free form has no such reach problem.
 */
@Experimental(since: "0.1")
func spawnEntity(world: World!): Entity = world.spawn()

/** Destroys [entity]. The free counterpart to `World.despawn`, as above. */
@Experimental(since: "0.1")
func despawnEntity(world: World!, entity: Entity) scope world.despawn(entity)

func<T> spawnWith(world: World!, store: Storage<T>!, value: T): Entity {
    fin entity = world.spawn()
    storageInsert<T>(store, entity, value)
    return entity
}

func<T: Clone> copyComponent(store: Storage<T>!, source: Entity, target: Entity)
scope if storageHas<T>(store, source)
then storageInsert<T>(store, target, storageGetClone(store, source))

func<T> spawnResourceWith(world: World!, store: Storage<T>!, name: String, value: T): Entity {
    fin entity = world.spawnResource(name)
    storageInsert<T>(store, entity, value)
    return entity
}

pack QueryFetch {
    var ok: Bool
    var entity: Entity
    var error: String
}

pack QueryCursor {
    var entities: Array<Entity>
    var cursor: Int
    var ok: Bool
    var error: String
}

/**
 * A typed single-result query.
 *
 * The component value remains borrowed from its storage. `single.*`
 * exposes it explicitly; the entity is retained for commands and diagnostics.
 */
@Experimental(since: "0.1")
pack Single<...T> where (...T).size >= 1 {
    var entity: Entity
    // The field generator emits a *string fragment* because the field's name is
    // generated too: `$index` splices the position in, giving `value0`,
    // `value1`, … . Writing `value: Ty` instead would declare the same name on
    // every iteration - the specialized pack would still take one argument per
    // type, but only the last field would be reachable by name and every
    // earlier one would be silently unreadable.
    inline for Ty in ...T with index {
        inline "value$index: $Ty"
    }
}

impl Single<...T> {
    /** The first (and, for a one-type query, only) component value. */
    oper.* &.() = self.value0
}

/**
 * Heterogeneous ECS query handle, written `QueryOf<A&, B!>`.
 *
 * Named apart from the `@Query` parameter decorator: a decorator registered
 * before a pack of the same name shadows it, and which one wins depends on
 * import order - so the two names are kept distinct rather than relying on it.
 *
 * The variadic type list is compile-time-only access metadata. Runtime state is
 * one compact entity cursor, so adding component types does not increase the
 * handle's allocation count.
 */
@Experimental(since: "0.1")
pack QueryOf<...T> {
    var cursor: QueryCursor

    /**
     * The world the query was asked of.
     *
     * Held because a row is the *components*, not the entity that carries them,
     * and the storages they come from are the world's. A `World` field names the
     * world itself rather than a copy - an aggregate is a reference here.
     */
    var world: World&
}

/**
 * A query is what `loop` walks: reset it, then take rows while it has them.
 *
 * Declaring the conformance rather than relying on the two methods being
 * present makes the requirement checkable - `loop q { … }` asks for an
 * `Iterator`, and a query is one.
 */
impl Iterator for QueryOf<...T> assoc Item = Tuple<Entity, ...T> {
    func !.reset() scope self.cursor.reset()

    /** Advances the cursor, answering whether a row was found. */
    func !.hasNext(): Bool = self.cursor.hasNext()

    /**
     * The row the cursor is on: the entity, then one component per fetch term.
     *
     * The entity comes first so a row is always at least a pair, and so the
     * component positions follow the order the query was written in.
     *
     * Fetch terms must explicitly use `&` for readonly access or `!` for mutable
     * access. The tuple keeps those borrowed field types; its Entity is a
     * separate scalar snapshot. A plain owning component type does not express
     * a borrowed fetch contract.
     */
    @ProvidesAccess
    func !.next(): Tuple<Entity, ...T> {
        fin row: Entity = self.cursor.next()
        // The row owns its entity snapshot and borrows the fetched components.
        return Tuple(
            row.clone()
            inline for Ty in ...T {
                storageGet<Ty>(storageOf(self.world), row)
            }
        )
    }

    /**
     * Walks the rows, handing each one to [body] as a whole.
     *
     * Written out rather than inherited from `Iterator`: a provided
     * member's copy keeps the spec's `Item` unspecialized in its callable
     * parameter, so the block is offered a bare `Tuple` and the concrete row
     * does not match it.
     */
    @ProvidesAccess
    func !.forEach(body: inline (Tuple<Entity, ...T>) -> Unit) {
        self.reset()
        while self.hasNext() then body(self.next())
    }

    /**
     * Walks the rows, handing each one to [body] *spread across parameters*.
     *
     * ```azora
     * shapes.unpack { entity, tag, paint -> … }
     * ```
     *
     * The same rows `forEach` walks, taken apart: one parameter for the entity
     * and one per fetch term, in the order the query was written. Separate from
     * [forEach] because the two differ only in how many parameters the block
     * takes, and a block's arity is not something a call can be resolved on.
     *
     * No tuple is built here - each component is fetched straight from its
     * storage, so `unpack` costs a walk and nothing more.
     */
    @ProvidesAccess
    func !.unpack(body: inline (Entity, ...T) -> Unit) {
        self.reset()
        while self.hasNext() {
            fin row: Entity = self.cursor.next()
            body(
                row
                inline for Ty in ...T {
                    storageGet<Ty>(storageOf(self.world), row)
                }
            )
        }
    }
}

impl QueryOf<...T> {
    /**
     * Builds the query from the world.
     *
     * What it selects is in its own type: every component in `...T` narrows the
     * cursor to rows that carry it, and the world is asked for each storage by
     * the component's own name. Nothing is passed in but the world, which is
     * what lets a system declare a query as a parameter and receive it built.
     */
    @Experimental(since: "0.1")
    @ProvidesAccess
    func stamp(world: World&): Int {
        var total = 0
        inline for Ty in ...T {
            total += (storageOf<Ty>(world).revision as Int)
        }
        return total
    }

    /**
     * How far the storages this query reads have moved.
     *
     * A query's rows change when a component is written, and a storage counts
     * its own writes, so the sum over the fetch terms answers for the whole
     * query in one number.
     */
    @ProvidesAccess
    func provide(world: World&): QueryOf<...T> {
        var cursor = queryAll(world, false)
        inline for Ty in ...T {
            queryWith<Ty>(cursor, storageOf(world))
        }
        return QueryOf(take cursor, world)
    }
}

impl QueryOf<...T> {
    /**
     * Returns the next matching entity.
     *
     * System-parameter lowering projects this entity into the tuple of borrowed
     * components requested by the `QueryOf<…>` type arguments.
     */
    func !.nextEntity(): Entity = self.cursor.next()
}

/**
 * One resource the world owns.
 *
 * Built by [insertResource] and [insertResourceNamed], which are `inline`: they
 * expand where `T` is a concrete type, so the slot is built knowing how to
 * destroy its value - the same discipline component storages follow.
 */
@Experimental(since: "0.1")
pack ResourceSlot<T> {
    var value: T
}

/**
 * Puts [value] in the world as the resource of its type.
 *
 * Answers whether it replaced one, which is how a system that inserts on first
 * use can tell. There is one resource per type, so inserting twice replaces,
 * and the replaced value is destroyed.
 */
@Experimental(since: "0.1")
inline func<T> insertResource(world: World!, value: T): Bool
scope return storeResource<T>(world, T.typeName, ResourceSlot<T>(take value))

/** Puts [value] under an explicit [name]. See [insertResource]. */
@Experimental(since: "0.1")
inline func<T> insertResourceNamed(world: World!, name: String, value: T): Bool
scope return storeResource<T>(world, name, ResourceSlot<T>(take value))

/** Stores [slot] under [name], destroying the resource it replaces. */
func<T> storeResource(world: World!, name: String, slot: ResourceSlot<T>): Bool {
    world.resourceWrites++
    return for i: Int in 0..<world.resourceNames.size {
        if world.resourceNames[i] == name {
            // remove destroys the old resource before the new one is appended.
            world.resourceNames.remove(i)
            world.resources.remove(i)
            world.resourceStamps.remove(i)
            world.resourceNames.add(name)
            world.resources.add(take slot)
            world.resourceStamps.add(world.resourceWrites)
            break true
        }
    } else {
        world.resourceNames.add(name)
        world.resources.add(take slot)
        world.resourceStamps.add(world.resourceWrites)
        false
    }
}

/**
 * How many times the resource under [name] has been written, as of its
 * newest write; -1 when it has never been.
 *
 * A number that moves exactly when the resource is written and never
 * otherwise. That is all a reader needs to tell "the same as last time" from
 * "different".
 */
@Experimental(since: "0.1")
func resourceStamp(world: World&, name: String): Int
scope return for i: Int in 0..<world.resourceNames.size {
    if world.resourceNames[i] == name then break world.resourceStamps[i]
} else -1

/** Whether the world holds a resource under [name]. */
@Experimental(since: "0.1")
func hasResourceNamed(world: World&, name: String): Bool = resourceStamp(world, name) >= 0

/**
 * The world's resource of type `T`, as a copy of its own.
 *
 * A resource a system asks for and the world does not hold is a wiring mistake,
 * not a condition to handle: nothing sensible can be returned in its place, and
 * carrying on would hide where it was supposed to be inserted.
 */
@Experimental(since: "0.1")
@SignatureOnly
inline func<T> resource(world: World&): T
scope return resourceSlot<T>(world, T.typeName).value.clone()

/** Borrows a world-owned resource without cloning its contents. */
inline func<T> borrowResource(world: World&): T&|world|
scope return resourceSlot<T>(world, T.typeName).value

/** The resource under an explicit [name], as a copy. See [resource]. */
@Experimental(since: "0.1")
inline func<T> resourceNamed(world: World&, name: String): T
scope return resourceSlot<T>(world, name).value.clone()

/**
 * The slot holding the resource under [name], borrowed from the world.
 *
 * Erased: the inline readers above give it a concrete `T`, and copy the value
 * out where that type is known.
 */
func<T> resourceSlot(world: World&, name: String): ResourceSlot<T>&|world| {
    for i: Int in 0..<world.resourceNames.size
    then if world.resourceNames[i] == name then return world.resources[i] as ResourceSlot<T>&
    panic "no resource '${name}' in this world - insert it before the systems that ask for it"
}

/**
 * The world's resource of type `T` as a copy, or [fallback] when there is none.
 *
 * A fallback rather than a failure: a system that runs before whatever inserts
 * the resource should see a defined value, not stop the frame.
 */
@Experimental(since: "0.1")
@SignatureOnly
inline func<T> resourceOr(world: World&, fallback: T): T {
    // Parenthesized: `return if …` is the statement form, and an inline body
    // must be one returned expression to expand where `T` is known.
    return (if hasResourceNamed(world, T.typeName) then resourceSlot<T>(world, T.typeName).value.clone() else fallback)
}

/** The resource under an explicit [name] as a copy, or [fallback]. See [resourceOr]. */
@Experimental(since: "0.1")
inline func<T> resourceNamedOr(world: World&, name: String, fallback: T): T {
    return (if hasResourceNamed(world, name) then resourceSlot<T>(world, name).value.clone() else fallback)
}

/**
 * Registers [store] as the world's storage for component `T`.
 *
 * Idempotent: registering the same component twice replaces the entry rather
 * than adding a second one, so a system that registers on first use is safe to
 * run every frame. Answers whether it replaced one.
 */
@Experimental(since: "0.1")
@SignatureOnly
inline func<T> registerStorage(world: World!, store: Storage<T>): Bool
scope return registerStorageNamed<T>(world, T.typeName, take store)

/**
 * Registers [store] under an explicit [name].
 *
 * The name is a parameter because the body has more than one statement, and an
 * `inline` body is folded only when it is a single expression - which is what
 * [registerStorage] is, so the type's own name is filled in there.
 */
@Experimental(since: "0.1")
func<T> registerStorageNamed(world: World!, name: String, store: Storage<T>): Bool {
    var i = 0
    while i < world.storageNames.size {
        if world.storageNames[i] == name {
            // remove destroys the old owner before the replacement is appended.
            world.storageNames.remove(i)
            world.storages.remove(i)
            world.storageNames.add(name)
            world.storages.add(take store)
            return true
        }
        i++
    }
    world.storageNames.add(name)
    world.storages.add(take store)
    return false
}

/** Mutable access to a registered component storage, creating it on first use. */
@Experimental(since: "0.1")
inline func<T> ensureStorage(world: World!): Storage<T>!
scope return ensureStorageNamed<T>(world, T.typeName)

/** Mutable access under an explicit component name. The world owns the returned store. */
func<T> ensureStorageNamed(world: World!, name: String): Storage<T>! {
    for i: Int in 0..<world.storageNames.size
    then if world.storageNames[i] == name then return world.storages[i] as Storage<T>!
    var created = Storage<T>(Array<Entity>(), Array<T>(), Array<Bool>(), Array<Bool>(), Long(0))
    registerStorageNamed<T>(world, name, take created)
    return world.storages[world.storages.size - 1] as Storage<T>!
}

/**
 * The world's storage for component `T`, or an empty one when none was
 * registered.
 *
 * A query over a component nothing ever stored matches nothing, which is what
 * an empty storage gives - the alternative is an error at the one moment a
 * caller can do least about it, midway through a frame.
 */
@Experimental(since: "0.1")
@SignatureOnly
inline func<T> storageOf(world: World&): Storage<T>&
scope return storageNamed<T>(world, T.typeName)

/** The world's storage registered under an explicit [name]. See [storageOf]. */
@Experimental(since: "0.1")
func<T> storageNamed(world: World&, name: String): Storage<T>& {
    for i: Int in 0..<world.storageNames.size
    then if world.storageNames[i] == name then return world.storages[i] as Storage<T>&
    // Empty readonly query storage has program lifetime and never contains a T.
    // Mutable access uses ensureStorage, which registers a world-owned store.
    return emptyStorage as Storage<T>&
}

fin emptyStorage: Storage<Any> =
    Storage<Any>(Array<Entity>(), Array<Any>(), Array<Bool>(), Array<Bool>(), 0)

/**
 * A query narrowed to rows that also carry `T`.
 *
 * The filter is in the type, not in the state: runtime is still the one cursor
 * `Q` was walking, and the extra type arguments are the compile-time record of
 * what was asked for. Nesting is what composes them, so `with` and `without`
 * can be written in either order and as many times as a system needs.
 */
@Experimental(since: "0.1")
pack QueryWith<Q, ...T> {
    var cursor: QueryCursor
}

/** A query narrowed to rows that do *not* carry `T`. */
@Experimental(since: "0.1")
pack QueryWithout<Q, ...T> {
    var cursor: QueryCursor
}

/**
 * How a system asks for the rows it wants.
 *
 * ```azora
 * func recolour(shapes: @query Shape)
 * func moving(bodies: @query [Position, Velocity] without Frozen)
 * ```
 *
 * `$T` is uppercase, so it is a *type* hole: these arms are matched where a
 * type is written rather than where a call is, and the parameter's declared
 * type becomes the query handle the system receives.
 */
@Experimental(since: "0.1")
macro @query {
    $Q => QueryOf<$Q>
    $Q with $T => QueryWith<QueryOf<$Q>, $T>
    $Q with [...$T] => QueryWith<QueryOf<$Q>, ...$T>
    $Q without $T => QueryWithout<QueryOf<$Q>, $T>
    $Q without [...$T] => QueryWithout<QueryOf<$Q>, ...$T>
    $Q with $T without $S => QueryWithout<QueryWith<QueryOf<$Q>, $T>, $S>
    $Q with [...$T] without $S => QueryWithout<QueryWith<QueryOf<$Q>, ...$T>, $S>
    $Q with $T without [...$S] => QueryWithout<QueryWith<QueryOf<$Q>, $T>, ...$S>
    $Q with [...$T] without [...$S] => QueryWithout<QueryWith<QueryOf<$Q>, ...$T>, ...$S>
    [...$Q] => QueryOf<...$Q>
    [...$Q] with $T => QueryWith<QueryOf<...$Q>, $T>
    [...$Q] with [...$T] => QueryWith<QueryOf<...$Q>, ...$T>
    [...$Q] without $T => QueryWithout<QueryOf<...$Q>, $T>
    [...$Q] without [...$T] => QueryWithout<QueryOf<...$Q>, ...$T>
    [...$Q] with $T without $S => QueryWithout<QueryWith<QueryOf<...$Q>, $T>, $S>
    [...$Q] with [...$T] without $S => QueryWithout<QueryWith<QueryOf<...$Q>, ...$T>, $S>
    [...$Q] with $T without [...$S] => QueryWithout<QueryWith<QueryOf<...$Q>, $T>, ...$S>
    [...$Q] with [...$T] without [...$S] => QueryWithout<QueryWith<QueryOf<...$Q>, ...$T>, ...$S>
}

impl QueryWith<Q, ...T> {
    /**
     * Builds the narrowed query from the world.
     *
     * The query it narrows builds itself first - `Q` is whatever the clause was
     * written against, and it knows how - and then each component in `...T`
     * removes the rows that do not carry it. Filters nest, so this holds however
     * many clauses were written.
     */
    @Experimental(since: "0.1")
    /** How far the storages this query reads have moved. See [QueryOf::stamp]. */
    @ProvidesAccess
    func stamp(world: World&): Int {
        var total = Q::stamp(world)
        inline for Ty in ...T {
            total += (storageOf<Ty>(world).revision as Int)
        }
        return total
    }

    @ProvidesAccess
    func provide(world: World&): QueryWith<Q, ...T> {
        var base = Q::provide(world)
        inline for Ty in ...T {
            queryWith<Ty>(base.cursor, storageOf(world))
        }
        return QueryWith(base.cursor)
    }
}

impl QueryWithout<Q, ...T> {
    /** The same, keeping only the rows that carry *none* of `...T`. */
    @Experimental(since: "0.1")
    /** How far the storages this query reads have moved. See [QueryOf::stamp]. */
    @ProvidesAccess
    func stamp(world: World&): Int {
        var total = Q::stamp(world)
        inline for Ty in ...T {
            total += (storageOf<Ty>(world).revision as Int)
        }
        return total
    }

    @ProvidesAccess
    func provide(world: World&): QueryWithout<Q, ...T> {
        var base = Q::provide(world)
        inline for Ty in ...T {
            queryWithout<Ty>(base.cursor, storageOf(world))
        }
        return QueryWithout(base.cursor)
    }
}

/** Rows matching every one of the filters. */
@Experimental(since: "0.1")
pack QueryAnd<Q, ...T> {
    var cursor: QueryCursor
}

/** Rows matching any one of the filters. */
@Experimental(since: "0.1")
pack QueryOr<Q, ...T> {
    var cursor: QueryCursor
}

impl Iterator for QueryAnd<Q, ...T> assoc Item = Entity {
    func !.reset() {
        self.cursor.reset()
    }

    func !.hasNext(): Bool = self.cursor.hasNext()

    /** The entity the cursor is on. */
    func !.next(): Entity = self.cursor.next()
}

impl Iterator for QueryOr<Q, ...T> assoc Item = Entity {
    func !.reset() {
        self.cursor.reset()
    }

    func !.hasNext(): Bool = self.cursor.hasNext()

    /** The entity the cursor is on. */
    func !.next(): Entity = self.cursor.next()
}

/**
 * Rows whose `T` appeared this frame - `@query [Added<Position>]`.
 *
 * A marker: it carries no state and is never constructed. What it does is stand
 * in a query's type list where a component would, saying *which* rows are
 * wanted rather than which components are read. [Changed] and [Removed] are the
 * same idea over the other two things that can happen to a component.
 */
@Experimental(since: "0.1")
pack Added<T>

/** Rows whose `T` was written this frame. */
@Experimental(since: "0.1")
pack Changed<T>

/** Rows whose `T` was taken away this frame. */
@Experimental(since: "0.1")
pack Removed<T>

/** A narrowed query walks its rows exactly as the query it narrowed does. */
impl QueryWith<Q, ...T> {
    /** The next matching entity. See [QueryOf.nextEntity]. */
    @Experimental(since: "0.1")
    func !.nextEntity(): Entity = self.cursor.next()
}

impl QueryWithout<Q, ...T> {
    /** The next matching entity. See [QueryOf.nextEntity]. */
    @Experimental(since: "0.1")
    func !.nextEntity(): Entity = self.cursor.next()
}

impl Iterator for QueryWith<Q, ...T> assoc Item = Entity {
    func !.reset() {
        self.cursor.reset()
    }

    func !.hasNext(): Bool = self.cursor.hasNext()

    /** The entity the cursor is on. */
    func !.next(): Entity = self.cursor.next()
}

impl Iterator for QueryWithout<Q, ...T> assoc Item = Entity {
    func !.reset() scope self.cursor.reset()

    func !.hasNext(): Bool = self.cursor.hasNext()

    /** The entity the cursor is on. */
    func !.next(): Entity = self.cursor.next()
}

func queryEmpty(): QueryCursor = .([Entity::invalid.clone()], 1, true, "")

func queryError(message: String): QueryCursor = .([Entity::invalid.clone()], 1, false, message)

impl QueryCursor {
    func !.add(entity: Entity) {
        if entity.isValid then self.entities.add(entity.clone())
    }

    func !.reset() {
        self.cursor = 1
    }

    func !.markFailed(message: String) {
        self.ok = false
        self.error = message
    }

    func !.invalidateAt(index: Int) {
        if index > 0 && index < self.entities.size then self.entities[index] = Entity::invalid.clone()
    }

    func !.hasNext(): Bool {
        for i in self.cursor..<self.entities.size {
            if self.entities[i].isValid then return true
        }
        return false
    }

    func !.next(): Entity {
        while self.cursor < self.entities.size {
            fin entity = self.entities[self.cursor]
            self.cursor++
            if entity.isValid then return entity.clone()
        }
        return Entity::invalid.clone()
    }

    func &.count(): Int {
        var total = 0
        for i: Int in 1..<self.entities.size {
            if self.entities[i].isValid then total++
        }
        return total
    }

    func &.isEmpty(): Bool = self.count() <= 0

    func &.single(): QueryFetch {
        var found = Entity::invalid.clone()
        var total = 0
        for i: Int in 1..<self.entities.size {
            fin entity = self.entities[i]
            if entity.isValid {
                found = entity.clone()
                total++
            }
        }
        return when {
            total == 1 -> .(true, take found, "")
            total == 0 -> .(false, ::invalid, "query expected one entity, found none")
            else -> .(false, ::invalid, "query expected one entity, found many")
        }
    }
}

func queryAll(world: World&, includeResources: Bool): QueryCursor {
    var query = queryEmpty()
    var i = 0
    while i < world.entityCount {
        fin entity = world.entityAt(i)
        if world.isAlive(entity) && (includeResources || !world.isResource(entity)) then query.add(entity)
        i++
    }
    return take query
}

func queryBroad(world: World&): QueryCursor = queryAll(world, true)

func queryScene(world: World&): QueryCursor = queryAll(world, false)

func queryRetainAlive(query: QueryCursor!, world: World&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !world.isAlive(entity) then query.invalidateAt(i)
        i++
    }
}

func queryRetainResources(query: QueryCursor!, world: World&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !world.isResource(entity) then query.invalidateAt(i)
        i++
    }
}

func queryRetainScene(query: QueryCursor!, world: World&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && world.isResource(entity) then query.invalidateAt(i)
        i++
    }
}

func<T> queryFromStorage(world: World&, store: Storage<T>&, includeResources: Bool): QueryCursor {
    var query = queryEmpty()
    var i = 0
    while i < store.entities.size {
        fin entity = store.entities[i]
        if entity.isValid && world.isAlive(entity) && (includeResources || !world.isResource(entity)) then query.add(entity)
        i++
    }
    return take query
}

func<T> queryWith(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !storageHas<T>(store, entity) then query.invalidateAt(i)
        i++
    }
}

func<T> queryWithout(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && storageHas<T>(store, entity) then query.invalidateAt(i)
        i++
    }
}

func<T> queryAdded(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !storageWasAdded<T>(store, entity) then query.invalidateAt(i)
        i++
    }
}

func<T> queryChanged(query: QueryCursor!, store: Storage<T>&) {
    var i = 1
    while i < query.entities.size {
        fin entity = query.entities[i]
        if entity.isValid && !storageWasChanged<T>(store, entity) then query.invalidateAt(i)
        i++
    }
}

func<T> queryResources(world: World&, store: Storage<T>&): QueryCursor {
    var query = queryFromStorage<T>(world, store, true)
    queryRetainResources(query, world)
    return take query
}

pack QueryAccess {
    var system: String
    var reads: Array<String>
    var writes: Array<String>
    var withs: Array<String>
    var withouts: Array<String>
    var added: Array<String>
    var changed: Array<String>
    var broad: Bool
    var includeResources: Bool
    var single: Bool
    var valid: Bool
    var error: String
}

func queryAccessInit(system: String): QueryAccess = .(system, [""], [""], [""], [""], [""], [""], false, false, false, true, "")

func queryNameListHas(list: Array<String>, name: String): Bool {
    for i: Int in 1..<list.size {
        if list[i] == name then return true
    }
    return false
}

func queryNameListsOverlap(left: Array<String>, right: Array<String>): Bool {
    var i = 1
    while i < left.size {
        if queryNameListHas(right, left[i]) then return true
        i++
    }
    return false
}

func queryAccessRead(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.reads, component) then access.reads.add(component)
}

func queryAccessWrite(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.writes, component) then access.writes.add(component)
}

func queryAccessWith(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.withs, component) then access.withs.add(component)
}

func queryAccessWithout(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.withouts, component) then access.withouts.add(component)
}

func queryAccessAdded(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.added, component) then access.added.add(component)
}

func queryAccessChanged(access: QueryAccess!, component: String) {
    if component != "" && !queryNameListHas(access.changed, component) then access.changed.add(component)
}

func queryAccessBroad(access: QueryAccess!, includeResources: Bool) {
    access.broad = true
    access.includeResources = includeResources
}

func queryAccessSingle(access: QueryAccess!) {
    access.single = true
}

func queryAccessFail(access: QueryAccess!, message: String) {
    access.valid = false
    access.error = message
}

func queryAccessDisjoint(left: QueryAccess&, right: QueryAccess&): Bool {
    return queryNameListsOverlap(left.withs, right.withouts) || queryNameListsOverlap(right.withs, left.withouts)
}

func queryAccessConflicts(left: QueryAccess&, right: QueryAccess&): Bool {
    return when {
        queryAccessDisjoint(left, right) -> false
        queryNameListsOverlap(left.writes, right.writes) -> true
        queryNameListsOverlap(left.writes, right.reads) -> true
        queryNameListsOverlap(right.writes, left.reads) -> true
        else -> false
    }
}

pack ResourceCell<T> {
    var hasValue: Bool
    var value: T
    var revision: Int
}

func<T> resourceInit(defaultValue: T): ResourceCell<T> = ResourceCell<T>(false, defaultValue, 0)

func<T> resourceExists(resource: ResourceCell<T>&): Bool = resource.hasValue

func<T> resourceSet(resource: ResourceCell<T>!, value: T) {
    resource.value = value
    resource.hasValue = true
    resource.revision++
}

func<T> resourceGet(resource: ResourceCell<T>&): T = resource.value

func<T> resourceGetOrDefault(resource: ResourceCell<T>&, defaultValue: T): T = if resource.hasValue then resource.value else defaultValue

pack EventQueue<T> {
    var events: Array<T>
    var cursor: Int
}

func<T> eventQueueInit(defaultEvent: T): EventQueue<T> {
    var events = [defaultEvent]
    return EventQueue<T>(take events, 1)
}

func<T> eventSend(queue: EventQueue<T>!, event: T) {
    queue.events.add(event)
}

func<T> eventLength(queue: EventQueue<T>&): Int = queue.events.size - queue.cursor

func<T> eventIsEmpty(queue: EventQueue<T>&): Bool = eventLength<T>(queue) <= 0

func<T> eventPeek(queue: EventQueue<T>&, index: Int): T = queue.events[queue.cursor + index]

func<T> eventHasNext(queue: EventQueue<T>&): Bool = queue.cursor < queue.events.size

func<T> eventNext(queue: EventQueue<T>!): T {
    fin event = queue.events[queue.cursor]
    queue.cursor++
    return event
}

pack CommandBuffer {
    var despawns: Array<Entity>
    var cursor: Int
}

func commandBufferInit(): CommandBuffer = .(Array<Entity>(), 0)

impl CommandBuffer {
    func !.despawn(entity: Entity) {
        self.despawns.add(entity.clone())
    }

    func !.apply(world: World!) {
        while self.cursor < self.despawns.size {
            world.despawn(self.despawns[self.cursor])
            self.cursor++
        }
        self.despawns.clear()
        self.cursor = 0
    }
}

/**
 * One `@System` function, as the scheduler sees it.
 *
 * Every field here is read off the decorator — nothing is passed at a
 * registration call site, because there is no registration call site. The
 * decorator is the only place a system's place in the frame is written down,
 * which is what stops the two from drifting apart.
 */
@Experimental(since: "0.1")
pack ScheduledSystem {
    /** The function's own name, as `runBefore`/`runAfter` spell it. */
    fin name: String
    fin phase: SystemPhase
    fin order: Int
    /** Comma-separated names of systems (or sets) this one must precede. */
    fin runBefore: String
    /** Comma-separated names of systems (or sets) this one must follow. */
    fin runAfter: String
    fin inSet: String
    /** Cleared to skip the system without removing its decorator. */
    var enabled: Bool
}

/**
 * True when [name] appears in the comma-separated [list].
 *
 * Matching is exact per segment, so `"input"` does not match `"input_debug"` —
 * a substring test would silently create ordering edges nobody asked for.
 * Surrounding spaces are ignored so `"input, physics"` reads naturally.
 */
func systemNameListed(list: String, name: String): Bool {
    if list == "" || name == "" then return false
    var start = 0
    for i: Int in 0..list.size {
        if i == list.size || list[i] == ',' {
            var from = start
            var to = i
            while from < to && list[from] == ' ' {
                from++
            }
            while to > from && list[to - 1] == ' ' then to--
            if to - from == name.size {
                var matched = true
                var k = 0
                while k < name.size {
                    if list[from + k] != name[k] {
                        matched = false
                        k = name.size
                    } else {
                        k++
                    }
                }
                if matched then return true
            }
            start = i + 1
        }
    }
    return false
}

/**
 * The position of [phase] in the frame.
 *
 * Phases are absolute: every `.PreUpdate` system runs before every `.Update`
 * one, whatever the ordering constraints say. Constraints only order systems
 * *within* a phase, so a stray `runAfter` cannot pull rendering into the middle
 * of simulation.
 */
func systemPhaseRank(phase: SystemPhase): Int {
    return when phase {
        .Startup -> 0
        .PreUpdate -> 1
        .Update -> 2
        .PostUpdate -> 3
        .FixedUpdate -> 4
        .RenderSky -> 5
        .RenderVolumes -> 6
        .RenderTransparent -> 7
        .Render -> 8
        .Audio -> 9
        .Last -> 10
    }
}

/** Whether any enabled system of [plan] runs in [phase]: a stage nothing uses costs nothing. */
func phaseHasSystems(plan: SystemPlan&, phase: SystemPhase): Bool {
    for i: Int in 0..<plan.count {
        if plan.systems[i].phase == phase && plan.systems[i].enabled then return true
    }
    return false
}

/**
 * The frame's systems and the order they run in.
 *
 * `resolved` holds indices into `systems` in execution order. It is computed
 * once by [systemPlan] rather than per frame, because the constraints come from
 * decorators and so cannot change while the program runs.
 *
 * The index of a system in `systems` is also its position in the compile-time
 * enumeration of `@System` functions — that correspondence is what lets
 * [runPhase] dispatch to the right function from a plain integer. See the note
 * on [systemPlan].
 */
@Experimental(since: "0.1")
pack SystemPlan {
    var systems: Array<ScheduledSystem>
    var count: Int
    var resolved: Array<Int>
    var resolvedCount: Int
    /** Set when the constraints contradict each other. */
    var cyclic: Bool
    var cycleReport: String
}

/** Records one decorated system. Called only by the [systemPlan] expansion. */
func systemPlanDeclare(
    plan: SystemPlan!
    name: String
    phase: SystemPhase
    order: Int
    runBefore: String
    runAfter: String
    inSet: String
) {
    plan.systems.add(ScheduledSystem(name, phase, order, runBefore, runAfter, inSet, true))
    plan.count++
}

impl SystemPlan {
    /** The index of the system called [name], or `-1`. */
    func &.indexOf(name: String): Int {
        for i: Int in 0..<self.count {
            if self.systems[i].name == name then return i
        }
        return -1
    }

    /**
     * Enables or disables a system, returning false if no system has that name.
     *
     * The decorator says where a system runs; whether it runs at all is a
     * runtime decision, so this is the one part of a system's schedule that is
     * not fixed at compile time.
     */
    func !.setEnabled(name: String, enabled: Bool): Bool {
        fin found = self.indexOf(name)
        if found < 0 then return false
        self.systems[found].enabled = enabled
        return true
    }

    /**
     * True when the system at [earlier] must run before the one at [later].
     *
     * A constraint counts from either end — one system saying "before you" and
     * the other saying "after me" are the same edge — and naming a set
     * constrains every member of it, so two packages can order their sets
     * without knowing each other's system names.
     */
    func &.constrains(earlier: Int, later: Int): Bool {
        fin a = self.systems[earlier]
        fin b = self.systems[later]
        return when {
            a.phase != b.phase -> false
            systemNameListed(a.runBefore, b.name) || systemNameListed(b.runAfter, a.name) -> true
            b.inSet != "" && systemNameListed(a.runBefore, b.inSet) -> true
            a.inSet != "" && systemNameListed(b.runAfter, a.inSet) -> true
            else -> false
        }
    }

    /**
     * Orders the systems: phase-major, then by the declared constraints.
     *
     * A stable topological sort. Among the systems whose predecessors are all
     * placed, the lowest `order` wins and enumeration order breaks the rest.
     * Stability matters — a schedule that reshuffles between runs turns an
     * ordering bug into one that only shows up sometimes.
     *
     * Contradictory constraints cannot be satisfied, so the remaining systems
     * are left in enumeration order and `cyclic` records the fact. Degrading to
     * "runs in the order you declared it" keeps the frame running; dropping the
     * systems instead would make a typo look like a physics bug.
     */
    func !.resolve() {
        self.cyclic = false
        self.cycleReport = ""
        self.resolvedCount = 0

        var placed: Array<Bool> = []
        var initIndex = 0
        while initIndex < self.count {
            placed.add(false)
            initIndex++
        }
        for i: Int in 0..<self.count then placed[i] = false

        var remaining = self.count
        while remaining > 0 {
            var choice = -1
            var candidate = 0
            while candidate < self.count {
                if !placed[candidate] {
                    // Ready when nothing still unplaced has to come first.
                    var ready = true
                    var other = 0
                    while other < self.count {
                        if !placed[other] && other != candidate && self.constrains(other, candidate) {
                            ready = false
                            other = self.count
                        } else {
                            other++
                        }
                    }
                    if ready && choice < 0 {
                        choice = candidate
                    } else {
                        if ready {
                            fin here = systemPhaseRank(self.systems[candidate].phase)
                            fin best = systemPhaseRank(self.systems[choice].phase)
                            if here < best {
                                choice = candidate
                            } else {
                                if here == best && self.systems[candidate].order < self.systems[choice].order then choice = candidate
                            }
                        }
                    }
                }
                candidate++
            }

            if choice < 0 {
                // Every remaining system waits on another one.
                self.cyclic = true
                self.cycleReport = "system ordering has a cycle"
                for leftover: Int in 0..<self.count {
                    if !placed[leftover] {
                        self.resolved[self.resolvedCount] = leftover
                        self.resolvedCount++
                        placed[leftover] = true
                    }
                }
                remaining = 0
            } else {
                self.resolved[self.resolvedCount] = choice
                self.resolvedCount++
                placed[choice] = true
                remaining--
            }
        }
    }

    /** The names of [phase]'s systems, in the order they will run. */
    func &.orderOf(phase: SystemPhase): Array<String> {
        var names = [""]
        var i = 0
        while i < self.resolvedCount {
            fin system = self.systems[self.resolved[i]]
            if system.phase == phase then names.add(system.name)
            i++
        }
        return names
    }
}

/**
 * The schedule, built from every `@System` function in the program.
 *
 * There is no registration: `reflect<*>.withAnnot<System>` enumerates the
 * decorated functions at compile time, and each one's decorator supplies its
 * phase, order and ordering constraints. Adding a system to the frame is
 * writing `@System` above it.
 *
 * ## The index correspondence
 *
 * This function and [runPhase] both unroll the same compile-time enumeration,
 * in the same order, so the *n*-th system recorded here is the *n*-th call site
 * emitted there. That is what lets the resolved order — a list of integers —
 * dispatch to functions without any function values, which is why the schedule
 * lowers the same way on the interpreter, WebAssembly and LLVM.
 * Both loops must therefore stay literally identical.
 *
 * Build it once and keep it; the ordering is fixed at compile time and cannot
 * change while the program runs.
 */
@Experimental(since: "0.1")
func systemPlan(): SystemPlan {
    var plan = SystemPlan(
        Array<ScheduledSystem>()
        0
        Array<Int>()
        0
        false
        ""
    )

    inline for S in reflect<*>.withAnnot<System> {
        systemPlanDeclare(
            plan
            reflect<S>.declName
            reflect<S>.annotMeta<System>.phase
            reflect<S>.annotMeta<System>.order
            reflect<S>.annotMeta<System>.runBefore
            reflect<S>.annotMeta<System>.runAfter
            reflect<S>.annotMeta<System>.inSet
        )
        plan.resolved.add(0)
    }

    plan.resolve()
    return take plan
}

/**
 * Runs [phase]'s systems, in the resolved order.
 *
 * The inner loop walks every system to find the one whose turn it is. That is
 * quadratic in the system count, but it is an integer comparison per step and
 * the alternative — an indirect call through a stored function — is what this
 * design exists to avoid. See [systemPlan] for why the index identifies the
 * function.
 */
@Experimental(since: "0.1")
func runPhase(plan: SystemPlan&, phase: SystemPhase, world: World!) {
    for step: Int in 0..<plan.resolvedCount {
        fin due = plan.resolved[step]
        if plan.systems[due].phase == phase && plan.systems[due].enabled {
            var cursor = 0
            inline for S in reflect<*>.withAnnot<System> {
                if cursor == due then S(world)
                cursor++
            }
        }
    }
}

macro @applyKey => inline """
    if key == "" {
        anchor.pass.positionalKey(anchor.parent, Self.typeName)
    } else {
        key
    }
"""

/**
 * Runs one whole frame: every phase, in order.
 *
 * `.Startup` is included, so a caller that wants it to happen once must disable
 * those systems afterwards — [SystemPlan.setEnabled] — rather than this
 * deciding on their behalf.
 */
@Experimental(since: "0.1")
func runSystems(plan: SystemPlan&, world: World!) {
    runPhase(plan, .Startup, world)
    runPhase(plan, .PreUpdate, world)
    runPhase(plan, .Update, world)
    runPhase(plan, .PostUpdate, world)
    runPhase(plan, .FixedUpdate, world)
    runPhase(plan, .Render, world)
    runPhase(plan, .Last, world)
}

/** An empty plan, for tests and for hosts that build a schedule by hand. */
func systemPlanEmpty(): SystemPlan = .(Array<ScheduledSystem>(), 0, Array<Int>(), 0, false, "")

test "constraints order systems regardless of declaration order" {
    var plan = systemPlanEmpty()
    // Declared back to front, exactly as a program might.
    systemPlanDeclare(plan, "render", .Update, 0, "", "physics", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "physics", .Update, 0, "", "input", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "input", .Update, 0, "", "", "")
    plan.resolved.add(0)
    plan.resolve()

    assert !plan.cyclic panic "three chained constraints are satisfiable"
    fin order = plan.orderOf(.Update)
    assert order[1] == "input" panic "input must run first, not last as declared"
    assert order[2] == "physics" panic "physics must follow input"
    assert order[3] == "render" panic "render must follow physics"
}

test "a phase runs whole, whatever the constraints say" {
    var plan = systemPlanEmpty()
    // `draw` renders but asks to follow a system in a later phase; the phase
    // boundary must win, or rendering would drift out of its slot.
    systemPlanDeclare(plan, "draw", .Render, 0, "", "cleanup", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "cleanup", .Last, 0, "", "", "")
    plan.resolved.add(0)
    plan.resolve()

    assert !plan.cyclic panic "a cross-phase constraint is not a cycle"
    assert plan.systems[plan.resolved[0]].name == "draw" panic "render precedes last"
    assert plan.systems[plan.resolved[1]].name == "cleanup" panic "last comes after render"
}

test "order breaks ties no constraint settles" {
    var plan = systemPlanEmpty()
    systemPlanDeclare(plan, "late", .Update, 10, "", "", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "early", .Update, 1, "", "", "")
    plan.resolved.add(0)
    plan.resolve()

    assert plan.systems[plan.resolved[0]].name == "early" panic "the lower order wins"
}

test "naming a set orders every system in it" {
    var plan = systemPlanEmpty()
    systemPlanDeclare(plan, "hud", .Update, 0, "", "sim", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "movement", .Update, 0, "", "", "sim")
    plan.resolved.add(0)
    plan.resolve()

    assert plan.systems[plan.resolved[0]].name == "movement" panic "following a set must mean following its members"
}

test "contradictory constraints degrade to declaration order" {
    var plan = systemPlanEmpty()
    systemPlanDeclare(plan, "a", .Update, 0, "", "b", "")
    plan.resolved.add(0)
    systemPlanDeclare(plan, "b", .Update, 0, "", "a", "")
    plan.resolved.add(0)
    plan.resolve()

    assert plan.cyclic panic "a two-system cycle must be reported"
    assert plan.resolvedCount == 2 panic "both systems must still run"
    assert plan.systems[plan.resolved[0]].name == "a" panic "the fallback is declaration order"
}

test "a name is matched against whole list entries, not substrings" {
    assert systemNameListed("input, physics", "physics") panic "a spaced entry must match"
    assert systemNameListed("input,physics", "input") panic "the first entry must match"
    assert !systemNameListed("input_debug", "input") panic "a prefix must not match"
    assert !systemNameListed("", "input") panic "an empty list matches nothing"
    assert !systemNameListed("input", "") panic "an empty name matches nothing"
}

test "phases order the frame regardless of constraints" {
    assert systemPhaseRank(.Startup) < systemPhaseRank(.Update) panic "startup must precede update"
    assert systemPhaseRank(.Update) < systemPhaseRank(.Render) panic "update must precede render"
}

test "query access permits disjoint systems" {
    var movement = queryAccessInit("movement")
    queryAccessWrite(movement, "Transform")
    queryAccessWith(movement, "Player")

    var enemies = queryAccessInit("enemy_ai")
    queryAccessWrite(enemies, "Transform")
    queryAccessWithout(enemies, "Player")

    assert !queryAccessConflicts(movement, enemies) panic "with/without filters must prove disjoint writes"
}

test "query access rejects shared writes" {
    var movement = queryAccessInit("movement")
    queryAccessWrite(movement, "Transform")

    var physics = queryAccessInit("physics")
    queryAccessRead(physics, "Transform")

    assert queryAccessConflicts(movement, physics) panic "writer/reader overlap must serialize systems"
}
