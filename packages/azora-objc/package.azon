package: {
    name: "azora-objc"
    version: "0.1.0-dev.1"
    module: "engine.objc"
    kind: "ffi"
}
native: {
    frameworks: [ "CoreFoundation" ]
    libs: [ "objc" ]
    // The message-send trampolines, compiled into every program that uses
    // this package (`azora build`). tools/build.sh links the same file as
    // libazora_runtime; roadmap B0 replaces it with Azora code.
    sources: [ "../../runtime/src/ffi/az_ffi.c" ]
}
