// Azora Engine — Objective-C runtime & FFI plumbing bridge.
//
// This is the foundation that lets the entire platform layer be written in
// the Azora language: Cocoa/Metal objects are `Long` handles and messages are
// sent straight through `objc_msgSend`. Only signatures that involve doubles
// or by-value structs go through the tiny trampoline shim (az_ffi.c), because
// those need an exact C function type on arm64.
//
// C frameworks (Metal, CoreText, CoreGraphics, QuartzCore) export plain C
// functions — those are bridged directly by name in az_gpu.az / az_platform.az.

module engine.objc

import engine.io

bridge .C {
    // Objective-C runtime
    func @foreignName("objc_getClass")(name: std::String): std::Long
    func @foreignName("sel_registerName")(name: std::String): std::Long
    func @foreignName("objc_msgSend")(target: std::Long, selector: std::Long, a: std::Long, b: std::Long, c: std::Long, d: std::Long, e: std::Long, f: std::Long, g: std::Long, h: std::Long): std::Long
    func @foreignName("objc_autoreleasePoolPush")(): std::Long
    func @foreignName("objc_autoreleasePoolPop")(pool: std::Long)

    // msgSend trampolines for double / by-value-struct signatures (az_ffi.c)
    func @foreignName("az_send_d0")(target: std::Long, selector: std::Long): std::Double
    func @foreignName("az_send_float0")(target: std::Long, selector: std::Long): std::Double
    func @foreignName("az_send_float1")(target: std::Long, selector: std::Long, a: std::Double): std::Long
    func @foreignName("az_send_f1")(target: std::Long, selector: std::Long, a: std::Double): std::Long
    func @foreignName("az_send_f2")(target: std::Long, selector: std::Long, a: std::Double, b: std::Double): std::Long
    func @foreignName("az_send_quad")(target: std::Long, selector: std::Long, a: std::Double, b: std::Double, c: std::Double, d: std::Double): std::Long
    func @foreignName("az_send_quad_i3")(target: std::Long, selector: std::Long, a: std::Double, b: std::Double, c: std::Double, d: std::Double, i1: std::Long, i2: std::Long, i3: std::Long): std::Long
    func @foreignName("az_send_pair")(target: std::Long, selector: std::Long, x: std::Double, y: std::Double): std::Long
    func @foreignName("az_send_out_quad")(target: std::Long, selector: std::Long, out4: std::Long)
    func @foreignName("az_send_out_pair")(target: std::Long, selector: std::Long, out2: std::Long)
    func @foreignName("az_send_scissor")(target: std::Long, selector: std::Long, x: std::Long, y: std::Long, w: std::Long, h: std::Long)
    func @foreignName("az_send_region")(target: std::Long, selector: std::Long, x: std::Long, y: std::Long, z: std::Long, w: std::Long, h: std::Long, d: std::Long, mip: std::Long, bytes: std::Long, bytesPerRow: std::Long): std::Long
    func @foreignName("az_get_region")(target: std::Long, selector: std::Long, bytes: std::Long, bytesPerRow: std::Long, x: std::Long, y: std::Long, z: std::Long, w: std::Long, h: std::Long, d: std::Long, mip: std::Long)

    // Exported symbols/constants (dlsym)
    func @foreignName("az_sym")(name: std::String): std::Long
}

// ── Message-send helpers ────────────────────────────────────────────────

func cls(name: std::String): std::Long {
    return objcGetClass(name)
}

func sel(name: std::String): std::Long {
    return selRegisterName(name)
}

func send0(o: std::Long, s: std::Long): std::Long {
    return objcMsgSend(o, s, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L)
}

func send1(o: std::Long, s: std::Long, a: std::Long): std::Long {
    return objcMsgSend(o, s, a, 0L, 0L, 0L, 0L, 0L, 0L, 0L)
}

func send2(o: std::Long, s: std::Long, a: std::Long, b: std::Long): std::Long {
    return objcMsgSend(o, s, a, b, 0L, 0L, 0L, 0L, 0L, 0L)
}

func send3(o: std::Long, s: std::Long, a: std::Long, b: std::Long, c: std::Long): std::Long {
    return objcMsgSend(o, s, a, b, c, 0L, 0L, 0L, 0L, 0L)
}

func send4(o: std::Long, s: std::Long, a: std::Long, b: std::Long, c: std::Long, d: std::Long): std::Long {
    return objcMsgSend(o, s, a, b, c, d, 0L, 0L, 0L, 0L)
}

/// `[[Cls alloc] init]`
func newObject(className: std::String): std::Long {
    return send0(send0(cls(className), sel("alloc")), sel("init"))
}

/// An NSString from an Azora string (autoreleased).
func nsString(text: std::String): std::Long {
    return send1(cls("NSString"), sel("stringWithUTF8String:"), text as std::Long)
}

/// The UTF-8 contents of an NSString as an Azora string.
func nsStringText(nsStr: std::Long): std::String {
    return send0(nsStr, sel("UTF8String")) as std::String
}

/// Reads an exported object constant (e.g. NSDefaultRunLoopMode).
func globalObject(symbolName: std::String): std::Long {
    fin addr = azSym(symbolName)
    if addr == 0L {
        return 0L
    }
    return azPeek64(addr, 0L)
}
