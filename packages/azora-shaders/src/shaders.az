// Azora Engine — equivalent Metal, Vulkan, and WebGL shader libraries.
//
// Metal is compiled at startup by az_gpu.az. Vulkan consumes GLSL 4.50 and
// WebAssembly embeds GLSL ES 3.00 in linear memory for the WebGL device backend.
//
// 3D: interleaved position+normal vertices, per-draw viewProj/model/color/light
//     uniforms, simple configurable directional lambert shading.
// 2D: position+uv+color vertices in physical pixels mapped to NDC, optional
//     texture (text quads) modulated by the vertex color.

module engine.shaders

import engine.lighting.photon.shader
import engine.atmosphere.legacyshader

/** Complete Metal shader library containing the equivalent 3D and 2D stages. */
func metalShaderSource(): String {
    return (""
        + "#include <metal_stdlib>\n"
        + "using namespace metal;\n"
        + photonMetalSource()
        + localLightMetalSource()
        + sceneEnvironmentMetalSource()
        + heightFogShader()
        + skyMetalSource()
        + "struct V3Out { float4 pos [[position]]; float3 normal; float3 world; };
"
        + "struct U3 { float4x4 viewProj; float4x4 model; float4 color; float4 light; float4 eye; float4 fog; float4 direct; float4 fogShape; float4 extra; };\n"
        + "vertex V3Out v3_main(uint vid [[vertex_id]],\n"
        + "                     const device float* verts [[buffer(0)]],\n"
        + "                     constant U3& u [[buffer(1)]]) {\n"
        + "    V3Out out;\n"
        + "    float3 p = float3(verts[vid*6+0], verts[vid*6+1], verts[vid*6+2]);\n"
        + "    float3 n = float3(verts[vid*6+3], verts[vid*6+4], verts[vid*6+5]);\n"
        + "    float4 world = u.model * float4(p, 1.0);
"
        + "    out.pos = u.viewProj * world;
"
        + "    out.world = world.xyz;
"
        + "    float3 x = u.model[0].xyz, y = u.model[1].xyz, z = u.model[2].xyz;\n"
        + "    float3x3 cof = float3x3(cross(y,z), cross(z,x), cross(x,y));\n"
        + "    out.normal = (cof*n) * (dot(x,cof[0]) < 0.0 ? -1.0 : 1.0);\n"
        + "    return out;\n"
        + "}\n"
        + "fragment float4 f3_main(V3Out in [[stage_in]], constant U3& u [[buffer(1)]], const device float* photons [[buffer(2)]], const device float* baked [[buffer(3)]], constant float4* detailLight [[buffer(4)]], constant float4* spots [[buffer(5)]], constant float4* env [[buffer(6)]], depth2d<float> detail [[texture(30)]], texture2d<float> clouds [[texture(31)]]) {\n"
        + "    float3 n = normalize(in.normal), l = normalize(u.light.xyz), v = normalize(u.eye.xyz-in.world);\n"
        + "    float d = max(dot(n, l), 0.0);\n"
        + "    float ambient = clamp(u.light.w, 0.0, 1.0);\n"
        + "    PhotonLighting p = scenePhotonLight(photons,baked,detail,detailLight,in.world,n,u.eye.w,u.direct.xyz);\n"
        + "    float sun = p.visibility * cloudShade(env,clouds,in.world);\n"
        + "    float wet = sceneWetness(env,n), snow = sceneSnow(env,n,in.world);\n"
        + "    float3 albedo = mix(u.color.rgb*(1.0-0.45*wet), float3(0.9,0.92,0.95), snow);\n"
        + "    float3 i = float3(ambient) + (1.0 - ambient) * d * sun * p.direct + p.indirect + sceneFlash(env,n);\n"
        + "    float haze=heightFog(u.eye.xyz,in.world,u.fog.w,u.fogShape);\n"
        + "    float3 lit=albedo*(i+u.extra.x)+localLights(spots,in.world,n,v,albedo,float3(0.04+0.04*wet));\n"
        + "    // A wet surface: a sharp sun highlight and the sky's colour at grazing angles.\n"
        + "    float fres = 0.04 + 0.96*pow(1.0-saturate(dot(n,v)),5.0);\n"
        + "    lit += wet*(1.0-snow)*(p.direct*sun*d*pow(saturate(dot(n,normalize(l+v))),90.0)*1.6 + u.fog.xyz*fres*0.3);\n"
        + "    return float4(mix(lit,u.fog.xyz,haze), u.color.a);\n"
        + "}\n"
        + "struct V2Out { float4 pos [[position]]; float2 uv; float4 color; };\n"
        + "struct U2 { float2 viewport; float useTex; float pad; float4 shape; };\n"
        + "vertex V2Out v2_main(uint vid [[vertex_id]],\n"
        + "                     const device float* verts [[buffer(0)]],\n"
        + "                     constant U2& u [[buffer(1)]]) {\n"
        + "    V2Out out;\n"
        + "    float2 p = float2(verts[vid*8+0], verts[vid*8+1]);\n"
        + "    out.pos = float4(p.x / u.viewport.x * 2.0 - 1.0,\n"
        + "                     1.0 - p.y / u.viewport.y * 2.0, 0.0, 1.0);\n"
        + "    out.uv = float2(verts[vid*8+2], verts[vid*8+3]);\n"
        + "    out.color = float4(verts[vid*8+4], verts[vid*8+5], verts[vid*8+6], verts[vid*8+7]);\n"
        + "    return out;\n"
        + "}\n"
        + "fragment float4 f2_main(V2Out in [[stage_in]], constant U2& u [[buffer(1)]],\n"
        + "                        texture2d<float> tex [[texture(0)]],\n"
        + "                        sampler smp [[sampler(0)]]) {\n"
        + "    if (u.useTex > 2.5) {\n"
        + "        // Shape mode: uv is the pixel offset inside a rounded rectangle of\n"
        + "        // shape.xy pixels with corner radius shape.z; shape.w > 0 strokes\n"
        + "        // only an inner border that many pixels wide. Coverage is the\n"
        + "        // signed distance to the edge, which antialiases every corner.\n"
        + "        float2 half_size = u.shape.xy * 0.5;\n"
        + "        float radius = min(u.shape.z, min(half_size.x, half_size.y));\n"
        + "        float2 q = abs(in.uv - half_size) - half_size + radius;\n"
        + "        float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;\n"
        + "        float coverage = clamp(0.5 - d, 0.0, 1.0);\n"
        + "        if (u.shape.w > 0.0) { coverage *= clamp(0.5 + d + u.shape.w, 0.0, 1.0); }\n"
        + "        return float4(in.color.rgb, in.color.a * coverage);\n"
        + "    }\n"
        + "    if (u.useTex > 1.5) {\n"
        + "        // Image mode: the texture supplies colour, the vertex tints it.\n"
        + "        float4 t = tex.sample(smp, in.uv);\n"
        + "        return float4(t.rgb * in.color.rgb, t.a * in.color.a);\n"
        + "    }\n"
        + "    if (u.useTex > 0.5) {\n"
        + "        // Glyph mode: the texture is a coverage mask, the vertex is the colour.\n"
        + "        float4 t = tex.sample(smp, in.uv);\n"
        + "        return float4(in.color.rgb, in.color.a * t.a);\n"
        + "    }\n"
        + "    return in.color;\n"
        + "}\n"
        + temporalUpscaleSource()
    )
}

/**
 * Temporal upscaling: one full-resolution pixel from the half-resolution scene
 * and the history.
 *
 * The scene was drawn with its geometry shifted by `jitter` low-resolution
 * pixels, so sample `i` holds the point that sits at `i + 0.5 - jitter`. The
 * 3x3 samples nearest the pixel are blended by distance, and their spread
 * bounds how far the reprojected history may differ from them - what a surface
 * that moved, appeared or vanished would otherwise leave behind as a ghost.
 */
func temporalUpscaleSource(): String {
    return (""
        + "struct ResolveU { float4x4 invViewProj; float4x4 prevViewProj; float4 rect; float4 jitter; float4 params; float4 motion; };\n"
        + "struct VelocityU { float4x4 jittered, current, previous, model, previousModel; };\n"
        + "struct VelocityOut { float4 pos [[position]]; float4 now; float4 before; };\n"
        + "vertex VelocityOut velocity_vertex(uint vid [[vertex_id]], const device float* verts [[buffer(0)]], constant VelocityU& u [[buffer(1)]]) {\n"
        + "    float4 p = float4(verts[vid*6], verts[vid*6+1], verts[vid*6+2], 1.0), world = u.model * p;\n"
        + "    VelocityOut out; out.pos = u.jittered * world;\n"
        + "    // A hair in front of the scene's own depth for the same surface, so the test lets it through.\n"
        + "    out.pos.z -= 0.0002 * out.pos.w;\n"
        + "    out.now = u.current * world; out.before = u.previous * (u.previousModel * p); return out;\n"
        + "}\n"
        + "fragment float4 velocity_fragment(VelocityOut in [[stage_in]]) {\n"
        + "    return float4(in.now.xy / in.now.w - in.before.xy / in.before.w, 0.0, 1.0);\n"
        + "}\n"
        + "struct ResolveVOut { float4 pos [[position]]; };\n"
        + "struct ResolveOut { float4 screen [[color(0)]]; float4 history [[color(1)]]; };\n"
        + "vertex ResolveVOut resolve_vertex(uint vid [[vertex_id]], constant ResolveU& u [[buffer(0)]]) {\n"
        + "    float2 corner = float2(float(vid & 1u), float(vid >> 1u)) * 2.0 - 1.0;\n"
        + "    ResolveVOut out; out.pos = float4(corner * u.rect.xy + u.rect.zw, 0.0, 1.0); return out;\n"
        + "}\n"
        + "float3 toYCoCg(float3 c) { return float3(0.25*c.r+0.5*c.g+0.25*c.b, 0.5*c.r-0.5*c.b, -0.25*c.r+0.5*c.g-0.25*c.b); }\n"
        + "float3 fromYCoCg(float3 c) { return float3(c.x+c.y-c.z, c.x+c.z, c.x-c.y-c.z); }\n"
        + "float4 historyAt(texture2d<float> h, sampler s, float2 pixel, float2 size) {\n"
        + "    float2 one = floor(pixel - 0.5) + 0.5, f = pixel - one;\n"
        + "    float2 w0 = f*(-0.5+f*(1.0-0.5*f)), w1 = 1.0+f*f*(-2.5+1.5*f), w2 = f*(0.5+f*(2.0-1.5*f)), w3 = f*f*(-0.5+0.5*f);\n"
        + "    float2 w12 = w1+w2, at12 = (one+w2/w12)/size, at0 = (one-1.0)/size, at3 = (one+2.0)/size;\n"
        + "    float4 sum = h.sample(s,float2(at12.x,at0.y))*(w12.x*w0.y) + h.sample(s,float2(at0.x,at12.y))*(w0.x*w12.y)\n"
        + "        + h.sample(s,at12)*(w12.x*w12.y) + h.sample(s,float2(at3.x,at12.y))*(w3.x*w12.y) + h.sample(s,float2(at12.x,at3.y))*(w12.x*w3.y);\n"
        + "    return sum / (w12.x*w0.y + w0.x*w12.y + w12.x*w12.y + w3.x*w12.y + w12.x*w3.y);\n"
        + "}\n"
        + "fragment ResolveOut resolve_fragment(ResolveVOut in [[stage_in]], constant ResolveU& u [[buffer(0)]],\n"
        + "        texture2d<float> current [[texture(0)]], depth2d<float> depth [[texture(1)]], texture2d<float> history [[texture(2)]],\n"
        + "        texture2d<float> motion [[texture(3)]]) {\n"
        + "    constexpr sampler linear(filter::linear, address::clamp_to_edge);\n"
        + "    float2 full = u.params.yz, low = u.jitter.zw, jitter = u.jitter.xy, pixel = in.pos.xy;\n"
        + "    float2 q = pixel * (low / full);\n"
        + "    int2 base = int2(floor(q + jitter)), limit = int2(low) - 1;\n"
        + "    float4 sum = 0.0, crisp = 0.0, m1 = 0.0, m2 = 0.0; float weights = 0.0, crispWeights = 0.0, closest = 0.0, nearest = 1.0;\n"
        + "    int2 front = base;\n"
        + "    float2 outward = full / low;\n"
        + "    for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {\n"
        + "        int2 at = clamp(base + int2(i, j), int2(0), limit);\n"
        + "        float4 c = current.read(uint2(at)); float4 v = float4(toYCoCg(c.rgb), c.a);\n"
        + "        float2 d = float2(at) + 0.5 - jitter - q; float w = exp(-2.0 * dot(d, d));\n"
        + "        // The same distance in output pixels: a sample this close is this pixel's own.\n"
        + "        float2 e = d * outward; float k = exp(-2.47 * dot(e, e));\n"
        + "        sum += v * w; weights += w; crisp += v * k; crispWeights += k; closest = max(closest, k);\n"
        + "        m1 += v; m2 += v * v;\n"
        + "        float z = depth.read(uint2(at)); if (z < nearest) { nearest = z; front = at; }\n"
        + "    }\n"
        + "    float4 now = sum / weights, mean = m1 / 9.0, spread = sqrt(max(m2 / 9.0 - mean * mean, 0.0));\n"
        + "    float4 own = crispWeights > 1e-3 ? crisp / crispWeights : now;\n"
        + "    float4 result = now;\n"
        + "    if (u.params.x > 0.5) {\n"
        + "        float2 ndc = float2(pixel.x / full.x * 2.0 - 1.0, 1.0 - pixel.y / full.y * 2.0), was; bool ahead = true;\n"
        + "        // The nearest surface in reach decides: a moving object's own motion where one\n"
        + "        // was drawn, the camera's for everything that stood still.\n"
        + "        float4 moved = u.motion.x > 0.5 ? motion.read(uint2(front)) : float4(0.0);\n"
        + "        if (moved.a > 0.5) { was = ndc - moved.xy; }\n"
        + "        else {\n"
        + "            float4 world = u.invViewProj * float4(ndc, nearest, 1.0);\n"
        + "            float4 before = u.prevViewProj * float4(world.xyz / world.w, 1.0);\n"
        + "            was = before.xy / before.w; ahead = before.w > 0.0;\n"
        + "        }\n"
        + "        float2 seen = float2((was.x + 1.0) * 0.5 * full.x, (1.0 - was.y) * 0.5 * full.y);\n"
        + "        if (ahead && all(seen >= 0.5) && all(seen <= full - 0.5)) {\n"
        + "            float4 h = historyAt(history, linear, seen, full), was = float4(toYCoCg(h.rgb), h.a);\n"
        + "            float4 kept = clamp(was, mean - 1.25 * spread, mean + 1.25 * spread);\n"
        + "            // History the neighbourhood rejected belongs to something that moved: there the\n"
        + "            // smooth reconstruction stands in, rather than the nearest sample's stair-step.\n"
        + "            float rejected = saturate(length(was.rgb - kept.rgb) / (length(spread.rgb) + 1e-3) - 0.5);\n"
        + "            // A sample landing on the pixel refreshes it; one beside it barely does,\n"
        + "            // so over the eight jitter phases each pixel gathers its own samples.\n"
        + "            float refresh = mix(u.params.w * (0.25 + 1.75 * closest), 0.5, rejected);\n"
        + "            result = mix(kept, mix(own, now, rejected), refresh);\n"
        + "        }\n"
        + "    }\n"
        + "    // motion.y: the scene was drawn at full resolution, without upscaling - a copy.\n"
        + "    if (u.motion.y > 0.5) result = float4(toYCoCg(current.read(uint2(clamp(int2(pixel), int2(0), limit))).rgb), current.read(uint2(clamp(int2(pixel), int2(0), limit))).a);\n"
        + "    float4 color = float4(max(fromYCoCg(result.rgb), 0.0), saturate(result.a));\n"
        + "    ResolveOut out; out.screen = color; out.history = color; return out;\n"
        + "}\n"
    )
}

/** Compatibility name used by the native Metal renderer. */
func shaderSource(): String {
    return metalShaderSource()
}

/** Vulkan GLSL 4.50 equivalent of Metal `v3Main`. */
func vulkan3dVertexShaderSource(): String {
    return (""
        + "#version 450\n"
        + "layout(location = 0) in vec3 inPosition;\n"
        + "layout(location = 1) in vec3 inNormal;\n"
        + "layout(set = 0, binding = 0) uniform U3 { mat4 viewProj; mat4 model; vec4 color; vec4 light; } u;\n"
        + "layout(location = 0) out vec3 normal;\n"
        + "void main() {\n"
        + "    gl_Position = u.viewProj * u.model * vec4(inPosition, 1.0);\n"
        + "    normal = mat3(u.model) * inNormal;\n"
        + "}\n"
    )
}

/** Vulkan GLSL 4.50 equivalent of Metal `f3Main`. */
func vulkan3dFragmentShaderSource(): String {
    return (""
        + "#version 450\n"
        + "layout(location = 0) in vec3 normal;\n"
        + "layout(set = 0, binding = 0) uniform U3 { mat4 viewProj; mat4 model; vec4 color; vec4 light; } u;\n"
        + "layout(location = 0) out vec4 outColor;\n"
        + "void main() {\n"
        + "    vec3 l = normalize(u.light.xyz);\n"
        + "    float d = max(dot(normalize(normal), l), 0.0);\n"
        + "    float ambient = clamp(u.light.w, 0.0, 1.0);\n"
        + "    float intensity = ambient + (1.0 - ambient) * d;\n"
        + "    outColor = vec4(u.color.rgb * intensity, u.color.a);\n"
        + "}\n"
    )
}

/** Vulkan GLSL 4.50 equivalent of Metal `v2Main`. */
func vulkan2dVertexShaderSource(): String {
    return (""
        + "#version 450\n"
        + "layout(location = 0) in vec2 inPosition;\n"
        + "layout(location = 1) in vec2 inUv;\n"
        + "layout(location = 2) in vec4 inColor;\n"
        + "layout(set = 0, binding = 0) uniform U2 { vec2 viewport; float useTex; float pad; } u;\n"
        + "layout(location = 0) out vec2 uv;\n"
        + "layout(location = 1) out vec4 color;\n"
        + "void main() {\n"
        + "    gl_Position = vec4(inPosition.x / u.viewport.x * 2.0 - 1.0, 1.0 - inPosition.y / u.viewport.y * 2.0, 0.0, 1.0);\n"
        + "    uv = inUv;\n"
        + "    color = inColor;\n"
        + "}\n"
    )
}

/** Vulkan GLSL 4.50 equivalent of Metal `f2Main`. */
func vulkan2dFragmentShaderSource(): String {
    return (""
        + "#version 450\n"
        + "layout(location = 0) in vec2 uv;\n"
        + "layout(location = 1) in vec4 color;\n"
        + "layout(set = 0, binding = 0) uniform U2 { vec2 viewport; float useTex; float pad; } u;\n"
        + "layout(set = 0, binding = 1) uniform sampler2D tex;\n"
        + "layout(location = 0) out vec4 outColor;\n"
        + "void main() {\n"
        + "    if (u.useTex > 1.5) {\n"
        + "        vec4 sampled = texture(tex, uv);\n"
        + "        outColor = vec4(sampled.rgb * color.rgb, sampled.a * color.a);\n"
        + "    } else if (u.useTex > 0.5) {\n"
        + "        vec4 sampled = texture(tex, uv);\n"
        + "        outColor = vec4(color.rgb, color.a * sampled.a);\n"
        + "    } else {\n"
        + "        outColor = color;\n"
        + "    }\n"
        + "}\n"
    )
}

/** WebGL 2 GLSL ES 3.00 equivalent of Metal `v3Main`. */
func webgl3dVertexShaderSource(): String {
    return (""
        + "#version 300 es\n"
        + "precision highp float;\n"
        + "in vec3 position;\n"
        + "in vec3 normal;\n"
        + "uniform mat4 modelViewMatrix;\n"
        + "uniform mat4 projectionMatrix;\n"
        + "uniform mat3 normalMatrix;\n"
        + "out vec3 vNormal;\n"
        + "void main() {\n"
        + "    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n"
        + "    vNormal = normalize(normalMatrix * normal);\n"
        + "}\n"
    )
}

/** WebGL 2 GLSL ES 3.00 equivalent of Metal `f3Main`. */
func webgl3dFragmentShaderSource(): String {
    return (""
        + "#version 300 es\n"
        + "precision highp float;\n"
        + "in vec3 vNormal;\n"
        + "uniform vec4 uColor;\n"
        + "uniform vec4 uLight;\n"
        + "out vec4 outColor;\n"
        + "void main() {\n"
        + "    float d = max(dot(normalize(vNormal), normalize(uLight.xyz)), 0.0);\n"
        + "    float ambient = clamp(uLight.w, 0.0, 1.0);\n"
        + "    float intensity = ambient + (1.0 - ambient) * d;\n"
        + "    outColor = vec4(uColor.rgb * intensity, uColor.a);\n"
        + "}\n"
    )
}

/** WebGL 2 GLSL ES 3.00 equivalent of Metal `v2Main`. */
func webgl2dVertexShaderSource(): String {
    return (""
        + "#version 300 es\n"
        + "precision highp float;\n"
        + "in vec3 position;\n"
        + "in vec2 uv;\n"
        + "in vec4 color;\n"
        + "uniform vec2 uViewport;\n"
        + "out vec2 vUv;\n"
        + "out vec4 vColor;\n"
        + "void main() {\n"
        + "    gl_Position = vec4(position.x / uViewport.x * 2.0 - 1.0, 1.0 - position.y / uViewport.y * 2.0, 0.0, 1.0);\n"
        + "    vUv = uv;\n"
        + "    vColor = color;\n"
        + "}\n"
    )
}

/** WebGL 2 GLSL ES 3.00 equivalent of Metal `f2Main`. */
func webgl2dFragmentShaderSource(): String {
    return (""
        + "#version 300 es\n"
        + "precision highp float;\n"
        + "in vec2 vUv;\n"
        + "in vec4 vColor;\n"
        + "uniform bool uUseTexture;\n"
        + "uniform sampler2D uTexture;\n"
        + "out vec4 outColor;\n"
        + "void main() {\n"
        + "    if (uUseTexture) {\n"
        + "        vec4 sampled = texture(uTexture, vUv);\n"
        + "        outColor = vec4(vColor.rgb, vColor.a * sampled.a);\n"
        + "    } else {\n"
        + "        outColor = vColor;\n"
        + "    }\n"
        + "}\n"
    )
}
