/** The per-draw uniform block every lit 3D pipeline reads (engine.gpu `writeSceneUniforms`). */
@Execution("GPU")
module engine.shaders.sceneUniforms

/**
 * viewProj, model; color (rgb, alpha); light (direction, ambient); eye (position, lighting flags);
 * fog (colour, density); sun (colour, mip bias); fogShape (base height, falloff, start, most hidden);
 * extra (emission, ...).
 */
pack U3 {
    fin viewProj: Float4x4
    fin model: Float4x4
    fin color: Float4
    fin light: Float4
    fin eye: Float4
    fin fog: Float4
    fin sun: Float4
    fin fogShape: Float4
    fin extra: Float4
}
