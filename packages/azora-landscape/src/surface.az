module engine.landscape.surface
import std.math
import engine.landscape.field
import engine.landscape.lod

// The surface of a field, as triangles, one chunk of 16³ cells at a time so a
// brush rebuilds only what it touched. Surface nets: every cell the surface
// passes through gets one vertex, the mean of the points where the surface
// crosses the cell's edges; every grid edge the surface crosses joins the four
// cells around it into a quad. Unlike marching cubes this needs no case
// table, and the vertices it places are smooth.

fin chunkCells: Int = 16

func chunkCount(cells: Int): Int = (cells + chunkCells - 1) / chunkCells

func chunkTotal(field: Field&): Int = chunkCount(field.cellsX) * chunkCount(field.cellsY) * chunkCount(field.cellsZ)

/** Chunk (a, b, c) as one number. */
func chunkIndex(field: Field&, a: Int, b: Int, c: Int): Int =
    a + chunkCount(field.cellsX) * (b + chunkCount(field.cellsY) * c)

/** Whether bit [bit] (1, 2 or 4) of corner number [corner] is set. */
func hasBit(corner: Int, bit: Int): Bool = (corner / bit) % 2 == 1

/**
 * Extracts chunk (a, b, c), with optional reduced levels of detail.
 */
func meshChunk(field: Field&, a: Int, b: Int, c: Int, levels: Bool = true): SurfaceChunk {
    var mesh = SurfaceChunk()
    fin x0 = a * chunkCells
    fin y0 = b * chunkCells
    fin z0 = c * chunkCells
    fin x1 = clampInt(x0 + chunkCells, 0, field.cellsX)
    fin y1 = clampInt(y0 + chunkCells, 0, field.cellsY)
    fin z1 = clampInt(z0 + chunkCells, 0, field.cellsZ)
    if !crossesSurface(field, x0, y0, z0, x1, y1, z1) {
        return take mesh
    }
    // The cells whose vertices this chunk's quads use: its own, and one layer
    // before it on each axis, since a quad joins the cells around an edge.
    fin sx = x1 - x0 + 1
    fin sy = y1 - y0 + 1
    fin sz = z1 - z0 + 1
    var slots: Array<Int> = .() * (sx * sy * sz)
    var cells: Array<SurfaceCell> = []
    var positions: Array<Double> = []
    var normals: Array<Double> = []
    var corner: Array<Double> = .() * 8
    var ck = z0 - 1
    while ck < z1 {
        var cj = y0 - 1
        while cj < y1 {
            var ci = x0 - 1
            while ci < x1 {
                if ci >= 0 && cj >= 0 && ck >= 0 {
                    var inside = 0
                    var n = 0
                    while n < 8 {
                        corner[n] = field.value(ci + (if hasBit(n, 1) then 1 else 0), cj + (if hasBit(n, 2) then 1 else 0), ck + (if hasBit(n, 4) then 1 else 0))
                        if corner[n] <= 0.0 then inside = inside + 1
                        n = n + 1
                    }
                    if inside > 0 && inside < 8 {
                        // The mean of the edge crossings, in the cell's own units.
                        var sumX: Double = 0.0
                        var sumY: Double = 0.0
                        var sumZ: Double = 0.0
                        var crossings: Double = 0.0
                        var from = 0
                        while from < 8 {
                            var bit = 1
                            while bit <= 4 {
                                if !hasBit(from, bit) {
                                    fin to = from + bit
                                    fin d0 = corner[from]
                                    fin d1 = corner[to]
                                    if (d0 <= 0.0) != (d1 <= 0.0) {
                                        fin t = d0 / (d0 - d1)
                                        fin ax = if hasBit(from, 1) then 1.0 else 0.0
                                        fin ay = if hasBit(from, 2) then 1.0 else 0.0
                                        fin az = if hasBit(from, 4) then 1.0 else 0.0
                                        sumX = sumX + ax + (if bit == 1 then t else 0.0)
                                        sumY = sumY + ay + (if bit == 2 then t else 0.0)
                                        sumZ = sumZ + az + (if bit == 4 then t else 0.0)
                                        crossings = crossings + 1.0
                                    }
                                }
                                bit = bit * 2
                            }
                            from = from + 1
                        }
                        fin wx = field.worldX(ci) + sumX / crossings * field.cell
                        fin wy = field.worldY(cj) + sumY / crossings * field.cell
                        fin wz = field.worldZ(ck) + sumZ / crossings * field.cell
                        fin normal = field.gradient(wx, wy, wz)
                        cells.add(sharedCell(ci-x0,cj-y0,ck-z0,x1-x0,y1-y0,z1-z0))
                        positions.add(wx)
                        positions.add(wy)
                        positions.add(wz)
                        normals.add(normal.x)
                        normals.add(normal.y)
                        normals.add(normal.z)
                        slots[(ci - x0 + 1) + sx * ((cj - y0 + 1) + sy * (ck - z0 + 1))] = positions.size / 3
                    }
                }
                ci = ci + 1
            }
            cj = cj + 1
        }
        ck = ck + 1
    }

    // Every grid edge this chunk owns that the surface crosses is one quad.
    var triangles: Array<Int> = []
    var k = z0
    while k < z1 {
        var j = y0
        while j < y1 {
            var i = x0
            while i < x1 {
                fin here = field.value(i, j, k) <= 0.0
                if j >= 1 && k >= 1 && here != (field.value(i + 1, j, k) <= 0.0) {
                    quad(triangles, slots, positions, normals, sx, sy, x0, y0, z0,
                        i, j - 1, k - 1, i, j, k - 1, i, j, k, i, j - 1, k)
                }
                if i >= 1 && k >= 1 && here != (field.value(i, j + 1, k) <= 0.0) {
                    quad(triangles, slots, positions, normals, sx, sy, x0, y0, z0,
                        i - 1, j, k - 1, i - 1, j, k, i, j, k, i, j, k - 1)
                }
                if i >= 1 && j >= 1 && here != (field.value(i, j, k + 1) <= 0.0) {
                    quad(triangles, slots, positions, normals, sx, sy, x0, y0, z0,
                        i - 1, j - 1, k, i, j - 1, k, i, j, k, i - 1, j, k)
                }
                i = i + 1
            }
            j = j + 1
        }
        k = k + 1
    }

    if triangles.size == 0 {
        return take mesh
    }
    fin center = Point((field.worldX(x0-1)+field.worldX(x1))*0.5,
        (field.worldY(y0-1)+field.worldY(y1))*0.5,(field.worldZ(z0-1)+field.worldZ(z1))*0.5)
    fin radius = sqrt(((x1-x0+1)*(x1-x0+1)+(y1-y0+1)*(y1-y0+1)+(z1-z0+1)*(z1-z0+1)) as Double)*field.cell*0.5
    mesh.center = center.clone()
    mesh.radius = radius
    if !addSurfaceLevel(mesh,triangles,positions,normals,0.0) || !levels then return take mesh
    var count = triangles.size
    var step = 2
    var maxDeviation: Double = 0.0
    while step <= 8 && count >= 24 {
        fin reduced = reduceSurface(cells,positions,normals,triangles,step,field.cell*0.02)
        // Small, boundary-dominated or steep chunks need no extra GPU copy.
        if reduced.triangles.size >= 3 && reduced.triangles.size*10 <= count*9 {
            maxDeviation = higher(maxDeviation,reduced.maxDeviation)
            if addSurfaceLevel(mesh,reduced.triangles,reduced.positions,reduced.normals,maxDeviation) {
                count = reduced.triangles.size
            }
        }
        step *= 2
    }
    return take mesh
}

/** Flat or solid chunks do not need vertex extraction. */
func crossesSurface(field: Field&, x0: Int, y0: Int, z0: Int, x1: Int, y1: Int, z1: Int): Bool {
    fin sign = field.value(x0, y0, z0) <= 0.0
    var k = z0
    while k <= z1 {
        var j = y0
        while j <= y1 {
            var i = x0
            while i <= x1 {
                if (field.value(i, j, k) <= 0.0) != sign then return true
                i = i + 1
            }
            j = j + 1
        }
        k = k + 1
    }
    return false
}

/**
 * The quad through the vertices of four cells, as two triangles turned to
 * face the way the surface does there.
 */
func quad(triangles: Array<Int>!, slots: Array<Int>&, positions: Array<Double>&, normals: Array<Double>&,
    sx: Int, sy: Int, x0: Int, y0: Int, z0: Int,
    ai: Int, aj: Int, ak: Int, bi: Int, bj: Int, bk: Int,
    ci: Int, cj: Int, ck: Int, di: Int, dj: Int, dk: Int) {
    var a = slots[(ai - x0 + 1) + sx * ((aj - y0 + 1) + sy * (ak - z0 + 1))] - 1
    var b = slots[(bi - x0 + 1) + sx * ((bj - y0 + 1) + sy * (bk - z0 + 1))] - 1
    var c = slots[(ci - x0 + 1) + sx * ((cj - y0 + 1) + sy * (ck - z0 + 1))] - 1
    var d = slots[(di - x0 + 1) + sx * ((dj - y0 + 1) + sy * (dk - z0 + 1))] - 1
    if a < 0 || b < 0 || c < 0 || d < 0 then return
    // Use the shorter diagonal to keep stretched quads from making long slivers.
    if diagonalSquared(positions, b, d) < diagonalSquared(positions, a, c) {
        fin first = a
        a = b
        b = c
        c = d
        d = first
    }
    // The face's own normal against the surface's at its corners.
    fin ux = positions[b * 3] - positions[a * 3]
    fin uy = positions[b * 3 + 1] - positions[a * 3 + 1]
    fin uz = positions[b * 3 + 2] - positions[a * 3 + 2]
    fin vx = positions[c * 3] - positions[a * 3]
    fin vy = positions[c * 3 + 1] - positions[a * 3 + 1]
    fin vz = positions[c * 3 + 2] - positions[a * 3 + 2]
    fin fx = uy * vz - uz * vy
    fin fy = uz * vx - ux * vz
    fin fz = ux * vy - uy * vx
    fin sx2 = normals[a * 3] + normals[b * 3] + normals[c * 3] + normals[d * 3]
    fin sy2 = normals[a * 3 + 1] + normals[b * 3 + 1] + normals[c * 3 + 1] + normals[d * 3 + 1]
    fin sz2 = normals[a * 3 + 2] + normals[b * 3 + 2] + normals[c * 3 + 2] + normals[d * 3 + 2]
    if fx * sx2 + fy * sy2 + fz * sz2 >= 0.0 {
        triangles.add(a)
        triangles.add(b)
        triangles.add(c)
        triangles.add(a)
        triangles.add(c)
        triangles.add(d)
    } else {
        triangles.add(a)
        triangles.add(c)
        triangles.add(b)
        triangles.add(a)
        triangles.add(d)
        triangles.add(c)
    }
}

func diagonalSquared(positions: Array<Double>&, a: Int, b: Int): Double {
    fin x = positions[a * 3] - positions[b * 3]
    fin y = positions[a * 3 + 1] - positions[b * 3 + 1]
    fin z = positions[a * 3 + 2] - positions[b * 3 + 2]
    return x * x + y * y + z * z
}

