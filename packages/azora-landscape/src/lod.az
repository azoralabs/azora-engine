module engine.landscape.lod

import std.math
import std.traits
import engine.landscape.field
import engine.io

/** A cell position relative to its chunk, -1 for the shared halo. */
pack SurfaceCell derives Clone {
    var x: Int = 0
    var y: Int = 0
    var z: Int = 0
    var seam: Bool = false
}

pack SurfaceDetail {
    var positions: Array<Double> = []
    var normals: Array<Double> = []
    var triangles: Array<Int> = []
    var maxDeviation: Double = 0.0
}

func sharedCell(x: Int, y: Int, z: Int, width: Int, height: Int, length: Int): SurfaceCell {
    // Surface Nets quads need the neighbour's halo. Keep both copies of any
    // vertex used by a quad outside this chunk at their original positions.
    return SurfaceCell(x,y,z,x < 0 || y < 0 || z < 0 ||
        x >= width-1 || y >= height-1 || z >= length-1)
}

func clusterRoot(parent: Array<Int>&, vertex: Int): Int {
    var root = vertex
    while parent[root] != root { root = parent[root] }
    return root
}

func clusterEdge(parent: Array<Int>!, cells: Array<SurfaceCell>&, normals: Array<Double>&, a: Int, b: Int, step: Int) {
    fin u = cells[a].&
    fin v = cells[b].&
    if u.seam || v.seam || u.x/step != v.x/step || u.y/step != v.y/step || u.z/step != v.z/step then return
    fin x = a*3
    fin y = b*3
    fin agreement = normals[x]*normals[y]+normals[x+1]*normals[y+1]+normals[x+2]*normals[y+2]
    if agreement < 0.84 then return
    fin source = clusterRoot(parent,a)
    fin target = clusterRoot(parent,b)
    if source > target { parent[source] = target }
    else if target > source { parent[target] = source }
}

/** Contracts only adjacent vertices within a small volume and with similar normals. */
func reduceSurface(cells: Array<SurfaceCell>&, positions: Array<Double>&, normals: Array<Double>&,
                   triangles: Array<Int>&, step: Int, minimumError: Double): SurfaceDetail {
    fin size = cells.size
    var parents: Array<Int> = .() * size
    var vertex = 0
    while vertex < size {
        parents[vertex] = vertex
        vertex += 1
    }
    var index = 0
    while index < triangles.size {
        fin a = triangles[index]
        fin b = triangles[index+1]
        fin c = triangles[index+2]
        clusterEdge(parents,cells,normals,a,b,step)
        clusterEdge(parents,cells,normals,b,c,step)
        clusterEdge(parents,cells,normals,c,a,step)
        index += 3
    }
    var detail = SurfaceDetail(maxDeviation: minimumError)
    detail.positions = .() * positions.size
    detail.normals = .() * normals.size
    var members: Array<Int> = .() * size
    vertex = 0
    while vertex < size {
        fin root = clusterRoot(parents,vertex)
        parents[vertex] = root
        members[root] += 1
        var axis = 0
        while axis < 3 {
            detail.positions[root*3+axis] += positions[vertex*3+axis]
            detail.normals[root*3+axis] += normals[vertex*3+axis]
            axis += 1
        }
        vertex += 1
    }
    vertex = 0
    while vertex < size {
        if members[vertex] > 0 {
            fin count = members[vertex] as Double
            fin at = vertex*3
            detail.positions[at] /= count
            detail.positions[at+1] /= count
            detail.positions[at+2] /= count
            fin nx = detail.normals[at]
            fin ny = detail.normals[at+1]
            fin nz = detail.normals[at+2]
            fin size2 = sqrt(nx*nx+ny*ny+nz*nz)
            if size2 > 0.000001 {
                detail.normals[at] = nx/size2
                detail.normals[at+1] = ny/size2
                detail.normals[at+2] = nz/size2
            }
        }
        vertex += 1
    }
    // The error a contraction makes is how far each original vertex is from its
    // cluster's plane: sliding a vertex along a flat surface changes nothing on screen.
    vertex = 0
    while vertex < size {
        fin a = vertex*3
        fin b = parents[vertex]*3
        fin dx = positions[a]-detail.positions[b]
        fin dy = positions[a+1]-detail.positions[b+1]
        fin dz = positions[a+2]-detail.positions[b+2]
        fin across = magnitude(dx*detail.normals[b]+dy*detail.normals[b+1]+dz*detail.normals[b+2])
        detail.maxDeviation = higher(detail.maxDeviation,across)
        vertex += 1
    }
    index = 0
    while index < triangles.size {
        fin a = parents[triangles[index]]
        fin b = parents[triangles[index+1]]
        fin c = parents[triangles[index+2]]
        if a != b && a != c && b != c {
            detail.triangles.add(a)
            detail.triangles.add(b)
            detail.triangles.add(c)
        }
        index += 3
    }
    return take detail
}

pack SurfaceLevel {
    var vertices: Long
    var count: Int
    var deviation: Double
}

/** Owns the CPU vertices until a caller uploads or copies them. */
pack SurfaceChunk {
    var center: Point = .()
    var radius: Double = 0.0
    var levels: Array<SurfaceLevel> = []
}

impl SurfaceChunk {
    dtor .() {
        for level in self.levels { azFree(level.vertices) }
    }
}

func addSurfaceLevel(mesh: SurfaceChunk!, triangles: Array<Int>&, positions: Array<Double>&,
                     normals: Array<Double>&, deviation: Double): Bool {
    fin bytes = azAlloc((triangles.size as Long)*24)
    if bytes == 0 then return false
    var i = 0
    while i < triangles.size {
        fin v = triangles[i]*3
        fin at = (i as Long)*24
        azPokeF32(bytes,at,positions[v])
        azPokeF32(bytes,at+4,positions[v+1])
        azPokeF32(bytes,at+8,positions[v+2])
        azPokeF32(bytes,at+12,normals[v])
        azPokeF32(bytes,at+16,normals[v+1])
        azPokeF32(bytes,at+20,normals[v+2])
        i += 1
    }
    mesh.levels.add(SurfaceLevel(bytes,triangles.size,deviation))
    return true
}
