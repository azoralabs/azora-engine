module engine.material.fusion.metal

import std.traits
import std.string
import std.serializer
import engine.core
import engine.io
import engine.objc
import engine.objc.shader
import engine.material.fusion

pack FusionPipeline derives Clone {
    var handle: Long = 0
    var diagnostic: String = ""
    var albedo: Rgba = .(0.8, 0.8, 0.82, 1.0)
    var textures: Array<Long> = []
}

pack FusionPipelineEntry derives Clone {
    var key: String = ""
    var pipeline: FusionPipeline = .()
}

pack FusionLibrary {
    var root: String = "."
    var queue: Long = 0
    var items: Array<FusionPipelineEntry> = []
}

func metalError(address: Long, message: String): String {
    fin diagnostic = azPeek64(address, 0)
    return if diagnostic == 0 then message else nsStringText(send0(diagnostic, sel("localizedDescription")))
}

func fusionReadText(path: String, limit: Int = 262144): String {
    var blob = readFile(path)
    defer { blob.release() }
    return if blob.size > limit || !blob.ok() then "" else blob.text(0, blob.size)
}

func buildFusionPipeline(device: Long, compiled: String): FusionPipeline {
    if device == 0 then return .(diagnostic: "A Metal device is required")
    fin library = metalShaderLibrary(device, compiled)
    if library == 0 then return .(diagnostic: "Could not load ${compiled}")
    defer { send0(library, sel("release")) }
    fin vertex = send1(library, sel("newFunctionWithName:"), nsString("materialVertex"))
    fin fragment = send1(library, sel("newFunctionWithName:"), nsString("materialFragment"))
    defer {
        send0(vertex, sel("release"))
        send0(fragment, sel("release"))
    }
    if vertex == 0 || fragment == 0 then return .(diagnostic: "Material shader must define materialVertex and materialFragment")
    fin descriptor = newObject("MTLRenderPipelineDescriptor")
    defer { send0(descriptor, sel("release")) }
    send1(descriptor, sel("setVertexFunction:"), vertex)
    send1(descriptor, sel("setFragmentFunction:"), fragment)
    fin attachment = send1(send0(descriptor, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), 0)
    send1(attachment, sel("setPixelFormat:"), 80)
    send1(descriptor, sel("setDepthAttachmentPixelFormat:"), 252)
    fin diagnostic = azAlloc(8)
    if diagnostic == 0 then return .(diagnostic: "Could not allocate Metal diagnostic storage")
    defer { azFree(diagnostic) }
    azPoke64(diagnostic, 0, 0)
    fin pipeline = send2(device, sel("newRenderPipelineStateWithDescriptor:error:"), descriptor, diagnostic)
    return if pipeline == 0 then .(diagnostic: metalError(diagnostic, "Metal pipeline creation failed")) else .(handle: pipeline)
}

func loadMaterialBindings(path: String, root: String, device: Long, queue: Long, built: FusionPipeline!): String {
    fin text = fusionReadText(path, 32768)
    if text == "" then return ""
    fin manifest = decodeSerialValue(text, serializerOptions()) catch SerialValue.Null
    when manifest {
        .Object(fields) -> {
            fin colors = fusionMember(fields, "albedo")
            if colors >= 0 {
                when fields[colors].value {
                    .Array(values) -> {
                        if values.size == 3 {
                            fin red = serialAsReal(values[0]) catch 0.8
                            fin green = serialAsReal(values[1]) catch 0.8
                            fin blue = serialAsReal(values[2]) catch 0.82
                            built.albedo = .(red, green, blue, 1.0)
                        }
                    }
                    else -> {}
                }
            }
            fin sets = fusionMember(fields, "textures")
            if sets < 0 then return "Invalid material texture bindings"
            when fields[sets].value {
                .Array(values) -> {
                    if values.size > 8 then return "Too many material texture sets"
                    for index: Int in 0..<values.size {
                        fin asset = serialAsText(values[index]) catch ""
                        if !fusionTexturePath(asset) || !loadFusionTextureSet(device, queue, "${root}/${asset}", built.textures) then
                            return "Could not load ${asset}"
                    }
                }
                else -> return "Invalid material texture bindings"
            }
        }
        else -> return "Invalid material bindings: ${path}"
    }
    return ""
}

func releaseFusionPipeline(pipeline: FusionPipeline&) {
    for texture in pipeline.textures then send0(texture, sel("release"))
    if pipeline.handle != 0 then send0(pipeline.handle, sel("release"))
}

impl FusionLibrary {
    func &.index(key: String): Int {
        for i: Int in 0..<self.items.size {
            if self.items[i].key == key then return i
        }
        return -1
    }

    /** A failed shader or texture load leaves the previous pipeline active. */
    func !.reload(device: Long, path: String): FusionPipeline {
        if !fusionAssetPath(path) then return .(diagnostic: "Invalid material shader path")
        fin stem = substring(path, 0, stringLength(path) - 3)
        fin relative = "project/${stem}.metallib"
        // Studio uses the project's independent shader build. Packaged games
        // keep a copy next to the Engine's own shader libraries.
        fin projectLibrary = "${self.root}/.azora-build/shaders/${relative}"
        fin probe = fopen(projectLibrary, "rb")
        if probe != 0 then fclose(probe)
        fin compiled = if probe != 0 then projectLibrary else shaderFolder() + "/" + relative
        var built = buildFusionPipeline(device, compiled)
        if built.handle != 0 {
            built.diagnostic = loadMaterialBindings(compiled + ".bindings", self.root, device, self.queue, built)
            if built.diagnostic != "" {
                releaseFusionPipeline(built)
                built.handle = 0
                built.textures.clear()
            }
        }
        fin index = self.index(path)
        if index < 0 {
            fin entry: FusionPipelineEntry = .(path, built.clone())
            self.items.add(take entry)
        } else if built.handle != 0 {
            releaseFusionPipeline(self.items[index].pipeline)
            self.items[index].pipeline = built.clone()
        }
        return built
    }

    func !.resolve(device: Long, path: String): Long {
        fin index = self.index(path)
        if index >= 0 then return self.items[index].pipeline.handle
        return if fusionAssetPath(path) then self.reload(device, path).handle else 0
    }

    func !.reloadAll(device: Long) {
        for index: Int in 0..<self.items.size {
            fin path = self.items[index].key
            self.reload(device, path)
        }
    }

    func &.bindTextures(encoder: Long, pipeline: Long) {
        for item in self.items {
            if item.pipeline.handle == pipeline {
                for slot: Int in 0..<item.pipeline.textures.size {
                    send2(encoder, sel("setFragmentTexture:atIndex:"), item.pipeline.textures[slot], slot as Long)
                }
                return
            }
        }
    }

    func !.release() {
        for item in self.items then releaseFusionPipeline(item.pipeline)
        self.items.clear()
    }
}

/** AZTX: four-byte magic, little-endian width/height and three RGBA8 images. */
func loadFusionTextureSet(device: Long, queue: Long, path: String, handles: Array<Long>!): Bool {
    var blob = readFile(path)
    defer { blob.release() }
    if !blob.matches(0, "AZTX") || blob.size < 12 then return false
    fin width = blob.i32(4) as Long
    fin height = blob.i32(8) as Long
    if width < 1 || height < 1 || width > 4096 || height > 4096 then return false
    fin imageBytes = width * height * 4
    if (blob.size as Long) != 12 + imageBytes * 3 then return false
    fin descriptor = send4TextureDescriptor(70, width, height, if queue != 0 then 1 else 0)
    fin from = handles.size
    for i: Int in 0..<3 {
        fin texture = send1(device, sel("newTextureWithDescriptor:"), descriptor)
        if texture == 0 then return false
        azSendRegion(texture, sel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"),
            0, 0, 0, width, height, 1, 0, blob.data + 12 + (i as Long)*imageBytes, width*4)
        handles.add(texture)
    }
    if queue != 0 {
        fin command = send0(queue, sel("commandBuffer"))
        fin blit = send0(command, sel("blitCommandEncoder"))
        for i: Int in from..<handles.size then send1(blit, sel("generateMipmapsForTexture:"), handles[i])
        send0(blit, sel("endEncoding"))
        send0(command, sel("commit"))
        send0(command, sel("waitUntilCompleted"))
    }
    return true
}

func send4TextureDescriptor(format: Long, width: Long, height: Long, mip: Long): Long {
    fin descriptor = send0(cls("MTLTextureDescriptor"), sel("new"))
    send1(descriptor, sel("setPixelFormat:"), format)
    send1(descriptor, sel("setWidth:"), width)
    send1(descriptor, sel("setHeight:"), height)
    if mip != 0 {
        var size = if width > height then width else height
        var levels: Long = 1
        while size > 1 {
            size /= 2
            levels++
        }
        send1(descriptor, sel("setMipmapLevelCount:"), levels)
    }
    return send0(descriptor, sel("autorelease"))
}
