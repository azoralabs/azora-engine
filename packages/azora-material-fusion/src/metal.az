module engine.material.fusion.metal

import std.traits
import engine.core
import engine.io
import engine.objc
import engine.material.fusion
import engine.material.fusion.compiler

pack FusionPipeline derives Clone {
    var handle: Long = 0
    var metal: Int = 0
    var baked: Bool = false
    var diagnostic: String = ""
    var albedo: Rgba = .(0.8, 0.8, 0.82, 1.0)
    var textures: Array<Long> = []
}

pack FusionPipelineEntry derives Clone {
    var key: String = ""
    var pipeline: FusionPipeline = .()
}

pack FusionLibrary {
    var root: String = "."
    var queue: Long = 0
    var items: Array<FusionPipelineEntry> = []
}

func metalError(address: Long, message: String): String {
    fin diagnostic = azPeek64(address, 0)
    if diagnostic == 0 then return message
    fin text = "${nsStringText(send0(diagnostic, sel("localizedDescription")))} "
    return substring(text, 0, stringLength(text) - 1)
}

func fusionReadText(path: String, limit: Int = 262144): String {
    var blob = readFile(path)
    defer { blob.release() }
    if blob.size > limit || !blob.ok() then return ""
    return blob.text(0, blob.size)
}

func buildFusionPipeline(device: Long, source: String, standard: Int, compiled: String): FusionPipeline {
    fin diagnostic = azAlloc(8)
    if diagnostic == 0 then return FusionPipeline(0, standard, false, "Could not allocate Metal diagnostic storage")
    defer { azFree(diagnostic) }
    azPoke64(diagnostic, 0, 0)
    var library: Long = 0
    if compiled != "" {
        fin url = send1(cls("NSURL"), sel("fileURLWithPath:"), nsString(compiled))
        library = send2(device, sel("newLibraryWithURL:error:"), url, diagnostic)
    }
    fin baked = library != 0
    if library == 0 {
        fin options = newObject("MTLCompileOptions")
        defer { send0(options, sel("release")) }
        send1(options, sel("setLanguageVersion:"), (standard as Long) * 65536)
        azPoke64(diagnostic, 0, 0)
        library = send3(device, sel("newLibraryWithSource:options:error:"), nsString(source), options, diagnostic)
        if library == 0 then return FusionPipeline(0, standard, false, metalError(diagnostic, "Metal library compilation failed"))
    }
    defer { send0(library, sel("release")) }
    fin vertex = send1(library, sel("newFunctionWithName:"), nsString("fusion_vertex"))
    fin fragment = send1(library, sel("newFunctionWithName:"), nsString("fusion_fragment"))
    defer { send0(vertex, sel("release"))
        send0(fragment, sel("release")) }
    if vertex == 0 || fragment == 0 then return FusionPipeline(0, standard, baked, "Material Fusion shader entry points are missing")
    fin descriptor = newObject("MTLRenderPipelineDescriptor")
    defer { send0(descriptor, sel("release")) }
    send1(descriptor, sel("setVertexFunction:"), vertex)
    send1(descriptor, sel("setFragmentFunction:"), fragment)
    fin attachment = send1(send0(descriptor, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), 0)
    send1(attachment, sel("setPixelFormat:"), 80)
    send1(descriptor, sel("setDepthAttachmentPixelFormat:"), 252)
    azPoke64(diagnostic, 0, 0)
    fin pipeline = send2(device, sel("newRenderPipelineStateWithDescriptor:error:"), descriptor, diagnostic)
    if pipeline == 0 then return FusionPipeline(0, standard, baked, metalError(diagnostic, "Metal pipeline creation failed"))
    return FusionPipeline(pipeline, standard, baked, "")
}

/** Prepares once per asset or edit. Falls back to MSL 2.0 on Metal 2 devices or a failed Metal 3 pipeline. */
func precompileFusion(device: Long, program: FusionProgram&, cache: String = ""): FusionPipeline {
    if program.diagnostic != "" then return FusionPipeline(0, 0, false, program.diagnostic)
    if device == 0 then return FusionPipeline(0, 0, false, "A Metal device is required")
    fin output = if cache == "" then "" else "${cache}.${fusionSourceKey(program.source)}"
    fin validCache = output != "" && fusionReadText("${output}.metal") == program.source
    fin supportsFamilies = send1(device, sel("respondsToSelector:"), sel("supportsFamily:")) != 0
    if supportsFamilies && send1(device, sel("supportsFamily:"), 5001) != 0 {
        fin modern = buildFusionPipeline(device, program.source, 3, if validCache then "${output}.metal3.metallib" else "")
        if modern.handle != 0 then return modern
        fin classic = buildFusionPipeline(device, program.source, 2, if validCache then "${output}.metal2.metallib" else "")
        if classic.handle != 0 then return classic
        return FusionPipeline(0, 2, false, "Metal 3: ${modern.diagnostic}
Metal 2: ${classic.diagnostic}")
    }
    return buildFusionPipeline(device, program.source, 2, if validCache then "${output}.metal2.metallib" else "")
}

impl FusionLibrary {
    func &.index(key: String): Int {
        var index = 0
        while index < self.items.size {
            if self.items[index].key == key then return index
            index = index + 1
        }
        return -1
    }

    /** Keeps the last valid pipeline when rebuilding an edited asset fails. */
    func !.replace(device: Long, key: String, document: FusionGraph&, cache: String = ""): FusionPipeline {
        fin program = compileFusionGraph(document)
        var built = precompileFusion(device, program, cache)
        built.albedo = program.albedo
        if built.handle != 0 {
            for asset in program.textureSets {
                if !loadFusionTextureSet(device, self.queue, "${self.root}/${asset}", built.textures) {
                    send0(built.handle, sel("release"))
                    built.handle = 0
                    for texture in built.textures { send0(texture, sel("release")) }
                    built.textures.clear()
                    built.diagnostic = "Could not load ${asset}"
                    break
                }
            }
        }
        fin index = self.index(key)
        if index < 0 {
            self.items.add(FusionPipelineEntry(key, built.clone()))
        } else if built.handle != 0 {
            fin old = self.items[index].pipeline.handle
            for texture in self.items[index].pipeline.textures { send0(texture, sel("release")) }
            self.items[index].pipeline = built.clone()
            if old != 0 then send0(old, sel("release"))
        }
        return built
    }

    func !.reload(device: Long, path: String): FusionPipeline {
        if !fusionAssetPath(path) then return FusionPipeline(0, 0, false, "Invalid Material Fusion asset path")
        fin document = readFusionGraph(fusionReadText("${self.root}/${path}"))
        return self.replace(device, path, document, "${self.root}/.azora-build/fusion/${path}")
    }

    func !.resolve(device: Long, path: String): Long {
        if !fusionAssetPath(path) then return 0
        fin index = self.index(path)
        if index >= 0 then return self.items[index].pipeline.handle
        return self.reload(device, path).handle
    }

    func &.bindTextures(encoder: Long, pipeline: Long) {
        for item in self.items {
            if item.pipeline.handle == pipeline {
                var slot = 0
                while slot < item.pipeline.textures.size {
                    send2(encoder, sel("setFragmentTexture:atIndex:"), item.pipeline.textures[slot], slot as Long)
                    slot += 1
                }
                return
            }
        }
    }

    func !.release() {
        var index = 0
        while index < self.items.size {
            fin handle = self.items[index].pipeline.handle
            for texture in self.items[index].pipeline.textures { send0(texture, sel("release")) }
            if handle != 0 then send0(handle, sel("release"))
            index = index + 1
        }
        self.items.clear()
    }
}

/** AZTX: four-byte magic, little-endian width/height and three RGBA8 images. */
func loadFusionTextureSet(device: Long, queue: Long, path: String, handles: Array<Long>!): Bool {
    var blob = readFile(path)
    defer { blob.release() }
    if !blob.matches(0, "AZTX") || blob.size < 12 then return false
    fin width = blob.i32(4) as Long
    fin height = blob.i32(8) as Long
    if width < 1 || height < 1 || width > 4096 || height > 4096 then return false
    fin imageBytes = width * height * 4
    if (blob.size as Long) != 12 + imageBytes * 3 then return false
    fin descriptor = send4TextureDescriptor(70, width, height, if queue != 0 then 1 else 0)
    fin from = handles.size
    var i = 0
    while i < 3 {
        fin texture = send1(device, sel("newTextureWithDescriptor:"), descriptor)
        if texture == 0 then return false
        azSendRegion(texture, sel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"),
            0, 0, 0, width, height, 1, 0, blob.data + 12 + (i as Long)*imageBytes, width*4)
        handles.add(texture)
        i += 1
    }
    if queue != 0 {
        fin command = send0(queue, sel("commandBuffer"))
        fin blit = send0(command, sel("blitCommandEncoder"))
        i = from
        while i < handles.size {
            send1(blit, sel("generateMipmapsForTexture:"), handles[i])
            i += 1
        }
        send0(blit, sel("endEncoding"))
        send0(command, sel("commit"))
        send0(command, sel("waitUntilCompleted"))
    }
    return true
}

func send4TextureDescriptor(format: Long, width: Long, height: Long, mip: Long): Long {
    fin descriptor = send0(cls("MTLTextureDescriptor"), sel("new"))
    send1(descriptor, sel("setPixelFormat:"), format)
    send1(descriptor, sel("setWidth:"), width)
    send1(descriptor, sel("setHeight:"), height)
    if mip != 0 {
        var size = if width > height then width else height
        var levels: Long = 1
        while size > 1 {
            size /= 2
            levels += 1
        }
        send1(descriptor, sel("setMipmapLevelCount:"), levels)
    }
    return send0(descriptor, sel("autorelease"))
}
