import std.io
import std.os::{envVar}
import engine.material.fusion
import engine.material.fusion.compiler
import engine.material.fusion.metal

func main() {
    fin path = envVar("AZORA_FUSION_ASSET")
    fin document = readFusionGraph(fusionReadText(path))
    fin program = compileFusionGraph(document)
    assert program.diagnostic == "" panic program.diagnostic
    println("${fusionSourceKey(program.source)}")
    print(program.source)
}
