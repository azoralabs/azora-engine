module engine.atmosphere.celestial

import std.math
import engine.core
import engine.math
import engine.atmosphere.components

/** Radians in one degree. */
inline fin perDegree: Double = 0.017453292519943295

/**
 * Where the sun and moon stand in the sky over the scene, as unit vectors in
 * the world: x east, y up, z south (the Engine's -Z is north).
 */
pack Celestial derives Clone {
    var sun: Vec3 = .(0.0, 1.0, 0.0)
    var moon: Vec3 = .(0.0, -1.0, 0.0)
    /** 0 new, 0.25 first quarter, 0.5 full, 0.75 last quarter. */
    var moonPhase: Double = 0.0
    /** Share of the moon's disc the sun lights, 0..1. */
    var moonLit: Double = 0.0
    /** Local clock time, 0..24. */
    var hour: Double = 12.0
    /** The observer's sidereal angle and latitude, in radians: how the celestial sphere is turned over the scene. */
    var sidereal: Double = 0.0
    var latitude: Double = 0.0
}

func celestialClamp(x: Double, low: Double, high: Double): Double = if x < low then low else if x > high then high else x

/** [angle] in degrees, brought into 0..<360. */
func wrapDegrees(angle: Double): Double = angle - (floor(angle / 360.0) as Double) * 360.0

/** Julian day at 0h UT of a Gregorian calendar date (Meeus, Astronomical Algorithms 7.1). */
func julianDay(year: Int, month: Int, day: Int): Double {
    var y: Int = year
    var m: Int = month
    if m <= 2 {
        y--
        m += 12
    }
    fin century: Int = y / 100
    fin leap: Int = 2 - century + century / 4
    return (floor(365.25 * ((y + 4716) as Double)) as Double) +
        (floor(30.6001 * ((m + 1) as Double)) as Double) +
        (day as Double) + (leap as Double) - 1524.5
}

/** Local clock hours since the scene's date began: the set hour plus the running day. */
func runningHour(sky: AetherSky&, elapsed: Double): Double {
    return sky.hour + (if sky.advanceTime then elapsed * sky.timeMultiplier / 3600.0 else 0.0)
}

/** [runningHour] rounded down to a whole minute: what the Photon Field traces with, so it moves in steps. */
func steppedHour(sky: AetherSky&, elapsed: Double): Double = (floor(runningHour(sky, elapsed) * 60.0) as Double) / 60.0

/**
 * The world direction of a body at [ascension] and [declination] (radians)
 * for an observer at [latitude] whose local sidereal angle is [sidereal].
 */
func horizonVector(ascension: Double, declination: Double, sidereal: Double, latitude: Double): Vec3 {
    fin hourAngle: Double = sidereal - ascension
    fin east: Double = -cos(declination) * sin(hourAngle)
    fin north: Double = cos(latitude) * sin(declination) - sin(latitude) * cos(declination) * cos(hourAngle)
    fin up: Double = sin(latitude) * sin(declination) + cos(latitude) * cos(declination) * cos(hourAngle)
    return .(east, up, -north)
}

func celestialAt(sky: AetherSky&, elapsed: Double): Celestial = celestialAtHour(sky, runningHour(sky, elapsed))

/** The sun uses the scene's local clock; the moon uses its authored world direction. */
func celestialAtHour(sky: AetherSky&, hour: Double): Celestial {
    fin jd: Double = julianDay(sky.year, sky.month, sky.day) + (hour - sky.timeZone) / 24.0
    fin t = (jd - 2451545.0) / 36525.0
    fin meanLongitude: Double = wrapDegrees(280.46646 + t * (36000.76983 + t * 0.0003032))
    fin anomaly: Double = wrapDegrees(357.52911 + t * (35999.05029 - 0.0001537 * t)) * perDegree
    fin centre: Double = sin(anomaly) * (1.914602 - t * (0.004817 + 0.000014 * t)) + sin(2.0 * anomaly) * (0.019993 - 0.000101 * t) +
        sin(3.0 * anomaly) * 0.000289
    fin node: Double = wrapDegrees(125.04 - 1934.136 * t) * perDegree
    fin sunLongitude = (meanLongitude + centre - 0.00569 - 0.00478 * sin(node)) * perDegree
    fin obliquity = (23.0 + (26.0 + (21.448 - t * (46.815 + t * (0.00059 - t * 0.001813))) / 60.0) / 60.0 + 0.00256 * cos(node)) * perDegree
    fin sunAscension: Double = atan2(cos(obliquity) * sin(sunLongitude), cos(sunLongitude))
    fin sunDeclination: Double = asin(sin(obliquity) * sin(sunLongitude))
    fin days = jd - 2451545.0
    fin sidereal: Double = wrapDegrees(280.46061837 + 360.98564736629 * days + 0.000387933 * t * t - t * t * t / 38710000.0 + sky.longitude) * perDegree
    fin latitude: Double = celestialClamp(sky.latitude, -90.0, 90.0) * perDegree

    fin sun = horizonVector(sunAscension, sunDeclination, sidereal, latitude)
    fin azimuth = wrapDegrees(sky.moonAzimuth) * perDegree
    fin elevation = celestialClamp(sky.moonElevation, -90.0, 90.0) * perDegree
    fin moon: Vec3 = .(sin(azimuth) * cos(elevation), sin(elevation), -cos(azimuth) * cos(elevation))
    fin alignment = celestialClamp(sun.dot(moon), -1.0, 1.0)
    fin phase = acos(alignment) / (360.0 * perDegree)
    return .(
        sun.clone()
        moon.clone()
        if sun.x * moon.z - sun.z * moon.x < 0.0 then 1.0 - phase else phase
        (1.0 - alignment) * 0.5
        wrapDegrees(hour * 15.0) / 15.0
        sidereal
        latitude
    )
}
