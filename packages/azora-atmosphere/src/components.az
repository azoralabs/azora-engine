module engine.atmosphere.components

import std.traits
import engine.core
import engine.ecs
import engine.scene
import engine.scene.transforms

/**
 * The sky over the scene: where and when it is, how fast the day runs, and
 * the atmosphere the sun and moon shine through. One "Aether Sphere" entity
 * carries it, with its `Light3d` (the sun and moon's shadows) and `PhotonField`.
 */
@Component
@Inspectable(title: "Atmosphere", serializedName: "AetherSky", icon: "sun", category: "Atmosphere", order: 30)
pack AetherSky derives Clone {
    var enabled: Bool = true
    /** Local clock time, in hours. */
    @Range(min: 0.0, max: 24.0, step: 0.05)
    var hour: Double = 14.0
    @Hidden
    var day: Int = 21
    @Hidden
    var month: Int = 7
    @Hidden
    var year: Int = 2026
    @Hidden
    var latitude: Double = 46.54
    /** Degrees east of Greenwich. */
    @Hidden
    var longitude: Double = 11.85
    /** Hours the local clock runs ahead of UTC. */
    @Hidden
    var timeZone: Double = 2.0
    /** Used only to migrate scenes saved with the previous clock setting. */
    @Hidden
    var dayMinutes: Double = 0.0
    var advanceTime: Bool = false
    /** Simulated seconds per real second. */
    @Range(min: 0.01, max: 86400.0, step: 1.0)
    var timeMultiplier: Double = 60.0
    /** The ground under the world origin, in metres above the sea: where the camera breathes the air from. */
    @Range(min: 0.0, max: 8000.0, step: 10.0)
    var altitude: Double = 1500.0
    @Range(min: 0.0, max: 8.0, step: 0.05)
    var sunIntensity: Double = 2.4
    /** Diameter of the visible solar disc, in degrees. */
    @Range(min: 0.05, max: 20.0, step: 0.05)
    var sunDiameter: Double = 1.6
    var moonVisible: Bool = true
    var dayMoon: Bool = true
    /** Compass bearing in degrees, with north along world -Z. */
    @Range(min: 0.0, max: 360.0, step: 1.0)
    var moonAzimuth: Double = 70.0
    /** Degrees above the horizon. Negative values place the moon below it. */
    @Range(min: -90.0, max: 90.0, step: 1.0)
    var moonElevation: Double = 25.0
    @Range(min: 0.0, max: 2.0, step: 0.01)
    var moonIntensity: Double = 0.24
    /** Multipliers of the air's molecules, its haze and its ozone (1 = Earth's). */
    @Range(min: 0.0, max: 4.0, step: 0.05)
    var rayleigh: Double = 1.0
    @Range(min: 0.0, max: 10.0, step: 0.05)
    var mie: Double = 1.0
    @Range(min: 0.0, max: 4.0, step: 0.05)
    var ozone: Double = 1.0
    @Range(min: 0.0, max: 1.0, step: 0.01)
    var groundAlbedo: Double = 0.3
    @Range(min: 0.0, max: 4.0, step: 0.05)
    var stars: Double = 1.0
    @Range(min: 0.1, max: 8.0, step: 0.05)
    var exposure: Double = 1.0
}

/** Converts the old day length to simulated seconds per second when a scene opens. */
func migrateAtmosphereClocks(world: World!) {
    let skies = ensureStorage<AetherSky>(world)
    for i: Int in 0..<storageLength<AetherSky>(skies) {
        let sky: AetherSky! = skies.values[i]
        if sky.dayMinutes <= 0.0 then continue
        if !sky.advanceTime {
            sky.advanceTime = true
            sky.timeMultiplier = 1440.0 / sky.dayMinutes
        }
        sky.dayMinutes = 0.0
    }
}

/**
 * The cloud layer, set by hand: how much of the sky it covers, what kind of
 * cloud, where and how dense. The rest of the weather leaves it as it is;
 * the scene's Wind carries it along. It works wherever it is in the scene.
 */
@Component
@Inspectable(title: "Volumetric Clouds", serializedName: "AetherClouds", icon: "cloud", category: "Weather", order: 31)
pack AetherClouds derives Clone {
    var enabled: Bool = true
    /** Share of the sky under cloud. */
    @Range(min: 0.0, max: 1.0, step: 0.01)
    var coverage: Double = 0.45
    /** 0 flat stratus, 0.5 cumulus, 1 towering cumulonimbus. */
    @Range(min: 0.0, max: 1.0, step: 0.01)
    var cloudType: Double = 0.5
    /** Bottom of the layer above the world origin, and its depth, in metres. */
    @Range(min: 200.0, max: 8000.0, step: 10.0)
    var baseAltitude: Double = 1400.0
    @Range(min: 200.0, max: 8000.0, step: 10.0)
    var thickness: Double = 2600.0
    @Range(min: 0.0, max: 4.0, step: 0.05)
    var density: Double = 1.0
    @Range(min: 0.0, max: 2.0, step: 0.05)
    var detail: Double = 1.0
    @Range(min: 0.0, max: 1.0, step: 0.01)
    var shadowStrength: Double = 0.85
    /** 0 low, 1 medium, 2 high: ray-march steps. */
    @Range(min: 0.0, max: 2.0, step: 1.0)
    var quality: Int = 1
}


/**
 * What the weather gives the rendered atmosphere: how far the clouds have
 * drifted, the air's haze (and how much of it is dust, of [dustColor]), the
 * lightning's flash, the ground's wetness and snow, the wind. Defaults are
 * still, clear air.
 */
@Component
pack AtmosphereConditions derives Clone {
    var driftX: Double = 0.0
    var driftZ: Double = 0.0
    var fogDensity: Double = 0.0
    var fogFalloff: Double = 0.0
    var flash: Double = 0.0
    var flashX: Double = 0.0
    var flashZ: Double = 0.0
    var wetness: Double = 0.0
    var snow: Double = 0.0
    var windX: Double = 0.0
    var windZ: Double = 0.0
    /** The share of the haze that is dust, and its colour. */
    var dust: Double = 0.0
    var dustColor: Rgba = .(0.74, 0.6, 0.42, 1.0)
}

/** The scene's cloud layer: its first enabled, shown Volumetric Clouds, or none (switched off). */
func sceneClouds(world: World!): AetherClouds {
    fin layers = ensureStorage<AetherClouds>(world)
    for i: Int in 0..<storageLength<AetherClouds>(layers) {
        fin entity = storageEntityAt<AetherClouds>(layers, i)
        if layers.values[i].enabled && world.isAlive(entity) && visibleInWorld(world, entity) then return layers.values[i].clone()
    }
    return .(enabled: false)
}

func atmosphereEntity(world: World!): Entity {
    fin skies = ensureStorage<AetherSky>(world)
    return for i: Int in 0..<storageLength<AetherSky>(skies) {
        fin owner = storageEntityAt<AetherSky>(skies, i)
        if world.isAlive(owner) && skies.values[i].enabled && visibleInWorld(world, owner) then break owner
    } else Entity(-1, 0)
}
