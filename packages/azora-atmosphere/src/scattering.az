module engine.atmosphere.scattering

import std.math
import engine.core
import engine.math
import engine.atmosphere.components

// A physically based atmosphere after Hillaire, "A Scalable and Production
// Ready Sky and Atmosphere Rendering Technique" (EGSR 2020): a transmittance
// table and a multiple-scattering table made when the air changes, a sky-view
// table and an aerial-perspective volume made each frame. Distances are in
// kilometres, the planet's centre is at the origin and the camera sits on its
// +Y axis.

/** The planet's radius and the top of its air, in kilometres. */
inline fin groundRadius: Double = 6360.0
inline fin airRadius: Double = 6460.0

/** How the sky's light becomes a display value: `1 - exp(-L·k)` with this `k` at exposure 1. */
inline fin skyExposure: Double = 11.0

/** Kilometres the aerial-perspective volume reaches from the camera. */
inline fin aerialReach: Double = 8.0

func atmosphereClamp(x: Double, low: Double, high: Double): Double = if x < low then low else if x > high then high else x

/** Kilometres from the camera at [origin] (on the +Y axis, [radius] from the centre) to sphere [sphere] along [mu] (cosine from up); -1 when missed. */
func sphereDistance(radius: Double, mu: Double, sphere: Double): Double {
    fin b = radius * mu
    fin c = radius * radius - sphere * sphere
    fin disc = b * b - c
    if disc < 0.0 then return -1.0
    fin root = sqrt(disc)
    fin near = -b - root
    fin far = -b + root
    return if near >= 0.0 then near else if far >= 0.0 then far else -1.0
}

/**
 * The share of sunlight in each colour that reaches a point [altitude] metres
 * above the sea through the air toward [direction] - what the scene's direct
 * light is, before clouds. Zero once the planet is in the way.
 */
func sunTransmittance(sky: AetherSky&, altitude: Double, direction: Vec3&): Vec3 {
    fin radius = groundRadius + atmosphereClamp(altitude, 0.0, 90000.0) / 1000.0
    fin mu = atmosphereClamp(direction.y, -1.0, 1.0)
    if sphereDistance(radius, mu, groundRadius) > 0.0 then return Vec3(0.0, 0.0, 0.0)
    fin span = sphereDistance(radius, mu, airRadius)
    if span <= 0.0 then return Vec3(1.0, 1.0, 1.0)
    fin steps = 32
    fin dt = span / (steps as Double)
    var red: Double = 0.0
    var green: Double = 0.0
    var blue: Double = 0.0
    for i: Int in 0..<steps {
        fin t = ((i as Double) + 0.5) * dt
        fin x = t * sqrt(atmosphereClamp(1.0 - mu * mu, 0.0, 1.0))
        fin y = radius + t * mu
        fin h = sqrt(x * x + y * y) - groundRadius
        fin rayleigh = exp(-h / 8.0) * sky.rayleigh
        fin mie = exp(-h / 1.2) * sky.mie * 4.40e-3
        fin ozone = atmosphereClamp(1.0 - absValue(h - 25.0) / 15.0, 0.0, 1.0) * sky.ozone
        red += (rayleigh * 5.802e-3 + mie + ozone * 0.650e-3) * dt
        green += (rayleigh * 13.558e-3 + mie + ozone * 1.881e-3) * dt
        blue += (rayleigh * 33.1e-3 + mie + ozone * 0.085e-3) * dt
    }
    return .(exp(-red), exp(-green), exp(-blue))
}

/** Metal source of every sky pass: the tables, the sky itself, the aerial volume and its application to the scene. */
func atmosphereMetalSource(): String = "#include <metal_stdlib>
using namespace metal;
constant float Rg = 6360.0;
constant float Rt = 6460.0;
constant float PI = 3.14159265;

struct AetherU {
    float4 sun;      // toward the sun, its light
    float4 moon;     // toward the moon, its light
    float4 camera;   // eye in world metres, camera radius in km
    float4 air;      // Rayleigh, Mie, ozone, ground albedo
    float4 screen;   // tan(fov/2)*aspect, tan(fov/2), exposure, stars
    float4 forward;
    float4 right;
    float4 up;
    float4 moonInfo; // lit fraction, phase, disc brightness, daylight
    float4 fog;      // density /km at its base, base height km (world), falloff /km, ambient
    float4 time;     // seconds, aerial reach km, scene width, scene height
    float4x4 inverse;
    float4 sky0;     // rows of the turn from the celestial sphere to the world
    float4 sky1;
    float4 sky2;
    float4 cloud;    // sky cover 0..1, sun reaching the fog, unused, unused
    float4 cloudShape; // base m, top m, coverage, type
    float4 cloudMore;  // density, detail, drift X m, drift Z m
    float4 cloudMarch; // steps, frame, cloud target width, height
    float4x4 previous; // last frame's clip transform
    float4 flash;      // flash position (world m) and strength
    float4 shadow;     // shadow map centre X, Z, side m, strength
    float4 dust;       // dust colour, share of the haze that is dust
};

struct Medium { float3 rayleigh; float mie; float3 extinction; };

Medium mediumAt(float h, constant AetherU& u) {
    float rd = exp(-h / 8.0), md = exp(-h / 1.2), od = max(0.0, 1.0 - abs(h - 25.0) / 15.0);
    Medium m;
    m.rayleigh = float3(5.802, 13.558, 33.1) * 1e-3 * rd * u.air.x;
    m.mie = 3.996e-3 * md * u.air.y;
    m.extinction = m.rayleigh + 4.40e-3 * md * u.air.y + float3(0.650, 1.881, 0.085) * 1e-3 * od * u.air.z;
    return m;
}

float sphereHit(float3 o, float3 d, float R) {
    float b = dot(o, d), c = dot(o, o) - R * R, disc = b * b - c;
    if (disc < 0.0) return -1.0;
    float s = sqrt(disc), t0 = -b - s, t1 = -b + s;
    return t0 >= 0.0 ? t0 : (t1 >= 0.0 ? t1 : -1.0);
}

float rayleighPhase(float c) { return 3.0 / (16.0 * PI) * (1.0 + c * c); }
float miePhase(float c, float g) {
    float k = 3.0 / (8.0 * PI) * (1.0 - g * g) / (2.0 + g * g);
    return k * (1.0 + c * c) / pow(max(1.0 + g * g - 2.0 * g * c, 1e-4), 1.5);
}

float2 transmittanceUV(float r, float mu) {
    float H = sqrt(Rt * Rt - Rg * Rg), rho = sqrt(max(r * r - Rg * Rg, 0.0));
    float d = max(0.0, -r * mu + sqrt(max(r * r * (mu * mu - 1.0) + Rt * Rt, 0.0)));
    float dmin = Rt - r, dmax = rho + H;
    return float2((d - dmin) / max(dmax - dmin, 1e-4), rho / H);
}

float3 transmittanceTo(texture2d<float> table, float r, float mu) {
    constexpr sampler s(filter::linear, address::clamp_to_edge);
    return table.sample(s, transmittanceUV(r, mu)).rgb;
}

/** Sunlight reaching a point at radius r toward cosine mu, nothing where the planet is in the way. */
float3 lightAt(texture2d<float> table, float r, float mu) {
    float horizon = -sqrt(max(1.0 - (Rg / r) * (Rg / r), 0.0));
    return mu < horizon ? float3(0.0) : transmittanceTo(table, r, mu);
}

float3 multipleAt(texture2d<float> table, float r, float mu) {
    constexpr sampler s(filter::linear, address::clamp_to_edge);
    return table.sample(s, float2(mu * 0.5 + 0.5, saturate((r - Rg) / (Rt - Rg)))).rgb;
}

struct FullOut { float4 pos [[position]]; float2 uv; float2 ndc; };

vertex FullOut aether_full(uint vid [[vertex_id]]) {
    float2 p = float2(vid == 1 ? 3.0 : -1.0, vid == 2 ? 3.0 : -1.0);
    FullOut o;
    o.pos = float4(p, 0.0, 1.0);
    o.uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
    o.ndc = p;
    return o;
}

vertex FullOut aether_sky_quad(uint vid [[vertex_id]], constant float4& rect [[buffer(0)]]) {
    const float2 points[6] = {float2(-1,-1),float2(1,-1),float2(1,1),float2(-1,-1),float2(1,1),float2(-1,1)};
    float2 p = points[vid];
    FullOut o;
    o.pos = float4(p * rect.xy + rect.zw, 0.0, 1.0);
    o.uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
    o.ndc = p;
    return o;
}

fragment float4 aether_transmittance(FullOut in [[stage_in]], constant AetherU& u [[buffer(0)]]) {
    float H = sqrt(Rt * Rt - Rg * Rg), rho = H * in.uv.y, r = sqrt(rho * rho + Rg * Rg);
    float dmin = Rt - r, dmax = rho + H, d = dmin + in.uv.x * (dmax - dmin);
    float mu = d <= 0.0 ? 1.0 : clamp((H * H - rho * rho - d * d) / (2.0 * r * d), -1.0, 1.0);
    float3 o = float3(0.0, r, 0.0), dir = float3(sqrt(max(1.0 - mu * mu, 0.0)), mu, 0.0);
    float span = max(sphereHit(o, dir, Rt), 0.0);
    float3 depth = 0.0;
    float dt = span / 40.0;
    for (int i = 0; i < 40; i++) {
        float3 p = o + dir * ((float(i) + 0.5) * dt);
        depth += mediumAt(length(p) - Rg, u).extinction * dt;
    }
    return float4(exp(-depth), 1.0);
}

/** Second-order light and the share scattered on, for a sun at uv.x and a height at uv.y; their series is what one more bounce adds forever. */
fragment float4 aether_multiple(FullOut in [[stage_in]], constant AetherU& u [[buffer(0)]], texture2d<float> transmittance [[texture(0)]]) {
    float cosSun = in.uv.x * 2.0 - 1.0;
    float r = Rg + mix(0.01, Rt - Rg - 0.01, in.uv.y);
    float3 o = float3(0.0, r, 0.0), sun = float3(sqrt(max(1.0 - cosSun * cosSun, 0.0)), cosSun, 0.0);
    float3 total = 0.0, transfer = 0.0;
    for (int i = 0; i < 8; i++) {
        for (int j = 0; j < 8; j++) {
            float c = 1.0 - 2.0 * (float(j) + 0.5) / 8.0, s = sqrt(max(1.0 - c * c, 0.0));
            float phi = 2.0 * PI * (float(i) + 0.5) / 8.0;
            float3 dir = float3(s * cos(phi), c, s * sin(phi));
            float ground = sphereHit(o, dir, Rg), top = sphereHit(o, dir, Rt);
            float end = ground > 0.0 ? ground : top;
            float dt = max(end, 0.0) / 20.0;
            float3 through = 1.0;
            for (int k = 0; k < 20; k++) {
                float3 p = o + dir * ((float(k) + 0.5) * dt);
                float pr = length(p);
                Medium m = mediumAt(pr - Rg, u);
                float3 scattering = m.rayleigh + m.mie;
                float3 fade = exp(-m.extinction * dt);
                float3 lit = lightAt(transmittance, pr, dot(p, sun) / pr) * scattering / (4.0 * PI);
                float3 share = (1.0 - fade) / max(m.extinction, 1e-6);
                total += through * lit * share;
                transfer += through * scattering * share;
                through *= fade;
            }
            if (ground > 0.0) {
                float3 p = o + dir * ground, n = normalize(p);
                total += through * lightAt(transmittance, Rg, dot(n, sun)) * saturate(dot(n, sun)) * u.air.w / PI;
            }
        }
    }
    total /= 64.0;
    transfer /= 64.0;
    return float4(total / max(1.0 - transfer, 1e-3), 1.0);
}

float3 skyViewDirection(float2 uv, float r) {
    float horizon = sqrt(max(r * r - Rg * Rg, 0.0)), beta = acos(clamp(horizon / r, -1.0, 1.0)), zenithHorizon = PI - beta;
    float zenith;
    if (uv.y < 0.5) { float c = 1.0 - 2.0 * uv.y; zenith = zenithHorizon * (1.0 - c * c); }
    else { float c = uv.y * 2.0 - 1.0; zenith = zenithHorizon + beta * c * c; }
    float azimuth = (uv.x - 0.5) * 2.0 * PI, s = sin(zenith);
    return float3(s * cos(azimuth), cos(zenith), s * sin(azimuth));
}

float2 skyViewUV(float3 d, float r) {
    float horizon = sqrt(max(r * r - Rg * Rg, 0.0)), beta = acos(clamp(horizon / r, -1.0, 1.0)), zenithHorizon = PI - beta;
    float zenith = acos(clamp(d.y, -1.0, 1.0)), v;
    if (zenith < zenithHorizon) v = (1.0 - sqrt(max(1.0 - zenith / zenithHorizon, 0.0))) * 0.5;
    else v = 0.5 + sqrt(saturate((zenith - zenithHorizon) / beta)) * 0.5;
    return float2(atan2(d.z, d.x) / (2.0 * PI) + 0.5, v);
}

/** The light scattered toward the eye along one ray, from the sun and the moon, single and multiple. */
float3 scatterAlong(float3 o, float3 dir, float span, int steps, constant AetherU& u, texture2d<float> transmittance, texture2d<float> multiple, thread float3& through) {
    float3 total = 0.0;
    through = 1.0;
    float cs = dot(dir, u.sun.xyz), cm = dot(dir, u.moon.xyz);
    float pr0 = rayleighPhase(cs), pm0 = miePhase(cs, 0.8), pr1 = rayleighPhase(cm), pm1 = miePhase(cm, 0.8);
    float previous = 0.0;
    for (int i = 0; i < steps; i++) {
        float f = (float(i) + 1.0) / float(steps);
        float t = span * f * f, dt = t - previous, mid = previous + dt * 0.5;
        previous = t;
        float3 p = o + dir * mid;
        float pr = length(p);
        Medium m = mediumAt(pr - Rg, u);
        float3 up = p / pr;
        float3 sunLight = lightAt(transmittance, pr, dot(up, u.sun.xyz));
        float3 moonLight = lightAt(transmittance, pr, dot(up, u.moon.xyz));
        float3 scattering = m.rayleigh + m.mie;
        float3 single = (m.rayleigh * pr0 + m.mie * pm0) * sunLight * u.sun.w + (m.rayleigh * pr1 + m.mie * pm1) * moonLight * u.moon.w;
        float3 many = scattering * (multipleAt(multiple, pr, dot(up, u.sun.xyz)) * u.sun.w + multipleAt(multiple, pr, dot(up, u.moon.xyz)) * u.moon.w);
        float3 fade = exp(-m.extinction * dt);
        total += through * (single + many) * (1.0 - fade) / max(m.extinction, 1e-6);
        through *= fade;
    }
    return total;
}

fragment float4 aether_sky_view(FullOut in [[stage_in]], constant AetherU& u [[buffer(0)]], texture2d<float> transmittance [[texture(0)]], texture2d<float> multiple [[texture(1)]]) {
    float r = u.camera.w;
    float3 dir = skyViewDirection(in.uv, r), o = float3(0.0, r, 0.0);
    float ground = sphereHit(o, dir, Rg), top = sphereHit(o, dir, Rt);
    float span = ground > 0.0 ? ground : max(top, 0.0);
    float3 through;
    float3 light = scatterAlong(o, dir, span, 30, u, transmittance, multiple, through);
    return float4(light, 1.0);
}

/** A hash of a cell of the celestial sphere: where a star sits and how bright it is. */
float starHash(float3 p) { return fract(sin(dot(p, float3(127.1, 311.7, 74.7))) * 43758.5453); }

float3 starField(float3 dir, float time) {
    float3 cells = dir * 300.0;
    float3 cell = floor(cells);
    float pick = starHash(cell);
    if (pick < 0.985) return float3(0.0);
    // The star keeps to the middle of its cell, so its glow is never cut by the cell's edge.
    float3 at = cell + 0.25 + 0.5 * float3(starHash(cell + 1.3), starHash(cell + 2.7), starHash(cell + 4.1));
    float d = length(cells - at);
    float magnitude = pow((pick - 0.985) / 0.015, 6.0);
    float twinkle = 0.75 + 0.25 * sin(time * (3.0 + 7.0 * starHash(cell + 9.2)) + pick * 40.0);
    float3 tint = mix(float3(0.62, 0.74, 1.0), float3(1.0, 0.86, 0.68), starHash(cell + 5.5));
    return tint * magnitude * twinkle * exp(-d * d * 30.0);
}

fragment float4 aether_sky(FullOut in [[stage_in]], constant AetherU& u [[buffer(0)]], texture2d<float> skyView [[texture(0)]], texture2d<float> transmittance [[texture(1)]],
        texture2d<float> clouds [[texture(2)]]) {
    constexpr sampler wrap(filter::linear, address::repeat);
    constexpr sampler clampS(filter::linear, address::clamp_to_edge);
    float4 cloud = clouds.sample(clampS, in.uv);
    float3 ray = normalize(u.forward.xyz + in.ndc.x * u.screen.x * u.right.xyz + in.ndc.y * u.screen.y * u.up.xyz);
    float r = u.camera.w;
    float3 light = skyView.sample(wrap, skyViewUV(ray, r)).rgb;
    float horizon = -sqrt(max(1.0 - (Rg / r) * (Rg / r), 0.0));
    float3 through = ray.y < horizon ? float3(0.0) : transmittanceTo(transmittance, r, ray.y);
    // The sun's disc, 0.53 degrees across, darker toward its limb.
    float cs = dot(ray, u.sun.xyz);
    float edge = cos(0.00465);
    if (cs > edge - 2e-5) {
        float across = saturate(acos(clamp(cs, -1.0, 1.0)) / 0.00465);
        float limb = 1.0 - 0.6 * (1.0 - sqrt(max(1.0 - across * across, 0.0)));
        light += through * u.sun.w * 18.0 * limb * smoothstep(edge - 2e-5, edge + 2e-5, cs);
    }
    // The moon: its sunlit part, a sphere lit from the sun's side, with darker seas.
    float cm = dot(ray, u.moon.xyz), moonEdge = cos(0.00452);
    float night = 1.0 - u.moonInfo.w;
    if (cm > moonEdge - 2e-5) {
        float3 m = u.moon.xyz, east = normalize(cross(float3(0.0, 1.0, 0.0), m) + float3(1e-5, 0.0, 0.0)), north = cross(m, east);
        float2 q = float2(dot(ray - m * cm, east), dot(ray - m * cm, north)) / sin(0.00452);
        float3 n = float3(q, sqrt(max(1.0 - dot(q, q), 0.0)));
        float3 toSun = normalize(float3(dot(u.sun.xyz, east), dot(u.sun.xyz, north), dot(u.sun.xyz, m)));
        float lit = saturate(dot(n, toSun) * 4.0 + 0.1);
        float seas = 0.78 + 0.22 * smoothstep(0.35, 0.65, starHash(floor(float3(q * 5.0, 1.0))) * 0.5 + starHash(floor(float3(q * 11.0, 2.0))) * 0.5);
        float disc = smoothstep(moonEdge - 2e-5, moonEdge + 2e-5, cm);
        light += through * u.moonInfo.z * lit * seas * disc * (0.35 + 0.65 * night);
    }
    // Stars, fixed to the celestial sphere, fading in daylight and near the haze of the horizon.
    float3 celestial = float3(dot(u.sky0.xyz, ray), dot(u.sky1.xyz, ray), dot(u.sky2.xyz, ray));
    light += starField(celestial, u.time.x) * u.screen.w * through * night * night * 0.06;
    // The clouds in front of all of it: the sky, the sun and moon, the stars.
    light = light * cloud.a + cloud.rgb;
    float3 color = 1.0 - exp(-light * u.screen.z);
    return float4(pow(color, float3(1.0 / 2.2)), 1.0);
}

/** One column of the aerial-perspective volume per thread: the air between the eye and each slice. */
kernel void aether_aerial(texture3d<float, access::write> volume [[texture(0)]], texture2d<float> transmittance [[texture(1)]],
        texture2d<float> multiple [[texture(2)]], texture2d<float> skyView [[texture(3)]], constant AetherU& u [[buffer(0)]],
        uint2 id [[thread_position_in_grid]]) {
    constexpr sampler wrapS(filter::linear, address::repeat);
    // The light fog droplets get from all around: the sky's, or under a deck the clouds' grey, dimmer the denser they are.
    float3 skyUp = skyView.sample(wrapS, float2(0.5, 0.02)).rgb, skySide = skyView.sample(wrapS, float2(0.25, 0.45)).rgb;
    float3 skyAround = (skyUp + skySide) * 0.5;
    float under = saturate(u.cloud.x * 1.3 - 0.3);
    float3 around = mix(skyAround, float3(dot(skyAround, float3(0.3, 0.5, 0.2))) * 0.55 / (0.5 + 0.5 * u.cloudMore.x), under);
    if (id.x >= 32 || id.y >= 32) return;
    float2 ndc = (float2(id) + 0.5) / 32.0 * 2.0 - 1.0;
    ndc.y = -ndc.y;
    float4 world = u.inverse * float4(ndc, 0.5, 1.0);
    float3 dir = normalize(world.xyz / world.w - u.camera.xyz);
    float r = u.camera.w;
    float3 o = float3(0.0, r, 0.0);
    float cs = dot(dir, u.sun.xyz), cm = dot(dir, u.moon.xyz);
    float pr0 = rayleighPhase(cs), pm0 = miePhase(cs, 0.8), pr1 = rayleighPhase(cm), pm1 = miePhase(cm, 0.8);
    float pf0 = miePhase(cs, 0.55), pf1 = miePhase(cm, 0.55);
    float3 total = 0.0, through = 1.0;
    float previous = 0.0;
    float eyeY = u.camera.y / 1000.0;
    for (int s = 0; s < 32; s++) {
        float f = (float(s) + 1.0) / 32.0, t = u.time.y * f * f;
        // Two samples per slice keep the near slices, where fog is thick, from banding.
        for (int k = 0; k < 2; k++) {
            float a = previous + (t - previous) * (float(k) * 0.5), b = previous + (t - previous) * (float(k) * 0.5 + 0.5), dt = b - a;
            float3 p = o + dir * ((a + b) * 0.5);
            float pr = length(p);
            Medium m = mediumAt(pr - Rg, u);
            float y = eyeY + dir.y * (a + b) * 0.5;
            float fog = u.fog.x * exp(-max(y - u.fog.y, 0.0) * u.fog.z);
            float3 up = p / pr;
            float3 sunLight = lightAt(transmittance, pr, dot(up, u.sun.xyz)) * u.sun.w;
            float3 moonLight = lightAt(transmittance, pr, dot(up, u.moon.xyz)) * u.moon.w;
            float3 sky = multipleAt(multiple, pr, dot(up, u.sun.xyz)) * u.sun.w + multipleAt(multiple, pr, dot(up, u.moon.xyz)) * u.moon.w;
            float3 scattering = m.rayleigh + m.mie;
            float3 single = (m.rayleigh * pr0 + m.mie * pm0) * sunLight + (m.rayleigh * pr1 + m.mie * pm1) * moonLight;
            // Fog droplets scatter nearly all they meet: sun and moon through a broad forward lobe, and the sky's own light.
            float3 droplets = fog * 0.95 * ((sunLight * pf0 + moonLight * pf1) * u.cloud.y + around * u.fog.w);
            // Dust takes its colour from what it scatters: the share of the haze it is tints the light it sends on.
            droplets *= mix(float3(1.0), u.dust.rgb * 1.25, saturate(u.dust.w));
            float3 extinction = m.extinction + fog;
            float3 fade = exp(-extinction * dt);
            total += through * (single + scattering * sky + droplets) * (1.0 - fade) / max(extinction, 1e-6);
            through *= fade;
        }
        previous = t;
        volume.write(float4(total, (through.r + through.g + through.b) / 3.0), uint3(id.x, id.y, uint(s)));
    }
}

/** The air between the eye and every surface of the scene, over its colour (read in place). */
fragment float4 aether_apply(FullOut in [[stage_in]], float4 scene [[color(0)]], constant AetherU& u [[buffer(0)]],
        depth2d<float> depth [[texture(0)]], texture3d<float> volume [[texture(1)]]) {
    float z = depth.read(uint2(in.pos.xy));
    float2 uv = in.pos.xy / u.time.zw;
    if (z <= 0.0) {
        // The sky itself drawn its own air; only thick fog and rain veil it, with the air of the farthest slice.
        float veil = saturate(u.fog.x / 3.0);
        if (veil <= 0.0) return scene;
        constexpr sampler last(filter::linear, address::clamp_to_edge);
        float4 air = volume.sample(last, float3(uv, 31.5 / 32.0));
        float3 lin = pow(max(scene.rgb, 0.0), float3(2.2));
        float3 seen = mix(lin, lin * air.a + (1.0 - exp(-air.rgb * u.screen.z)), veil);
        return float4(pow(seen, float3(1.0 / 2.2)), scene.a);
    }
    float4 world = u.inverse * float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, z, 1.0);
    float reach = length(world.xyz / world.w - u.camera.xyz) / 1000.0;
    float slice = sqrt(saturate(reach / u.time.y)) * 32.0 - 1.0;
    constexpr sampler s(filter::linear, address::clamp_to_edge);
    float4 air = volume.sample(s, float3(uv, (max(slice, 0.0) + 0.5) / 32.0));
    float near = saturate(slice + 1.0);
    air = mix(float4(0.0, 0.0, 0.0, 1.0), air, near);
    float3 lin = pow(max(scene.rgb, 0.0), float3(2.2));
    float3 seen = lin * air.a + (1.0 - exp(-air.rgb * u.screen.z));
    return float4(pow(seen, float3(1.0 / 2.2)), scene.a);
}
"
