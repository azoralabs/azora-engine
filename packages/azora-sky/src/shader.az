module engine.sky.shader

func skyMetalSource(): String {
    return (""
        + "struct SkyUniform { float4 rect, forward, right, up, sun, moon; };\n"
        + "struct SkyVertex { float4 pos [[position]]; float2 ndc; };\n"
        + "vertex SkyVertex sky_vertex(uint index [[vertex_id]], constant SkyUniform& u [[buffer(0)]]) {\n"
        + "    float2 p = float2(index==1?3.0:-1.0,index==2?3.0:-1.0);\n"
        + "    return {float4(p*u.rect.xy+u.rect.zw,0.9999,1),p};\n"
        + "}\n"
        + "float skyHash(float3 p) { return fract(sin(dot(p,float3(135.9,47.13,19.27)))*43758.5453); }\n"
        + "fragment float4 sky_fragment(SkyVertex in [[stage_in]], constant SkyUniform& u [[buffer(0)]]) {\n"
        + "    float3 ray = normalize(u.forward.xyz + in.ndc.x*u.right.xyz + in.ndc.y*u.up.xyz);\n"
        + "    float y = max(ray.y,0.0), day = u.sun.w;\n"
        + "    float sd = dot(ray,u.sun.xyz), md = dot(ray,u.moon.xyz);\n"
        + "    float sunset = exp(-abs(u.sun.y)*8.0)*max(0.0,pow(saturate(sd),4.0));\n"
        + "    float3 daySky = mix(float3(0.72,0.84,0.92),float3(0.16,0.43,0.72),pow(y,0.39));\n"
        + "    float3 nightSky = mix(float3(0.11,0.15,0.24),float3(0.016,0.026,0.067),pow(y,0.46));\n"
        + "    float3 color = mix(nightSky,daySky,day) + float3(0.57,0.29,0.12)*sunset*exp(-5*y);\n"
        + "    float3 cells = ray*460; float3 f = fract(cells)-0.5;\n"
        + "    float rnd = skyHash(floor(cells));\n"
        + "    float stars = step(0.991,rnd)*exp(-dot(f,f)*42.0)*(1.0-day)*smoothstep(0.0,0.15,ray.y);\n"
        + "    color += stars*mix(float3(0.49,0.68,1.0),float3(1.0,0.88,0.67),fract(rnd*129.0));\n"
        + "    float glow = pow(saturate(sd),680.0)*smoothstep(-0.025,0.03,u.sun.y);\n"
        + "    float disc = smoothstep(0.99972,0.99984,sd)*smoothstep(-0.024,0.02,u.sun.y);\n"
        + "    color += float3(1,0.76,0.46)*glow*0.46 + float3(1,0.95,0.78)*disc*2.5;\n"
        + "    float moon = smoothstep(0.99957,0.99972,md)*smoothstep(-0.015,0.08,u.moon.y)*(1-day);\n"
        + "    float crater = 0.76+0.24*skyHash(floor(ray*1600.0));\n"
        + "    color += float3(0.76,0.84,1.0)*(moon*crater + 0.15*pow(saturate(md),430.0)*(1-day));\n"
        + "    return float4(color,1);\n"
        + "}\n")
}

func heightFogShader(): String {
    return (""
    + "float heightFog(float3 eye, float3 surface, float density, float4 shape) {\n"
    + "    float rayLength=length(surface-eye);\n"
    + "    if (density<=0.0 || rayLength<=shape.z) return 0.0;\n"
    + "    float startHeight=mix(eye.y,surface.y,shape.z/rayLength);\n"
    + "    float nearExp=clamp(-shape.y*(startHeight-shape.x),-40.0,20.0);\n"
    + "    float farExp=clamp(-shape.y*(surface.y-shape.x),-40.0,20.0);\n"
    + "    float diff=abs(nearExp-farExp);\n"
    + "    float mean=diff<0.001 ? exp((nearExp+farExp)*0.5) : exp(max(nearExp,farExp))*(1.0-exp(-diff))/diff;\n"
    + "    float opticalDepth=density*(rayLength-shape.z)*mean;\n"
    + "    return min(saturate(shape.w),1.0-exp(-opticalDepth));\n"
    + "}\n")
}
