module engine.gpu.terrain

import std.traits
import std.math
import engine.core
import engine.io
import engine.math
import engine.math.mat
import engine.objc
import engine.scene.terrain
import engine.roads

// A heightfield is drawn as square chunks of 32 x 32 cells, each with its own
// vertex buffer of 33 x 33 full-resolution vertices. A chunk draws at one of six
// levels of detail: level L keeps every 2^L-th vertex of the grid. Every chunk
// has the same vertex layout, so one set of index buffers serves all of them:
// one per level and per mask of neighbours that are one level coarser. Along
// such an edge the vertices the neighbour does not have are folded onto the
// ones it does, so the two meshes meet edge to edge with no cracks.

/** Cells along a chunk's side; its vertex grid is one more. */
inline fin terrainChunkCells: Int = 32
inline fin terrainChunkSide: Int = 33
inline fin terrainLevels: Int = 6

pack TerrainChunk derives Clone {
    var buffer: Long = 0
    /** The image column and row of the chunk's first vertex. */
    var column: Int = 0
    var row: Int = 0
    /** The chunk's height range in the image's own units. */
    var low: Double = 0.0
    var high: Double = 0.0
    /** The largest height error of each level against the full grid, in the image's own units. */
    var errors: Array<Double> = []
    /** The level drawn last frame, kept so a chunk near a threshold does not flicker. */
    var level: Int = 0
    var edgeMask: Int = 0
}

pack TerrainMesh derives Clone {
    var path: String = ""
    var image: TerrainImage = .()
    var chunks: Array<TerrainChunk> = []
    var chunksX: Int = 0
    var chunksZ: Int = 0
    var gradedEntity: Int = -1
    var layout: Long = 0
    /** The terrain frame it was last drawn in: a mesh nobody draws for a while is released (streamed tiles). */
    var lastUsed: Int = 0
    var placement: Mat4 = mat4Identity()
    /** The lowest and highest image height of any chunk: with the unit square, the whole terrain's box. */
    var low: Double = 0.0
    var high: Double = 0.0
}

/** The affine part of the transform used when cutting and filling a heightfield. */
func sameTerrainPlacement(a: Mat4&, b: Mat4&): Bool =
    a.m00 == b.m00 && a.m01 == b.m01 && a.m02 == b.m02 && a.m03 == b.m03 &&
    a.m10 == b.m10 && a.m11 == b.m11 && a.m12 == b.m12 && a.m13 == b.m13 &&
    a.m20 == b.m20 && a.m21 == b.m21 && a.m22 == b.m22 && a.m23 == b.m23

/** The 32-bit index buffers every chunk shares, by level * 16 + coarser-neighbour mask. */
pack TerrainIndices derives Clone {
    var buffers: Array<Long> = []
    var counts: Array<Int> = []
    /** Buffers that leave squares of a chunk out (see [holedTerrainIndices]), made when first drawn. */
    var holedKeys: Array<Int> = []
    var holedBuffers: Array<Long> = []
    var holedCounts: Array<Int> = []
}

/**
 * Which of a chunk's squares [holes] leaves out, a bit each: the chunk whose
 * first vertex is image sample ([column], [row]) has (32 / spacing)^2 squares,
 * bit `j * side + i` for the square `i` across and `j` down. Zero when it
 * draws whole.
 */
func chunkHoles(holes: TerrainHoles&, column: Int, row: Int): Int {
    if holes.columns <= 0 || (holes.spacing != 8 && holes.spacing != 16 && holes.spacing != 32) then return 0
    fin side = terrainChunkCells / holes.spacing
    fin first = column / holes.spacing
    fin top = row / holes.spacing
    var bits = 0
    for j: Int in 0..<side {
        for i: Int in 0..<side {
            fin x = first + i
            fin index = (top + j) * holes.columns + x
            if x < holes.columns && index < holes.hidden.size && holes.hidden[index] then bits += 1 << (j * side + i)
        }
    }
    return bits
}

/** The finest level that can leave out squares [spacing] samples a side: its cells must not be larger. */
func holedLevelLimit(spacing: Int): Int = when spacing {
    8 -> 3
    16 -> 4
    else -> terrainLevels - 1
}

/**
 * The slot in [indices]' holed buffers of [level] and coarser-neighbour
 * [mask] with the squares in [bits] (see [chunkHoles], squares [spacing]
 * samples a side) left out, made the first time it is asked for: only the
 * few that chunks next to a hole use are ever made.
 */
func holedTerrainIndices(indices: TerrainIndices!, device: Long, level: Int, mask: Int, bits: Int, spacing: Int): Int {
    fin key = ((level * 16 + mask) * 4 + spacing / 8) * 65536 + bits
    for i: Int in 0..<indices.holedKeys.size then if indices.holedKeys[i] == key then return i
    fin step = 1 << level
    fin cells = terrainChunkCells / step
    fin side = terrainChunkCells / spacing
    fin data = azAlloc((terrainChunkCells * terrainChunkCells * 6 * 4) as Long)
    var count = 0
    if data != 0 {
        for cj: Int in 0..<cells {
            for ci: Int in 0..<cells {
                fin square = ((cj * step) / spacing) * side + (ci * step) / spacing
                if (bits >> square) % 2 == 1 then continue
                fin p00 = foldedVertex(ci * step, cj * step, step, mask)
                fin p10 = foldedVertex((ci + 1) * step, cj * step, step, mask)
                fin p01 = foldedVertex(ci * step, (cj + 1) * step, step, mask)
                fin p11 = foldedVertex((ci + 1) * step, (cj + 1) * step, step, mask)
                if cellRunsDown(ci, cj) {
                    count = addTerrainTriangle(data, count, p00, p01, p11)
                    count = addTerrainTriangle(data, count, p00, p11, p10)
                } else {
                    count = addTerrainTriangle(data, count, p00, p01, p10)
                    count = addTerrainTriangle(data, count, p10, p01, p11)
                }
            }
        }
    }
    indices.holedKeys.add(key)
    indices.holedBuffers.add(if data == 0 then 0 else send3(device, sel("newBufferWithBytes:length:options:"), data,
        ((if count > 0 then count else 1) * 4) as Long, 0))
    indices.holedCounts.add(count)
    if data != 0 then azFree(data)
    return indices.holedKeys.size - 1
}

func terrainVertex(data: Long, at: Int, image: TerrainImage&, x: Int, z: Int) {
    fin dx = image.columns - 1
    fin dz = image.rows - 1
    fin left = if x > 0 then x - 1 else x
    fin right = if x < dx then x + 1 else x
    fin front = if z > 0 then z - 1 else z
    fin back = if z < dz then z + 1 else z
    fin normalX = (terrainHeight(image,left,z) - terrainHeight(image,right,z)) * (dx as Double) / ((right-left) as Double)
    fin normalZ = (terrainHeight(image,x,front) - terrainHeight(image,x,back)) * (dz as Double) / ((back-front) as Double)
    fin offset = (at as Long) * 24
    azPokeF32(data, offset, (x as Double) / (dx as Double) - 0.5)
    azPokeF32(data, offset+4, terrainHeight(image,x,z))
    azPokeF32(data, offset+8, (z as Double) / (dz as Double) - 0.5)
    azPokeF32(data, offset+12, normalX)
    azPokeF32(data, offset+16, 1.0)
    azPokeF32(data, offset+20, normalZ)
}

/** The image height at chunk vertex (i, j), clamped to the image so edge chunks repeat their last row. */
func chunkHeight(image: TerrainImage&, chunk: TerrainChunk&, i: Int, j: Int): Double {
    fin x = if chunk.column + i < image.columns then chunk.column + i else image.columns - 1
    fin z = if chunk.row + j < image.rows then chunk.row + j else image.rows - 1
    return terrainHeight(image, x, z)
}

/**
 * Whether a cell's diagonal runs from its first corner to its last. The cells
 * of each 2 x 2 block turn their diagonals toward the block's centre, which is
 * what lets an edge fold onto a coarser neighbour with no gap.
 */
func cellRunsDown(ci: Int, cj: Int): Bool = (ci + cj) % 2 == 0

/** The height the level with cells of [step] vertices draws at chunk vertex (i, j). */
func levelHeight(image: TerrainImage&, chunk: TerrainChunk&, step: Int, i: Int, j: Int): Double {
    fin last = terrainChunkCells / step - 1
    fin ci = if i / step < last then i / step else last
    fin cj = if j / step < last then j / step else last
    fin u = ((i - ci * step) as Double) / (step as Double)
    fin v = ((j - cj * step) as Double) / (step as Double)
    fin h00 = chunkHeight(image, chunk, ci * step, cj * step)
    fin h10 = chunkHeight(image, chunk, (ci + 1) * step, cj * step)
    fin h01 = chunkHeight(image, chunk, ci * step, (cj + 1) * step)
    fin h11 = chunkHeight(image, chunk, (ci + 1) * step, (cj + 1) * step)
    if cellRunsDown(ci, cj) {
        return if u >= v then h00 + u * (h10 - h00) + v * (h11 - h10) else h00 + v * (h01 - h00) + u * (h11 - h01)
    }
    return if u + v <= 1.0 then h00 + u * (h10 - h00) + v * (h01 - h00) else h11 + (1.0 - u) * (h01 - h11) + (1.0 - v) * (h10 - h11)
}

func loadTerrainMesh(device: Long, root: String, path: String): TerrainMesh {
    if !terrainFile(path) then return TerrainMesh(path)
    fin image = readTerrainImage("${root}/${path}")
    return if image.samples == 0 then TerrainMesh(path) else buildTerrainMesh(device, path, image)
}

/**
 * How much more a level's rise over the road bed counts than its error
 * elsewhere. The road sits 0.35 m over its bed; a coarse level whose
 * triangles rise above the bed by a fraction of what is tolerated on bare
 * hillside already swallows the road in the distance, which drew the far
 * roads broken.
 */
inline fin terrainRoadStrictness: Double = 8.0

/**
 * The chunked, levelled mesh of [image]. [paved] (one byte per sample, see
 * `gradeRoadTerrain`) marks samples under the pavement: a level's rise above
 * them weighs [terrainRoadStrictness] times its error in choosing the level.
 */
func buildTerrainMesh(device: Long, path: String, image: TerrainImage, paved: Long = 0): TerrainMesh {
    var mesh: TerrainMesh = .(path, image)
    mesh.chunksX = (image.columns - 1 + terrainChunkCells - 1) / terrainChunkCells
    mesh.chunksZ = (image.rows - 1 + terrainChunkCells - 1) / terrainChunkCells
    fin bytes = (terrainChunkSide * terrainChunkSide * 24) as Long
    fin data = azAlloc(bytes)
    if data == 0 then return take mesh
    var cz = 0
    while cz < mesh.chunksZ {
        var cx = 0
        while cx < mesh.chunksX {
            var chunk: TerrainChunk = .(column: cx * terrainChunkCells, row: cz * terrainChunkCells)
            chunk.low = 1000000.0
            chunk.high = -1000000.0
            var j = 0
            while j < terrainChunkSide {
                var i = 0
                while i < terrainChunkSide {
                    fin x = if chunk.column + i < image.columns then chunk.column + i else image.columns - 1
                    fin z = if chunk.row + j < image.rows then chunk.row + j else image.rows - 1
                    terrainVertex(data, j * terrainChunkSide + i, image, x, z)
                    fin h = terrainHeight(image, x, z)
                    if h < chunk.low then chunk.low = h
                    if h > chunk.high then chunk.high = h
                    i++
                }
                j++
            }
            // Each level's error is the largest gap between the grid and what the level draws,
            // never smaller than a finer level's, so a coarser level is never thought closer.
            var worst: Double = 0.0
            var rise: Double = 0.0
            for level: Int in 0..<terrainLevels {
                fin step = 1 << level
                if level > 0 {
                    for j: Int in 0..<terrainChunkSide {
                        for i: Int in 0..<terrainChunkSide {
                            fin drawn = levelHeight(image, chunk, step, i, j)
                            fin grid = chunkHeight(image, chunk, i, j)
                            fin gap = absValue(grid - drawn)
                            if gap > worst then worst = gap
                            if paved != 0 && drawn > grid + rise {
                                fin x = if chunk.column + i < image.columns then chunk.column + i else image.columns - 1
                                fin z = if chunk.row + j < image.rows then chunk.row + j else image.rows - 1
                                if azPeek8(paved, (z * image.columns + x) as Long) != 0 then rise = drawn - grid
                            }
                        }
                    }
                }
                fin road = rise * terrainRoadStrictness
                chunk.errors.add(if road > worst then road else worst)
            }
            chunk.buffer = send3(device, sel("newBufferWithBytes:length:options:"), data, bytes, 0)
            if mesh.chunks.size == 0 || chunk.low < mesh.low then mesh.low = chunk.low
            if mesh.chunks.size == 0 || chunk.high > mesh.high then mesh.high = chunk.high
            mesh.chunks.add(take chunk)
            cx++
        }
        cz++
    }
    azFree(data)
    return take mesh
}

/** Chunk vertex (i, j) at [step] with the edges in [mask] folded onto a coarser neighbour. */
func foldedVertex(i: Int, j: Int, step: Int, mask: Int): Int {
    var x = i
    var y = j
    if step < terrainChunkCells {
        if ((j == 0 && mask % 2 == 1) || (j == terrainChunkCells && (mask / 2) % 2 == 1)) && (i / step) % 2 == 1 then x = i - step
        if ((i == 0 && (mask / 4) % 2 == 1) || (i == terrainChunkCells && (mask / 8) % 2 == 1)) && (j / step) % 2 == 1 then y = j - step
    }
    return y * terrainChunkSide + x
}

func addTerrainTriangle(data: Long, count: Int, a: Int, b: Int, c: Int): Int {
    if a == b || b == c || a == c then return count
    azPoke32(data, (count as Long) * 4, a)
    azPoke32(data, ((count + 1) as Long) * 4, b)
    azPoke32(data, ((count + 2) as Long) * 4, c)
    return count + 3
}

/**
 * The index buffers for every level and neighbour mask. Mask bits: 1 the first
 * row's neighbour, 2 the last row's, 4 the first column's, 8 the last column's.
 */
func buildTerrainIndices(device: Long): TerrainIndices {
    var indices: TerrainIndices = .()
    fin data = azAlloc((terrainChunkCells * terrainChunkCells * 6 * 4) as Long)
    if data == 0 then return take indices
    var level = 0
    while level < terrainLevels {
        fin step = 1 << level
        fin cells = terrainChunkCells / step
        for mask: Int in 0..<16 {
            var count = 0
            for cj: Int in 0..<cells {
                for ci: Int in 0..<cells {
                    fin p00 = foldedVertex(ci * step, cj * step, step, mask)
                    fin p10 = foldedVertex((ci + 1) * step, cj * step, step, mask)
                    fin p01 = foldedVertex(ci * step, (cj + 1) * step, step, mask)
                    fin p11 = foldedVertex((ci + 1) * step, (cj + 1) * step, step, mask)
                    if cellRunsDown(ci, cj) {
                        count = addTerrainTriangle(data, count, p00, p01, p11)
                        count = addTerrainTriangle(data, count, p00, p11, p10)
                    } else {
                        count = addTerrainTriangle(data, count, p00, p01, p10)
                        count = addTerrainTriangle(data, count, p10, p01, p11)
                    }
                }
            }
            indices.buffers.add(send3(device, sel("newBufferWithBytes:length:options:"), data, ((if count > 0 then count else 1) * 4) as Long, 0))
            indices.counts.add(count)
        }
        level++
    }
    azFree(data)
    return take indices
}

func releaseTerrainMesh(mesh: TerrainMesh&) {
    for chunk in mesh.chunks {
        if chunk.buffer != 0 then send0(chunk.buffer, sel("release"))
    }
    if mesh.image.samples != 0 then azFree(mesh.image.samples)
}

func releaseTerrainIndices(indices: TerrainIndices!) {
    for buffer in indices.buffers {
        if buffer != 0 then send0(buffer, sel("release"))
    }
    for buffer in indices.holedBuffers {
        if buffer != 0 then send0(buffer, sel("release"))
    }
    indices.buffers.clear()
    indices.counts.clear()
    indices.holedKeys.clear()
    indices.holedBuffers.clear()
    indices.holedCounts.clear()
}


pack RoadSurfaceMesh {
    var asset: String
    var buffer: Long
    var count: Int
}

/** The road mesh buffers and shared CPU network for one rendered scene. */
pack RoadRenderCache {
    var layout: Long = 0
    /** The frame and scene revisions [layout] was last checked at, so a frame checks it once. */
    var checkedFrame: Int = -1
    var checkedStamp: Long = -1
    var revision: Long = 0
    var network: RoadNetwork = .()
    var buffers: Array<Long> = []
    var counts: Array<Int> = []
    var surfaces: Array<RoadSurfaceMesh> = []
}

func releaseRoadBuffers(cache: RoadRenderCache!) {
    for buffer in cache.buffers {
        if buffer != 0 then send0(buffer, sel("release"))
    }
    for surface in cache.surfaces {
        if surface.buffer != 0 then send0(surface.buffer,sel("release"))
    }
    cache.surfaces.clear()
    cache.buffers.clear()
    cache.counts.clear()
}
