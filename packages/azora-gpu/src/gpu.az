// Azora Engine — GPU renderer (Metal), written entirely in Azora.
//
// Talks to Metal through the Objective-C runtime (az_objc.az) and to
// CoreText/CoreGraphics through their plain C APIs for text rasterization.
// Shaders are compiled from MSL source at startup.

module engine.gpu

import std.io
import engine.objc
import engine.math.mat
import engine.shaders
import engine.io

bridge .C {
    // Metal / QuartzCore C entry points
    func MTLCreateSystemDefaultDevice(): std::Long

    // CoreFoundation / CoreText / CoreGraphics (text rasterization)
    func CFStringCreateWithCString(allocator: std::Long, str: std::String, encoding: std::Int): std::Long
    func CFRelease(cf: std::Long)
    func CFDictionaryCreate(allocator: std::Long, keys: std::Long, values: std::Long, numValues: std::Long, keyCallBacks: std::Long, valueCallBacks: std::Long): std::Long
    func CFAttributedStringCreate(allocator: std::Long, str: std::Long, attributes: std::Long): std::Long
    func CTFontCreateWithName(name: std::Long, size: std::Double, matrix: std::Long): std::Long
    func CTLineCreateWithAttributedString(attrString: std::Long): std::Long
    func CTLineGetTypographicBounds(line: std::Long, ascent: std::Long, descent: std::Long, leading: std::Long): std::Double
    func CTLineDraw(line: std::Long, context: std::Long)
    func CGColorSpaceCreateDeviceRGB(): std::Long
    func CGColorSpaceRelease(space: std::Long)
    func CGColorCreateGenericRGB(r: std::Double, g: std::Double, b: std::Double, a: std::Double): std::Long
    func CGColorRelease(color: std::Long)
    func CGBitmapContextCreate(data: std::Long, width: std::Long, height: std::Long, bitsPerComponent: std::Long, bytesPerRow: std::Long, space: std::Long, bitmapInfo: std::Int): std::Long
    func CGBitmapContextGetData(context: std::Long): std::Long
    func CGContextRelease(context: std::Long)
    func CGContextScaleCTM(context: std::Long, sx: std::Double, sy: std::Double)
    func CGContextSetTextPosition(context: std::Long, x: std::Double, y: std::Double)
}

// ── State ───────────────────────────────────────────────────────────────

pack AzGpu {
    var ok: std::Bool
    var device: std::Long
    var queue: std::Long
    var layer: std::Long
    var pipe3d: std::Long
    var pipe2d: std::Long
    var depthOn: std::Long
    var depthOff: std::Long
    var sampler: std::Long
    var depthTex: std::Long
    var depthW: std::Long
    var depthH: std::Long
    var drawable: std::Long
    var cmd: std::Long
    var enc: std::Long
    var hasEncoder: std::Bool
    var mode: std::Int
    var viewProj: std::Long
    var scratch: std::Long
    var scale: std::Double
    var lightX: std::Double
    var lightY: std::Double
    var lightZ: std::Double
    var ambient: std::Double
}

/// A GPU mesh: vertex buffer handle + vertex count (interleaved pos+normal).
pack Mesh {
    var buffer: std::Long
    var count: std::Int
}

// ── Setup ───────────────────────────────────────────────────────────────

func gpuFailed(): AzGpu {
    return AzGpu(false, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, false, -1, 0L, 0L, 1.0, 0.5, 0.8, 0.3, 0.35)
}

func gpuInit(scale: std::Double): AzGpu {
    fin device = MTLCreateSystemDefaultDevice()
    if device == 0L {
        std::println("azora-engine: no Metal device")
        return gpuFailed()
    }
    fin queue = send0(device, sel("newCommandQueue"))

    // CAMetalLayer (attached to the window's content view by the platform layer).
    fin layer = send0(cls("CAMetalLayer"), sel("layer"))
    send1(layer, sel("setDevice:"), device)
    send1(layer, sel("setPixelFormat:"), 80L)
    fin unused0 = azSendF1(layer, sel("setContentsScale:"), scale)

    // Shader library from MSL source.
    fin lib = send3(device, sel("newLibraryWithSource:options:error:"), nsString(shaderSource()), 0L, 0L)
    if lib == 0L {
        std::println("azora-engine: shader compilation failed")
        return gpuFailed()
    }

    // 3D pipeline: BGRA8 color + Depth32 depth.
    fin d3 = newObject("MTLRenderPipelineDescriptor")
    send1(d3, sel("setVertexFunction:"), send1(lib, sel("newFunctionWithName:"), nsString("v3_main")))
    send1(d3, sel("setFragmentFunction:"), send1(lib, sel("newFunctionWithName:"), nsString("f3_main")))
    fin ca3 = send1(send0(d3, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), 0L)
    send1(ca3, sel("setPixelFormat:"), 80L)
    send1(d3, sel("setDepthAttachmentPixelFormat:"), 252L)
    fin pipe3d = send2(device, sel("newRenderPipelineStateWithDescriptor:error:"), d3, 0L)
    if pipe3d == 0L {
        std::println("azora-engine: 3D pipeline failed")
        return gpuFailed()
    }

    // 2D pipeline: alpha blending for UI rects and text quads.
    fin d2 = newObject("MTLRenderPipelineDescriptor")
    send1(d2, sel("setVertexFunction:"), send1(lib, sel("newFunctionWithName:"), nsString("v2_main")))
    send1(d2, sel("setFragmentFunction:"), send1(lib, sel("newFunctionWithName:"), nsString("f2_main")))
    fin ca2 = send1(send0(d2, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), 0L)
    send1(ca2, sel("setPixelFormat:"), 80L)
    send1(ca2, sel("setBlendingEnabled:"), 1L)
    send1(ca2, sel("setSourceRGBBlendFactor:"), 4L)
    send1(ca2, sel("setDestinationRGBBlendFactor:"), 5L)
    send1(ca2, sel("setSourceAlphaBlendFactor:"), 4L)
    send1(ca2, sel("setDestinationAlphaBlendFactor:"), 5L)
    send1(d2, sel("setDepthAttachmentPixelFormat:"), 252L)
    fin pipe2d = send2(device, sel("newRenderPipelineStateWithDescriptor:error:"), d2, 0L)
    if pipe2d == 0L {
        std::println("azora-engine: 2D pipeline failed")
        return gpuFailed()
    }

    // Depth-stencil states: compare Less + write for 3D, Always for UI.
    fin dsOn = newObject("MTLDepthStencilDescriptor")
    send1(dsOn, sel("setDepthCompareFunction:"), 1L)
    send1(dsOn, sel("setDepthWriteEnabled:"), 1L)
    fin depthOn = send1(device, sel("newDepthStencilStateWithDescriptor:"), dsOn)

    fin dsOff = newObject("MTLDepthStencilDescriptor")
    send1(dsOff, sel("setDepthCompareFunction:"), 7L)
    send1(dsOff, sel("setDepthWriteEnabled:"), 0L)
    fin depthOff = send1(device, sel("newDepthStencilStateWithDescriptor:"), dsOff)

    // Linear sampler for text textures.
    fin sd = newObject("MTLSamplerDescriptor")
    send1(sd, sel("setMinFilter:"), 1L)
    send1(sd, sel("setMagFilter:"), 1L)
    fin sampler = send1(device, sel("newSamplerStateWithDescriptor:"), sd)

    var gpu = AzGpu(
        true, device, queue, layer,
        pipe3d, pipe2d, depthOn, depthOff, sampler,
        0L, 0L, 0L,
        0L, 0L, 0L, false, -1,
        azAlloc(64L),
        azAlloc(4096L),
        scale,
        0.5, 0.8, 0.3, 0.35
    )
    // Identity view-projection until a camera is applied.
    pokeIdentity(gpu.viewProj)
    return gpu
}

func pokeIdentity(buf: std::Long) {
    var i = 0
    while i < 16 {
        var v = 0.0
        if i == 0 || i == 5 || i == 10 || i == 15 {
            v = 1.0
        }
        azPokeF32(buf, (i * 4) as std::Long, v)
        i = i + 1
    }
}

/// Writes a row-major Mat4 into [buf] as column-major float16 (GPU layout).
func pokeMat4(buf: std::Long, offset: std::Long, m: Mat4) {
    azPokeF32(buf, offset, m.m00)
    azPokeF32(buf, offset + 4L, m.m10)
    azPokeF32(buf, offset + 8L, m.m20)
    azPokeF32(buf, offset + 12L, m.m30)
    azPokeF32(buf, offset + 16L, m.m01)
    azPokeF32(buf, offset + 20L, m.m11)
    azPokeF32(buf, offset + 24L, m.m21)
    azPokeF32(buf, offset + 28L, m.m31)
    azPokeF32(buf, offset + 32L, m.m02)
    azPokeF32(buf, offset + 36L, m.m12)
    azPokeF32(buf, offset + 40L, m.m22)
    azPokeF32(buf, offset + 44L, m.m32)
    azPokeF32(buf, offset + 48L, m.m03)
    azPokeF32(buf, offset + 52L, m.m13)
    azPokeF32(buf, offset + 56L, m.m23)
    azPokeF32(buf, offset + 60L, m.m33)
}
