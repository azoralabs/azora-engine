module dolomites.camera

import std.math
import engine.core
import engine.ecs
import engine.game
import engine.gizmos
import engine.math
import engine.scene
import engine.vehicles
import engine.landscape
import dolomites.components

/**
 * A camera that follows a vehicle from behind. It moves in the same
 * simulation sub-steps as the vehicle (see [stepChaseCamera]), with easings
 * that close the same share of the gap however the time is cut up: eased
 * once per frame by the frame's time, it lagged a different distance after a
 * short frame than after a long one, and whenever the frame rate dipped the
 * car seemed to jump back and forth in front of it.
 */
@Component
pack ChaseCamera {
    var heading: Double
    var focus: Vec3
    fin pitch: Double
    /** Degrees the camera looks further down to keep its eye off the ground, eased toward what the slope asks. */
    var lift: Double = 0.0
    /** Heading, focus and lift one step earlier. */
    var lastHeading: Double = 0.0
    var lastFocus: Vec3 = .(0.0, 0.0, 0.0)
    var lastLift: Double = 0.0
}

func attachChaseCamera(frame: Game!, player: Entity) {
    fin controller = storageGet<PlayerController>(ensureStorage(frame.world), player)
    fin vehicle = storageGet<Vehicle>(ensureStorage(frame.world), player)
    fin position = presentedPosition(frame.world, player)
    fin pitch = -atan2(controller.cameraHeight, controller.cameraDistance) / degreesToRadians
    frame.camera = EditorCamera(target: position.clone(), yaw: vehicle.yaw / degreesToRadians,
        pitch: pitch, distance: controller.cameraDistance, fov: 58.0, far: 60000.0)
    storageInsert<ChaseCamera>(ensureStorage<ChaseCamera>(frame.world), player,
        ChaseCamera(vehicle.yaw, position.clone(), pitch, lastHeading: vehicle.yaw, lastFocus: position.clone()))
}

/** The share of the way an easing at [rate] per second closes in [seconds], the same however the time is cut up. */
func easing(rate: Double, seconds: Double): Double = 1.0 - exp(-rate * seconds)

/** One fixed step of every chase camera, right after its vehicle's. */
@System(phase: .FixedUpdate, runAfter: "driveVehicle")
func stepChaseCamera(world: World!, time: Time&, cameras: @query [ChaseCamera!, Vehicle&, Course&]) {
    cameras.unpack { player, chase, vehicle, course ->
        fin controller = storageGetOrDefault<PlayerController>(ensureStorage(world), player, .())
        fin dt = time.fixedDeltaSecs
        chase.lastHeading = chase.heading
        chase.lastFocus = chase.focus.clone()
        chase.lastLift = chase.lift
        fin turn = vehicle.yaw - chase.heading
        chase.heading += atan2(sin(turn), cos(turn)) * easing(4.5, dt)
        fin position: Vec3 = .(vehicle.x, vehicle.y, vehicle.z)
        chase.focus = chase.focus.add(position.subtract(chase.focus).scale(easing(12.0, dt)))
        // Rising quickly enough never to sink into the slope, settling back slowly enough never to bob.
        var eye: EditorCamera = .(target: aimOf(chase.focus, chase.heading), yaw: chase.heading / degreesToRadians,
            pitch: chase.pitch, distance: controller.cameraDistance)
        fin needed = liftOverGround(eye, chase.pitch, course.terrain)
        chase.lift += (needed - chase.lift) * easing(if needed > chase.lift then 14.0 else 2.5, dt)
    }
}

/** Where the camera looks: a little above and ahead of the vehicle. */
func aimOf(focus: Vec3&, heading: Double): Vec3 = focus.add(.(0.0, 0.55, 0.0)).add(vehicleForward(heading).scale(1.6))

/** Places the frame's camera between its last two steps, by the same fraction the vehicle is drawn at. */
@System(phase: .PostUpdate)
func followVehicle(frame: Game!, cameras: @query [ChaseCamera&]) {
    fin t = vehicleClamp(frame.interpolation, 0.0, 1.0)
    cameras.unpack { player, chase ->
        fin turn = chase.heading - chase.lastHeading
        fin heading = chase.lastHeading + atan2(sin(turn), cos(turn)) * t
        fin focus = chase.lastFocus.add(chase.focus.subtract(chase.lastFocus).scale(t))
        frame.camera.yaw = heading / degreesToRadians
        frame.camera.target = aimOf(focus, heading)
        frame.camera.pitch = chase.pitch - (chase.lastLift + (chase.lift - chase.lastLift) * t)
    }
}

/** Metres between the eye and the ground straight below it; far when there is none. */
func clearance(camera: EditorCamera&, terrain: Array<CollisionSurface>&): Double {
    fin eye = camera.position()
    fin below = castLandscape(terrain, .(eye.x, eye.y + 30.0, eye.z), .(0.0, -1.0, 0.0), 60.0)
    return if below.hit then eye.y - below.py else 1000.0
}

/**
 * The least extra downward pitch, in degrees (up to 45), that keeps the eye
 * [groundGap] metres over the ground below it: found by halving, so it moves
 * continuously with the slope instead of in steps.
 */
inline fin groundGap: Double = 0.9

func liftOverGround(camera: EditorCamera!, pitch: Double, terrain: Array<CollisionSurface>&): Double {
    camera.pitch = pitch
    if clearance(camera, terrain) >= groundGap then return 0.0
    var low: Double = 0.0
    var high: Double = 45.0
    for step: Int in 0..<9 {
        fin middle = (low + high) * 0.5
        camera.pitch = pitch - middle
        if clearance(camera, terrain) >= groundGap then high = middle else low = middle
    }
    camera.pitch = pitch
    return high
}
