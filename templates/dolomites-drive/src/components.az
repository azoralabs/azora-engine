module dolomites.components

import engine.core
import engine.ecs
import engine.game
import engine.physics.d3
import engine.vehicles
import engine.landscape

@Component
pack Driver {
    var input: DriveInput = .()
}

@Component
pack Course {
    var terrain: Array<CollisionSurface>
    fin gravity: Gravity3D
    /** Which landscapes and roads [terrain] was last matched to, as the world partition streams cells. */
    var sync: ColliderSync = .()
}

impl Course {
    dtor .() {
        releaseLandscapeColliders(self.terrain)
    }
}
