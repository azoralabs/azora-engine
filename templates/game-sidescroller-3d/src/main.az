/**
 * @file game-sidescroller-3d,
 *
 * Native LLVM side-scroller demonstrating the current Azora Engine:
 * data-oriented ECS storage, a typed route, reactive HUD state, immediate
 * UI, engine physics contacts, 3D rendering, keyboard/gamepad input and audio.
 *
 * A / D or arrows   Move
 * Space or Up       Jump
 * Escape            Pause
 */
module game

import engine

enum GameRoute {
    Menu
    Playing
    Paused
    GameOver
}

@Component
pack Player {
    var velocity: Vec3
    var grounded: Bool
    var coyoteTime: Double
    var jumpBuffer: Double
    var health: Int
    var score: Int
    var invulnerableFor: Double
    var facing: Double
}

@Component
pack Platform {
    var center: Vec3
    var halfSize: Vec3
    var color: Color
}

@Component
pack Coin {
    var center: Vec3
    var collected: Bool
    var phase: Double
}

@Component
pack Walker {
    var center: Vec3
    var velocityX: Double
    var minX: Double
    var maxX: Double
}

pack GameSession {
    var elapsed: Double
    var cameraX: Double
    var bestScore: Int
}

inline fin moveSpeed: Double = 7.8
inline fin moveResponse: Double = 15.0
inline fin airResponse: Double = 6.5
inline fin jumpSpeed: Double = 10.8
inline fin gravity: Double = 27.0

func playerHalf(): Vec3 = .(0.42, 0.72, 0.38)

func freshPlayer(): Player = .(vec3Zero(), false, 0.0, 0.0, 3, 0, 0.0, 1.0)

func clampReal(value: Double, lo: Double, hi: Double): Double = when {
    value < lo -> lo
    value > hi -> hi
    else -> value
}

func approach(current: Double, target: Double, amount: Double): Double =
    if current < target then clampReal(current + amount, current, target) else clampReal(current - amount, target, current)

func addPlatform(world: World!, platforms: Storage<Platform>!, x: Double, y: Double, width: Double, depth: Double,
                 r: Double, g: Double, b: Double) {
    spawnWith(world, platforms, Platform(.(x, y, 0.0), .(width * 0.5, 0.35, depth * 0.5), colorRgb(r, g, b)))
}

func addCoin(world: World!, coins: Storage<Coin>!, x: Double, y: Double, phase: Double) {
    spawnWith(world, coins, Coin(.(x, y, 0.0), false, phase))
}

func addWalker(world: World!, walkers: Storage<Walker>!, x: Double, y: Double, minX: Double, maxX: Double, speed: Double) {
    spawnWith(world, walkers, Walker(.(x, y, 0.0), speed, minX, maxX))
}

func buildLevel(world: World!, platforms: Storage<Platform>!, coins: Storage<Coin>!, walkers: Storage<Walker>!) {
    // Ground islands form a readable route while leaving real fall hazards.
    addPlatform(world, platforms, 0.0, -0.35, 12.0, 5.0, 0.20, 0.48, 0.31)
    addPlatform(world, platforms, 8.0, 0.35, 3.2, 4.0, 0.22, 0.52, 0.35)
    addPlatform(world, platforms, 13.0, 1.20, 4.0, 3.4, 0.22, 0.56, 0.38)
    addPlatform(world, platforms, 19.0, 0.10, 5.0, 4.5, 0.24, 0.48, 0.34)
    addPlatform(world, platforms, 25.0, 2.00, 3.0, 3.2, 0.30, 0.58, 0.40)
    addPlatform(world, platforms, 30.0, 0.50, 5.2, 4.5, 0.24, 0.50, 0.36)
    addPlatform(world, platforms, 37.0, 1.30, 4.2, 3.4, 0.28, 0.56, 0.40)
    addPlatform(world, platforms, 44.0, -0.10, 6.0, 5.0, 0.20, 0.46, 0.31)
    addPlatform(world, platforms, 51.0, 1.55, 3.2, 3.2, 0.30, 0.58, 0.41)
    addPlatform(world, platforms, 57.0, 0.15, 6.5, 5.0, 0.20, 0.48, 0.33)
    addPlatform(world, platforms, 65.0, 2.30, 3.5, 3.0, 0.32, 0.62, 0.44)
    addPlatform(world, platforms, 72.0, 0.00, 8.0, 5.0, 0.18, 0.44, 0.30)

    addCoin(world, coins, 3.0, 1.25, 0.0)
    addCoin(world, coins, 7.6, 1.75, 0.4)
    addCoin(world, coins, 12.2, 2.65, 0.8)
    addCoin(world, coins, 14.1, 2.65, 1.2)
    addCoin(world, coins, 18.2, 1.55, 1.6)
    addCoin(world, coins, 24.8, 3.45, 2.0)
    addCoin(world, coins, 29.2, 1.95, 2.4)
    addCoin(world, coins, 36.2, 2.75, 2.8)
    addCoin(world, coins, 43.0, 1.35, 3.2)
    addCoin(world, coins, 50.8, 3.05, 3.6)
    addCoin(world, coins, 56.0, 1.65, 4.0)
    addCoin(world, coins, 64.8, 3.80, 4.4)
    addCoin(world, coins, 70.0, 1.35, 4.8)
    addCoin(world, coins, 73.0, 1.35, 5.2)

    addWalker(world, walkers, 17.8, 1.0, 17.0, 21.0, 1.7)
    addWalker(world, walkers, 29.0, 1.4, 27.8, 31.8, -2.0)
    addWalker(world, walkers, 43.0, 0.8, 41.5, 46.0, 2.2)
    addWalker(world, walkers, 56.0, 1.1, 54.4, 59.6, -2.4)
    addWalker(world, walkers, 70.0, 0.9, 68.5, 74.0, 2.5)
}

/** Puts the player back at the start with full health, every coin back, and every walker on its beat. */
func resetSession(playerEntity: Entity, players: Storage<Player>!, transforms: Storage<Transform>!, coins: Storage<Coin>!,
                  walkers: Storage<Walker>!, score: ReactiveResource<Int>!, session: GameSession!) {
    storageInsert(players, playerEntity, freshPlayer())
    storageInsert(transforms, playerEntity, Transform(translation: .(-3.5, 1.2, 0.0)))
    for i in 1..<storageLength(coins) then coins.values[i].collected = false
    for w in 1..<storageLength(walkers) {
        let walker = walkers.values[w].!
        if walker.center.x <= walker.minX || walker.center.x >= walker.maxX then walker.center.x = (walker.minX + walker.maxX) * 0.5
    }
    score.set(0)
    session.elapsed = 0.0
    session.cameraX = -1.0
}

func readMoveInput(app: App&): Double {
    var movement: Double = 0.0
    if app.keyDown(.A) || app.keyDown(.Left) then movement -= 1.0
    if app.keyDown(.D) || app.keyDown(.Right) then movement += 1.0
    if App::controllerConnected(0) {
        fin axis = App::controllerAxis(0, .LeftX)
        if absReal(axis) > 0.18 then movement = axis
    }
    return clampReal(movement, -1.0, 1.0)
}

func jumpPressed(app: App&): Bool =
    app.keyPressed(.Space) || app.keyPressed(.Up) || (App::controllerConnected(0) && App::controllerButtonValue(0, .South) > 0.5)

func updateWalkers(walkers: Storage<Walker>!, dt: Double) {
    for i in 1..<storageLength(walkers) {
        let walker = walkers.values[i].!
        walker.center.x += walker.velocityX * dt
        if walker.center.x < walker.minX {
            walker.center.x = walker.minX
            walker.velocityX = absReal(walker.velocityX)
        }
        if walker.center.x > walker.maxX {
            walker.center.x = walker.maxX
            walker.velocityX = -absReal(walker.velocityX)
        }
    }
}

/** Pushes the player out of every platform it sinks into; true when one is underfoot. */
func solvePlatforms(position: Vec3!, velocity: Vec3!, platforms: Storage<Platform>&): Bool {
    var grounded = false
    for i in 1..<storageLength(platforms) {
        fin platform = platforms.values[i].&
        when boxContact3d(position, playerHalf(), platform.center, platform.halfSize) {
            .Touching(contact) -> {
                if contact.normal.y > 0.5 && velocity.y <= 0.0 {
                    position.y += contact.penetration
                    velocity.y = 0.0
                    grounded = true
                } else if contact.normal.y < -0.5 && velocity.y > 0.0 {
                    position.y -= contact.penetration
                    velocity.y = 0.0
                } else {
                    position.x += contact.normal.x * contact.penetration
                    velocity.x = 0.0
                }
            }
            .Separate -> continue
        }
    }
    return grounded
}

func collectCoins(position: Vec3, player: Player!, coins: Storage<Coin>!, score: ReactiveResource<Int>!) {
    for i in 1..<storageLength(coins) {
        let coin = coins.values[i].!
        if coin.collected || !overlapTouching3d(boxContact3d(position, playerHalf(), coin.center, .(0.34, 0.34, 0.34))) then continue
        coin.collected = true
        player.score += 100
        score.set(player.score)
    }
}

func hitWalker(position: Vec3, walkers: Storage<Walker>&): Bool = for i in 1..<storageLength(walkers) {
    if overlapTouching3d(boxContact3d(position, playerHalf(), walkers.values[i].center, .(0.48, 0.48, 0.48))) then break true
} else false

/** One step of the player; false once it has fallen off the world or run out of health. */
func updatePlayer(app: App&, player: Player!, transform: Transform!, platforms: Storage<Platform>&, coins: Storage<Coin>!,
                  walkers: Storage<Walker>&, score: ReactiveResource<Int>!, audio: AudioScene&, dt: Double): Bool {
    if player.invulnerableFor > 0.0 then player.invulnerableFor -= dt
    player.jumpBuffer = if jumpPressed(app) then 0.14 else player.jumpBuffer - dt
    player.coyoteTime = if player.grounded then 0.12 else player.coyoteTime - dt

    fin movement = readMoveInput(app)
    fin response = if player.grounded then moveResponse else airResponse
    player.velocity.x = approach(player.velocity.x, movement * moveSpeed, response * dt)
    if absReal(movement) > 0.05 then player.facing = movement

    if player.jumpBuffer > 0.0 && player.coyoteTime > 0.0 {
        player.velocity.y = jumpSpeed
        player.grounded = false
        player.coyoteTime = 0.0
        player.jumpBuffer = 0.0
    }
    player.velocity.y = clampReal(player.velocity.y - gravity * dt, -18.0, 1000.0)

    transform.translation.x += player.velocity.x * dt
    transform.translation.y += player.velocity.y * dt
    player.grounded = solvePlatforms(transform.translation, player.velocity, platforms)
    collectCoins(transform.translation, player, coins, score)

    if player.invulnerableFor <= 0.0 && hitWalker(transform.translation, walkers) {
        player.health--
        player.invulnerableFor = 1.1
        player.velocity.x = -player.facing * 7.5
        player.velocity.y = 6.5
        playCrash(audio, 0.45)
    }
    updateEngine(audio, absReal(player.velocity.x), absReal(movement), moveSpeed)
    return transform.translation.y > -10.0 && player.health > 0
}

func drawBox(app: App!, cube: Mesh&, center: Vec3, size: Vec3, color: Color&) {
    app.drawMesh(cube, mat4Mul(mat4Translation(center.x, center.y, center.z), mat4Scale(size.x, size.y, size.z)), color.r, color.g, color.b)
}

func drawBackdrop(app: App!, cube: Mesh&, cameraX: Double, elapsed: Double) {
    // Layered geometry gives the side camera depth and parallax.
    for i in -5..<18 {
        fin x = (i as Double) * 7.0 + cameraX * 0.22
        fin h: Double = 3.0 + (((i + 7) % 5) as Double) * 1.2
        drawBox(app, cube, .(x, h * 0.5 - 1.5, -12.0), .(5.5, h, 2.4), colorRgb(0.18, 0.28, 0.42))
    }
    for cloud in -3..<12 {
        fin drift = elapsed * (0.18 + (((cloud + 4) % 3) as Double) * 0.05)
        fin x = (cloud as Double) * 11.0 + drift + cameraX * 0.45
        fin y: Double = 6.0 + (((cloud + 8) % 4) as Double) * 0.75
        drawBox(app, cube, .(x, y, -7.0), .(2.8, 0.45, 1.0), colorRgb(0.84, 0.90, 0.98))
        drawBox(app, cube, .(x + 0.9, y + 0.3, -7.0), .(1.4, 0.55, 1.0), colorRgb(0.90, 0.94, 1.0))
    }
}

func renderWorld(app: App!, cube: Mesh&, cylinder: Mesh&, player: Player&, transform: Transform&, platforms: Storage<Platform>&,
                 coins: Storage<Coin>&, walkers: Storage<Walker>&, session: GameSession&) {
    drawBackdrop(app, cube, session.cameraX, session.elapsed)
    for p in 1..<storageLength(platforms) {
        fin platform = platforms.values[p].&
        drawBox(app, cube, platform.center, platform.halfSize.scale(2.0), platform.color)
        drawBox(app, cube, .(platform.center.x, platform.center.y + platform.halfSize.y + 0.07, platform.center.z),
            .(platform.halfSize.x * 2.0, 0.14, platform.halfSize.z * 2.0), colorRgb(0.43, 0.76, 0.36))
    }
    for c in 1..<storageLength(coins) {
        fin coin = coins.values[c].&
        if coin.collected then continue
        fin bob = sin(session.elapsed * 3.0 + coin.phase) * 0.12
        fin turn = mat4RotationY(session.elapsed * 2.5 + coin.phase)
        fin move = mat4Translation(coin.center.x, coin.center.y + bob, coin.center.z)
        app.drawMesh(cylinder, mat4Mul(move, mat4Mul(turn, mat4Scale(0.22, 0.08, 0.22))), 1.0, 0.78, 0.12)
    }
    for w in 1..<storageLength(walkers) {
        fin at = walkers.values[w].center
        drawBox(app, cube, at, .(0.9, 0.9, 0.8), colorRgb(0.82, 0.22, 0.30))
        drawBox(app, cube, .(at.x - 0.22, at.y - 0.55, 0.0), .(0.18, 0.28, 0.26), colorRgb(0.19, 0.16, 0.20))
        drawBox(app, cube, .(at.x + 0.22, at.y - 0.55, 0.0), .(0.18, 0.28, 0.26), colorRgb(0.19, 0.16, 0.20))
    }
    // A hit player blinks while it cannot be hit again.
    if player.invulnerableFor > 0.0 && ((player.invulnerableFor * 12.0) as Int) % 2 != 0 then return
    fin at = transform.translation
    drawBox(app, cube, at, .(0.84, 1.44, 0.76), colorRgb(0.16, 0.62, 0.96))
    drawBox(app, cube, .(at.x, at.y + 0.94, 0.0), .(0.64, 0.55, 0.64), colorRgb(0.96, 0.74, 0.54))
    drawBox(app, cube, .(at.x + player.facing * 0.22, at.y + 1.02, 0.34), .(0.09, 0.09, 0.05), colorRgb(0.06, 0.08, 0.12))
}

func drawHud(app: App!, player: Player&, score: ReactiveResource<Int>&) {
    app.uiRect(18.0, 18.0, 250.0, 76.0, 0.03, 0.05, 0.09, 0.82)
    app.uiText("SCORE  ${score.value}", 34.0, 31.0, 18.0)
    app.uiText("HEALTH ${player.health} / 3", 34.0, 61.0, 15.0)
    app.uiText("A/D move   SPACE jump   ESC pause", 20.0, (app.height() as Double) - 34.0, 13.0)
}

func drawMenuScene(app: App!, cube: Mesh&, elapsed: Double) {
    app.applyCamera(.(.(sin(elapsed * 0.18) * 2.0, 3.5, 11.5), 0.0, -0.16, 52.0))
    drawBackdrop(app, cube, 0.0, elapsed)
    drawBox(app, cube, .(0.0, -0.4, 0.0), .(14.0, 0.7, 5.0), colorRgb(0.20, 0.48, 0.31))
    drawBox(app, cube, .(0.0, 1.0 + sin(elapsed * 1.8) * 0.12, 0.0), .(0.9, 1.5, 0.8), colorRgb(0.16, 0.62, 0.96))
}

/** The title menu; 1 to play, 2 to quit, 0 while it waits. */
func drawMenu(app: App!, bestScore: Int): Int {
    fin panelWidth: Double = 420.0
    fin panelX = ((app.width() as Double) - panelWidth) * 0.5
    fin panelY = (app.height() as Double) * 0.19
    app.uiRect(panelX, panelY, panelWidth, 330.0, 0.025, 0.04, 0.075, 0.90)
    app.uiTitle("SKYLINE RUNNER", panelY + 38.0, 34.0)
    app.uiTitle("An Azora Engine side-scroller", panelY + 86.0, 15.0)
    if bestScore > 0 then app.uiTitle("Best score  ${bestScore}", panelY + 122.0, 15.0)
    app.uiTitle("Keyboard and gamepad supported", panelY + 302.0, 12.0)
    return when {
        app.button("PLAY", panelX + 70.0, panelY + 166.0, 280.0, 52.0) -> 1
        app.buttonColored("QUIT", panelX + 70.0, panelY + 236.0, 280.0, 48.0, 0.38, 0.42, 0.50) -> 2
        else -> 0
    }
}

/** The pause card; 1 to resume, 2 for the main menu, 0 while it waits. */
func drawPause(app: App!): Int {
    fin width = app.width() as Double
    fin height = app.height() as Double
    fin x = (width - 360.0) * 0.5
    fin y = height * 0.25
    app.uiRect(0.0, 0.0, width, height, 0.01, 0.02, 0.04, 0.62)
    app.uiRect(x, y, 360.0, 270.0, 0.035, 0.055, 0.095, 0.96)
    app.uiTitle("PAUSED", y + 34.0, 30.0)
    return when {
        app.button("RESUME", x + 55.0, y + 104.0, 250.0, 48.0) -> 1
        app.buttonColored("MAIN MENU", x + 55.0, y + 172.0, 250.0, 48.0, 0.38, 0.42, 0.50) -> 2
        else -> 0
    }
}

/** The run-over card; 1 to run again, 2 for the main menu, 0 while it waits. */
func drawGameOver(app: App!, score: Int, bestScore: Int): Int {
    fin width = app.width() as Double
    fin height = app.height() as Double
    fin x = (width - 410.0) * 0.5
    fin y = height * 0.20
    app.uiRect(0.0, 0.0, width, height, 0.02, 0.01, 0.025, 0.68)
    app.uiRect(x, y, 410.0, 330.0, 0.07, 0.035, 0.055, 0.96)
    app.uiTitle("RUN OVER", y + 34.0, 31.0)
    app.uiTitle("Score ${score}   Best ${bestScore}", y + 91.0, 17.0)
    return when {
        app.button("RUN AGAIN", x + 65.0, y + 151.0, 280.0, 50.0) -> 1
        app.buttonColored("MAIN MENU", x + 65.0, y + 220.0, 280.0, 48.0, 0.38, 0.42, 0.50) -> 2
        else -> 0
    }
}

async func main() {
    var app = appInit("Skyline Runner - Azora Engine", 1280, 720)
    if !app.ok then return

    var audio = scene()
    start(audio)
    app.setClearColor(0.48, 0.68, 0.90)
    app.setLightDirection(-0.55, 0.82, 0.28)
    app.setAmbientLight(0.38)
    fin cube = app.meshCube(1.0)
    fin cylinder = app.meshCylinder(1.0, 1.0, 18)

    var world: World = .()
    var transforms = storageInit(Transform())
    var players = storageInit(freshPlayer())
    var platforms = storageInit(Platform(vec3Zero(), .(1.0, 1.0, 1.0), colorRgb(0.3, 0.6, 0.4)))
    var coins = storageInit(Coin(vec3Zero(), true, 0.0))
    var walkers = storageInit(Walker(vec3Zero(), 0.0, 0.0, 0.0))
    fin playerEntity = world.spawnNamed("Player")
    buildLevel(world, platforms, coins, walkers)

    var route: GameRoute = .Menu
    var score = reactiveResource(0)
    var session: GameSession = .(0.0, -1.0, 0)
    resetSession(playerEntity, players, transforms, coins, walkers, score, session)
    var camera: Camera = .(vec3Zero(), 0.0, -0.13, 55.0)

    while app.frame() {
        scope {
            fin dt = clampReal(app.deltaTime(), 0.0, 0.05)
            session.elapsed += dt
            world.progress(dt)
            let player = players.values[storageIndexOf(players, playerEntity)].!
            let transform = transforms.values[storageIndexOf(transforms, playerEntity)].!
            if route != .Menu {
                session.cameraX = approach(session.cameraX, transform.translation.x + 3.2, 8.0 * dt)
                camera.pos = .(session.cameraX, 3.6, 12.0)
                app.applyCamera(camera)
            }
            when route {
                .Menu -> {
                    updateEngine(audio, 0.0, 0.0, moveSpeed)
                    drawMenuScene(app, cube, session.elapsed)
                    fin action = drawMenu(app, session.bestScore)
                    if action == 1 || app.keyPressed(.Enter) {
                        resetSession(playerEntity, players, transforms, coins, walkers, score, session)
                        route = .Playing
                    }
                    if action == 2 || app.keyPressed(.Escape) then app.quit()
                }
                .Playing -> {
                    updateWalkers(walkers, dt)
                    fin alive = updatePlayer(app, player, transform, platforms, coins, walkers, score, audio, dt)
                    renderWorld(app, cube, cylinder, player, transform, platforms, coins, walkers, session)
                    drawHud(app, player, score)
                    if app.keyPressed(.Escape) {
                        route = .Paused
                    } else if !alive {
                        if player.score > session.bestScore then session.bestScore = player.score
                        playCrash(audio, 0.8)
                        route = .GameOver
                    }
                }
                .Paused -> {
                    renderWorld(app, cube, cylinder, player, transform, platforms, coins, walkers, session)
                    drawHud(app, player, score)
                    updateEngine(audio, 0.0, 0.0, moveSpeed)
                    fin action = drawPause(app)
                    if action == 1 || app.keyPressed(.Escape) {
                        route = .Playing
                    } else if action == 2 then route = .Menu
                }
                .GameOver -> {
                    renderWorld(app, cube, cylinder, player, transform, platforms, coins, walkers, session)
                    updateEngine(audio, 0.0, 0.0, moveSpeed)
                    fin action = drawGameOver(app, player.score, session.bestScore)
                    if action == 1 || app.keyPressed(.Enter) {
                        resetSession(playerEntity, players, transforms, coins, walkers, score, session)
                        route = .Playing
                    } else if action == 2 || app.keyPressed(.Escape) then route = .Menu
                }
            }
            app.present()
        }
    }
    stop(audio)
    app.shutdown()
}
