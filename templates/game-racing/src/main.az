}

func buildCivicQuarter(world: World!, props: Storage<Prop>!) {
    fin cx: Double = 0.0
    fin cz: Double = 72.0
    fin limestone = colorRgb(0.81, 0.77, 0.68)
    addCityPiece(world, props, .(cx, 0.12, cz), .(44.0, 0.24, 31.0), colorRgb(0.62, 0.61, 0.57), false)
    addCityPiece(world, props, .(cx, 4.0, cz), .(31.0, 7.5, 19.0), limestone, true)
    addCityPiece(world, props, .(cx, 8.1, cz), .(35.0, 0.65, 22.0), colorRgb(0.48, 0.46, 0.42), false)
    addCityPiece(world, props, .(cx, 12.0, cz), .(8.0, 7.5, 8.0), limestone, false)
    addCityPiece(world, props, .(cx, 16.0, cz), .(1.1, 2.5, 1.1), colorRgb(0.25, 0.28, 0.32), false)
    for column in -4..4 then addCityPiece(world, props, .((column as Double) * 2.7, 3.0, cz - 9.6), .(0.48, 5.5, 0.48), colorRgb(0.90, 0.87, 0.79), false)
}

func buildObservationTower(world: World!, props: Storage<Prop>!) {
    fin cx: Double = 144.0
    fin cz: Double = 0.0
    addCityPiece(world, props, .(cx, 0.12, cz), .(22.0, 0.24, 22.0), colorRgb(0.55, 0.57, 0.59), false)
    addCityPiece(world, props, .(cx, 18.0, cz), .(5.0, 36.0, 5.0), colorRgb(0.60, 0.63, 0.65), true)
    addCityPiece(world, props, .(cx, 34.0, cz), .(13.0, 4.0, 13.0), colorRgb(0.08, 0.28, 0.39), false)
    addCityPiece(world, props, .(cx, 39.0, cz), .(7.0, 6.0, 7.0), colorRgb(0.76, 0.78, 0.77), false)
    addCityPiece(world, props, .(cx, 45.0, cz), .(0.45, 8.0, 0.45), colorRgb(0.88, 0.35, 0.18), false)
}

func isLandmarkBlock(gx: Int, gz: Int): Bool {
    return when {
        gz == -2 -> true
        gx == 0 && gz == 0 -> true
        (gx == -2 || gx == -1) && gz == -1 -> true
        (gx == 2 || gx == 3) && gz == 0 -> true
        (gx == -2 || gx == -1) && (gz == 1 || gz == 2) -> true
        gx >= 3 && gx <= 5 && gz >= 3 && gz <= 5 -> true
        gx >= -5 && gx <= -3 && gz >= 2 && gz <= 4 -> true
        gx >= -6 && gx <= -4 && gz == -3 -> true
        gx >= -1 && gx <= 1 && gz == 3 -> true
        gx == 6 && gz == 0 -> true
        else -> false
    }
}

// Persistent landmark geometry is authored once. Ordinary blocks are generated,
// deterministically around the camera by queueStreamedCity.
func buildCity(world: World!, props: Storage<Prop>!) {
    buildCentralPlaza(world, props)
    buildPark(world, props)
    buildMuseum(world, props)
    buildSoccerGround(world, props)
    buildRiverAndBridge(world, props)
    buildTrainStation(world, props)
    buildMall(world, props)
    buildAquarium(world, props)
    buildCivicQuarter(world, props)
    buildObservationTower(world, props)
    buildRoadMarkings(world, props)
}

// ── Input ─────────────────────────────────────────────────────────────────

// ── Input ─────────────────────────────────────────────────────────────────

pack DriveInput {
    var throttle: Double
    var steer: Double
}

// True while the pointer is held down inside the rectangle (unlike `button`,
// which fires once per click) — the basis for hold-to-drive touch pedals.
func padHeld(app: App&, x: Double, y: Double, w: Double, h: Double): Bool = app.hovered(x, y, w, h) && app.mouseDown(.Left)

func drawPad(app: App!, label: String, x: Double, y: Double, w: Double, h: Double, r: Double, g: Double, b: Double) {
    fin shade = if padHeld(app, x, y, w, h) then 0.7 else 1.0
    app.uiRect(x + 2.0, y + 3.0, w, h, 0.0, 0.0, 0.0, 0.22)
    app.uiRect(x, y, w, h, r * shade, g * shade, b * shade, 0.92)
    fin ts: Double = 16.0
    fin tw = app.uiTextWidth(label, ts)
    app.uiTextColored(label, x + (w - tw) * 0.5, y + (h - app.uiTextHeight(ts)) * 0.5, ts, 1.0, 1.0, 1.0)
}

func drawDrivePads(app: App!) {
    fin bottom = (app.height() as Double) - 96.0
    fin rx = (app.width() as Double) - 190.0
    drawPad(app, "<", 24.0, bottom, 78.0, 78.0, 0.24, 0.52, 0.96)
    drawPad(app, ">", 112.0, bottom, 78.0, 78.0, 0.24, 0.52, 0.96)
    drawPad(app, "BRAKE", rx, bottom, 78.0, 78.0, 0.90, 0.30, 0.30)
    drawPad(app, "GAS", rx + 88.0, bottom, 78.0, 78.0, 0.30, 0.82, 0.42)
}

// Fold keyboard, gamepad and on-screen pedals into one drive command.
func gatherInput(app: App&): DriveInput {
    var throttle: Double = 0.0
    var steer: Double = 0.0
    if app.keyDown(.Up) || app.keyDown(.W) then throttle += 1.0
    if app.keyDown(.Down) || app.keyDown(.S) then throttle -= 1.0
    if app.keyDown(.Left) || app.keyDown(.A) then steer += 1.0
    if app.keyDown(.Right) || app.keyDown(.D) then steer -= 1.0
    if App::controllerConnected(0) {
        throttle += App::controllerButtonValue(0, .RightTrigger) - App::controllerButtonValue(0, .LeftTrigger)
        steer -= App::controllerAxis(0, .LeftX)
    }
    fin bottom = (app.height() as Double) - 96.0
    fin rx = (app.width() as Double) - 190.0
    if padHeld(app, 24.0, bottom, 78.0, 78.0) then steer += 1.0
    if padHeld(app, 112.0, bottom, 78.0, 78.0) then steer -= 1.0
    if padHeld(app, rx, bottom, 78.0, 78.0) then throttle -= 1.0
    if padHeld(app, rx + 88.0, bottom, 78.0, 78.0) then throttle += 1.0
    return .(clampReal(throttle, -1.0, 1.0), clampReal(steer, -1.0, 1.0))
}

