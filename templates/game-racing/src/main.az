]


func flatDistance(a: Vec3, b: Vec3): Double {
    fin dx = a.x - b.x
    fin dz = a.z - b.z
    return sqrt(dx * dx + dz * dz)
}

func nearestBlockCoord(value: Double): Int {
    fin scaled = value / blockStep
    return (if scaled >= 0.0 then scaled + 0.5 else scaled - 0.5) as Int
}

func insideCity(gx: Int, gz: Int): Bool = gx > -cityHalfBlocks && gx < cityHalfBlocks && gz > -cityHalfBlocks && gz < cityHalfBlocks

func blockVariation(gx: Int, gz: Int): Double = ((((gx * 17 + gz * 29) % 7) + 7) % 7) as Double

func streamedBuildingHeight(gx: Int, gz: Int, second: Bool): Double {
    fin centerDistance = absReal(gx as Double) + absReal(gz as Double)
    var height: Double = 7.0 + blockVariation(gx, gz) * 1.65
    if centerDistance < 12.0 then height += (12.0 - centerDistance) * 0.72
    return if second then height * 0.68 + 2.2 else height
}

func carRight(car: Car&): Vec3 = .(cos(car.yaw), 0.0, -sin(car.yaw))

func cardinalYaw(from: Vec3, to: Vec3): Double {
    fin dx = to.x - from.x
    fin dz = to.z - from.z
    if absReal(dx) > absReal(dz) then return if dx > 0.0 then -PI * 0.5 else PI * 0.5
    return if dz > 0.0 then PI else 0.0
}

func trafficHasCarAhead(car: Car&, cars: Storage<Car>&, selfIndex: Int): Bool = for i in 1..<storageLength(cars) {
    fin other = cars.values[i].&
    if i == selfIndex || other.routeIndex != car.routeIndex then continue
    fin delta = other.pos - car.pos
    fin distance = flatDistance(other.pos, car.pos)
    if distance > 0.01 && distance < 9.0 && car.forward().dot(delta) > 0.0 && absReal(carRight(car).dot(delta)) < 2.8 then break true
} else false

func signalIsRed(car: Car&, route: TrafficRoute&, elapsed: Double): Bool =
    flatDistance(car.pos, route.points[car.waypointIndex]) <= 7.0 && ((elapsed / 6.0) as Int) % 2 != car.routeIndex % 2

func driveTrafficCar(car: Car!, route: TrafficRoute&, blocked: Bool, elapsed: Double, dt: Double) {
    if flatDistance(car.pos, route.points[car.waypointIndex]) < 3.0 then car.waypointIndex = (car.waypointIndex + 1) % route.points.size
    fin desired = (route.points[car.waypointIndex] - car.pos).normalized
    fin alignment = car.forward().dot(desired)
    fin steering = clampReal(-carRight(car).dot(desired) * 2.4, -1.0, 1.0)
    var throttle: Double = when {
        alignment < 0.45 -> 0.12
        car.speed >= car.targetSpeed -> 0.0
        else -> 0.62
    }
    if blocked || signalIsRed(car, route, elapsed) {
        car.speed = clampReal(car.speed - brake * dt, 0.0, car.targetSpeed)
        throttle = 0.0
    }
    car.drive(throttle, steering, dt)
}

/** What [car] has run into among the generated buildings of the block under it. */
func streamedBuildingContact(car: Car&): Overlap3D {
    fin gx = nearestBlockCoord(car.pos.x)
    fin gz = nearestBlockCoord(car.pos.z)
    if !insideCity(gx, gz) || isLandmarkBlock(gx, gz) then return .Separate
    fin cx = (gx as Double) * blockStep
    fin cz = (gz as Double) * blockStep
    fin h1 = streamedBuildingHeight(gx, gz, false)
    fin h2 = streamedBuildingHeight(gx, gz, true)
    fin first = boxContact3d(car.pos, carHalf(), .(cx - 3.55, h1 * 0.5 + 0.20, cz), .(3.125, h1 * 0.5, 5.9))
    if overlapTouching3d(first) then return first
    return boxContact3d(car.pos, carHalf(), .(cx + 3.55, h2 * 0.5 + 0.20, cz), .(3.125, h2 * 0.5, 5.9))
}

/** The first building [car] has run into, streamed or authored. */
func buildingContact(car: Car&, props: Storage<Prop>&): Overlap3D {
    fin streamed = streamedBuildingContact(car)
    if overlapTouching3d(streamed) then return streamed
    return for i in 1..<storageLength(props) {
        fin piece = props.values[i].&
        if !piece.solid then continue
        fin contact = boxContact3d(car.pos, carHalf(), piece.pos, piece.scale.scale(0.5))
        if overlapTouching3d(contact) then break contact
    } else .Separate
}

/** Pushes car [selfIndex] out of what it ran into; true when it hit something. */
func resolveCarContacts(cars: Storage<Car>!, props: Storage<Prop>&, selfIndex: Int): Bool {
    when buildingContact(cars.values[selfIndex], props) {
        .Touching(contact) -> {
            let car = cars.values[selfIndex].!
            car.pos += contact.normal.scale(contact.penetration + 0.02)
            car.speed *= -0.16
            return true
        }
        .Separate -> {}
    }
    for i in 1..<storageLength(cars) {
        if i == selfIndex then continue
        when boxContact3d(cars.values[selfIndex].pos, carHalf(), cars.values[i].pos, carHalf()) {
            .Touching(contact) -> {
                cars.values[selfIndex].pos += contact.normal.scale(contact.penetration * 0.58 + 0.01)
                cars.values[i].pos -= contact.normal.scale(contact.penetration * 0.42 + 0.01)
                cars.values[selfIndex].speed *= 0.28
                cars.values[i].speed *= 0.45
                return true
            }
            .Separate -> continue
        }
    }
    return false
}

func advanceCars(cars: Storage<Car>!, routes: Array<TrafficRoute>&, traffic: TrafficSimulation!, input: DriveInput&, dt: Double) {
    traffic.elapsed += dt
    for i in 1..<storageLength(cars) {
        if cars.values[i].isPlayer {
            cars.values[i].drive(input.throttle, input.steer, dt)
            continue
        }
        fin blocked = trafficHasCarAhead(cars.values[i], cars, i)
        driveTrafficCar(cars.values[i], routes[cars.values[i].routeIndex], blocked, traffic.elapsed, dt)
    }
}

func solveCarContacts(cars: Storage<Car>!, props: Storage<Prop>&): Bool {
    var playerCrashed = false
    for i in 1..<storageLength(cars) {
        if !resolveCarContacts(cars, props, i) then continue
        if cars.values[i].isPlayer then playerCrashed = true else cars.values[i].speed *= 0.15
    }
    return playerCrashed
}

// Movement and collision are separate deterministic simulation phases.
func simulateCars(cars: Storage<Car>!, props: Storage<Prop>&, routes: Array<TrafficRoute>&, traffic: TrafficSimulation!,
                  input: DriveInput&, dt: Double): Bool {
    advanceCars(cars, routes, traffic, input, dt)
    if traffic.crashCooldown > 0.0 then traffic.crashCooldown -= dt
    if !solveCarContacts(cars, props) || traffic.crashCooldown > 0.0 then return false
    traffic.crashCooldown = 0.48
    return true
}

func districtName(pos: Vec3): String = when {
    pos.x > 66.0 && pos.x < 126.0 && pos.z > 78.0 && pos.z < 124.0 -> "Grand Central Station"
    pos.x < -64.0 && pos.x > -128.0 && pos.z > 46.0 && pos.z < 96.0 -> "Metropolitan Mall"
    pos.x < -88.0 && pos.x > -136.0 && pos.z < -54.0 && pos.z > -90.0 -> "Riverside Aquarium"
    pos.x > 132.0 && pos.x < 156.0 && pos.z > -14.0 && pos.z < 14.0 -> "Skyline Observation Tower"
    pos.x > -24.0 && pos.x < 24.0 && pos.z > 56.0 && pos.z < 88.0 -> "Civic Quarter"
    pos.x < -27.0 && pos.x > -69.0 && pos.z > 31.0 && pos.z < 65.0 -> "City Football Ground"
    pos.x < -27.0 && pos.x > -69.0 && pos.z < -15.0 && pos.z > -33.0 -> "Riverside Park"
    pos.x > 40.0 && pos.z > -10.0 && pos.z < 10.0 -> "Museum Quarter"
    absReal(pos.x) < 18.0 && absReal(pos.z) < 18.0 -> "Central Pedestrian Plaza"
    else -> "Downtown"
}

// Third-person chase camera: sit behind and above the player, looking forward.
func chaseCamera(cam: Camera!, car: Car&) {
    fin f = car.forward()
    cam.pos = .(car.pos.x - f.x * 9.0, car.pos.y + 4.2, car.pos.z - f.z * 9.0)
    cam.yaw = car.yaw
    cam.pitch = -0.22
}

func pushCube(queue: RenderQueue!, cube: Mesh&, pos: Vec3, rot: Vec3, scale: Vec3, color: Color) {
    queue.add(cube, .(pos, rot, scale), materialColor(color))
}

func queueCity(queue: RenderQueue!, cube: Mesh&, props: Storage<Prop>&) {
    for p in 1..<storageLength(props) {
        fin piece = props.values[p].&
        if piece.solid && piece.scale.y > 1.0 {
            fin shadow: Vec3 = .(piece.pos.x - piece.scale.y * 0.22, 0.026, piece.pos.z + piece.scale.y * 0.14)
            pushCube(queue, cube, shadow, vec3Zero(), .(piece.scale.x * 1.03, 0.025, piece.scale.z * 1.03), colorRgb(0.075, 0.08, 0.09))
        }
        pushCube(queue, cube, piece.pos, vec3Zero(), piece.scale, piece.color)
    }
}


func queueStreamedBlock(queue: RenderQueue!, cube: Mesh&, gx: Int, gz: Int) {
    if isLandmarkBlock(gx, gz) || !insideCity(gx, gz) then return

    fin cx = (gx as Double) * blockStep
    fin cz = (gz as Double) * blockStep
    fin variation = blockVariation(gx, gz)
    fin h1 = streamedBuildingHeight(gx, gz, false)
    fin h2 = streamedBuildingHeight(gx, gz, true)
    fin shade: Double = 0.30 + variation * 0.045
    fin wall1 = colorRgb(shade * 1.08, shade, shade * 0.91)
    fin wall2 = colorRgb(shade * 0.82, shade * 0.91, shade * 1.08)
    fin glass = colorRgb(0.08, 0.25 + variation * 0.014, 0.36 + variation * 0.018)

    pushCube(queue, cube, .(cx, 0.10, cz), vec3Zero(), .(blockSurface, 0.20, blockSurface), colorRgb(0.49, 0.51, 0.53))

    // Cheap projected geometry gives every streamed building a stable shadow.
    pushCube(queue, cube, .(cx - 4.0, 0.026, cz + 0.8), vec3Zero(), .(6.45, 0.025, 12.1), colorRgb(0.075, 0.08, 0.09))
    pushCube(queue, cube, .(cx + 3.1, 0.026, cz + 0.7), vec3Zero(), .(6.45, 0.025, 12.1), colorRgb(0.075, 0.08, 0.09))
    pushCube(queue, cube, .(cx - 3.55, h1 * 0.5 + 0.20, cz), vec3Zero(), .(6.25, h1, 11.8), wall1)
    pushCube(queue, cube, .(cx + 3.55, h2 * 0.5 + 0.20, cz), vec3Zero(), .(6.25, h2, 11.8), wall2)
    pushCube(queue, cube, .(cx - 3.55, h1 * 0.62, cz + 5.94), vec3Zero(), .(4.8, 1.25, 0.08), glass)
    pushCube(queue, cube, .(cx + 3.55, h2 * 0.61, cz + 5.94), vec3Zero(), .(4.8, 1.05, 0.08), glass)

    // Local centerline dashes make the million-block road grid legible without,
    // storing road entities for the whole world.
    pushCube(queue, cube, .(cx - 12.0, 0.035, cz), vec3Zero(), .(0.14, 0.04, 3.8), colorRgb(0.94, 0.75, 0.18))
    pushCube(queue, cube, .(cx, 0.035, cz - 12.0), vec3Zero(), .(3.8, 0.04, 0.14), colorRgb(0.94, 0.75, 0.18))
}

func queueStreamedCity(queue: RenderQueue!, cube: Mesh&, focus: Vec3) {
    fin centerX = nearestBlockCoord(focus.x)
    fin centerZ = nearestBlockCoord(focus.z)
    for gx in centerX - streamRadius..centerX + streamRadius {
        for gz in centerZ - streamRadius..centerZ + streamRadius then queueStreamedBlock(queue, cube, gx, gz)
    }
}

func buildClouds(): Array<Cloud> = [
    Cloud(vec3Zero(), .(1.0, 1.0, 1.0), 0.0)
    Cloud(.(-72.0, 30.0, -62.0), .(14.0, 2.4, 6.0), 1.4)
    Cloud(.(-20.0, 35.0, -88.0), .(18.0, 3.1, 7.0), 1.0)
    Cloud(.(38.0, 27.0, -45.0), .(12.0, 2.2, 5.5), 1.7)
    Cloud(.(78.0, 38.0, 8.0), .(20.0, 3.5, 8.0), 0.8)
    Cloud(.(-88.0, 32.0, 42.0), .(15.0, 2.8, 6.5), 1.2)
]

func updateAndRenderSky(queue: RenderQueue!, cube: Mesh&, sun: Mesh&, clouds: Array<Cloud>!, focus: Vec3, dt: Double) {
    queue.add(sun, .(focus + Vec3(52.0, 48.0, -88.0), vec3Zero(), .(6.0, 6.0, 6.0)), materialColor(colorRgb(1.0, 0.73, 0.18)))
    for i in 1..<clouds.size {
        let cloud = clouds[i].!
        cloud.pos.x += cloud.speed * dt
        if cloud.pos.x > 110.0 then cloud.pos.x = -110.0
        fin cloudWorld = focus + cloud.pos
        pushCube(queue, cube, cloudWorld, vec3Zero(), cloud.scale, colorRgb(0.92, 0.94, 0.96))
        pushCube(queue, cube, cloudWorld + Vec3(cloud.scale.x * 0.22, 1.2, 0.0), vec3Zero(), cloud.scale.scale(0.62), colorRgb(0.97, 0.98, 1.0))
    }
}

func renderRiver(queue: RenderQueue!, cube: Mesh&, elapsed: Double, focus: Vec3) {
    if absReal(focus.z + 48.0) > 180.0 then return
    for strip in -7..7 {
        fin phase = elapsed * 1.8 + (strip as Double) * 0.72
        fin wave = sin(phase) * 0.07
        fin blue: Double = 0.52 + sin(phase * 0.73) * 0.05
        pushCube(queue, cube, .(focus.x, 0.04 + wave, -48.0 + (strip as Double)), vec3Zero(), .(360.0, 0.08, 1.08), colorRgb(0.08, 0.30, blue))
    }
}

func carPoint(car: Car&, x: Double, y: Double, z: Double): Vec3 =
    car.pos + carRight(car).scale(x) + Vec3(0.0, y, 0.0) + car.forward().scale(z)

func pushWheel(queue: RenderQueue!, wheel: Mesh&, car: Car&, x: Double, z: Double, steering: Double) {
    fin wheelPos = carPoint(car, x, -0.18, z)
    fin wheelRot: Vec3 = .(car.wheelSpin, car.yaw + steering, 0.0)
    queue.add(wheel, .(wheelPos, wheelRot, .(1.0, 1.0, 1.0)), materialColor(colorRgb(0.035, 0.04, 0.045)))
    queue.add(wheel, .(wheelPos, wheelRot, .(1.08, 0.52, 0.52)), materialColor(colorRgb(0.34, 0.36, 0.38)))
}

func renderCar(queue: RenderQueue!, cube: Mesh&, wheel: Mesh&, car: Car&) {
    fin rot: Vec3 = .(0.0, car.yaw, 0.0)
    fin dark = colorRgb(0.055, 0.06, 0.07)
    fin glass = colorRgb(0.08, 0.20, 0.27)

    // Projected contact shadow anchors the vehicle to the road surface.
    pushCube(queue, cube, .(car.pos.x - 0.32, 0.028, car.pos.z + 0.20), rot, .(2.20, 0.025, 4.05), colorRgb(0.055, 0.06, 0.07))

    // Chassis, body, hood and cabin establish a recognisable low-poly car.
    pushCube(queue, cube, carPoint(car, 0.0, -0.10, 0.0), rot, .(1.92, 0.30, 3.55), dark)
    pushCube(queue, cube, carPoint(car, 0.0, 0.12, 0.0), rot, .(1.78, 0.55, 3.35), car.color)
    pushCube(queue, cube, carPoint(car, 0.0, 0.42, 0.92), rot, .(1.62, 0.25, 1.30), car.color)
    pushCube(queue, cube, carPoint(car, 0.0, 0.62, -0.28), rot, .(1.42, 0.78, 1.55), glass)
    pushCube(queue, cube, carPoint(car, 0.0, 0.72, 0.51), rot, .(1.30, 0.46, 0.10), colorRgb(0.16, 0.34, 0.42))

    // Ackermann-style front steering: the inside wheel turns more sharply.
    fin turningLeft = car.wheelSteer > 0.0
    fin leftSteer = car.wheelSteer * (if turningLeft then 1.16 else 0.88)
    fin rightSteer = car.wheelSteer * (if turningLeft then 0.88 else 1.16)
    pushWheel(queue, wheel, car, -1.00, 1.12, leftSteer)
    pushWheel(queue, wheel, car, 1.00, 1.12, rightSteer)
    pushWheel(queue, wheel, car, -1.00, -1.12, 0.0)
    pushWheel(queue, wheel, car, 1.00, -1.12, 0.0)

    // Headlights and tail-light bar communicate front and direction at speed.
    pushCube(queue, cube, carPoint(car, -0.55, 0.14, 1.70), rot, .(0.36, 0.18, 0.08), colorRgb(1.0, 0.88, 0.50))
    pushCube(queue, cube, carPoint(car, 0.55, 0.14, 1.70), rot, .(0.36, 0.18, 0.08), colorRgb(1.0, 0.88, 0.50))
    pushCube(queue, cube, carPoint(car, 0.0, 0.14, -1.70), rot, .(1.20, 0.15, 0.08), colorRgb(0.88, 0.06, 0.05))
}

func renderTraffic(queue: RenderQueue!, cube: Mesh&, wheel: Mesh&, cars: Storage<Car>&) {
    for c in 1..<storageLength(cars) then renderCar(queue, cube, wheel, cars.values[c])
}

// ── Entry point ───────────────────────────────────────────────────────────

async func main() {
    var app = appInit("__AZORA_PROJECT_NAME__ — Azora Racing", 1280, 720)
    if !app.ok then return
    var audio = scene()
    start(audio)
    defer {
        stop(audio)
        app.shutdown()
    }

    app.setClearColor(0.53, 0.70, 0.92)
    app.setLightDirection(-0.48, 0.86, 0.31)
    app.setAmbientLight(0.34)

    fin cube = app.meshCube(1.0)
    fin wheel = app.meshCylinder(0.48, 0.34, 14)
    fin sun = app.meshCylinder(1.0, 0.8, 24)
    fin ground = app.meshGrid(cityLimit, 64)

    var world: World = .()
    var props = storageInit(Prop(vec3Zero(), .(1.0, 1.0, 1.0), colorRgb(0.0, 0.0, 0.0), false))
    var cars = storageInit(newCar(.(0.0, 0.35, 0.0), 0.0, 0.0, colorRgb(0.90, 0.22, 0.26), false, -1, 0, 0.0))
    var staticQueue = renderQueueInit()
    var dynamicQueue = renderQueueInit()
    var cam = cameraDefault()
    fin routes = buildTrafficRoutes()
    var traffic: TrafficSimulation = .(0.0, 0.0)
    var clouds = buildClouds()
    buildCity(world, props)

    // Player is always car index 1.
    spawnWith(world, cars, newCar(.(-9.8, 0.35, 4.0), 0.0, 0.0, colorRgb(0.92, 0.24, 0.28), true, -1, 0, 0.0))
    for a in 0..<30 {
        fin routeIndex = (a % 6) + 1
        fin route = routes[routeIndex].&
        fin pointIndex = ((a / 6) * 2) % route.points.size
        fin nextIndex = (pointIndex + 1) % route.points.size
        fin trafficPos = route.points[pointIndex]
        fin color = colorRgb(0.25 + ((a % 5) as Double) * 0.13, 0.34 + (((a + 2) % 4) as Double) * 0.12, 0.38 + (((a + 4) % 5) as Double) * 0.11)
        spawnWith(world, cars, newCar(trafficPos, cardinalYaw(trafficPos, route.points[nextIndex]), 3.5 + ((a % 3) as Double), color, false,
            routeIndex, nextIndex, 8.0 + ((a % 4) as Double) * 0.65))
    }

    // Static city geometry is queued once; only moving cars rebuild each frame.
    pushCube(staticQueue, ground, vec3Zero(), vec3Zero(), .(1.0, 1.0, 1.0), colorRgb(0.16, 0.18, 0.20))
    queueCity(staticQueue, cube, props)

    while app.frame() {
        scope {
            fin dt = app.deltaTime()
            world.progress(dt)
            fin input = gatherInput(app)
            fin crashed = simulateCars(cars, props, routes, traffic, input, dt)
            fin player = cars.values[1].&
            updateEngine(audio, absReal(player.speed), input.throttle, maxSpeed)
            if crashed then playCrash(audio, clampReal(absReal(player.speed) / 12.0, 0.25, 1.0))
            chaseCamera(cam, player)
            app.applyCamera(cam)

            dynamicQueue.clear()
            queueStreamedCity(dynamicQueue, cube, player.pos)
            renderRiver(dynamicQueue, cube, traffic.elapsed, player.pos)
            updateAndRenderSky(dynamicQueue, cube, sun, clouds, player.pos, dt)
            renderTraffic(dynamicQueue, cube, wheel, cars)
            app.drawRenderQueue(staticQueue)
            app.drawRenderQueue(dynamicQueue)
            drawDrivePads(app)

            app.uiText("Speed ${(absReal(player.speed) * 3.6) as Int} km/h", 20.0, 24.0, 20.0)
            app.uiText(districtName(player.pos), 20.0, 52.0, 15.0)
            app.uiText("WASD / arrows / gamepad / touch - ESC to quit", 20.0, 76.0, 13.0)
            if app.keyPressed(.Escape) then app.quit()
            app.present()
        }
    }
}
