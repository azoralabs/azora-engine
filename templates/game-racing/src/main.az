// Azora Racing - a low-poly open-city racer.
//
// A drivable car in a streamed 1000-by-1000-block city with broad streets,
// pedestrian districts, rail infrastructure, civic landmarks, shopping and
// waterfront destinations. AI traffic follows closed lane routes, observes
// timed intersections, keeps following distance, and shares the same collision
// system as the player.

module game

import std.math
import engine

// ── Components ────────────────────────────────────────────────────────────

// A car: kinematic body driven by throttle/steer each frame.
pack Car {
    var pos: Vec3
    var yaw: Double
    var speed: Double
    var wheelSpin: Double
    var wheelSteer: Double
    var color: Color
    var isPlayer: Bool
    var routeIndex: Int
    var waypointIndex: Int
    var targetSpeed: Double
}

// A static piece of the city (building or road tile).
pack Prop {
    var pos: Vec3
    var scale: Vec3
    var color: Color
    var solid: Bool
}

/** A closed, ordered lane path used by autonomous traffic. */
pack TrafficRoute {
    var points: Array<Vec3>
}

/** Shared traffic timing keeps intersections deterministic. */
pack TrafficSimulation {
    var elapsed: Double
    var crashCooldown: Double
}

/** Slowly moving sky geometry shared by the presentation layer. */
pack Cloud {
    var pos: Vec3
    var scale: Vec3
    var speed: Double
}

// ── Tuning ────────────────────────────────────────────────────────────────

inline fin maxSpeed: Double = 30.0
inline fin reverseSpeed: Double = 8.0
inline fin accel: Double = 20.0
inline fin brake: Double = 36.0
inline fin friction: Double = 7.0
inline fin blockStep: Double = 24.0
inline fin blockSurface: Double = 15.5
inline fin cityHalfBlocks = 500
inline fin cityLimit: Double = 11990.0
inline fin streamRadius = 5

func clampReal(x: Double, lo: Double, hi: Double): Double = when {
    x < lo -> lo
    x > hi -> hi
    else -> x
}

/** Half extents of every car's collision box. */
func carHalf(): Vec3 = .(0.95, 0.65, 1.8)

// ── Car behaviour ─────────────────────────────────────────────────────────

func newCar(pos: Vec3, yaw: Double, speed: Double, color: Color, isPlayer: Bool, routeIndex: Int, waypointIndex: Int,
            targetSpeed: Double): Car = .(pos, yaw, speed, 0.0, 0.0, color, isPlayer, routeIndex, waypointIndex, targetSpeed)

impl Car {
    // Heading on the ground plane; matches the camera's yaw convention.
    func &.forward(): Vec3 = .(-sin(self.yaw), 0.0, -cos(self.yaw))

    // Advance one frame. `throttle` in [-1, 1] (negative = reverse/brake),
    // `steer` in [-1, 1] (positive = left).
    func !.drive(throttle: Double, steer: Double, dt: Double) {
        if throttle > 0.0 {
            self.speed += throttle * accel * dt
        } else if throttle < 0.0 {
            self.speed += throttle * (if self.speed > 0.0 then brake else accel) * dt
        }

        // Rolling friction always pulls the speed toward zero.
        fin drag = friction * dt
        self.speed = when {
            self.speed > drag -> self.speed - drag
            self.speed < -drag -> self.speed + drag
            else -> 0.0
        }
        self.speed = clampReal(self.speed, -reverseSpeed, maxSpeed)

        // A bicycle steering model: the front axle turns smoothly, and yaw is
        // derived from steering angle, wheelbase, and signed road speed.
        fin grip = clampReal(absReal(self.speed) / 6.0, 0.0, 1.0)
        self.wheelSteer += (steer * 0.56 - self.wheelSteer) * clampReal(dt * 8.5, 0.0, 1.0)
        self.yaw += tan(self.wheelSteer) * (self.speed / 2.75) * dt * grip
        self.pos += self.forward().scale(self.speed * dt)
        self.wheelSpin += (self.speed * dt) / 0.48

        // Keep cars inside the city; a wall stops them dead.
        if absReal(self.pos.x) > cityLimit {
            self.pos.x = clampReal(self.pos.x, -cityLimit, cityLimit)
            self.speed = 0.0
        }
        if absReal(self.pos.z) > cityLimit {
            self.pos.z = clampReal(self.pos.z, -cityLimit, cityLimit)
            self.speed = 0.0
        }
    }
}

// ── City construction ─────────────────────────────────────────────────────

func addCityPiece(world: World!, props: Storage<Prop>!, pos: Vec3, scale: Vec3, color: Color, solid: Bool) {
    spawnWith(world, props, Prop(pos, scale, color, solid))
}

func addTree(world: World!, props: Storage<Prop>!, x: Double, z: Double, height: Double) {
    addCityPiece(world, props, .(x, height * 0.28, z), .(0.42, height * 0.56, 0.42), colorRgb(0.30, 0.18, 0.09), true)
    addCityPiece(world, props, .(x, height * 0.72, z), .(2.2, height * 0.58, 2.2), colorRgb(0.18, 0.48, 0.22), false)
}

func addStreetLamp(world: World!, props: Storage<Prop>!, x: Double, z: Double) {
    addCityPiece(world, props, .(x, 1.55, z), .(0.13, 3.1, 0.13), colorRgb(0.12, 0.13, 0.15), false)
    addCityPiece(world, props, .(x, 3.15, z), .(0.48, 0.18, 0.48), colorRgb(1.0, 0.82, 0.38), false)
}

func addCrosswalk(world: World!, props: Storage<Prop>!, x: Double, z: Double, alongX: Bool) {
    for stripe in -4..4 {
        fin offset = (stripe as Double) * 0.72
        if alongX {
            addCityPiece(world, props, .(x + offset, 0.045, z), .(0.46, 0.05, 3.8), colorRgb(0.88, 0.90, 0.92), false)
        } else {
            addCityPiece(world, props, .(x, 0.045, z + offset), .(3.8, 0.05, 0.46), colorRgb(0.88, 0.90, 0.92), false)
        }
    }
}

func buildRoadMarkings(world: World!, props: Storage<Prop>!) {
    // Six broad cross-city roads, each with two lanes and a dashed centreline.
    var road: Double = -60.0
    while road <= 60.0 {
        var dash: Double = -86.0
        while dash <= 86.0 {
            addCityPiece(world, props, .(road, 0.035, dash), .(0.16, 0.04, 3.6), colorRgb(0.95, 0.76, 0.18), false)
            addCityPiece(world, props, .(dash, 0.035, road), .(3.6, 0.04, 0.16), colorRgb(0.95, 0.76, 0.18), false)
            dash += 8.0
        }
        road += blockStep
    }

    // Crosswalks protect all four approaches to the central pedestrian plaza.
    addCrosswalk(world, props, -12.0, -7.2, true)
    addCrosswalk(world, props, 12.0, -7.2, true)
    addCrosswalk(world, props, -7.2, -12.0, false)
    addCrosswalk(world, props, -7.2, 12.0, false)
}

func buildDowntownBlock(world: World!, props: Storage<Prop>!, gx: Int, gz: Int) {
    fin cx = (gx as Double) * blockStep
    fin cz = (gz as Double) * blockStep
    fin variation = ((((gx * 7 + gz * 3) % 5) + 5) % 5) as Double
    fin h1: Double = 7.0 + absReal((gx as Double) + (gz as Double)) * 1.25 + variation * 1.45
    fin h2: Double = 5.5 + variation * 1.10
    fin shade: Double = 0.31 + (((((gx + gz + 8) % 4) + 4) % 4) as Double) * 0.095
    fin wall = colorRgb(shade * 1.08, shade, shade * 0.90)
    fin wall2 = colorRgb(shade * 0.82, shade * 0.88, shade * 1.02)
    fin glass = colorRgb(0.10, 0.27 + variation * 0.018, 0.38 + variation * 0.02)

    // A generous pavement wraps two independent buildings on every block.
    addCityPiece(world, props, .(cx, 0.10, cz), .(blockSurface, 0.20, blockSurface), colorRgb(0.49, 0.51, 0.53), false)
    addCityPiece(world, props, .(cx - 3.55, h1 * 0.5 + 0.20, cz), .(6.25, h1, 11.8), wall, true)
    addCityPiece(world, props, .(cx + 3.55, h2 * 0.5 + 0.20, cz), .(6.25, h2, 11.8), wall2, true)

    // Window bands, shop fronts, doors and roof equipment break up the massing.
    addCityPiece(world, props, .(cx - 3.55, h1 * 0.62, cz + 5.94), .(4.8, 1.25, 0.08), glass, false)
    addCityPiece(world, props, .(cx + 3.55, h2 * 0.61, cz + 5.94), .(4.8, 1.05, 0.08), glass, false)
    addCityPiece(world, props, .(cx - 6.72, h1 * 0.48, cz), .(0.08, 1.30, 8.5), glass, false)
    addCityPiece(world, props, .(cx + 6.72, h2 * 0.48, cz), .(0.08, 1.15, 8.5), glass, false)
    addCityPiece(world, props, .(cx - 3.55, 1.15, cz - 5.95), .(1.10, 2.25, 0.10), colorRgb(0.10, 0.09, 0.08), false)
    addCityPiece(world, props, .(cx + 3.55, 0.78, cz - 5.96), .(4.8, 1.35, 0.10), colorRgb(0.18, 0.32, 0.36), false)
    addCityPiece(world, props, .(cx - 3.55, h1 + 0.45, cz), .(2.7, 0.90, 2.4), colorRgb(shade * 0.72, shade * 0.72, shade * 0.74), false)

    if ((gx + gz + 8) % 2) == 0 then addStreetLamp(world, props, cx - 7.1, cz - 7.1)
}

func buildCentralPlaza(world: World!, props: Storage<Prop>!) {
    addCityPiece(world, props, .(0.0, 0.10, 0.0), .(16.0, 0.20, 16.0), colorRgb(0.67, 0.65, 0.60), false)
    addCityPiece(world, props, .(0.0, 0.42, 0.0), .(5.2, 0.65, 5.2), colorRgb(0.70, 0.72, 0.74), true)
    addCityPiece(world, props, .(0.0, 0.78, 0.0), .(4.2, 0.15, 4.2), colorRgb(0.18, 0.54, 0.70), false)
    addCityPiece(world, props, .(0.0, 2.0, 0.0), .(0.42, 2.5, 0.42), colorRgb(0.76, 0.73, 0.66), false)
    addCityPiece(world, props, .(-5.4, 0.45, -5.4), .(3.0, 0.55, 0.55), colorRgb(0.35, 0.20, 0.11), false)
    addCityPiece(world, props, .(5.4, 0.45, 5.4), .(3.0, 0.55, 0.55), colorRgb(0.35, 0.20, 0.11), false)
    addTree(world, props, -6.1, 5.8, 3.5)
    addTree(world, props, 6.1, -5.8, 3.5)
    addStreetLamp(world, props, -6.5, -6.5)
    addStreetLamp(world, props, 6.5, 6.5)
}

func buildPark(world: World!, props: Storage<Prop>!) {
    fin cx: Double = -48.0
    fin cz: Double = -24.0
    addCityPiece(world, props, .(cx, 0.09, cz), .(39.0, 0.18, 16.0), colorRgb(0.20, 0.43, 0.22), false)
    addCityPiece(world, props, .(cx, 0.13, cz), .(37.0, 0.05, 2.2), colorRgb(0.72, 0.67, 0.54), false)
    addCityPiece(world, props, .(cx - 8.0, 0.15, cz), .(8.0, 0.08, 6.0), colorRgb(0.16, 0.42, 0.58), false)

    for tree in -4..4 {
        fin tx = cx + (tree as Double) * 4.0
        addTree(world, props, tx, cz - 6.1, 3.4 + (((tree + 4) % 3) as Double) * 0.45)
        addTree(world, props, tx, cz + 6.1, 3.7)
    }
    addCityPiece(world, props, .(cx + 9.0, 0.45, cz - 2.7), .(3.2, 0.55, 0.55), colorRgb(0.34, 0.20, 0.11), false)
    addCityPiece(world, props, .(cx + 9.0, 0.45, cz + 2.7), .(3.2, 0.55, 0.55), colorRgb(0.34, 0.20, 0.11), false)
}

func buildMuseum(world: World!, props: Storage<Prop>!) {
    fin cx: Double = 60.0
    fin cz: Double = 0.0
    fin stone = colorRgb(0.78, 0.75, 0.67)
    addCityPiece(world, props, .(cx, 0.10, cz), .(38.5, 0.20, 16.0), colorRgb(0.64, 0.62, 0.58), false)
    addCityPiece(world, props, .(cx, 0.35, cz + 4.8), .(22.0, 0.40, 4.0), stone, true)
    addCityPiece(world, props, .(cx, 3.7, cz - 1.0), .(25.0, 7.0, 10.5), stone, true)
    addCityPiece(world, props, .(cx, 7.45, cz - 1.0), .(27.0, 0.55, 12.0), colorRgb(0.49, 0.47, 0.43), false)
    addCityPiece(world, props, .(cx, 8.15, cz - 1.0), .(18.0, 0.75, 6.0), stone, false)

    for column in -4..4 {
        fin x = cx + (column as Double) * 2.4
        addCityPiece(world, props, .(x, 3.0, cz + 4.75), .(0.55, 5.3, 0.55), colorRgb(0.88, 0.86, 0.79), false)
    }
    addCityPiece(world, props, .(cx, 2.0, cz + 5.08), .(3.2, 3.7, 0.12), colorRgb(0.11, 0.18, 0.21), false)
    addStreetLamp(world, props, cx - 15.0, cz + 6.2)
    addStreetLamp(world, props, cx + 15.0, cz + 6.2)
}

func buildSoccerGround(world: World!, props: Storage<Prop>!) {
    fin cx: Double = -48.0
    fin cz: Double = 48.0
    fin white = colorRgb(0.92, 0.94, 0.91)
    addCityPiece(world, props, .(cx, 0.09, cz), .(39.0, 0.18, 30.0), colorRgb(0.16, 0.45, 0.19), false)
    addCityPiece(world, props, .(cx, 0.14, cz - 13.0), .(34.0, 0.05, 0.18), white, false)
    addCityPiece(world, props, .(cx, 0.14, cz + 13.0), .(34.0, 0.05, 0.18), white, false)
    addCityPiece(world, props, .(cx - 17.0, 0.14, cz), .(0.18, 0.05, 26.0), white, false)
    addCityPiece(world, props, .(cx + 17.0, 0.14, cz), .(0.18, 0.05, 26.0), white, false)
    addCityPiece(world, props, .(cx, 0.14, cz), .(0.18, 0.05, 26.0), white, false)
    addCityPiece(world, props, .(cx - 17.0, 1.2, cz), .(0.18, 2.2, 7.0), white, false)
    addCityPiece(world, props, .(cx + 17.0, 1.2, cz), .(0.18, 2.2, 7.0), white, false)
    addCityPiece(world, props, .(cx, 1.1, cz - 15.0), .(38.0, 2.0, 2.2), colorRgb(0.25, 0.31, 0.40), true)
    addCityPiece(world, props, .(cx, 1.1, cz + 15.0), .(38.0, 2.0, 2.2), colorRgb(0.25, 0.31, 0.40), true)
}

func buildRiverAndBridge(world: World!, props: Storage<Prop>!) {
    fin riverZ: Double = -48.0
    fin stone = colorRgb(0.43, 0.45, 0.47)
    fin bankWidth = cityLimit - 16.0
    fin bankCenter: Double = 16.0 + bankWidth * 0.5

    // Solid embankments keep vehicles out of the water except at the bridge.
    addCityPiece(world, props, .(-bankCenter, 0.60, riverZ - 7.2), .(bankWidth, 1.2, 1.1), stone, true)
    addCityPiece(world, props, .(bankCenter, 0.60, riverZ - 7.2), .(bankWidth, 1.2, 1.1), stone, true)
    addCityPiece(world, props, .(-bankCenter, 0.60, riverZ + 7.2), .(bankWidth, 1.2, 1.1), stone, true)
    addCityPiece(world, props, .(bankCenter, 0.60, riverZ + 7.2), .(bankWidth, 1.2, 1.1), stone, true)

    // The central boulevard becomes a broad drivable bridge over both lanes.
    addCityPiece(world, props, .(0.0, 0.11, riverZ), .(32.0, 0.22, 17.0), colorRgb(0.24, 0.26, 0.28), false)
    addCityPiece(world, props, .(-15.7, 0.70, riverZ), .(0.32, 1.2, 18.0), colorRgb(0.70, 0.72, 0.74), true)
    addCityPiece(world, props, .(15.7, 0.70, riverZ), .(0.32, 1.2, 18.0), colorRgb(0.70, 0.72, 0.74), true)
    addCityPiece(world, props, .(-10.5, -0.30, riverZ), .(1.2, 1.2, 2.6), stone, false)
    addCityPiece(world, props, .(10.5, -0.30, riverZ), .(1.2, 1.2, 2.6), stone, false)
    addStreetLamp(world, props, -14.4, riverZ - 6.2)
    addStreetLamp(world, props, 14.4, riverZ - 6.2)
    addStreetLamp(world, props, -14.4, riverZ + 6.2)
    addStreetLamp(world, props, 14.4, riverZ + 6.2)
}

func buildTrainStation(world: World!, props: Storage<Prop>!) {
    fin cx: Double = 96.0
    fin cz: Double = 96.0
    fin stone = colorRgb(0.66, 0.60, 0.52)
    fin steel = colorRgb(0.18, 0.21, 0.25)
    fin glass = colorRgb(0.10, 0.34, 0.46)

    // A broad concourse fronts the terminal and separates pedestrians from rail.
    addCityPiece(world, props, .(cx, 0.10, cz - 8.0), .(60.0, 0.20, 18.0), colorRgb(0.58, 0.57, 0.54), false)
    addCityPiece(world, props, .(cx, 4.8, cz), .(52.0, 9.2, 14.0), stone, true)
    addCityPiece(world, props, .(cx, 5.0, cz - 7.05), .(31.0, 6.2, 0.14), glass, false)
    addCityPiece(world, props, .(cx, 9.75, cz), .(56.0, 0.65, 17.0), steel, false)
    addCityPiece(world, props, .(cx, 12.0, cz - 0.8), .(4.5, 4.5, 1.0), stone, false)
    addCityPiece(world, props, .(cx, 12.1, cz - 1.35), .(2.2, 2.2, 0.12), colorRgb(0.91, 0.86, 0.67), false)

    // Twin platforms, four rails and repeated sleepers read clearly at speed.
    addCityPiece(world, props, .(cx, 0.30, cz + 13.0), .(62.0, 0.55, 3.0), colorRgb(0.48, 0.49, 0.50), true)
    addCityPiece(world, props, .(cx, 0.30, cz + 22.0), .(62.0, 0.55, 3.0), colorRgb(0.48, 0.49, 0.50), true)
    for rail in 0..<4 {
        fin rz = cz + 16.0 + (rail as Double) * 2.0
        addCityPiece(world, props, .(0.0, 0.16, rz), .(720.0, 0.16, 0.13), steel, false)
    }
    for sleeper in -30..30 {
        fin sx = (sleeper as Double) * 8.0
        addCityPiece(world, props, .(sx, 0.10, cz + 19.0), .(0.34, 0.12, 9.0), colorRgb(0.32, 0.22, 0.14), false)
    }

    // A stopped low-poly train makes the station immediately recognisable.
    addCityPiece(world, props, .(cx - 4.0, 1.45, cz + 17.0), .(34.0, 2.5, 1.65), colorRgb(0.78, 0.12, 0.10), false)
    addCityPiece(world, props, .(cx - 4.0, 2.15, cz + 16.12), .(27.0, 0.72, 0.08), colorRgb(0.10, 0.22, 0.30), false)
    addStreetLamp(world, props, cx - 24.0, cz - 14.5)
    addStreetLamp(world, props, cx + 24.0, cz - 14.5)
}

func buildMall(world: World!, props: Storage<Prop>!) {
    fin cx: Double = -96.0
    fin cz: Double = 72.0
    fin concrete = colorRgb(0.72, 0.68, 0.62)
    fin accent = colorRgb(0.82, 0.20, 0.16)
    fin glass = colorRgb(0.09, 0.31, 0.42)

    addCityPiece(world, props, .(cx, 0.09, cz), .(64.0, 0.18, 44.0), colorRgb(0.38, 0.40, 0.42), false)
    addCityPiece(world, props, .(cx, 5.0, cz + 4.0), .(48.0, 9.8, 29.0), concrete, true)
    addCityPiece(world, props, .(cx, 5.2, cz - 10.6), .(26.0, 6.4, 0.15), glass, false)
    addCityPiece(world, props, .(cx, 10.2, cz + 4.0), .(51.0, 0.65, 32.0), colorRgb(0.25, 0.27, 0.30), false)
    addCityPiece(world, props, .(cx, 7.0, cz - 11.0), .(13.0, 1.5, 0.25), accent, false)
    addCityPiece(world, props, .(cx, 3.0, cz + 12.8), .(44.0, 0.40, 3.2), colorRgb(0.16, 0.34, 0.19), false)

    // Parking aisles and pedestrian islands organize the public frontage.
    for bay in -6..6 {
        fin bx = cx + (bay as Double) * 3.4
        addCityPiece(world, props, .(bx, 0.14, cz - 17.0), .(0.10, 0.05, 7.0), colorRgb(0.90, 0.90, 0.84), false)
    }
    addTree(world, props, cx - 27.0, cz - 17.0, 4.2)
    addTree(world, props, cx + 27.0, cz - 17.0, 4.2)
}

