module thirdPerson.components

import engine.core
import engine.ecs
import engine.math.vec

@Component
pack ThirdPersonPlayer {
    var sam: Entity
    var startYaw: Double
    var facing: Double
    var yaw: Double
    var pitch: Double = -15.0
    var orbiting: Bool = false
    var mouseX: Double = 0.0
    var mouseY: Double = 0.0
    var motion: Vec3 = .(0.0, 0.0, 0.0)
    var running: Bool = false
    var jump: Bool = false
}

pack ArenaCollider {
    var entity: Entity
    var center: Vec3
    var half: Vec3
    var initial: Vec3
    var previous: Vec3
    var inverseMass: Double = 0.0
    var ramp: Bool = false
    var velocity: Vec3 = .(0.0, 0.0, 0.0)
    var supported: Bool = false
}

@Component
pack ArenaSimulation {
    var moving: Array<ArenaCollider>
    var solids: Array<ArenaCollider>
    var gravity: Vec3
    var grounded: Bool = false
}

pack CameraInterval {
    var enter: Double = 0.0
    var exit: Double = 1.0
}

