// __AZORA_PROJECT_NAME__ — Tetris (2D), built on the Azora Engine.
//
//   LEFT / RIGHT   move piece,
//   UP             rotate,
//   DOWN           soft drop,
//   SPACE          hard drop,
//   ENTER          restart after game over,
//   ESC            quit,
//
// The whole game — board, pieces, rendering — is Azora code drawing 2D
// rectangles and text through the engine's immediate-mode UI.

module game

import engine

bridge .C {
    func @foreignName("arc4random_uniform")(bound: std::Int): std::Int
}

fin boardW = 10
fin boardH = 20
fin CELL = 26.0

/// The 4 rotation bitmasks of the 7 tetrominoes (4x4 grid, row-wise from the,
/// top, most significant bit = top-left).
func pieceMasks(): std::Array<std::Int> {
    return @std::arr[
        0x0F00, 0x2222, 0x00F0, 0x4444, // I
        0x8E00, 0x6440, 0x0E20, 0x44C0, // J
        0x2E00, 0x4460, 0x0E80, 0xC440, // L
        0x6600, 0x6600, 0x6600, 0x6600, // O
        0x6C00, 0x4620, 0x06C0, 0x8C40, // S
        0x4E00, 0x4640, 0x0E40, 0x4C40, // T
        0xC600, 0x2640, 0x0C60, 0x4C80  // Z
    ]
}

/// True when cell (i, j) of the piece's 4x4 grid is occupied.
func pieceCell(masks: std::Array<std::Int>, p: std::Int, r: std::Int, i: std::Int, j: std::Int): std::Bool {
    fin mask = masks[p * 4 + r]
    fin bit = (3 - j) * 4 + (3 - i)
    return ((mask >> bit) & 1) != 0
}

/// True when the piece at (x, y) would overlap the walls, floor or stack.
func collides(board: std::Long, masks: std::Array<std::Int>, p: std::Int, r: std::Int, x: std::Int, y: std::Int): std::Bool {
    var j = 0
    while j < 4 {
        var i = 0
        while i < 4 {
            if pieceCell(masks, p, r, i, j) {
                fin bx = x + i
                fin bj = y + j
                if bx < 0 || bx >= boardW || bj >= boardH {
                    return true
                }
                if bj >= 0 {
                    if azPeek8(board, (bj * boardW + bx) as std::Long) != 0 {
                        return true
                    }
                }
            }
            i = i + 1
        }
        j = j + 1
    }
    return false
}

func lockPiece(board: std::Long, masks: std::Array<std::Int>, p: std::Int, r: std::Int, x: std::Int, y: std::Int) {
    var j = 0
    while j < 4 {
        var i = 0
        while i < 4 {
            if pieceCell(masks, p, r, i, j) {
                fin bj = y + j
                if bj >= 0 {
                    azPoke8(board, (bj * boardW + x + i) as std::Long, p + 1)
                }
            }
            i = i + 1
        }
        j = j + 1
    }
}

/// Removes full rows, returns how many were cleared.
func clearLines(board: std::Long): std::Int {
    var cleared = 0
    var j = boardH - 1
    while j >= 0 {
        var full = true
        var i = 0
        while i < boardW {
            if azPeek8(board, (j * boardW + i) as std::Long) == 0 {
                full = false
            }
            i = i + 1
        }
        if full {
            cleared = cleared + 1
            // Shift everything above row j down by one.
            var k = j
            while k > 0 {
                var i2 = 0
                while i2 < boardW {
                    fin above = azPeek8(board, ((k - 1) * boardW + i2) as std::Long)
                    azPoke8(board, (k * boardW + i2) as std::Long, above)
                    i2 = i2 + 1
                }
                k = k - 1
            }
            var i3 = 0
            while i3 < boardW {
                azPoke8(board, i3 as std::Long, 0)
                i3 = i3 + 1
            }
        } else {
            j = j - 1
        }
    }
    return cleared
}

func clearBoard(board: std::Long) {
    var k = 0
    while k < boardW * boardH {
        azPoke8(board, k as std::Long, 0)
        k = k + 1
    }
}

func drawCell(app: App, ox: std::Double, oy: std::Double, i: std::Int, j: std::Int, colors: std::Array<std::Double>, c: std::Int) {
    fin x = ox + (i as std::Double) * CELL
    fin y = oy + (j as std::Double) * CELL
    fin r = colors[c * 3]
    fin g = colors[c * 3 + 1]
    fin b = colors[c * 3 + 2]
    app.uiRect(x + 1.0, y + 1.0, CELL - 2.0, CELL - 2.0, r, g, b, 1.0)
}

func main() {
    var app = appInit("__AZORA_PROJECT_NAME__ — Tetris", 560, 620)
    if !app.ok {
        return
    }
    app.setClearColor(0.08, 0.08, 0.11)

    fin masks = pieceMasks()
    // Per-piece colors (index 1..7): I J L O S T Z.
    fin colors = @std::arr[
        0.0, 0.0, 0.0
        0.20, 0.75, 0.90, // I  cyan
        0.25, 0.40, 0.90, // J  blue
        0.95, 0.60, 0.20, // L  orange
        0.95, 0.85, 0.25, // O  yellow
        0.35, 0.85, 0.40, // S  green
        0.75, 0.35, 0.90, // T  purple
        0.90, 0.30, 0.30  // Z  red
    ]

    fin board = azAlloc((boardW * boardH) as std::Long)

    var piece = arc4randomUniform(7)
    var rot = 0
    var px = 3
    var py = -1
    var dropTimer = 0.0
    var score = 0
    var lines = 0
    var gameOver = false

    while app.frame() {
        fin dt = app.deltaTime()
        fin w = app.width() as std::Double
        fin ox = (w - (boardW as std::Double) * CELL) * 0.5
        fin oy = 40.0

        if !gameOver {
            // ── Input ──
            if app.keyPressed(keyArrowLeft) {
                if !collides(board, masks, piece, rot, px - 1, py) {
                    px = px - 1
                }
            }
            if app.keyPressed(keyArrowRight) {
                if !collides(board, masks, piece, rot, px + 1, py) {
                    px = px + 1
                }
            }
            if app.keyPressed(keyArrowUp) {
                fin nr = (rot + 1) % 4
                if !collides(board, masks, piece, nr, px, py) {
                    rot = nr
                }
            }
            if app.keyPressed(keySpace) {
                while !collides(board, masks, piece, rot, px, py + 1) {
                    py = py + 1
                    score = score + 2
                }
                dropTimer = 10.0 // lock immediately
            }

            // ── Gravity ──
            var interval = 0.55 - (lines as std::Double) * 0.02
            if interval < 0.1 {
                interval = 0.1
            }
            if app.keyDown(keyArrowDown) {
                interval = 0.04
            }
            dropTimer = dropTimer + dt
            if dropTimer >= interval {
                dropTimer = 0.0
                if collides(board, masks, piece, rot, px, py + 1) {
                    lockPiece(board, masks, piece, rot, px, py)
                    fin cleared = clearLines(board)
                    lines = lines + cleared
                    score = score + cleared * cleared * 100
                    piece = arc4randomUniform(7)
                    rot = 0
                    px = 3
                    py = -1
                    if collides(board, masks, piece, rot, px, py) {
                        gameOver = true
                    }
                } else {
                    py = py + 1
                }
            }
        } else {
            if app.keyPressed(keyEnter) {
                clearBoard(board)
                score = 0
                lines = 0
                gameOver = false
                piece = arc4randomUniform(7)
                rot = 0
                px = 3
                py = -1
            }
        }

        // ── Render ──
        fin bw = (boardW as std::Double) * CELL
        fin bh = (boardH as std::Double) * CELL
        app.uiRect(ox - 4.0, oy - 4.0, bw + 8.0, bh + 8.0, 0.18, 0.19, 0.24, 1.0)
        app.uiRect(ox, oy, bw, bh, 0.05, 0.05, 0.07, 1.0)

        var j = 0
        while j < boardH {
            var i = 0
            while i < boardW {
                fin c = azPeek8(board, (j * boardW + i) as std::Long)
                if c != 0 {
                    drawCell(app, ox, oy, i, j, colors, c)
                }
                i = i + 1
            }
            j = j + 1
        }

        if !gameOver {
            var pj = 0
            while pj < 4 {
                var pi = 0
                while pi < 4 {
                    if pieceCell(masks, piece, rot, pi, pj) && py + pj >= 0 {
                        drawCell(app, ox, oy, px + pi, py + pj, colors, piece + 1)
                    }
                    pi = pi + 1
                }
                pj = pj + 1
            }
        }

        app.uiText("Score ${score}   Lines ${lines}", ox, 12.0, 15.0)
        if gameOver {
            app.uiTitle("GAME OVER — press ENTER", oy + bh * 0.45, 22.0)
        }

        if app.keyPressed(keyEscape) {
            app.quit()
        }
        app.present()
    }

    app.shutdown()
}
