// Does `with` / `without` actually narrow a query?
//
// The filters compiled long before they were ever shown to *filter*, and a
// query that quietly matches everything is not a failure anything reports - it
// is a frame that touches rows it should not have. Every count below has one
// right answer, so a filter that passes everything through shows up as a
// number rather than as a crash.
//
// Run through `tests/run.sh`, which checks the interpreter and the native
// build agree: the query walk was dead in native builds for a long time while
// the interpreter was fine, so one backend proves nothing on its own.

module app

import std.io
import engine.core
import engine.ecs

@Component pack Position { var x: std::Int }
@Component pack Frozen { var since: std::Int }
@Component pack Tagged { var id: std::Int }

func countOf(cursor: QueryCursor&): std::Int {
    return cursor.count()
}

func main() {
    var world = World::init()

    var positions = storageOf<Position>(world)
    var frozen = storageOf<Frozen>(world)
    var tagged = storageOf<Tagged>(world)

    fin a = world.spawn()
    fin b = world.spawn()
    fin c = world.spawn()
    fin d = world.spawn()

    // All four carry a Position.
    storageInsert<Position>(positions, a, Position(1))
    storageInsert<Position>(positions, b, Position(2))
    storageInsert<Position>(positions, c, Position(3))
    storageInsert<Position>(positions, d, Position(4))

    // b and d are Frozen.
    storageInsert<Frozen>(frozen, b, Frozen(10))
    storageInsert<Frozen>(frozen, d, Frozen(20))

    // a and b are Tagged.
    storageInsert<Tagged>(tagged, a, Tagged(100))
    storageInsert<Tagged>(tagged, b, Tagged(200))

    // Each answers whether it *replaced* a registration, so a first one is
    // false. The values are read rather than discarded because an `inline func`
    // only folds its `T.typeName` where its result is bound.
    fin p = registerStorage<Position>(world, positions)
    fin f = registerStorage<Frozen>(world, frozen)
    fin t = registerStorage<Tagged>(world, tagged)
    std::println("replacedAnything=${p || f || t}")

    var all = QueryOf<Position>::provide(world)
    std::println("all=${countOf(all.cursor)}")

    var thawed = QueryWithout<QueryOf<Position>, Frozen>::provide(world)
    std::println("withoutFrozen=${countOf(thawed.cursor)}")

    var chilled = QueryWith<QueryOf<Position>, Frozen>::provide(world)
    std::println("withFrozen=${countOf(chilled.cursor)}")

    // Filters nest, and nesting is what composes them.
    var only = QueryWithout<QueryWith<QueryOf<Position>, Tagged>, Frozen>::provide(world)
    std::println("taggedNotFrozen=${countOf(only.cursor)}")

    // Walking yields exactly the rows the count promised. This is the half that
    // was silently dead natively: an unbound `hasNext` returned false and the
    // loop never ran, so the count agreed while the walk did nothing.
    var walked = 0
    for row in thawed {
        if row.isValid {
            walked = walked + 1
        }
    }
    std::println("walkedThawed=${walked}")
}
