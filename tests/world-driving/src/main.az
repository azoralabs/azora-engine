import std.io
import std.math
import engine.core
import engine.ecs
import engine.io
import engine.math
import engine.scene
import engine.scene.transforms
import engine.scene.io
import engine.physics.d3
import engine.landscape
import engine.vehicles
import engine.roads

func main() {
    fin root = "../../templates/dolomites-drive"
    var world: World = .()
    var file = readFile("${root}/dolomites.azscene")
    assert file.ok() && readScene(world,file.text(0,file.size)) > 0 panic "read the template scene"
    file.release()
    fin item = storageValueAt<HeightfieldTerrain>(ensureStorage(world),0)
    fin source = readTerrainImage("${root}/${item.image}")
    assert source.columns == 1025 && source.rows == 1025 panic "load the full 16-bit heightmap"
    assert absValue(item.width/1167.49258-10.0) < 0.001 && absValue(item.length/1076.83579-10.0) < 0.001 panic "scale both landscape axes"
    azFree(source.samples)
    fin roads = buildRoadNetwork(world)
    assert roadSurfaceAt(roads,0.0,313.0).found panic "crossroads has a north approach"
    assert !roadSurfaceAt(roads,1650.0,286.0).found panic "T-junction has no fourth approach"
    assert roadSurfaceAt(roads,3350.0,327.0).found && !roadSurfaceAt(roads,3350.0,300.0).found panic "roundabout has a paved ring and open island"
    assert roadSurfaceAt(roads,-1000.0,307.8).found panic "second lane is paved"
    fin asphalt = readFile("${root}/Textures/Asphalt/surface.aztexture")
    assert asphalt.matches(0,"AZTX") && asphalt.size > 1000000 panic "the asphalt material has its packed texture"
    println("heightmap and road junctions ok")
    var ground = loadLandscapeColliders(world,root)
    defer { releaseLandscapeColliders(ground) }
    fin paving = roadSurfaceAt(roads,-1000.0,305.4)
    fin ray = castLandscape(ground,.(-999.0,65.0,305.4),.(-0.1,-0.995,0.0),20.0)
    assert ray.hit && absValue(ray.py-paving.height) < 0.08 && ray.grip > 1.15 panic "tilted ray contacts the visible asphalt"
    fin deck = castLandscape(ground,.(-561.0,75.0,470.0),.(0.0,-1.0,0.0),80.0)
    assert deck.hit && deck.py > 50.0 && deck.grip > 1.15 panic "the deck deck carries vehicles above the ravine"
    fin under = castLandscape(ground,.(-561.0,40.0,470.0),.(0.0,-1.0,0.0),45.0)
    assert under.hit && deck.py-under.py >= 20.0 panic "the ravine stays below the deck"
    fin summit = roadSurfaceAt(roads,1720.0,-3900.0)
    assert summit.found && summit.height > 580.0 panic "the pass reaches the high ridge"
    fin start = storageEntityAt<PlayerStart>(ensureStorage(world),0)
    fin driver = spawnVehicle(world,start,ground)
    for frame: Int in 0..<504 then simulateVehicle(world,driver,ground,.(1.0,0.0,false),gravity3d(),1.0/120.0)
    fin driven = storageGet<Vehicle>(ensureStorage(world),driver)
    assert driven.speed > 10.0 && driven.grounded >= 2 && worldPosition(world,driver).x > -963.0 panic "car accelerates on the highway"
    testColliderWindow(root, item.image)
    testCookedCollision()
    println("asphalt contact and car driving ok")
}

func testCookedCollision() {
    // A four-metre wall with a roof triangle behind it, both in one grid bucket.
    fin bytes = 36 + 8 + 8 + 80
    fin data = azAlloc(bytes as Long)
    assert data != 0 panic "allocate collision fixture"
    defer { azFree(data) }
    azPoke32(data, 0, 826497601)
    azPoke32(data, 4, 65537)
    azPoke32(data, 8, 2)
    azPoke32(data, 12, 2)
    azPokeF32(data, 16, -12.0)
    azPokeF32(data, 20, -12.0)
    azPokeF32(data, 24, 24.0)
    azPokeF32(data, 32, 4.0)
    azPoke32(data, 40, 2)
    azPoke32(data, 48, 1)
    fin wall: Array<Double> = [0.0, 0.0, -2.0, 0.0, 4.0, -2.0, 0.0, 4.0, 2.0, 1.0]
    fin roof: Array<Double> = [0.0, 4.0, -2.0, 0.0, 4.0, 2.0, 4.0, 4.0, -2.0, 1.0]
    for i: Int in 0..<10 {
        azPokeF32(data, 52 + (i as Long) * 4, wall[i])
        azPokeF32(data, 92 + (i as Long) * 4, roof[i])
    }
    fin asset = ".azora-build/world-driving.azcol"
    assert writeBinaryFile(asset, data, bytes as Long) panic "write indexed collision fixture"
    var world: World = .()
    fin entity = world.spawn()
    storageInsert<Collision>(ensureStorage(world), entity, .(asset: asset, reach: 6.0))
    prepareSolidCollision(world, ".", .(0.0, 0.0, 0.0))
    fin wallHit = sweepSceneCollision(world, .(-8.0, 1.2, 0.0), .(40.0, 0.0, 0.0), 0.6, 0.95)
    assert wallHit.hit && absValue(wallHit.t - 0.185) < 0.001 && wallHit.nx < -0.99 panic "fast body stops at the facade"
    fin roofHit = sweepSceneCollision(world, .(1.0, 10.0, 0.0), .(0.0, -20.0, 0.0), 0.5, 1.0)
    assert roofHit.hit && absValue(roofHit.t - 0.25) < 0.001 && roofHit.ny > 0.99 panic "descending body hits the roof"
    fin above = sweepSceneCollision(world, .(-8.0, 10.0, 0.0), .(40.0, 0.0, 0.0), 0.6, 0.95)
    assert !above.hit panic "a body above the roof passes"
    world.despawn(entity)
    fin gone = sweepSceneCollision(world, .(-8.0, 1.2, 0.0), .(40.0, 0.0, 0.0), 0.6, 0.95)
    assert !gone.hit panic "evicting the building releases its collider"
}

func testColliderWindow(root: String, image: String) {
    var world: World = .()
    for tile: Int in 0..<2 {
        fin entity = world.spawn()
        storageInsert<Transform>(ensureStorage(world), entity, .(translation: .((tile as Double) * 20.0, 0.0, 0.0)))
        storageInsert<HeightfieldTerrain>(ensureStorage(world), entity,
            .(image: image, width: 20.0, length: 20.0, elevation: 10.0, gradeRoads: false))
        storageInsert<LandscapeCollision>(ensureStorage(world), entity, .())
    }
    var surfaces: Array<CollisionSurface> = []
    var sync: ColliderSync = .()
    defer { releaseLandscapeColliders(surfaces) }
    syncLandscapeColliders(world, root, surfaces, sync, .(23.0, 0.0, 0.0), 5.0)
    assert surfaces.size == 1 panic "the second tile is alone in range"
    syncLandscapeColliders(world, root, surfaces, sync, .(10.0, 0.0, 0.0), 5.0)
    assert surfaces.size == 2 panic "the first tile joins the second"
    for x: Int in 0..1 {
        fin hit = castLandscape(surfaces, .((x as Double) * 20.0, 10.0, 0.0), .(0.0, -1.0, 0.0), 20.0)
        assert hit.hit panic "both newly added and retained tiles can be queried"
    }
    syncLandscapeColliders(world, root, surfaces, sync, .(0.0, 0.0, 0.0), 5.0)
    assert surfaces.size == 1 panic "the second tile leaves the window"
}
