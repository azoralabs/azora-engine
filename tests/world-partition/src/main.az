import std.io
import std.os
import std.math
import engine.core
import engine.ecs
import engine.math
import engine.scene
import engine.scene.transforms
import engine.procedural
import engine.scene.terrain
import engine.io
import engine.roads
import engine.foliage
import engine.world.partition

// A world plan is deterministic and sensible (settlements, roads, junctions,
// buildings), and the partition streams cells in and out around a point.

func main() {
    testAuthoredCells()
    var world: World = .()
    fin owner = world.spawn()
    storageInsert<WorldRecipe>(ensureStorage(world), owner, .())
    storageInsert<WorldPartition>(ensureStorage(world), owner, .(loadRadius: 2500.0, unloadRadius: 3500.0, folder: ".azora-build", overview: false))
    fin recipe = storageGet<WorldRecipe>(ensureStorage(world), owner).clone()
    fin plan = planWorld(recipe)
    fin again = planWorld(recipe)
    var length: Double = 0.0
    for road in plan.roads {
        for i: Int in 1..<road.points.size {
            fin a = road.points[i - 1].&
            fin b = road.points[i].&
            length += sqrt((b.x - a.x) * (b.x - a.x) + (b.z - a.z) * (b.z - a.z))
        }
    }
    if envVar("AZORA_WORLD_VERBOSE") != "" {
        println("settlements ${plan.towns.size} roads ${plan.roads.size} (${(length / 1000.0) as Int} km) junctions ${plan.junctions.size} buildings ${plan.buildings.size}")
    }
    assert plan.towns.size == again.towns.size && plan.buildings.size == again.buildings.size panic "a recipe plans the same world every time"
    assert plan.towns.size > 40 && plan.junctions.size > 200 && plan.buildings.size > 2000 && length > 300000.0 panic "a populated world"
    if envVar("AZORA_WORLD_START") != "" {
        for road in plan.roads {
            if road.kind != 0 || road.points.size < 40 then continue
            fin p = road.points[30].&
            fin q = road.points[31].&
            println("start ${formatDecimal(p.x, 2)} ${formatDecimal(p.y, 2)} ${formatDecimal(p.z, 2)} yaw ${formatDecimal(atan2(-(q.x - p.x), -(q.z - p.z)) / 0.017453292519943295, 2)}")
            return
        }
    }
    // Stream around the first city: cells come in, then go when the point moves away.
    fin city = plan.towns[0].&
    fin centre: Vec3 = .(city.x, city.height, city.z)
    fin loaded = streamWorld(world, ".", centre)
    if envVar("AZORA_WORLD_VERBOSE") != "" then println("loaded ${loaded} cells, ${world.aliveCount} entities")
    assert loaded > 3 && storageLength<HeightfieldTerrain>(ensureStorage(world)) == 0 panic "content cells contain no terrain"
    assert storageLength<SplineRoad>(ensureStorage(world)) > 10 && storageLength<Mesh3d>(ensureStorage(world)) > 100 panic "the city's streets and buildings load"
    // Each cell has an entity under the partition's, and what it brought in hangs under that.
    let states = ensureStorage<PartitionState>(world)
    fin cells = states.values[storageIndexOf<PartitionState>(states, owner)].cells.clone()
    for cell in cells {
        assert world.getParent(cell.group) == owner && storageHas<Streamed>(ensureStorage(world), cell.group) panic "a cell hangs under its partition"
        assert storageGet<Name>(ensureStorage(world), cell.group).value == "Cell ${cell.column}, ${cell.row}" panic "a cell is named for its place"
    }
    // Procedural ground has one persistent entity and no cell-dependent holes.
    let lit = ensureStorage<WorldPartition>(world)
    lit.values[storageIndexOf<WorldPartition>(lit, owner)].overview = true
    streamWorld(world, ".", centre)
    let viewed = ensureStorage<PartitionState>(world)
    fin land = viewed.values[storageIndexOf<PartitionState>(viewed, owner)].terrain
    assert world.getParent(land) == owner && !storageHas<TerrainHoles>(ensureStorage(world), land) panic "the procedural land is whole"
    fin far: Vec3 = .(city.x + 30000.0, city.height, city.z)
    streamWorld(world, ".", far, 0)
    let moved = ensureStorage<PartitionState>(world)
    assert moved.values[storageIndexOf<PartitionState>(moved, owner)].cells.size == 0 &&
        storageLength<HeightfieldTerrain>(ensureStorage(world)) == 1 && world.isAlive(land) panic "cells far behind unload; the same landscape stays"
    // A partition switched off takes what it streamed in with it.
    streamWorld(world, ".", centre)
    assert storageLength<Streamed>(ensureStorage(world)) > 100 panic "the city streams in again"
    let partitions = ensureStorage<WorldPartition>(world)
    partitions.values[storageIndexOf<WorldPartition>(partitions, owner)].enabled = false
    streamWorld(world, ".", centre)
    assert storageLength<Streamed>(ensureStorage(world)) == 0 panic "a partition switched off unloads its cells"
    // A changed recipe is another world: planned again, under other cached files.
    let switched = ensureStorage<WorldPartition>(world)
    switched.values[storageIndexOf<WorldPartition>(switched, owner)].enabled = true
    streamWorld(world, ".", centre, 1)
    fin before = storageGet<PartitionState>(ensureStorage(world), owner).recipe
    let recipes = ensureStorage<WorldRecipe>(world)
    recipes.values[storageIndexOf<WorldRecipe>(recipes, owner)].seed = recipe.seed + 1
    streamWorld(world, ".", centre, 1)
    fin after = storageGet<PartitionState>(ensureStorage(world), owner).recipe.&
    assert after != before && after == worldCacheName(storageGet<WorldRecipe>(ensureStorage(world), owner)) &&
        storageGet<PartitionState>(ensureStorage(world), owner).cells.size == 1 panic "a new recipe plans a new world"
    println("a world plans, streams in and streams out")
}


func testAuthoredCells() {
    fin folder = ".azora-build/authored-content"
    fin layer = ".azora-build/authored-buildings"
    makeFolders(folder)
    makeFolders(layer)
    fin index = azAlloc(11)
    for i: Int in 0..<11 then azPoke8(index, i as Long, 0)
    fin signature = "AZCELL1"
    for i: Int in 0..<7 then azPoke8(index, i as Long, charAt(signature, i) as Int)
    assert writeBinaryFile("${folder}/cells.azindex", index, 11) panic "write authored cell index"
    azPoke8(index, 7, 1)
    assert writeBinaryFile("${layer}/cells.azindex", index, 11) panic "write supplemental cell index"
    azFree(index)
    assert writeTextFile("${folder}/cells.azlayers", layer) panic "write layer manifest"
    assert writeTextFile("${folder}/0-0.azscene",
        "{\"format\":\"azora-scene\",\"version\":2,\"entities\":[" +
        "{\"parent\":-1,\"components\":{\"HeightfieldTerrain\":{},\"Transform\":{\"translation\":[1,2,3]}}}," +
        "{\"parent\":0,\"components\":{\"SplineRoad\":{},\"Mesh3d\":{}}}]}") panic "write authored cell"
    assert writeTextFile("${layer}/1-0.azscene", "{\"format\":\"azora-scene\",\"version\":2,\"entities\":[" +
        "{\"parent\":-1,\"components\":{\"Mesh3d\":{}}}]}") panic "write supplemental cell"

    var world: World = .()
    fin ground = world.spawn()
    storageInsert<HeightfieldTerrain>(ensureStorage(world), ground, .())
    fin owner = world.spawn()
    storageInsert<WorldRecipe>(ensureStorage(world), owner, .(width: 4000.0, length: 4000.0, cellSize: 2000.0))
    storageInsert<WorldPartition>(ensureStorage(world), owner, .(loadRadius: 25.0, unloadRadius: 200.0, folder: folder))
    fin at: Vec3 = .(-1000.0, 0.0, -1000.0)
    assert streamWorld(world, ".", at) == 1 panic "the index selects the authored cell without an authored field"
    fin state = storageGet<PartitionState>(ensureStorage(world), owner).&
    assert state.authored && state.plan.roads.size == 0 panic "authored folders do not generate synthetic content"
    assert storageLength<HeightfieldTerrain>(ensureStorage(world)) == 1 && world.isAlive(ground) panic "the original terrain stays resident"
    fin roads = ensureStorage<SplineRoad>(world)
    fin road = storageEntityAt<SplineRoad>(roads, 0)
    assert storageLength<SplineRoad>(roads) == 1 && worldPosition(world, road).x == 1.0 panic "road and its transform loaded"
    fin far: Vec3 = .(1000.0, 0.0, -1000.0)
    assert streamWorld(world, ".", far) == 2 && !world.isAlive(road) panic "cells present only in a supplemental layer still stream"
    assert storageLength<Mesh3d>(ensureStorage(world)) == 1 panic "the supplemental object is present"
    assert storageLength<HeightfieldTerrain>(ensureStorage(world)) == 1 && world.isAlive(ground) panic "terrain survives cell eviction"
}
