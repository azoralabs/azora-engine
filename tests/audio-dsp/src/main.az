import std.io
import std.math
import engine.io
import engine.audio.dsp

// Each check prints "<name> ok" or "<name> FAIL <value>".

fin rate: Double = 48000.0

func report(name: String, passed: Bool, value: Double) {
    println(if passed then "${name} ok" else "${name} FAIL ${value}")
}

/** [frames] samples of a sine of [hz] at [gain]. */
func sine(frames: Int, hz: Double, gain: Double): Long {
    fin buffer = sampleBuffer(frames)
    var i = 0
    while i < frames {
        setSample(buffer, i, gain * sin(2.0 * PI * hz * (i as Double) / rate))
        i += 1
    }
    return buffer
}

func whiteNoiseBounded() {
    var source = noise(7)
    var inside = true
    var sum: Double = 0.0
    var i = 0
    while i < 48000 {
        fin x = source.white()
        if x < -1.0 || x >= 1.0 then inside = false
        sum += if x < 0.0 then -x else x
        i += 1
    }
    fin mean = sum / 48000.0
    report("whiteNoiseBounded", inside && mean > 0.45 && mean < 0.55, mean)
}

func pinkNoiseLowHeavy() {
    var source = pinkNoise(11)
    var low: Biquad = .()
    var high: Biquad = .()
    low.lowpass(200.0, 0.707, rate)
    high.highpass(5000.0, 0.707, rate)
    var lowEnergy: Double = 0.0
    var highEnergy: Double = 0.0
    var i = 0
    while i < 96000 {
        fin x = source.next()
        fin a = low.process(x)
        fin b = high.process(x)
        lowEnergy += a * a
        highEnergy += b * b
        i += 1
    }
    fin ratio = sqrt(lowEnergy / highEnergy)
    report("pinkNoiseLowHeavy", ratio > 1.2, ratio)
}

/** RMS of [buffer] after [filter], over its second half (past the transient). */
func filteredRatio(filter: Biquad!, buffer: Long, frames: Int): Double {
    fin filtered = sampleBuffer(frames)
    var i = 0
    while i < frames {
        setSample(filtered, i, filter.process(sample(buffer, i)))
        i += 1
    }
    fin half = frames / 2
    fin ratio = rms(filtered + (half as Long) * 8, half) / rms(buffer + (half as Long) * 8, half)
    azFree(filtered)
    return ratio
}

func lowpassAttenuates() {
    fin tone = sine(48000, 10000.0, 1.0)
    var filter: Biquad = .()
    filter.lowpass(500.0, 0.707, rate)
    fin ratio = filteredRatio(filter, tone, 48000)
    azFree(tone)
    report("lowpassAttenuates", ratio < 0.02, ratio)
}

func bandpassPassesCentre() {
    fin tone = sine(48000, 1000.0, 1.0)
    var filter: Biquad = .()
    filter.bandpass(1000.0, 2.0, rate)
    fin ratio = filteredRatio(filter, tone, 48000)
    azFree(tone)
    report("bandpassPassesCentre", ratio > 0.9 && ratio < 1.1, ratio)
}

func delayReadsBack() {
    var line = delayLine(256)
    var i = 0
    while i < 100 {
        line.push(i as Double)
        i += 1
    }
    fin whole = line.read(10.0)
    fin between = line.read(10.5)
    line.release()
    report("delayReadsBack", whole == 89.0 && between == 88.5, whole * 1000.0 + between)
}

func limiterHoldsCeiling() {
    fin frames = 48000
    fin stereo = sampleBuffer(frames * 2)
    var i = 0
    while i < frames {
        fin x = 2.0 * sin(2.0 * PI * 220.0 * (i as Double) / rate)
        setSample(stereo, i * 2, x)
        setSample(stereo, i * 2 + 1, x)
        i += 1
    }
    var limiter: Limiter = .()
    limiter.process(stereo, frames, 0.9)
    fin top = peak(stereo, frames * 2)
    azFree(stereo)
    report("limiterHoldsCeiling", top <= 0.9001, top)
}

func reverbTailDecays() {
    fin frames = 96000
    fin stereo = sampleBuffer(frames * 2)
    setSample(stereo, 0, 1.0)
    setSample(stereo, 1, 1.0)
    var room = reverb(rate)
    room.process(stereo, frames, 0.3)
    room.release()
    fin first = rms(stereo, 96000)
    fin second = rms(stereo + 96000 * 8, 96000)
    azFree(stereo)
    report("reverbTailDecays", first > 0.0 && second < 0.25 * first, second / first)
}

func spatialAtListenerIsFinite() {
    fin left = equalPowerLeft(0.0)
    fin right = equalPowerRight(0.0)
    fin gain = distanceGain(0.0, 1.0)
    fin even = left - right < 0.0001 && right - left < 0.0001 && left > 0.7070 && left < 0.7072
    report("spatialAtListenerIsFinite", even && gain == 1.0, left)
}

func sineHasNoClicks() {
    fin tone = sine(48000, 440.0, 1.0)
    fin jump = peakDelta(tone, 48000)
    azFree(tone)
    report("sineHasNoClicks", jump < 0.06, jump)
}

func main() {
    whiteNoiseBounded()
    pinkNoiseLowHeavy()
    lowpassAttenuates()
    bandpassPassesCentre()
    delayReadsBack()
    limiterHoldsCeiling()
    reverbTailDecays()
    spatialAtListenerIsFinite()
    sineHasNoClicks()
}
