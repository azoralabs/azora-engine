// Azora Engine — GPU renderer (Metal), written entirely in Azora.
//
// Talks to Metal through the Objective-C runtime (az_objc.az) and to
// CoreText/CoreGraphics through their plain C APIs for text rasterization.
// Shaders are compiled from MSL source at startup.

module engine.gpu

import std.io
import engine.objc
import engine.math.mat
import engine.shaders
import engine.io

bridge .C {
    // Metal / QuartzCore C entry points
    func MTLCreateSystemDefaultDevice(): Long

    // CoreFoundation / CoreText / CoreGraphics (text rasterization)
    func CFStringCreateWithCString(allocator: Long, str: String, encoding: Int): Long
    func CFRelease(cf: Long)
    func CFDictionaryCreate(allocator: Long, keys: Long, values: Long, numValues: Long, keyCallBacks: Long, valueCallBacks: Long): Long
    func CFAttributedStringCreate(allocator: Long, str: Long, attributes: Long): Long
    func CTFontCreateWithName(name: Long, size: Double, matrix: Long): Long
    func CTLineCreateWithAttributedString(attrString: Long): Long
    func CTLineGetTypographicBounds(line: Long, ascent: Long, descent: Long, leading: Long): Double
    func CTLineDraw(line: Long, context: Long)
    func CGColorSpaceCreateDeviceRGB(): Long
    func CGColorSpaceRelease(space: Long)
    func CGColorCreateGenericRGB(r: Double, g: Double, b: Double, a: Double): Long
    func CGColorRelease(color: Long)
    func CGBitmapContextCreate(data: Long, width: Long, height: Long, bitsPerComponent: Long, bytesPerRow: Long, space: Long, bitmapInfo: Int): Long
    func CGBitmapContextGetData(context: Long): Long
    func CGContextRelease(context: Long)
    func CGContextScaleCTM(context: Long, sx: Double, sy: Double)
    func CGContextSetTextPosition(context: Long, x: Double, y: Double)
}

// ── State ───────────────────────────────────────────────────────────────

pack AzGpu {
    var ok: Bool
    var device: Long
    var queue: Long
    var layer: Long
    var pipe3d: Long
    var pipe2d: Long
    var depthOn: Long
    var depthOff: Long
    var sampler: Long
    var depthTex: Long
    var depthW: Long
    var depthH: Long
    var drawable: Long
    var cmd: Long
    var enc: Long
    var hasEncoder: Bool
    var mode: Int
    var viewProj: Long
    var scratch: Long
    var scale: Double
    var lightX: Double
    var lightY: Double
    var lightZ: Double
    var ambient: Double
}

/// A GPU mesh: vertex buffer handle + vertex count (interleaved pos+normal).
pack Mesh {
    var buffer: Long
    var count: Int
}

// ── Setup ───────────────────────────────────────────────────────────────

func gpuFailed(): AzGpu {
    return AzGpu(false, Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), Long(0), false, -1, Long(0), Long(0), 1.0, 0.5, 0.8, 0.3, 0.35)
}

func gpuInit(scale: Double): AzGpu {
    fin device = MTLCreateSystemDefaultDevice()
    if device == Long(0) {
        println("azora-engine: no Metal device")
        return gpuFailed()
    }
    fin queue = send0(device, sel("newCommandQueue"))
    if queue == Long(0) {
        send0(device, sel("release"))
        println("azora-engine: command queue creation failed")
        return gpuFailed()
    }

    // CAMetalLayer (attached to the window's content view by the platform layer).
    fin layer = send0(cls("CAMetalLayer"), sel("layer"))
    send1(layer, sel("setDevice:"), device)
    send1(layer, sel("setPixelFormat:"), Long(80))
    fin unused0 = azSendF1(layer, sel("setContentsScale:"), scale)

    // Shader library from MSL source.
    fin lib = send3(device, sel("newLibraryWithSource:options:error:"), nsString(shaderSource()), Long(0), Long(0))
    if lib == Long(0) {
        println("azora-engine: shader compilation failed")
        send0(queue, sel("release"))
        send0(device, sel("release"))
        return gpuFailed()
    }

    defer { send0(lib, sel("release")) }

    // 3D pipeline: BGRA8 color + Depth32 depth.
    fin d3 = newObject("MTLRenderPipelineDescriptor")
    defer { send0(d3, sel("release")) }
    fin v3 = send1(lib, sel("newFunctionWithName:"), nsString("v3_main"))
    fin f3 = send1(lib, sel("newFunctionWithName:"), nsString("f3_main"))
    defer { send0(v3, sel("release")) }
    defer { send0(f3, sel("release")) }
    send1(d3, sel("setVertexFunction:"), v3)
    send1(d3, sel("setFragmentFunction:"), f3)
    fin ca3 = send1(send0(d3, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), Long(0))
    send1(ca3, sel("setPixelFormat:"), Long(80))
    send1(d3, sel("setDepthAttachmentPixelFormat:"), Long(252))
    fin pipe3d = send2(device, sel("newRenderPipelineStateWithDescriptor:error:"), d3, Long(0))
    if pipe3d == Long(0) {
        println("azora-engine: 3D pipeline failed")
        send0(queue, sel("release"))
        send0(device, sel("release"))
        return gpuFailed()
    }

    // 2D pipeline: alpha blending for UI rects and text quads.
    fin d2 = newObject("MTLRenderPipelineDescriptor")
    defer { send0(d2, sel("release")) }
    fin v2 = send1(lib, sel("newFunctionWithName:"), nsString("v2_main"))
    fin f2 = send1(lib, sel("newFunctionWithName:"), nsString("f2_main"))
    defer { send0(v2, sel("release")) }
    defer { send0(f2, sel("release")) }
    send1(d2, sel("setVertexFunction:"), v2)
    send1(d2, sel("setFragmentFunction:"), f2)
    fin ca2 = send1(send0(d2, sel("colorAttachments")), sel("objectAtIndexedSubscript:"), Long(0))
    send1(ca2, sel("setPixelFormat:"), Long(80))
    send1(ca2, sel("setBlendingEnabled:"), Long(1))
    send1(ca2, sel("setSourceRGBBlendFactor:"), Long(4))
    send1(ca2, sel("setDestinationRGBBlendFactor:"), Long(5))
    send1(ca2, sel("setSourceAlphaBlendFactor:"), Long(4))
    send1(ca2, sel("setDestinationAlphaBlendFactor:"), Long(5))
    send1(d2, sel("setDepthAttachmentPixelFormat:"), Long(252))
    fin pipe2d = send2(device, sel("newRenderPipelineStateWithDescriptor:error:"), d2, Long(0))
    if pipe2d == Long(0) {
        println("azora-engine: 2D pipeline failed")
        send0(pipe3d, sel("release"))
        send0(queue, sel("release"))
        send0(device, sel("release"))
        return gpuFailed()
    }

    // Depth-stencil states: compare Less + write for 3D, Always for UI.
    fin dsOn = newObject("MTLDepthStencilDescriptor")
    defer { send0(dsOn, sel("release")) }
    send1(dsOn, sel("setDepthCompareFunction:"), Long(1))
    send1(dsOn, sel("setDepthWriteEnabled:"), Long(1))
    fin depthOn = send1(device, sel("newDepthStencilStateWithDescriptor:"), dsOn)

    fin dsOff = newObject("MTLDepthStencilDescriptor")
    defer { send0(dsOff, sel("release")) }
    send1(dsOff, sel("setDepthCompareFunction:"), Long(7))
    send1(dsOff, sel("setDepthWriteEnabled:"), Long(0))
    fin depthOff = send1(device, sel("newDepthStencilStateWithDescriptor:"), dsOff)

    // Linear sampler for text textures.
    fin sd = newObject("MTLSamplerDescriptor")
    defer { send0(sd, sel("release")) }
    send1(sd, sel("setMinFilter:"), Long(1))
    send1(sd, sel("setMagFilter:"), Long(1))
    fin sampler = send1(device, sel("newSamplerStateWithDescriptor:"), sd)

    var gpu = AzGpu(
        true, device, queue, layer,
        pipe3d, pipe2d, depthOn, depthOff, sampler,
        Long(0), Long(0), Long(0),
        Long(0), Long(0), Long(0), false, -1,
        azAlloc(Long(64)),
        azAlloc(Long(4096)),
        scale,
        0.5, 0.8, 0.3, 0.35
    )
    // Identity view-projection until a camera is applied.
    pokeIdentity(gpu.viewProj)
    return take gpu
}

/** Releases retained Metal objects and native upload memory. Repeated shutdown is harmless. */
func gpuShutdown(gpu: AzGpu!) {
    if gpu.depthTex != Long(0) { send0(gpu.depthTex, sel("release")) }
    if gpu.sampler != Long(0) { send0(gpu.sampler, sel("release")) }
    if gpu.depthOff != Long(0) { send0(gpu.depthOff, sel("release")) }
    if gpu.depthOn != Long(0) { send0(gpu.depthOn, sel("release")) }
    if gpu.pipe2d != Long(0) { send0(gpu.pipe2d, sel("release")) }
    if gpu.pipe3d != Long(0) { send0(gpu.pipe3d, sel("release")) }
    if gpu.queue != Long(0) { send0(gpu.queue, sel("release")) }
    if gpu.device != Long(0) { send0(gpu.device, sel("release")) }
    if gpu.viewProj != Long(0) { azFree(gpu.viewProj) }
    if gpu.scratch != Long(0) { azFree(gpu.scratch) }
    gpu.depthTex = Long(0)
    gpu.sampler = Long(0)
    gpu.depthOff = Long(0)
    gpu.depthOn = Long(0)
    gpu.pipe2d = Long(0)
    gpu.pipe3d = Long(0)
    gpu.queue = Long(0)
    gpu.device = Long(0)
    gpu.layer = Long(0)
    gpu.viewProj = Long(0)
    gpu.scratch = Long(0)
    gpu.drawable = Long(0)
    gpu.cmd = Long(0)
    gpu.enc = Long(0)
    gpu.hasEncoder = false
    gpu.ok = false
}

func pokeIdentity(buf: Long) {
    var i = 0
    while i < 16 {
        var v: Double = 0.0
        if i == 0 || i == 5 || i == 10 || i == 15 {
            v = 1.0
        }
        azPokeF32(buf, (i * 4) as Long, v)
        i = i + 1
    }
}

/// Writes a row-major Mat4 into [buf] as column-major float16 (GPU layout).
func pokeMat4(buf: Long, offset: Long, m: Mat4&) {
    azPokeF32(buf, offset, m.m00)
    azPokeF32(buf, offset + Long(4), m.m10)
    azPokeF32(buf, offset + Long(8), m.m20)
    azPokeF32(buf, offset + Long(12), m.m30)
    azPokeF32(buf, offset + Long(16), m.m01)
    azPokeF32(buf, offset + Long(20), m.m11)
    azPokeF32(buf, offset + Long(24), m.m21)
    azPokeF32(buf, offset + Long(28), m.m31)
    azPokeF32(buf, offset + Long(32), m.m02)
    azPokeF32(buf, offset + Long(36), m.m12)
    azPokeF32(buf, offset + Long(40), m.m22)
    azPokeF32(buf, offset + Long(44), m.m32)
    azPokeF32(buf, offset + Long(48), m.m03)
    azPokeF32(buf, offset + Long(52), m.m13)
    azPokeF32(buf, offset + Long(56), m.m23)
    azPokeF32(buf, offset + Long(60), m.m33)
}
