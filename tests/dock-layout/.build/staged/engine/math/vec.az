// Azora Engine — 3D math library.
//
// Vec3 and Mat4 are value types in spirit: every operation returns a new
// instance (packs are reference types at runtime, so shared mutation is
// avoided by convention here).
//
// Mat4 is row-major with translation in m03/m13/m23; the native runtime
// converts to the GPU layout when a matrix crosses the FFI boundary.

module engine.math.vec

import std.math
import std.convert
import std.error
import std.reflection

error MathError {
    DivisionByZero
    ZeroLength
}

@Experimental(since: "0.1")
pack Vec<T, N: Int> where T is Number && N in 2..4 {
    var x: T = 0
    var y: T = 0
    var z: T = 0 where N >= 3
    var w: T = 0 where N == 4
}

impl Vec<T, N> { // automatically inherit Vec’s declaration constraints
    ctor .(all: T) {
        inline for f in reflect<Self>.fields {
            self.${f.name} = all
        }
    }

    oper+ &.(rhs: Self&): Self {
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} + rhs.${f.name}
            }
        )
    }

    oper+= !.(rhs: Self&): Unit {
        inline for f in reflect<Self>.fields {
            self.${f.name} += rhs.${f.name}
        }
    }

    oper+ &.(rhs: T&): Self {
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} + rhs
            }
        )
    }

    oper+= !.(rhs: T&): Unit {
        inline for f in reflect<Self>.fields {
            self.${f.name} += rhs
        }
    }

    oper- &.(rhs: Self&): Self {
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} - rhs.${f.name}
            }
        )
    }

    oper-= !.(rhs: Self&): Unit {
        inline for f in reflect<Self>.fields {
            self.${f.name} -= rhs.${f.name}
        }
    }

    oper- &.(rhs: T&): Self {
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} - rhs
            }
        )
    }

    oper-= !.(rhs: T&): Unit {
        inline for f in reflect<Self>.fields {
            self.${f.name} -= rhs
        }
    }

    oper* &.(rhs: Self&): Self {
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} * rhs.${f.name}
            }
        )
    }

    oper*= !.(rhs: Self&): Unit {
        inline for f in reflect<Self>.fields {
            self.${f.name} *= rhs.${f.name}
        }
    }

    oper* &.(rhs: T&): Self {
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} * rhs
            }
        )
    }

    oper*= !.(rhs: T&): Unit {
        inline for f in reflect<Self>.fields {
            self.${f.name} *= rhs
        }
    }

    oper/ &.(rhs: Self&): Self
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            inline for f in reflect<Self>.fields {
                if rhs.${f.name} == 0 { error MathError.DivisionByZero }
            }
        }
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} / rhs.${f.name}
            }
        )
    }

    oper/= !.(rhs: Self&): Unit
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            inline for f in reflect<Self>.fields {
                if rhs.${f.name} == 0 { error MathError.DivisionByZero }
            }
        }
        inline for f in reflect<Self>.fields {
            self.${f.name} /= rhs.${f.name}
        }
    }

    oper/ &.(rhs: T&): Self
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            if rhs == 0 { error MathError.DivisionByZero }
        }
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} / rhs
            }
        )
    }

    oper/= !.(rhs: T&): Unit
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            if rhs == 0 { error MathError.DivisionByZero }
        }
        inline for f in reflect<Self>.fields {
            self.${f.name} /= rhs
        }
    }

    oper% &.(rhs: Self&): Self
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            inline for f in reflect<Self>.fields {
                if rhs.${f.name} == 0 { error MathError.DivisionByZero }
            }
        }
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} % rhs.${f.name}
            }
        )
    }

    oper%= !.(rhs: Self&): Unit
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            inline for f in reflect<Self>.fields {
                if rhs.${f.name} == 0 { error MathError.DivisionByZero }
            }
        }
        inline for f in reflect<Self>.fields {
            self.${f.name} %= rhs.${f.name}
        }
    }

    oper% &.(rhs: T&): Self
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            if rhs == 0 { error MathError.DivisionByZero }
        }
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} % rhs
            }
        )
    }

    oper%= !.(rhs: T&): Unit
    inline if T is Integer { inline "?! MathError" } {
        inline if T is Integer {
            if rhs == 0 { error MathError.DivisionByZero }
        }
        inline for f in reflect<Self>.fields {
            self.${f.name} %= rhs
        }
    }

    inline for op in ["&", "|", "^"] {
        inline fin assignOp = "${op}="

        oper$op &.(rhs: Self&): Self where T is Integer = Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} $op rhs.${f.name}
            }
        )

        oper$op &.(rhs: T&): Self where T is Integer = Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} $op rhs
            }
        )

        oper$assignOp !.(rhs: Self&) where T is Integer {
            inline for f in reflect<Self>.fields {
                self.${f.name} $assignOp rhs.${f.name}
            }
        }

        oper$assignOp !.(rhs: T&) where T is Integer {
            inline for f in reflect<Self>.fields {
                self.${f.name} $assignOp rhs
            }
        }
    }

    oper+ &.(): Self = self

    oper- &.(): Self where T is SignedNumber = Self(
        inline for f in reflect<Self>.fields {
            -self.${f.name}
        }
    )

    oper~ &.(): Self where T is Integer = Self(
        inline for f in reflect<Self>.fields {
            ~self.${f.name}
        }
    )

    inline for op in ["<<", ">>"] {
        inline fin assignOp = "${op}="

        oper$op &.(rhs: Int&): Self where T is Integer = Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} $op rhs
            }
        )

        oper$assignOp !.(rhs: Int&) where T is Integer {
            inline for f in reflect<Self>.fields {
                self.${f.name} $assignOp rhs
            }
        }
    }

    oper[] &.(index: Int): T ?! IndexError {
        inline for f in reflect<Self>.fields with i {
            if index == i { return self.${f.name} }
        }
        return .OutOfBounds(index, N)
    }

    oper[]= !.(index: Int, value: T): Unit ?! IndexError {
        inline for f in reflect<Self>.fields with i {
            if index == i {
                self.${f.name} = value
                return
            }
        }
        return .OutOfBounds(index, N)
    }

    oper.. &.(rhs: Self&) by Self::one

    oper>.. &.(rhs: Self&) by Self::one


    /**
     * Vector magnitude.
     */
    prop  &.length: Double = sqrt(self.lengthSquared)

    prop  &.lengthSquared: Double {
        var result: Double = 0
        inline for f in reflect<Self>.fields {
            fin value = self.${f.name} as Double
            result += value * value
        }
        return result
    }

    /**
     * The dot product with [rhs].
     *
     * Accumulated in `Double` for the same reason [lengthSquared] is: the sum of
     * products overflows a narrow element type long before the result would.
     */
    func &.dot(rhs: Self&): Double {
        var result: Double = 0
        inline for f in reflect<Self>.fields {
            result += (self.${f.name} as Double) * (rhs.${f.name} as Double)
        }
        return result
    }

    func &.distanceTo(other: Self&): Double {
        return (self - other).length
    }

    /**
     * Returns a normalized copy.
     */
    prop  &.normalized: Self ?! MathError where T is FloatingPoint {
        if self.length == 0 { error MathError.ZeroLength }
        return Self(
            inline for f in reflect<Self>.fields {
                self.${f.name} / self.length as T
            }
        )
    }

    /**
     * Normalizes this vector in place.
     */
    func !.normalize() ?! MathError where T is FloatingPoint {
        fin length = self.length
        if length == 0 { error MathError.ZeroLength }
        fin divisor = length as T
        inline for f in reflect<Self>.fields {
            self.${f.name} /= divisor
        }
    }

    func &.perpendicular(): Self where T is SignedNumber && N == 2 {
        return Self(-self.y, self.x)
    }

    /**
     * Three-dimensional cross product.
     */
    func &.cross(rhs: Self&): Self where N == 3 {
        return Self(
            self.y * rhs.z - self.z * rhs.y,
            self.z * rhs.x - self.x * rhs.z,
            self.x * rhs.y - self.y * rhs.x
        )
    }
}

inline for Ty in Numbers {
    oper+<N: Int> Ty&.(rhs: Vec<Ty, N>&): Vec<Ty, N>
    where N in 2..4 {
        return Vec<Ty, N>(
            inline for f in reflect<Vec<Ty, N>>.fields {
                self + rhs.${f.name}
            }
        )
    }
}

inline for Ty in Numbers {
    oper-<N: Int> Ty&.(rhs: Vec<Ty, N>&): Vec<Ty, N>
    where N in 2..4 {
        return Vec<Ty, N>(
            inline for f in reflect<Vec<Ty, N>>.fields {
                self - rhs.${f.name}
            }
        )
    }
}

inline for Ty in Numbers {
    oper*<N: Int> Ty&.(rhs: Vec<Ty, N>&): Vec<Ty, N>
    where N in 2..4 {
        return Vec<Ty, N>(
            inline for f in reflect<Vec<Ty, N>>.fields {
                self * rhs.${f.name}
            }
        )
    }
}

inline for Ty in Numbers {
    oper/<N: Int> Ty&.(rhs: Vec<Ty, N>&): Vec<Ty, N>
    inline if Ty is Integer { inline "?! MathError" }
    where N in 2..4 {
        inline if Ty is Integer {
            inline for f in reflect<Vec<Ty, N>>.fields {
                if rhs.${f.name} == 0 { error MathError.DivisionByZero }
            }
        }
        return Vec<Ty, N>(
            inline for f in reflect<Vec<Ty, N>>.fields {
                self / rhs.${f.name}
            }
        )
    }
}

inline for Ty in Numbers {
    oper%<N: Int> Ty&.(rhs: Vec<Ty, N>&): Vec<Ty, N>
    inline if Ty is Integer { inline "?! MathError" }
    where N in 2..4 {
        inline if Ty is Integer {
            inline for f in reflect<Vec<Ty, N>>.fields {
                if rhs.${f.name} == 0 { error MathError.DivisionByZero }
            }
        }
        return Vec<Ty, N>(
            inline for f in reflect<Vec<Ty, N>>.fields {
                self % rhs.${f.name}
            }
        )
    }
}

impl Cast<Vec<T, N>> for Vec<U, N> {
    prop &.castValue: Vec<T, N> = Vec<T, N>(
        inline for f in reflect<Vec<U, N>>.fields {
            self.${f.name} as T
        }
    )
}

inline for Ty in Numbers {
    inline for N in 2..4 {
        impl Cast<Vec<Ty, N>> for Ty {
            prop &.castValue: Vec<Ty, N> = Vec<Ty, N>(self)
        }
    }
}

impl Vec<T, N> {
    inline func<I: Int> axis(value: T = 1): Vec<T, N> where I in 0..<N {
        return Vec<T, N>(
            inline for i in 0..<N {
                if i == I { value } else { 0 as T }
            }
        )
    }

    prop zero: Vec<T, N> = Vec<T, N>(0 as T)
    prop one: Vec<T, N> = Vec<T, N>(1 as T)
    prop right: Vec<T, N> = Vec<T, N>(inline for i in 0..<N { if i == 0 { 1 as T } else { 0 as T } })
    prop up: Vec<T, N> = Vec<T, N>(inline for i in 0..<N { if i == 1 { 1 as T } else { 0 as T } })
    prop forward: Vec<T, N> where N >= 3 = Vec<T, N>(inline for i in 0..<N { if i == 2 { 1 as T } else { 0 as T } })
    prop left: Vec<T, N> where T is SignedNumber = Vec<T, N>(inline for i in 0..<N { if i == 0 { -1 as T } else { 0 as T } })
    prop down: Vec<T, N> where T is SignedNumber = Vec<T, N>(inline for i in 0..<N { if i == 1 { -1 as T } else { 0 as T } })
    prop back: Vec<T, N> where T is SignedNumber && N >= 3 = Vec<T, N>(inline for i in 0..<N { if i == 2 { -1 as T } else { 0 as T } })
}

inline for [t, Ty] in [["i", "u", "f", ""], [Int, UInt, Float, Double]] {
    inline for i in 2..4 {
        typealias Vec$i$t = Vec<Ty, i>
    }
}
